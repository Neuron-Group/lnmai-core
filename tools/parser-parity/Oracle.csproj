<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup><Compile Include="$(MajSimaiSource)/Runtime/**/*.cs" /></ItemGroup>
  <Target Name="CheckReference" BeforeTargets="BeforeBuild" Condition="!Exists('$(MajSimaiSource)/Runtime/SimaiParser.cs')">
    <Error Text="Pass -p:MajSimaiSource=/absolute/path/to/MajSimai" />
  </Target>
</Project>
