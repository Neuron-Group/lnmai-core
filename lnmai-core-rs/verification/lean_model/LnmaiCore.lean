/-- [lnmai_core::aeneas_test::update_score]:
    Source: 'src/aeneas_test.rs', lines 117:0-124:1
    Visibility: public -/
def aeneas_test.update_score
  (state : aeneas_test.ScoreState) (base : Std.U32) (grade : aeneas_test.Grade)
  :
  Result aeneas_test.ScoreState
  := do
  let (earned, _) ← aeneas_test.compute_score base grade
  let b ←
    aeneas_test.Grade.Insts.CoreCmpPartialEqGrade.eq grade
      aeneas_test.Grade.Miss
  let (state1, i) ←
    if b
    then ok (state, 0#u32)
    else do
         let i1 ← state.combo + 1#u32
         ok (state, i1)
  let b1 ←
    aeneas_test.Grade.Insts.CoreCmpPartialEqGrade.eq grade
      aeneas_test.Grade.Perfect
  let (state2, i1) ←
    if b1
    then do
         let i2 ← state1.perfect_combo + 1#u32
         ok (state1, i2)
    else ok (state1, 0#u32)
  let i2 ← state2.total_score + earned
  ok { combo := i, perfect_combo := i1, total_score := i2 }

