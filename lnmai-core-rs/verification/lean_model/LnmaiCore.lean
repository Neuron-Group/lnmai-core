    Source: 'src/aeneas_test.rs', lines 85:0-96:1
    Visibility: public -/
def aeneas_test.judge_tap
  (diff : aeneas_test.Duration) : Result aeneas_test.Grade := do
  let abs_diff ←
    if diff.micros < 0#i64
    then -. diff.micros
    else ok diff.micros
  if abs_diff <= 16667#i64
  then ok aeneas_test.Grade.Perfect
  else
    if abs_diff <= 50001#i64
    then ok aeneas_test.Grade.Great
    else
      if abs_diff <= 150003#i64
      then ok aeneas_test.Grade.Good
      else ok aeneas_test.Grade.Miss

