index(&self, note: &N) -> Id {\n        self.ops.note_index(note)\n    }\n\n    fn group_size(&self, note: &N) -> Id {\n        self.ops.group_size(note)\n    }\n\n    fn phase(&self, note: &N) -> HoldPhase {\n        self.ops.phase(note)\n    }\n\n    fn head_grade(&self, note: &N) -> Option<Grade> {\n        self.ops.head_grade(note)\n    }\n\n    fn head_diff(&self, note: &N) -> D {\n        self.ops.head_diff(note)\n    }\n\n    fn grade_rejected(&self, grade: &Grade) -> bool {\n        self.ops.grade_rejected(grade)\n    }\n\n    fn within_head_window(&self, note: &N) -> bool {\n        self.ops.within_head_window(note)\n    }\n\n    fn unlocked(&self, frontiers: &F, area: &A, note: &N) -> bool {\n        self.ops.unlocked(frontiers, area, note)\n    }\n\n    fn eligible(&self, note: &N) -> bool {\n        self.ops.eligible(note)\n    }\n\n    fn button_ring(&self) -> bool {\n        self.ops.button_ring()\n    }\n\n    fn outer_button(&self, area: &A) -> Option<Z> {\n        self.ops.outer_button(area)\n    }\n\n    fn button_available(&self, cursor: &C, zone: &Z) -> bool {\n        self.ops.button_available(cursor, zone)\n    }\n\n    fn sensor_available(&self, cursor: &C, area: &A) -> bool {\n        self.ops.sensor_available(cursor, area)\n    }\n\n    fn use_button(&self, cursor: C, zone: &Z) -> C {\n        self.ops.use_button(cursor, zone)\n    }\n\n    fn use_sensor(&self, cursor: C, area: &A) -> C {\n        self.ops.use_sensor(cursor, area)\n    }\n\n    fn step(\n        &self,\n        note: &N,\n        diff: D,\n        clicked: bool,\n        pressed: bool,\n        shared: Option<(Grade, D)>,\n    ) -> (N, Option<Event>) {\n        self.ops.step(note, diff, clicked, pressed, shared)\n    }\n\n    fn advance_frontier(&self, frontiers: F, area: &A) -> F {\n        self.ops.advance_frontier(frontiers, area)\n    }\n\n    fn update_queue(&self, queues: Q, area: &A, note: &N) -> Q {\n        self.ops.update_queue(queues, area, note)\n    }\n\n    fn append_active(&self, active: H, area: A, note: N) -> H {\n        self.ops.append_active(active, area, note)\n    }\n\n    fn append_event(&self, events: E, event: Event) -> E {\n        self.ops.append_event(events, event)\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"impl_trait":{"id":23,"generics":{"regions":[],"types":[{"Deduplicated":29030},{"Deduplicated":28859},{"Deduplicated":28860},{"Deduplicated":28864},{"Deduplicated":28865},{"Deduplicated":28869},{"Deduplicated":28870},{"Deduplicated":28871},{"Deduplicated":29031},{"Deduplicated":29032},{"Deduplicated":29033},{"Deduplicated":29034},{"Deduplicated":29035},{"Deduplicated":29036}],"const_generics":[],"trait_refs":[]}},"generics":{"regions":[],"types":[{"index":0,"name":"S"},{"index":1,"name":"A"},{"index":2,"name":"N"},{"index":3,"name":"F"},{"index":4,"name":"Q"},{"index":5,"name":"C"},{"index":6,"name":"H"},{"index":7,"name":"E"},{"index":8,"name":"Event"},{"index":9,"name":"D"},{"index":10,"name":"Z"},{"index":11,"name":"Id"},{"index":12,"name":"Grade"},{"index":13,"name":"Ops"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":48,"beg":{"line":358,"col":9},"end":{"line":358,"col":74}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":23,"generics":{"regions":[],"types":[{"Deduplicated":29029},{"Deduplicated":28859},{"Deduplicated":28860},{"Deduplicated":28864},{"Deduplicated":28865},{"Deduplicated":28869},{"Deduplicated":28870},{"Deduplicated":28871},{"Deduplicated":29031},{"Deduplicated":29032},{"Deduplicated":29033},{"Deduplicated":29034},{"Deduplicated":29035},{"Deduplicated":29036}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,