ble(&self, note: &N) -> bool;\n    fn unlocked(&self, frontiers: &F, note: &N) -> bool;\n    fn button_ring_for_touch(&self) -> bool;\n    fn sensor_area(&self, note: &N) -> Area;\n    fn outer_button(&self, area: &Area) -> Option<Zone>;\n    fn button_available(&self, cursor: &C, zone: &Zone) -> bool;\n    fn sensor_available(&self, cursor: &C, area: &Area) -> bool;\n    fn use_button(&self, cursor: C, zone: &Zone) -> C;\n    fn use_sensor(&self, cursor: C, area: &Area) -> C;\n    fn step(\n        &self,\n        note: &N,\n        diff: &D,\n        clicked: bool,\n        shared: Option<(Grade, D)>,\n    ) -> (N, Option<Event>);\n    fn ended(&self, note: &N) -> bool;\n    fn event_grade(&self, event: &Event) -> Grade;\n    fn is_miss_or_too_fast(&self, grade: &Grade) -> bool;\n    fn prepend_event(&self, events_rev: E, event: &Event) -> E;\n    fn register_group(&self, groups: G, id: Id, size: Id, grade: Grade, diff: D) -> G;\n    fn advance_frontier(&self, frontiers: F) -> F;\n}","attr_info":{"attributes":[{"DocComment":" Scheduler point operations, plus two explicitly identified group subcalls."},{"DocComment":""},{"DocComment":" `step` is one note's lifecycle call, never a queue/click/group iteration."},{"DocComment":" `shared_result` and `register_group` retain the existing group-plan helpers;"},{"DocComment":" their list traversal is a SEPARATE proof boundary (SchedulerFrameProof's"},{"DocComment":" group-plan interpretation plus concrete container/number laws). They must"},{"DocComment":" not be described as single field accesses. Queue traversal is composed"},{"DocComment":" below, rather than delegated to normalize/replace callbacks."},{"DocComment":""},{"DocComment":" M supplies QueueCursor's peek/resolved/advance and QueueReplace's"},{"DocComment":" get/index_equal/write. Each queue_ops result must implement the same laws."},{"DocComment":" Id represents both group identifiers and group sizes; it is not a usize."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Q"},{"index":2,"name":"N"},{"index":3,"name":"F"},{"index":4,"name":"C"},{"index":5,"name":"G"},{"index":6,"name":"E"},{"index":7,"name":"Event"},{"index":8,"name":"T"},{"index":9,"name":"D"},{"index":10,"name":"Area"},{"index":11,"name":"Zone"},{"index":12,"name":"Id"},{"index":13,"name":"Grade"},{"index":14,"name":"M"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"queue_ops","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":23266}],"output":{"Deduplicated":23290}},"item":{"id":614,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":23111},{"Deduplicated":23113},{"Deduplicated":23114},{"Deduplicated":23115},{"Deduplicated":23117},{"Deduplicated":23118},{"Deduplicated":23119},{"Deduplicated":23281},{"Deduplicated":23282},{"Deduplicated":23291},{"Deduplicated":23292},{"Deduplicated":23293},{"Deduplicated":23294},{"Deduplicated":23295},{"Deduplicated":23290}],"const_generics":[],"trait_refs":[{"HashConsedValue":[23296,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":23111},{"Deduplicated":23113},{"Deduplicated":23114},{"Deduplicated":23115},{"Deduplicated":23117},{"Deduplicated":23118},{"Deduplicated":23119},{"Deduplicated":23281},{"Deduplicated":23282},{"Deduplicated":23291},{"Deduplicated":23292},{"Deduplicated":23293},{"Deduplicated":23294},{"Deduplicated":23295},{"Deduplicated":23290}],"const_generics":[],"trait_refs":