icWork<Notes, F, E>,\n    ops: Ops,\n) -> TouchAutomaticWork<Notes, F, E>\nwhere\n    Ops: TouchAutomatic<S, N, Notes, F, E, Event, D, Shared>,\n{\n    let len = ops.length(source);\n    let mut index = 0;\n    while index < len {\n        let before = ops.get(source, index);\n        if ops.before_cursor(source, index) || ops.resolved(&before) {\n            work.notes = ops.append_note(work.notes, before);\n        } else {\n            let diff = ops.sensor_diff(&before);\n            let shared = ops.shared(&before);\n            let too_late = ops.too_late(&before);\n            if shared.is_none() && !too_late {\n                work.notes = ops.append_note(work.notes, before);\n            } else {\n                let (after, event) = ops.step(&before, diff, shared);\n                let resolved_now = !ops.resolved(&before) && ops.resolved(&after);\n                if resolved_now {\n                    work.frontiers = ops.advance_frontier(work.frontiers);\n                }\n                if let Some(event) = event {\n                    work.events_rev = ops.prepend_event(work.events_rev, event);\n                }\n                work.notes = ops.append_note(work.notes, after);\n            }\n        }\n        index += 1;\n    }\n    work\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"S"},{"index":1,"name":"N"},{"index":2,"name":"Notes"},{"index":3,"name":"F"},{"index":4,"name":"E"},{"index":5,"name":"Event"},{"index":6,"name":"D"},{"index":7,"name":"Shared"},{"index":8,"name":"Ops"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":37,"beg":{"line":35,"col":9},"end":{"line":35,"col":60}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":