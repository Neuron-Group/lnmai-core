n    }\n\n    fn append_body_line(\n        &self,\n        mut body: MaidataChartBlock<Text, Ops::Level>,\n        index: usize,\n    ) -> MaidataChartBlock<Text, Ops::Level> {\n        // Keep newline mutation/allocation before even indexing the input.\n        self.primitives.push_newline(&mut body.raw_body);\n        self.primitives.push_str(\n            &mut body.raw_body,\n            self.primitives.borrow(&self.lines[index]),\n        );\n        body\n    }\n\n    fn append_chart(\n        &self,\n        mut charts: Vec<MaidataChartBlock<Text, Ops::Level>>,\n        body: MaidataChartBlock<Text, Ops::Level>,\n    ) -> Vec<MaidataChartBlock<Text, Ops::Level>> {\n        charts.push(body);\n        charts\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"impl_trait":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":28913},{"Deduplicated":28867},{"Deduplicated":28915},{"Deduplicated":28917},{"Deduplicated":28916}],"const_generics":[],"trait_refs":[]}},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Text"},{"index":1,"name":"Ops"},{"index":2,"name":"Clause0_View"},{"index":3,"name":"Clause0_Level"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":12,"beg":{"line":79,"col":9},"end":{"line":79,"col":29}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":28860},{"Deduplicated":28859},{"Deduplicated":28864},{"Deduplicated":28865}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"sk