y!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if outer_slot_is_upper_half(start_lane) {\n                    direct\n                } else {\n                    mirror\n                },\n            ))\n        }\n        SlideBodyKind::CircleLeft => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if !outer_slot_is_upper_half(start_lane) {\n                    direct\n                } else {\n                    mirror\n                },\n            ))\n        }\n        SlideBodyKind::CircleUp => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if rel_end < 5 { direct } else { mirror },\n            ))\n        }\n        SlideBodyKind::V => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::V, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Pp => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Ppqq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Qq => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Ppqq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, mirror))\n        }\n        SlideBodyKind::P => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Pq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Q => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Pq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, mirror))\n        }\n        SlideBodyKind::S | SlideBodyKind::Z => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if rel_end != 5 {\n                Err(ShapeError::InvalidEnd)\n            } else {\n                let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::S, None));\n                let sym = if kind == SlideBodyKind::Z {\n                    mirror\n                } else {\n                    direct\n                };\n                Ok(mk_slide_shape(canonical, sym))\n            }\n        }\n        SlideBodyKind::Turn => {\n            let turn_area = turn_area.unwrap_or(SensorArea::A1);\n            let turn_rel = shape_try!(relative_end_from_typed(start_lane, turn_area));\n            let end_rel = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if turn_rel == 7 {\n                if end_rel < 2 || end_rel > 5 {\n                    Err(ShapeError::InvalidTurnEnd)\n                } else {\n                    let canonical =\n                        shape_try!(mk_canonical_slide_shape(SlideKind::Turn, Some(end_rel)));\n                    Ok(mk_slide_shape(canonical, direct))\n                }\n            } else if turn_rel == 3 {\n                if end_rel < 5 {\n                    Err(ShapeError::InvalidTurnEnd)\n                } else {\n                    let canonical =\n                        shape_try!(mk_canonical_slide_shape(SlideKind::Turn, Some(end_rel)));\n                    Ok(mk_slide_shape(canonical, mirror))\n                }\n            } else {\n                Err(ShapeError::InvalidTurn)\n            }\n        }\n        SlideBodyKind::Wifi => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if rel_end != 5 {\n                Err(ShapeError::InvalidEnd)\n            } else {\n                let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Wifi, None));\n                Ok(mk_slide_shape(canonical, direct))\n            }\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" `solveSlideShape`."},{"Unknown":{"path":"allow","args":"clippy::manual_range_contains"}}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"HashConsedValue":[11610,{"Adt":{"id":{"Adt":31},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":8290},{"HashConsedValue":[11676,{"Adt":{"id":{"Adt":89},"generics":{"regions":[],"types":[{"Deduplicated":7873}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":11676}],"output":{"HashConsedValue":[11677,{"Adt":{"id":{"Adt":104},"generics":{"regions":[],"types":[{"Deduplicated":11575},{"Deduplicated":11636}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":20,"beg":{"line":282,"col":0},"end":{"line":402,"col":1}},"generated_from_span":null},"bound_body_regions":10,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":20,"beg":{"line":287,"col":5},"end":{"line":287,"col":35}},"generated_from_span":null},"ty":{"Deduplicated":11677}},{"index":1,"name":"kind","span":{"data":{"file_id"