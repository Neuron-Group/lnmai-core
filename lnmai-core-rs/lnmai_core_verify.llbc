ata":{"file_id":15,"beg":{"line":32,"col":0},"end":{"line":62,"col":1}},"generated_from_span":null},"source_text":"pub fn select_command(facts: CommandFacts) -> Option<SlideBodyKind> {\n    if facts.line {\n        Some(SlideBodyKind::Line)\n    } else if facts.circle_right {\n        Some(SlideBodyKind::CircleRight)\n    } else if facts.circle_left {\n        Some(SlideBodyKind::CircleLeft)\n    } else if facts.circle_up {\n        Some(SlideBodyKind::CircleUp)\n    } else if facts.v {\n        Some(SlideBodyKind::V)\n    } else if facts.pp {\n        Some(SlideBodyKind::Pp)\n    } else if facts.qq {\n        Some(SlideBodyKind::Qq)\n    } else if facts.p {\n        Some(SlideBodyKind::P)\n    } else if facts.q {\n        Some(SlideBodyKind::Q)\n    } else if facts.s {\n        Some(SlideBodyKind::S)\n    } else if facts.z {\n        Some(SlideBodyKind::Z)\n    } else if facts.turn {\n        Some(SlideBodyKind::Turn)\n    } else if facts.wifi {\n        Some(SlideBodyKind::Wifi)\n    } else {\n        None\n    }\n}","attr_info":{"attributes":[{"DocComment":" The ordered contains-branches of Lean `parseSlideBodyFromText`."},{"DocComment":" In particular, a doubled p/q beats its single-character command, while"},{"DocComment":" an earlier line/circle/v command still beats the doubled command."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"HashConsedValue":[8356,{"Adt":{"id":{"Adt":30},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}],"output":{"HashConsedValue":[8367,{"Adt":{"id":{"Adt":72},"generics":{"regions":[],"types":[{"Deduplicated":7841}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":15,"b