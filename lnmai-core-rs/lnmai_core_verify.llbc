   input_clicked: bool,\n    has_shared: bool,\n) -> (TouchState, TouchAction) {\n    match state {\n        TouchState::Waiting => {\n            if too_late {\n                (TouchState::Ended, TouchAction::Miss)\n            } else if has_shared {\n                (TouchState::Ended, TouchAction::Shared)\n            } else if can_judge {\n                if input_clicked {\n                    (TouchState::Judgeable, TouchAction::Judge)\n                } else {\n                    (TouchState::Judgeable, TouchAction::NoEvent)\n                }\n            } else {\n                (state, TouchAction::NoEvent)\n            }\n        }\n        TouchState::Judgeable => {\n            if too_late {\n                (TouchState::Ended, TouchAction::Miss)\n            } else if has_shared {\n                (TouchState::Ended, TouchAction::Shared)\n            } else if input_clicked {\n                (TouchState::Judgeable, TouchAction::Judge)\n            } else {\n                (state, TouchAction::NoEvent)\n            }\n        }\n        TouchState::Judged(_) | TouchState::Ended => (state, TouchAction::NoEvent),\n    }\n}","attr_info":{"attributes":[{"DocComment":" Select the touch action before evaluating a local judgment. Shared results"},{"DocComment":" precede local input, but an expired note always emits its timeout miss."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"HashConsedValue":[7225,{"Adt":{"id":{"Adt":5},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":6395},{"Deduplicated":6395},{"Deduplicated":6395},{"Deduplicated":6395}],"output":{"HashConsedValue":[7269,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":7225},{"HashC