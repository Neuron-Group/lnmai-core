ize + sensor-slot-store composition.\n    fn update_queue(&self, queues: Q, area: &A, note: &N) -> Q;\n    fn append_active(&self, active: H, area: A, note: N) -> H;\n    fn append_event(&self, events: E, event: Event) -> E;\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"S"},{"index":2,"name":"A"},{"index":3,"name":"N"},{"index":4,"name":"F"},{"index":5,"name":"Q"},{"index":6,"name":"C"},{"index":7,"name":"H"},{"index":8,"name":"E"},{"index":9,"name":"Event"},{"index":10,"name":"D"},{"index":11,"name":"Z"},{"index":12,"name":"Id"},{"index":13,"name":"Grade"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"length","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":23266},{"Deduplicated":23268}],"output":{"Deduplicated":6226}},"item":{"id":873,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":23111},{"Deduplicated":23113},{"Deduplicated":23114},{"Deduplicated":23115},{"Deduplicated":23117},{"Deduplicated":23118},{"Deduplicated":23119},{"Deduplicated":23281},{"Deduplicated":23282},{"Deduplicated":23291},{"Deduplicated":23292},{"Deduplicated":23293},{"Deduplicated":23294},{"Deduplicated":23295}],"const_generics":[],"trait_refs":[{"HashConsedValue":[23325,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":23111},{"Deduplicated":23113},{