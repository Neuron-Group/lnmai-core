in the contribution from a prior\n        // row. Add this row's carry to it and propagate any overflow instead\n        // of overwriting that contribution.\n        let mut position = i + right_len;\n        let (sum, mut overflow) = out[position].overflowing_add(carry);\n        out[position] = sum;\n        position += 1;\n        while overflow && position < out.len() {\n            let (next, next_overflow) = out[position].overflowing_add(1u64);\n            out[position] = next;\n            overflow = next_overflow;\n            position += 1;\n        }\n        debug_assert!(!overflow);\n        i += 1;\n    }\n    normalize(out)\n}","attr_info":{"attributes":[{"DocComment":" Schoolbook product: out[i + j] accumulates left[i] * right[j]."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":29176},{"Deduplicated":29179}],"output":{"Deduplicated":8387}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":3,"beg":{"line":172,"col":0},"end":{"line":213,"col":1}},"generated_from_span":null},"bound_body_regions":51,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":3,"beg":{"line":172,"col":45},"end":{"line":172,"col":51}},"generated_from_span":null},"ty":{"Deduplicated":8387}},{"index":1,"name":"left","span":{"data":{"file_id":3,"beg":{"line":172,"col":11},"end":{"line":172,"col":15}},"generated_from_span":null},"ty":{"Deduplicated":8398}},{"index":2,"name":"right","span":{"data":{"file_id":3,"beg":{"line":172,"col":26},"end":{"line":172,"col":31}},"generated_from_span":null},"ty":{"Deduplicated":8399}},{"index":3,"name":"left_len","span