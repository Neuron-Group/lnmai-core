        }\n        None => {\n            let group = ops.group_length(&groups);\n            groups = ops.append_empty(groups, id);\n            groups = ops.prepend_member(groups, group, note);\n            if triggered {\n                groups = ops.prepend_trigger(groups, group, note);\n            }\n            groups\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" Update one source note. In particular, false still inserts a missing member,"},{"DocComment":" and removes at most ONE trigger. No sets, deduplication, or length clamping."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"S"},{"index":1,"name":"B"},{"index":2,"name":"Id"},{"index":3,"name":"Ops"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":51,"beg":{"line":89,"col":9},"end":{"line":89,"col":35}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":20,"generics":{"regions":[],"types":[{"Deduplicated":29085},{"Deduplicated":29079},{"Deduplicated":29080},{"Deduplicated":29084}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":29080},{"HashConsedValue":[30007,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":29084},"Shared"]}]},{"Deduplicated":29568},{"Deduplicated":8028},{"Deduplicated":29569}],"output":{"Deduplicated":29080}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":51,"beg":{"line":87,"col":0},"end":{"line":117,"col":1}},"generated_from_span":null},"bound_body_regions":83,"locals":{"arg_count":5,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":51,"beg":{"line":87,"col":95},"end"