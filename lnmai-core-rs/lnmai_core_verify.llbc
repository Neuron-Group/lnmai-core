   } else if facts.after_body_end {\n                HoldBodyAction::Unchanged\n            } else if facts.pressed {\n                HoldBodyAction::StartPressed\n            } else {\n                HoldBodyAction::ReleaseHead(grade)\n            }\n        }\n        HoldSubState::BodyHeld => {\n            if facts.is_classic {\n                if facts.classic_limit_reached || head_grade.is_miss_or_too_fast() {\n                    HoldBodyAction::EndNow(head_grade)\n                } else if facts.pressed {\n                    HoldBodyAction::KeepClassicPressed\n                } else {\n                    HoldBodyAction::EndRelease(head_grade)\n                }\n            } else if facts.body_window_disabled {\n                if facts.reached_end {\n                    HoldBodyAction::EndNow(head_grade)\n                } else {\n                    HoldBodyAction::Unchanged\n                }\n            } else if facts.reached_end {\n                HoldBodyAction::EndNow(head_grade)\n            } else if facts.after_body_end {\n                HoldBodyAction::Unchanged\n            } else if facts.pressed {\n                HoldBodyAction::KeepPressed\n            } else {\n                HoldBodyAction::Release\n            }\n        }\n        HoldSubState::BodyReleased => {\n            // Restored Classic BodyReleased states follow this branch too.\n            if facts.body_window_disabled {\n                if facts.reached_end {\n                    HoldBodyAction::EndNow(head_grade)\n                } else {\n                    HoldBodyAction::Unchanged\n                }\n            } else if facts.reached_end {\n                HoldBodyAction::EndNow(head_grade)\n            } else if facts.after_body_end {\n                HoldBodyAction::Unchanged\n            } else if facts.pressed {\n                HoldBodyAction::Recover\n            } else {\n                HoldBodyAction::ReleasedOff\n            }\n        }\n        _ => HoldBodyAction::Unchanged,\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":6858},{"Deduplicated":6838},{"HashConsedValue":[7572,{"Adt":{"id":{"Adt":10},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}],"output":{"Deduplicated":7545}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":8,"beg":{"line":267,"col":0},"end":{"line":347,"col":1}},"generated_from_span":null},"bound_body_regions":7,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":8,"beg":{"line":271,"col":5},"end":{"line":271,"col":19}},"generated_from_span":null},"ty":{"Deduplicated":7545}},{"index":1,"name":"state","span":{"data":{"file_id":8,"beg":{"line":268,"col":4},"end":{"line":268,"col":9}},"generated_from_span":null},"ty":{"Deduplicated":6858}},{"index":2,"name":"head_grade","span":{"data":{"file_id":8,"beg":{"line":269,"col":4},"end":{"line":269,"col":14}},"generated_from_span":null},"ty":{"Deduplicated":6838}},{"index":3,"name":"facts","span":{"data":{"file_id":8,"beg":{"line":270,"col":4},"end":{"line":270,"col":9}},"generated_from_span":null},"ty":{"Deduplicated":7572}},{"index":4,"name":"grade","span":{"data":{"file_id":8,"beg":{"line":273,"col":33},"end":{"line":273,"col":38}},"generated_from_span":null},"ty":{"Deduplicated":6838}},{"index":5,"name":null,"span":{"data":{"file_id":8,"beg":{"line":274,"col":15},"end":{"line":274,"col":31}},"generated_from_span":null},"ty":{"Deduplicated":6421}},{"index":6,"name":null,"span":{"data":{"file_id":8,"beg":{"line":275,"col":19},"end":{"line":275,"col":45}},"generated_from_span":null},"ty":{"Deduplicated":6421}},{"index":7,"name":null,"span":{"dat