ade::LatePerfect3rd\n        }\n    } else if diff_msec.micros <= SLIDE_GREAT_1ST.micros {\n        if is_fast {\n            JudgeGrade::FastGreat\n        } else {\n            JudgeGrade::LateGreat\n        }\n    } else if diff_msec.micros <= SLIDE_GREAT_2ND.micros {\n        if is_fast {\n            JudgeGrade::FastGreat2nd\n        } else {\n            JudgeGrade::LateGreat2nd\n        }\n    } else if diff_msec.micros <= SLIDE_GREAT_3RD.micros {\n        if is_fast {\n            JudgeGrade::FastGreat3rd\n        } else {\n            JudgeGrade::LateGreat3rd\n        }\n    } else {\n        if is_fast {\n            JudgeGrade::FastGood\n        } else {\n            JudgeGrade::LateGood\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" Judge a modern (deluxe) slide. The 3rd-perfect window is dynamically extended"},{"DocComment":" based on `stay_time` (last wait time at slide end)."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":6810},{"Deduplicated":6810},{"Deduplicated":6395}],"output":{"Deduplicated":6812}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":5,"beg":{"line":154,"col":0},"end":{"line":210,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":5,"beg":{"line":154,"col":80},"end":{"line":154,"col":90}},"generated_from_span":null},"ty":{"Deduplicated":6812}},{"index":1,"name":"diff","span":{"data":{"file_id":5,"beg":{"line":154,"col":26},"end":{"line":154,"col":30}},"generated_from_span":null},"ty":{"Deduplicated":6810}},{"index":2,"name":"stay_time","span":{"data":{"file_id":5,"beg":{"line":154,"col":42},"end":{"line":154,"col":51