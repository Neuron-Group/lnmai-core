ood\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" Judge a tap note"}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":9812},{"Deduplicated":7972}],"output":{"Deduplicated":9813}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":9,"beg":{"line":10,"col":0},"end":{"line":57,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":9,"beg":{"line":10,"col":49},"end":{"line":10,"col":59}},"generated_from_span":null},"ty":{"Deduplicated":9813}},{"index":1,"name":"diff","span":{"data":{"file_id":9,"beg":{"line":10,"col":17},"end":{"line":10,"col":21}},"generated_from_span":null},"ty":{"Deduplicated":9812}},{"index":2,"name":"is_ex","span":{"data":{"file_id":9,"beg":{"line":10,"col":33},"end":{"line":10,"col":38}},"generated_from_span":null},"ty":{"Deduplicated":7972}},{"index":3,"name":null,"span":{"data":{"file_id":9,"beg":{"line":11,"col":7},"end":{"line":11,"col":12}},"generated_from_span":null},"ty":{"Deduplicated":7972}},{"index":4,"name":"is_fast","span":{"data":{"file_id":9,"beg":{"line":15,"col":8},"end":{"line":15,"col":15}},"generated_from_span":null},"ty":{"Deduplicated":7972}},{"index":5,"name":null,"span":{"data":{"file_id":9,"beg":{"line":15,"col":18},"end":{"line":15,"col":29}},"generated_from_span":null},"ty":{"Deduplicated":8407}},{"index":6,"name":"abs_diff","span":{"data":{"file_id":9,"beg":{"line":16,"col":8},"end":{"line":16,"col":16}},"generated_from_span":null},"ty":{"Deduplicated":9812}},{"index":7,"name":null,"span":{"data":{"file_id":9,"beg":{"line":16,"col":19},"end":{"line":16,"col":23}},"generated_from_span":null},"ty":{"Deduplicated"