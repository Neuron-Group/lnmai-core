s replacement. Parent and"},{"DocComment":" refresh operations preserve slot count and order. Append preserves both"},{"DocComment":" batches' order; allocation/representation conditions belong to the adapter."},{"DocComment":" The lifecycle event batch contains zero or one event."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"S"},{"index":2,"name":"N"},{"index":3,"name":"E"},{"index":4,"name":"A"},{"index":5,"name":"R"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"read","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":19842},{"Deduplicated":19844},{"Deduplicated":5311}],"output":{"Deduplicated":19705}},"item":{"id":500,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":19702},{"Deduplicated":19704},{"Deduplicated":19705},{"Deduplicated":19706},{"Deduplicated":19849},{"Deduplicated":19850}],"const_generics":[],"trait_refs":[{"HashConsedValue":[19851,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":19702},{"Deduplicated":19704},{"Deduplicated":19705},{"Deduplicated":19706},{"Deduplicated":19849},{"Deduplicated":19850}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[3,0]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[]