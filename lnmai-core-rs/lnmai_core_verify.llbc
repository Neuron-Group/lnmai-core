s.is_hanabi,\n                },\n            ),\n            None => NotePlan::Skip,\n        },\n        NoteKind::Touch => match sensor {\n            Some(sensor) => NotePlan::Touch(\n                sensor,\n                TouchFlags {\n                    is_break: flags.is_break,\n                    is_hanabi: flags.is_hanabi,\n                },\n            ),\n            None => NotePlan::Skip,\n        },\n        NoteKind::TouchHold => match sensor {\n            Some(sensor) => NotePlan::TouchHold(\n                sensor,\n                HoldFlags {\n                    is_break: flags.is_break,\n                    is_ex: flags.is_ex,\n                    is_hanabi: flags.is_hanabi,\n                },\n            ),\n            None => NotePlan::Skip,\n        },\n        NoteKind::Slide => match slot {\n            Some(slot) => NotePlan::Slide(slot, flags),\n            None => NotePlan::Skip,\n        },\n        NoteKind::Rest | NoteKind::Unknown => NotePlan::Skip,\n    }\n}","attr_info":{"attributes":[{"DocComment":" The complete kind/position/flag decision for one raw token."},{"DocComment":" Sensor presence cannot rescue a missing Tap/Hold/Slide slot and vice versa."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Slot"},{"index":1,"name":"Sensor"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"HashConsedValue":[14958,{"Adt":{"id":{"Adt":78},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":29083},{"Deduplicated":29302},{"Deduplicated":14976}],"output":{"HashConsedValue":[29943,{"Adt":{"id":{"Adt":83},"generics":{"regions":[],"types":[{"Deduplicated":29079},{"Deduplicated":29080}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body"