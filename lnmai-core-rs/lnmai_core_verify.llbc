is_finished() {\n            let next = with_head(second, rest2);\n            let (remaining, commands) = advance_fuel(fuel, emit, &next, held);\n            let commands = prepend_progress(emit, &first.arrow_progress_when_finished, &commands);\n            (remaining, commands)\n        } else {\n            let next = with_head(second, rest2);\n            (with_head(first, &next), Vec::new())\n        }\n    } else if first.is_finished() {\n        let (remaining, commands) = advance_fuel(fuel, emit, rest, held);\n        let commands = prepend_progress(emit, &first.arrow_progress_when_finished, &commands);\n        (remaining, commands)\n    } else {\n        (with_head(first, rest), Vec::new())\n    }\n}","attr_info":{"attributes":[{"Unknown":{"path":"allow","args":"clippy::len_zero"}}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":28,"beg":{"line":29,"col":23},"end":{"line":29,"col":28}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":25,"generics":{"regions":[],"types":[{"Deduplicated":28859}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":8349},{"Deduplicated":7972},{"Deduplicated":29379},{"HashConsedValue":[29391,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":10505},"Shared"]}]}],"output":{"HashConsedValue":[29392,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":29380},{"Deduplicated":28866}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":28,"beg":{"line":29,"col":0},"end":{"line":82,"col":1}}