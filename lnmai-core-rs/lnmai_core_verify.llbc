_text":"pub fn split_top_level(sep: char, chars: &[char]) -> Vec<Vec<char>> {\n    let mut result = Vec::new();\n    let mut depth = 0usize;\n    let mut current = Vec::new();\n    let mut index = 0usize;\n    while index < chars.len() {\n        let c = chars[index];\n        if c == '[' {\n            depth += 1;\n            current.push(c);\n        } else if c == ']' {\n            depth = depth.saturating_sub(1);\n            current.push(c);\n        } else if c == sep && depth == 0 {\n            result.push(current);\n            current = Vec::new();\n        } else {\n            current.push(c);\n        }\n        index += 1;\n    }\n    result.push(current);\n    result\n}","attr_info":{"attributes":[{"DocComment":" Preserve empty pieces and treat separators inside brackets as literal text."},{"DocComment":" Brackets themselves have priority even when the separator is '[' or ']'."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":7278},{"Deduplicated":23463}],"output":{"Deduplicated":21727}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":29,"beg":{"line":25,"col":0},"end":{"line":48,"col":1}},"generated_from_span":null},"bound_body_regions":22,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":29,"beg":{"line":25,"col":53},"end":{"line":25,"col":67}},"generated_from_span":null},"ty":{"Deduplicated":21727}},{"index":1,"name":"sep","span":{"data":{"file_id":29,"beg":{"line":25,"col":23},"end":{"line":25,"col":26}},"generated_from_span":null},"ty":{"Deduplicated":7278}},{"index":2,"name":"chars","span":{"data":{"file_id":29,"beg":{"line":25,"col":34},"end":{"line":25,"co