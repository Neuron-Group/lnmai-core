{"charon_version":"0.1.210","translated":{"crate_name":"lnmai_core_verify","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":null,"rustc_args":[],"targets":[],"monomorphize":false,"monomorphize_mut":null,"start_from":[],"start_from_if_exists":[],"start_from_attribute":null,"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"remove_adt_clauses":true,"hide_allocator":true,"remove_unused_self_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":null,"no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"aarch64-apple-darwin","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"crates/lnmai-core-verify/src/lib.rs"},"crate_name":"lnmai_core_verify","contents":"//! Verification-facing subset of lnmai-core.\n//!\n//! These finite tables and bounded arithmetic operations are extracted by\n//! Charon/Aeneas and related to Lean under explicit preconditions. The runtime\n//! shares area/conversion code and calls judgment tables through exact-number\n//! adapters; unbounded time and scoring arithmetic live in `lnmai_core`.\n\npub mod areas;\npub mod big_int;\npub mod big_nat;\npub mod big_rat;\npub mod constants;\npub mod convert;\npub mod frame_commands;\npub mod grade_counts;\npub mod judge;\npub mod judgment_adapter;\npub mod lifecycle;\npub mod maidata_line_adapter;\npub mod maidata_scan;\npub mod natural_parser;\npub mod prefix_directives;\npub mod queue_maintenance;\npub mod queue_remaining;\npub mod scheduler;\npub mod score;\npub mod shape;\npub mod slide_chain;\npub mod slide_lifecycle;\npub mod slide_parents;\npub mod slide_parser;\npub mod slide_parser_frontend;\npub mod slide_parser_sequence;\npub mod slide_parser_text;\npub mod slide_queue;\npub mod slide_queue_metrics;\npub mod slide_schedule;\npub mod slide_tables;\npub mod storage;\npub mod symmetry;\npub mod tap_schedule;\npub mod time;\npub mod timing_aggregate;\npub mod timing_number;\npub mod timing_parser;\npub mod tokenize;\npub mod touch_schedule;\npub mod types;\npub mod vec_erase;\npub mod vec_prepend;\n\npub mod hold_schedule;\n\npub mod normalization;\npub mod touch_automatic;\npub mod touch_hold_body;\npub mod touch_hold_body_adapter;\npub mod touch_hold_rebuild;\npub mod touch_hold_schedule;\n"},{"id":1,"name":{"Local":"crates/lnmai-core-verify/src/areas.rs"},"crate_name":"lnmai_core_verify","contents":"//! Sensor areas, button zones and outer slots.\n//!\n//! Mirrors `LnmaiCore/Areas.lean`. Constructor order matches Lean so the\n//! bridge to `LnmaiCore.SensorArea` etc. is a direct constructor mapping.\n//!\n//! The Lean module defines index/rotation functions only for `ButtonZone` and\n//! `OuterSlot`; `SensorArea` has no `toIndex` in Lean, so none is provided here.\n\n#[derive(Clone, Copy, Default, PartialEq, Eq, PartialOrd, Ord, Debug)]\npub enum SensorArea {\n    #[default]\n    A1,\n    A2,\n    A3,\n    A4,\n    A5,\n    A6,\n    A7,\n    A8,\n    B1,\n    B2,\n    B3,\n    B4,\n    B5,\n    B6,\n    B7,\n    B8,\n    C,\n    D1,\n    D2,\n    D3,\n    D4,\n    D5,\n    D6,\n    D7,\n    D8,\n    E1,\n    E2,\n    E3,\n    E4,\n    E5,\n    E6,\n    E7,\n    E8,\n}\n\n#[derive(Clone, Copy, Default, PartialEq, Eq, PartialOrd, Ord, Debug)]\npub enum ButtonZone {\n    #[default]\n    K1,\n    K2,\n    K3,\n    K4,\n    K5,\n    K6,\n    K7,\n    K8,\n}\n\n#[derive(Clone, Copy, Default, PartialEq, Eq, PartialOrd, Ord, Debug)]\npub enum OuterSlot {\n    #[default]\n    S1,\n    S2,\n    S3,\n    S4,\n    S5,\n    S6,\n    S7,\n    S8,\n}\n\nimpl SensorArea {\n    /// Constructor order from `SensorArea.all` in Lean.\n    pub fn all() -> [Self; 33] {\n        [\n            Self::A1,\n            Self::A2,\n            Self::A3,\n            Self::A4,\n            Self::A5,\n            Self::A6,\n            Self::A7,\n            Self::A8,\n            Self::B1,\n            Self::B2,\n            Self::B3,\n            Self::B4,\n            Self::B5,\n            Self::B6,\n            Self::B7,\n            Self::B8,\n            Self::C,\n            Self::D1,\n            Self::D2,\n            Self::D3,\n            Self::D4,\n            Self::D5,\n            Self::D6,\n            Self::D7,\n            Self::D8,\n            Self::E1,\n            Self::E2,\n            Self::E3,\n            Self::E4,\n            Self::E5,\n            Self::E6,\n            Self::E7,\n            Self::E8,\n        ]\n    }\n}\n\nimpl core::fmt::Display for SensorArea {\n    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n        core::fmt::Debug::fmt(self, f)\n    }\n}\n\nimpl ButtonZone {\n    /// Constructor order from `ButtonZone.all` in Lean.\n    pub fn all() -> [Self; 8] {\n        [\n            Self::K1,\n            Self::K2,\n            Self::K3,\n            Self::K4,\n            Self::K5,\n            Self::K6,\n            Self::K7,\n            Self::K8,\n        ]\n    }\n\n    pub fn storage_order() -> [Self; 8] {\n        Self::all()\n    }\n}\n\nimpl core::fmt::Display for ButtonZone {\n    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n        core::fmt::Debug::fmt(self, f)\n    }\n}\n\nimpl OuterSlot {\n    /// Constructor order from `OuterSlot.all` in Lean.\n    pub fn all() -> [Self; 8] {\n        [\n            Self::S1,\n            Self::S2,\n            Self::S3,\n            Self::S4,\n            Self::S5,\n            Self::S6,\n            Self::S7,\n            Self::S8,\n        ]\n    }\n\n    pub fn storage_order() -> [Self; 8] {\n        Self::all()\n    }\n}\n\nimpl core::fmt::Display for OuterSlot {\n    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n        core::fmt::Debug::fmt(self, f)\n    }\n}\n\n/// `((n - 1) + steps) % 8 + 1` with `steps` reduced first so the addition\n/// cannot overflow. Matches Lean's `rotateRingIndex` for all step counts.\nfn ring_index(steps: usize, n: usize) -> usize {\n    ((n - 1 + (steps % 8)) % 8) + 1\n}\n\nfn ring_sensor_a(k: usize) -> SensorArea {\n    match k {\n        1 => SensorArea::A1,\n        2 => SensorArea::A2,\n        3 => SensorArea::A3,\n        4 => SensorArea::A4,\n        5 => SensorArea::A5,\n        6 => SensorArea::A6,\n        7 => SensorArea::A7,\n        _ => SensorArea::A8,\n    }\n}\n\nfn ring_sensor_b(k: usize) -> SensorArea {\n    match k {\n        1 => SensorArea::B1,\n        2 => SensorArea::B2,\n        3 => SensorArea::B3,\n        4 => SensorArea::B4,\n        5 => SensorArea::B5,\n        6 => SensorArea::B6,\n        7 => SensorArea::B7,\n        _ => SensorArea::B8,\n    }\n}\n\nfn ring_sensor_d(k: usize) -> SensorArea {\n    match k {\n        1 => SensorArea::D1,\n        2 => SensorArea::D2,\n        3 => SensorArea::D3,\n        4 => SensorArea::D4,\n        5 => SensorArea::D5,\n        6 => SensorArea::D6,\n        7 => SensorArea::D7,\n        _ => SensorArea::D8,\n    }\n}\n\nfn ring_sensor_e(k: usize) -> SensorArea {\n    match k {\n        1 => SensorArea::E1,\n        2 => SensorArea::E2,\n        3 => SensorArea::E3,\n        4 => SensorArea::E4,\n        5 => SensorArea::E5,\n        6 => SensorArea::E6,\n        7 => SensorArea::E7,\n        _ => SensorArea::E8,\n    }\n}\n\nfn ring_button(k: usize) -> ButtonZone {\n    match k {\n        1 => ButtonZone::K1,\n        2 => ButtonZone::K2,\n        3 => ButtonZone::K3,\n        4 => ButtonZone::K4,\n        5 => ButtonZone::K5,\n        6 => ButtonZone::K6,\n        7 => ButtonZone::K7,\n        _ => ButtonZone::K8,\n    }\n}\n\nfn ring_outer(k: usize) -> OuterSlot {\n    match k {\n        1 => OuterSlot::S1,\n        2 => OuterSlot::S2,\n        3 => OuterSlot::S3,\n        4 => OuterSlot::S4,\n        5 => OuterSlot::S5,\n        6 => OuterSlot::S6,\n        7 => OuterSlot::S7,\n        _ => OuterSlot::S8,\n    }\n}\n\nimpl SensorArea {\n    /// `SensorArea.rotate` in Lean. Sensor C is fixed; the A/B/D/E rings\n    /// rotate independently.\n    pub fn rotate(self, steps: usize) -> SensorArea {\n        match self {\n            SensorArea::C => SensorArea::C,\n            SensorArea::A1 => ring_sensor_a(ring_index(steps, 1)),\n            SensorArea::A2 => ring_sensor_a(ring_index(steps, 2)),\n            SensorArea::A3 => ring_sensor_a(ring_index(steps, 3)),\n            SensorArea::A4 => ring_sensor_a(ring_index(steps, 4)),\n            SensorArea::A5 => ring_sensor_a(ring_index(steps, 5)),\n            SensorArea::A6 => ring_sensor_a(ring_index(steps, 6)),\n            SensorArea::A7 => ring_sensor_a(ring_index(steps, 7)),\n            SensorArea::A8 => ring_sensor_a(ring_index(steps, 8)),\n            SensorArea::B1 => ring_sensor_b(ring_index(steps, 1)),\n            SensorArea::B2 => ring_sensor_b(ring_index(steps, 2)),\n            SensorArea::B3 => ring_sensor_b(ring_index(steps, 3)),\n            SensorArea::B4 => ring_sensor_b(ring_index(steps, 4)),\n            SensorArea::B5 => ring_sensor_b(ring_index(steps, 5)),\n            SensorArea::B6 => ring_sensor_b(ring_index(steps, 6)),\n            SensorArea::B7 => ring_sensor_b(ring_index(steps, 7)),\n            SensorArea::B8 => ring_sensor_b(ring_index(steps, 8)),\n            SensorArea::D1 => ring_sensor_d(ring_index(steps, 1)),\n            SensorArea::D2 => ring_sensor_d(ring_index(steps, 2)),\n            SensorArea::D3 => ring_sensor_d(ring_index(steps, 3)),\n            SensorArea::D4 => ring_sensor_d(ring_index(steps, 4)),\n            SensorArea::D5 => ring_sensor_d(ring_index(steps, 5)),\n            SensorArea::D6 => ring_sensor_d(ring_index(steps, 6)),\n            SensorArea::D7 => ring_sensor_d(ring_index(steps, 7)),\n            SensorArea::D8 => ring_sensor_d(ring_index(steps, 8)),\n            SensorArea::E1 => ring_sensor_e(ring_index(steps, 1)),\n            SensorArea::E2 => ring_sensor_e(ring_index(steps, 2)),\n            SensorArea::E3 => ring_sensor_e(ring_index(steps, 3)),\n            SensorArea::E4 => ring_sensor_e(ring_index(steps, 4)),\n            SensorArea::E5 => ring_sensor_e(ring_index(steps, 5)),\n            SensorArea::E6 => ring_sensor_e(ring_index(steps, 6)),\n            SensorArea::E7 => ring_sensor_e(ring_index(steps, 7)),\n            SensorArea::E8 => ring_sensor_e(ring_index(steps, 8)),\n        }\n    }\n\n    /// `SensorArea.toOuterSlot?`.\n    pub fn to_outer_slot(self) -> Option<OuterSlot> {\n        match self {\n            SensorArea::A1 => Some(OuterSlot::S1),\n            SensorArea::A2 => Some(OuterSlot::S2),\n            SensorArea::A3 => Some(OuterSlot::S3),\n            SensorArea::A4 => Some(OuterSlot::S4),\n            SensorArea::A5 => Some(OuterSlot::S5),\n            SensorArea::A6 => Some(OuterSlot::S6),\n            SensorArea::A7 => Some(OuterSlot::S7),\n            SensorArea::A8 => Some(OuterSlot::S8),\n            _ => None,\n        }\n    }\n\n    /// `SensorArea.toOuterButtonZone?`.\n    // Explicit matching keeps the extracted function first-order.\n    #[allow(clippy::manual_map)]\n    pub fn to_outer_button_zone(self) -> Option<ButtonZone> {\n        match self.to_outer_slot() {\n            Some(slot) => Some(slot.to_button_zone()),\n            None => None,\n        }\n    }\n}\n\nimpl ButtonZone {\n    /// `ButtonZone.toIndex`.\n    pub fn to_index(self) -> usize {\n        match self {\n            ButtonZone::K1 => 0,\n            ButtonZone::K2 => 1,\n            ButtonZone::K3 => 2,\n            ButtonZone::K4 => 3,\n            ButtonZone::K5 => 4,\n            ButtonZone::K6 => 5,\n            ButtonZone::K7 => 6,\n            ButtonZone::K8 => 7,\n        }\n    }\n\n    /// `ButtonZone.ofIndex?`.\n    pub fn of_index(index: usize) -> Option<ButtonZone> {\n        match index {\n            0 => Some(ButtonZone::K1),\n            1 => Some(ButtonZone::K2),\n            2 => Some(ButtonZone::K3),\n            3 => Some(ButtonZone::K4),\n            4 => Some(ButtonZone::K5),\n            5 => Some(ButtonZone::K6),\n            6 => Some(ButtonZone::K7),\n            7 => Some(ButtonZone::K8),\n            _ => None,\n        }\n    }\n\n    /// `ButtonZone.rotate`.\n    pub fn rotate(self, steps: usize) -> ButtonZone {\n        match self {\n            ButtonZone::K1 => ring_button(ring_index(steps, 1)),\n            ButtonZone::K2 => ring_button(ring_index(steps, 2)),\n            ButtonZone::K3 => ring_button(ring_index(steps, 3)),\n            ButtonZone::K4 => ring_button(ring_index(steps, 4)),\n            ButtonZone::K5 => ring_button(ring_index(steps, 5)),\n            ButtonZone::K6 => ring_button(ring_index(steps, 6)),\n            ButtonZone::K7 => ring_button(ring_index(steps, 7)),\n            ButtonZone::K8 => ring_button(ring_index(steps, 8)),\n        }\n    }\n\n    /// `ButtonZone.toOuterSlot`.\n    pub fn to_outer_slot(self) -> OuterSlot {\n        match self {\n            ButtonZone::K1 => OuterSlot::S1,\n            ButtonZone::K2 => OuterSlot::S2,\n            ButtonZone::K3 => OuterSlot::S3,\n            ButtonZone::K4 => OuterSlot::S4,\n            ButtonZone::K5 => OuterSlot::S5,\n            ButtonZone::K6 => OuterSlot::S6,\n            ButtonZone::K7 => OuterSlot::S7,\n            ButtonZone::K8 => OuterSlot::S8,\n        }\n    }\n\n    /// `ButtonZone.toOuterSensorArea`.\n    pub fn to_outer_sensor_area(self) -> SensorArea {\n        self.to_outer_slot().to_outer_sensor_area()\n    }\n}\n\nimpl OuterSlot {\n    /// `OuterSlot.toIndex`.\n    pub fn to_index(self) -> usize {\n        match self {\n            OuterSlot::S1 => 0,\n            OuterSlot::S2 => 1,\n            OuterSlot::S3 => 2,\n            OuterSlot::S4 => 3,\n            OuterSlot::S5 => 4,\n            OuterSlot::S6 => 5,\n            OuterSlot::S7 => 6,\n            OuterSlot::S8 => 7,\n        }\n    }\n\n    /// `OuterSlot.ofIndex?`.\n    pub fn of_index(index: usize) -> Option<OuterSlot> {\n        match index {\n            0 => Some(OuterSlot::S1),\n            1 => Some(OuterSlot::S2),\n            2 => Some(OuterSlot::S3),\n            3 => Some(OuterSlot::S4),\n            4 => Some(OuterSlot::S5),\n            5 => Some(OuterSlot::S6),\n            6 => Some(OuterSlot::S7),\n            7 => Some(OuterSlot::S8),\n            _ => None,\n        }\n    }\n\n    /// `OuterSlot.rotate`.\n    pub fn rotate(self, steps: usize) -> OuterSlot {\n        match self {\n            OuterSlot::S1 => ring_outer(ring_index(steps, 1)),\n            OuterSlot::S2 => ring_outer(ring_index(steps, 2)),\n            OuterSlot::S3 => ring_outer(ring_index(steps, 3)),\n            OuterSlot::S4 => ring_outer(ring_index(steps, 4)),\n            OuterSlot::S5 => ring_outer(ring_index(steps, 5)),\n            OuterSlot::S6 => ring_outer(ring_index(steps, 6)),\n            OuterSlot::S7 => ring_outer(ring_index(steps, 7)),\n            OuterSlot::S8 => ring_outer(ring_index(steps, 8)),\n        }\n    }\n\n    /// `OuterSlot.toButtonZone`.\n    pub fn to_button_zone(self) -> ButtonZone {\n        match self {\n            OuterSlot::S1 => ButtonZone::K1,\n            OuterSlot::S2 => ButtonZone::K2,\n            OuterSlot::S3 => ButtonZone::K3,\n            OuterSlot::S4 => ButtonZone::K4,\n            OuterSlot::S5 => ButtonZone::K5,\n            OuterSlot::S6 => ButtonZone::K6,\n            OuterSlot::S7 => ButtonZone::K7,\n            OuterSlot::S8 => ButtonZone::K8,\n        }\n    }\n\n    /// `OuterSlot.toOuterSensorArea`.\n    pub fn to_outer_sensor_area(self) -> SensorArea {\n        match self {\n            OuterSlot::S1 => SensorArea::A1,\n            OuterSlot::S2 => SensorArea::A2,\n            OuterSlot::S3 => SensorArea::A3,\n            OuterSlot::S4 => SensorArea::A4,\n            OuterSlot::S5 => SensorArea::A5,\n            OuterSlot::S6 => SensorArea::A6,\n            OuterSlot::S7 => SensorArea::A7,\n            OuterSlot::S8 => SensorArea::A8,\n        }\n    }\n}\n"},{"id":2,"name":{"Local":"crates/lnmai-core-verify/src/big_int.rs"},"crate_name":"lnmai_core_verify","contents":"//! Exact signed integers over the extracted limb-vector magnitude.\n//!\n//! This is the shared implementation of the runtime Integer type. The\n//! canonical form stores a sign bit plus a canonical BigNat magnitude; zero\n//! is never negative. Division is total and Euclidean, matching Lean Int:\n//! division by zero is zero and a / b with a remainder is rounded downward in\n//! the Euclidean sense. The truncated quotient and remainder used by the\n//! rounding helpers are kept separate.\n\nuse crate::big_nat::{self, BigNat};\n\n/// Sign plus canonical magnitude; zero has no sign.\n#[derive(Clone)]\npub struct BigIntKernel {\n    pub negative: bool,\n    pub magnitude: BigNat,\n}\n\n/// Canonical constructor: a zero magnitude is never negative.\npub fn make(negative: bool, magnitude: BigNat) -> BigIntKernel {\n    if big_nat::is_zero(&magnitude) {\n        BigIntKernel {\n            negative: false,\n            magnitude,\n        }\n    } else {\n        BigIntKernel {\n            negative,\n            magnitude,\n        }\n    }\n}\n\npub fn zero() -> BigIntKernel {\n    BigIntKernel {\n        negative: false,\n        magnitude: big_nat::zero(),\n    }\n}\n\npub fn from_u64(value: u64) -> BigIntKernel {\n    make(false, big_nat::from_u64(value))\n}\n\npub fn from_u128(value: u128) -> BigIntKernel {\n    let low = value as u64;\n    let high = (value >> 64) as u64;\n    make(false, big_nat::from_u64_pair(high, low))\n}\n\npub fn from_i64(value: i64) -> BigIntKernel {\n    if value < 0 {\n        let magnitude = (0i128 - (value as i128)) as u64;\n        make(true, big_nat::from_u64(magnitude))\n    } else {\n        make(false, big_nat::from_u64(value as u64))\n    }\n}\n\npub fn from_i128(value: i128) -> BigIntKernel {\n    if value < 0 {\n        let magnitude = if value == i128::MIN {\n            1u128 << 127\n        } else {\n            (0i128 - value) as u128\n        };\n        make(true, from_u128(magnitude).magnitude)\n    } else {\n        make(false, from_u128(value as u128).magnitude)\n    }\n}\n\n/// The magnitude of a natural value, with no sign.\npub fn of_nat(value: &BigNat) -> BigIntKernel {\n    make(false, value.clone())\n}\n\npub fn is_zero(value: &BigIntKernel) -> bool {\n    big_nat::is_zero(&value.magnitude)\n}\n\npub fn is_negative(value: &BigIntKernel) -> bool {\n    value.negative && !big_nat::is_zero(&value.magnitude)\n}\n\npub fn is_positive(value: &BigIntKernel) -> bool {\n    !value.negative && !big_nat::is_zero(&value.magnitude)\n}\n\npub fn neg(value: &BigIntKernel) -> BigIntKernel {\n    if big_nat::is_zero(&value.magnitude) {\n        return zero();\n    }\n    make(!value.negative, value.magnitude.clone())\n}\n\npub fn abs(value: &BigIntKernel) -> BigIntKernel {\n    make(false, value.magnitude.clone())\n}\n\n/// Comparison: -1, 0 or 1.\npub fn compare(left: &BigIntKernel, right: &BigIntKernel) -> i8 {\n    let left_negative = is_negative(left);\n    let right_negative = is_negative(right);\n    if left_negative && !right_negative {\n        return -1;\n    }\n    if !left_negative && right_negative {\n        return 1;\n    }\n    let magnitude = big_nat::compare(&left.magnitude, &right.magnitude);\n    if left_negative {\n        return 0 - magnitude;\n    }\n    magnitude\n}\n\npub fn equal(left: &BigIntKernel, right: &BigIntKernel) -> bool {\n    left.negative == right.negative && big_nat::equal(&left.magnitude, &right.magnitude)\n}\n\n/// Same-sign operands add magnitudes; opposite signs subtract the smaller\n/// magnitude from the larger and keep the winner's sign.\npub fn add(left: &BigIntKernel, right: &BigIntKernel) -> BigIntKernel {\n    if big_nat::is_zero(&left.magnitude) {\n        return right.clone();\n    }\n    if big_nat::is_zero(&right.magnitude) {\n        return left.clone();\n    }\n    let left_negative = is_negative(left);\n    let right_negative = is_negative(right);\n    if left_negative == right_negative {\n        let magnitude = big_nat::add(&left.magnitude, &right.magnitude);\n        return make(left_negative, magnitude);\n    }\n    let order = big_nat::compare(&left.magnitude, &right.magnitude);\n    if order == 0 {\n        return zero();\n    }\n    if order > 0 {\n        let magnitude = big_nat::sub(&left.magnitude, &right.magnitude);\n        return make(left_negative, magnitude);\n    }\n    let magnitude = big_nat::sub(&right.magnitude, &left.magnitude);\n    make(right_negative, magnitude)\n}\n\npub fn sub(left: &BigIntKernel, right: &BigIntKernel) -> BigIntKernel {\n    add(left, &neg(right))\n}\n\npub fn mul(left: &BigIntKernel, right: &BigIntKernel) -> BigIntKernel {\n    let negative = is_negative(left) != is_negative(right);\n    make(negative, big_nat::mul(&left.magnitude, &right.magnitude))\n}\n\n/// Truncated quotient (sign of the dividend) with zero divisor giving zero.\npub fn div_trunc(left: &BigIntKernel, right: &BigIntKernel) -> BigIntKernel {\n    if is_zero(right) {\n        return zero();\n    }\n    let negative = is_negative(left) != is_negative(right);\n    make(negative, big_nat::div(&left.magnitude, &right.magnitude))\n}\n\n/// Truncated remainder (sign of the dividend) with zero divisor giving the\n/// dividend, as in Rust and Lean Int.tmod.\npub fn rem_trunc(left: &BigIntKernel, right: &BigIntKernel) -> BigIntKernel {\n    if is_zero(right) {\n        return left.clone();\n    }\n    make(\n        is_negative(left),\n        big_nat::rem(&left.magnitude, &right.magnitude),\n    )\n}\n\n/// Euclidean quotient: the unique q with a = q * b + r and 0 <= r < |b|.\npub fn div_euclid(left: &BigIntKernel, right: &BigIntKernel) -> BigIntKernel {\n    if is_zero(right) {\n        return zero();\n    }\n    let quotient = big_nat::div(&left.magnitude, &right.magnitude);\n    let remainder = big_nat::rem(&left.magnitude, &right.magnitude);\n    if big_nat::is_zero(&remainder) {\n        return make(is_negative(left) != is_negative(right), quotient);\n    }\n    if is_negative(left) {\n        let bumped = big_nat::succ(&quotient);\n        return make(!is_negative(right), bumped);\n    }\n    make(is_negative(right), quotient)\n}\n\n/// Euclidean remainder: always nonnegative and below |right|.\npub fn rem_euclid(left: &BigIntKernel, right: &BigIntKernel) -> BigIntKernel {\n    let residual = sub(left, &mul(&div_euclid(left, right), right));\n    abs(&residual)\n}\n\n/// Low 64 bits, matching Lean UInt64.ofInt and native two's-complement casts.\npub fn low_u64(value: &BigIntKernel) -> u64 {\n    let magnitude = big_nat::low_u64(&value.magnitude);\n    if is_negative(value) {\n        let (negated, _) = 0u64.overflowing_sub(magnitude);\n        return negated;\n    }\n    magnitude\n}\n\n/// The value as an i64 when it fits exactly.\npub fn to_i64(value: &BigIntKernel) -> Option<i64> {\n    if big_nat::is_zero(&value.magnitude) {\n        return Some(0i64);\n    }\n    if value.magnitude.limbs.len() > 1 {\n        return None;\n    }\n    let magnitude = value.magnitude.limbs[0];\n    if is_negative(value) {\n        if magnitude > 9223372036854775808u64 {\n            return None;\n        }\n        if magnitude == 9223372036854775808u64 {\n            return Some(i64::MIN);\n        }\n        return Some(0i64 - (magnitude as i64));\n    }\n    if magnitude > i64::MAX as u64 {\n        return None;\n    }\n    Some(magnitude as i64)\n}\n\n/// Greatest common divisor of magnitudes; used to normalize rationals.\npub fn gcd(left: &BigIntKernel, right: &BigIntKernel) -> BigNat {\n    big_nat::gcd(&left.magnitude, &right.magnitude)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn int(value: i128) -> BigIntKernel {\n        from_i128(value)\n    }\n\n    /// Values below 2^63 exercise the machine-word oracle exactly.\n    const CASES: [i128; 11] = [\n        0,\n        1,\n        -1,\n        2,\n        -3,\n        7,\n        -10,\n        1_000_000_007,\n        -1_000_000_007,\n        303_700_037,\n        -999_999_937,\n    ];\n\n    #[test]\n    fn arithmetic_matches_i128() {\n        for left in CASES {\n            for right in CASES {\n                assert!(equal(&add(&int(left), &int(right)), &int(left + right)));\n                assert!(equal(&sub(&int(left), &int(right)), &int(left - right)));\n                assert!(equal(&mul(&int(left), &int(right)), &int(left * right)));\n                assert!(equal(&neg(&int(left)), &int(-left)));\n                assert!(equal(&abs(&int(left)), &int(left.abs())));\n                let order = match left.cmp(&right) {\n                    std::cmp::Ordering::Less => -1,\n                    std::cmp::Ordering::Equal => 0,\n                    std::cmp::Ordering::Greater => 1,\n                };\n                assert_eq!(compare(&int(left), &int(right)), order);\n                assert_eq!(is_negative(&int(left)), left < 0);\n                assert_eq!(is_positive(&int(left)), left > 0);\n                assert_eq!(is_zero(&int(left)), left == 0);\n                if right != 0 {\n                    assert!(equal(\n                        &div_trunc(&int(left), &int(right)),\n                        &int(left / right)\n                    ));\n                    assert!(equal(\n                        &rem_trunc(&int(left), &int(right)),\n                        &int(left % right)\n                    ));\n                    let quotient = div_euclid(&int(left), &int(right));\n                    let remainder = rem_euclid(&int(left), &int(right));\n                    assert!(equal(\n                        &add(&mul(&quotient, &int(right)), &remainder),\n                        &int(left)\n                    ));\n                    assert!(!is_negative(&remainder));\n                    assert!(compare(&remainder, &abs(&int(right))) < 0);\n                }\n            }\n        }\n        assert!(is_zero(&div_euclid(&int(5), &int(0))));\n        assert!(is_zero(&div_trunc(&int(5), &int(0))));\n        assert!(equal(&rem_trunc(&int(5), &int(0)), &int(5)));\n        assert!(equal(&div_euclid(&int(-5), &int(3)), &int(-2)));\n        assert!(equal(&div_euclid(&int(-5), &int(-3)), &int(2)));\n        assert!(equal(&div_euclid(&int(5), &int(-3)), &int(-1)));\n        assert!(equal(&rem_euclid(&int(-5), &int(-3)), &int(1)));\n    }\n\n    #[test]\n    fn conversions_and_exactness() {\n        assert_eq!(to_i64(&int(-7)), Some(-7));\n        assert_eq!(to_i64(&int(i64::MIN as i128)), Some(i64::MIN));\n        assert_eq!(to_i64(&int(i64::MAX as i128)), Some(i64::MAX));\n        assert_eq!(to_i64(&from_i128(i64::MIN as i128 - 1)), None);\n        assert_eq!(to_i64(&from_i128(i64::MAX as i128 + 1)), None);\n        assert_eq!(low_u64(&int(-1)), u64::MAX);\n        assert_eq!(low_u64(&int(1)), 1);\n        let big = from_u128(u128::MAX);\n        assert!(equal(&big, &from_u128(u128::MAX)));\n        assert_eq!(low_u64(&big), u64::MAX);\n        assert_eq!(low_u64(&neg(&big)), 1);\n        // Zero is never negative even when the sign bit is set at construction.\n        assert!(!is_negative(&make(true, big_nat::zero())));\n        assert!(equal(&make(true, big_nat::zero()), &zero()));\n        // gcd ignores signs.\n        assert!(big_nat::equal(\n            &gcd(&int(-12), &int(18)),\n            &big_nat::from_u64(6)\n        ));\n    }\n}\n"},{"id":3,"name":{"Local":"crates/lnmai-core-verify/src/big_nat.rs"},"crate_name":"lnmai_core_verify","contents":"//! Exact nonnegative integers as little-endian 64-bit limb vectors.\n//!\n//! This is the shared implementation of the runtime Natural type: the same\n//! code is extracted by Charon/Aeneas, so every operation the runtime performs\n//! is a kernel function rather than a third-party library call. The canonical\n//! form stores the value as sum limbs[i] * 2^(64*i) with no trailing zero\n//! limbs (the empty vector is zero), and every operation preserves that form.\n//!\n//! Subtraction, division and remainder are total, matching Lean Nat: a - b\n//! floors at zero, a / 0 is zero and a % 0 is a.\n\n#![allow(clippy::len_zero)]\n\n/// Little-endian 64-bit limbs in canonical form; empty means zero.\n#[derive(Clone)]\npub struct BigNat {\n    pub limbs: Vec<u64>,\n}\n\n/// Remove trailing zero limbs, restoring the canonical form.\npub fn normalize(limbs: Vec<u64>) -> BigNat {\n    let mut length = limbs.len();\n    while length > 0 && limbs[length - 1] == 0 {\n        length -= 1;\n    }\n    let mut normalized: Vec<u64> = Vec::new();\n    let mut index = 0usize;\n    while index < length {\n        normalized.push(limbs[index]);\n        index += 1;\n    }\n    BigNat { limbs: normalized }\n}\n\n/// Zero.\npub fn zero() -> BigNat {\n    BigNat { limbs: Vec::new() }\n}\n\n/// One.\n#[allow(clippy::vec_init_then_push)]\npub fn one() -> BigNat {\n    let mut limbs: Vec<u64> = Vec::new();\n    limbs.push(1u64);\n    BigNat { limbs }\n}\n\n/// The value of a single machine word.\npub fn from_u64(value: u64) -> BigNat {\n    let mut limbs = Vec::new();\n    if value != 0 {\n        limbs.push(value);\n    }\n    BigNat { limbs }\n}\n\n/// Two limbs, most significant first, canonicalized.\n#[allow(clippy::vec_init_then_push)]\npub fn from_u64_pair(high: u64, low: u64) -> BigNat {\n    let mut limbs = Vec::new();\n    limbs.push(low);\n    limbs.push(high);\n    normalize(limbs)\n}\n\npub fn is_zero(value: &BigNat) -> bool {\n    value.limbs.len() == 0\n}\n\npub fn is_one(value: &BigNat) -> bool {\n    value.limbs.len() == 1 && value.limbs[0] == 1\n}\n\npub fn equal(left: &BigNat, right: &BigNat) -> bool {\n    if left.limbs.len() != right.limbs.len() {\n        return false;\n    }\n    let mut index = 0usize;\n    let mut same = true;\n    while index < left.limbs.len() && same {\n        same = left.limbs[index] == right.limbs[index];\n        index += 1;\n    }\n    same\n}\n\n/// Comparison of canonical limb vectors: -1, 0 or 1.\npub fn compare(left: &BigNat, right: &BigNat) -> i8 {\n    let left_len = left.limbs.len();\n    let right_len = right.limbs.len();\n    if left_len < right_len {\n        return -1;\n    }\n    if left_len > right_len {\n        return 1;\n    }\n    let mut index = left_len;\n    let mut order = 0i8;\n    while index > 0 && order == 0 {\n        index -= 1;\n        if left.limbs[index] < right.limbs[index] {\n            order = -1;\n        } else if left.limbs[index] > right.limbs[index] {\n            order = 1;\n        }\n    }\n    order\n}\n\n/// Sum with a propagating carry; the condition covers the final carry.\npub fn add(left: &BigNat, right: &BigNat) -> BigNat {\n    let left_len = left.limbs.len();\n    let right_len = right.limbs.len();\n    let mut out: Vec<u64> = Vec::new();\n    let mut carry = 0u64;\n    let mut index = 0usize;\n    while index < left_len || index < right_len || carry != 0 {\n        let x = if index < left_len {\n            left.limbs[index]\n        } else {\n            0\n        };\n        let y = if index < right_len {\n            right.limbs[index]\n        } else {\n            0\n        };\n        let (partial, first_carry) = x.overflowing_add(y);\n        let (digit, second_carry) = partial.overflowing_add(carry);\n        out.push(digit);\n        if first_carry || second_carry {\n            carry = 1;\n        } else {\n            carry = 0;\n        }\n        index += 1;\n    }\n    normalize(out)\n}\n\n/// Truncated difference: left - right floors at zero, as in Lean Nat.\npub fn sub(left: &BigNat, right: &BigNat) -> BigNat {\n    if compare(left, right) <= 0 {\n        return zero();\n    }\n    let left_len = left.limbs.len();\n    let right_len = right.limbs.len();\n    let mut out: Vec<u64> = Vec::new();\n    let mut borrow = 0u64;\n    let mut index = 0usize;\n    while index < left_len {\n        let x = left.limbs[index];\n        let y = if index < right_len {\n            right.limbs[index]\n        } else {\n            0\n        };\n        let (partial, first_borrow) = x.overflowing_sub(y);\n        let (digit, second_borrow) = partial.overflowing_sub(borrow);\n        out.push(digit);\n        if first_borrow || second_borrow {\n            borrow = 1;\n        } else {\n            borrow = 0;\n        }\n        index += 1;\n    }\n    normalize(out)\n}\n\n/// Schoolbook product: out[i + j] accumulates left[i] * right[j].\npub fn mul(left: &BigNat, right: &BigNat) -> BigNat {\n    let left_len = left.limbs.len();\n    let right_len = right.limbs.len();\n    if left_len == 0 || right_len == 0 {\n        return zero();\n    }\n    let mut out: Vec<u64> = Vec::new();\n    let mut index = 0usize;\n    while index < left_len + right_len {\n        out.push(0u64);\n        index += 1;\n    }\n    let mut i = 0usize;\n    while i < left_len {\n        let mut carry = 0u64;\n        let mut j = 0usize;\n        while j < right_len {\n            let product = (left.limbs[i] as u128) * (right.limbs[j] as u128)\n                + (out[i + j] as u128)\n                + (carry as u128);\n            out[i + j] = product as u64;\n            carry = (product >> 64) as u64;\n            j += 1;\n        }\n        // The next limb may already contain the contribution from a prior\n        // row. Add this row's carry to it and propagate any overflow instead\n        // of overwriting that contribution.\n        let mut position = i + right_len;\n        let (sum, mut overflow) = out[position].overflowing_add(carry);\n        out[position] = sum;\n        position += 1;\n        while overflow && position < out.len() {\n            let (next, next_overflow) = out[position].overflowing_add(1u64);\n            out[position] = next;\n            overflow = next_overflow;\n            position += 1;\n        }\n        debug_assert!(!overflow);\n        i += 1;\n    }\n    normalize(out)\n}\n\n/// value * mul + addend for a machine word multiplier and addend.\npub fn mul_add_small(value: &BigNat, mul: u64, addend: u64) -> BigNat {\n    let len = value.limbs.len();\n    let mut out: Vec<u64> = Vec::new();\n    let mut carry = addend as u128;\n    let mut index = 0usize;\n    while index < len {\n        let product = (value.limbs[index] as u128) * (mul as u128) + carry;\n        out.push(product as u64);\n        carry = product >> 64;\n        index += 1;\n    }\n    let mut tail = carry;\n    while tail != 0 {\n        out.push(tail as u64);\n        tail >>= 64;\n    }\n    normalize(out)\n}\n\n/// Division and remainder by a nonzero machine word, with the remainder first.\npub fn divmod_small(value: &BigNat, divisor: u64) -> (u64, BigNat) {\n    let len = value.limbs.len();\n    if divisor == 0 {\n        let quotient = value.clone();\n        return (0u64, quotient);\n    }\n    let mut quotient: Vec<u64> = Vec::new();\n    let mut index = 0usize;\n    while index < len {\n        quotient.push(0u64);\n        index += 1;\n    }\n    let mut remainder = 0u128;\n    let mut position = len;\n    while position > 0 {\n        position -= 1;\n        let current = (remainder << 64) | (value.limbs[position] as u128);\n        quotient[position] = (current / (divisor as u128)) as u64;\n        remainder = current % (divisor as u128);\n    }\n    (remainder as u64, normalize(quotient))\n}\n\n/// Number of significant bits; zero has none.\npub fn bit_length(value: &BigNat) -> usize {\n    if value.limbs.len() == 0 {\n        return 0;\n    }\n    let top = value.limbs[value.limbs.len() - 1];\n    let mut bits = (value.limbs.len() - 1) * 64;\n    let mut probe = top;\n    while probe != 0 {\n        bits += 1;\n        probe >>= 1;\n    }\n    bits\n}\n\n/// Bit at position index, zero when out of range.\npub fn bit_at(value: &BigNat, index: usize) -> u64 {\n    let limb = index / 64;\n    if limb >= value.limbs.len() {\n        return 0;\n    }\n    (value.limbs[limb] >> (index % 64)) & 1\n}\n\n/// value * 2.\npub fn shl_one(value: &BigNat) -> BigNat {\n    let len = value.limbs.len();\n    let mut out: Vec<u64> = Vec::new();\n    if len == 0 {\n        return normalize(out);\n    }\n    let top = value.limbs[len - 1];\n    let extra = top >> 63;\n    let mut index2 = 0usize;\n    while index2 < len {\n        let current = value.limbs[index2] << 1;\n        let carry = if index2 == 0 {\n            0\n        } else {\n            value.limbs[index2 - 1] >> 63\n        };\n        out.push(current | carry);\n        index2 += 1;\n    }\n    if extra != 0 {\n        out.push(extra);\n    }\n    normalize(out)\n}\n\n/// value + 1.\npub fn succ(value: &BigNat) -> BigNat {\n    let one = one();\n    add(value, &one)\n}\n\n/// value + addend.\npub fn add_u64(value: &BigNat, addend: u64) -> BigNat {\n    let word = from_u64(addend);\n    add(value, &word)\n}\n\n/// Bit-serial division: q * divisor + r = value with r < divisor.\n/// A zero divisor returns (value, zero) so that the caller matches Lean's\n/// total division (a / 0 = 0, a % 0 = a).\npub fn divmod(value: &BigNat, divisor: &BigNat) -> (BigNat, BigNat) {\n    if is_zero(divisor) {\n        return (zero(), value.clone());\n    }\n    if compare(value, divisor) < 0 {\n        return (zero(), value.clone());\n    }\n    let high = bit_length(value);\n    let mut quotient = zero();\n    let mut remainder = zero();\n    let mut position = high;\n    while position > 0 {\n        position -= 1;\n        let rest = shl_one(&remainder);\n        let bit = bit_at(value, position);\n        if bit == 1 {\n            remainder = succ(&rest);\n        } else {\n            remainder = rest;\n        }\n        quotient = shl_one(&quotient);\n        if compare(&remainder, divisor) >= 0 {\n            remainder = sub(&remainder, divisor);\n            quotient = succ(&quotient);\n        }\n    }\n    (quotient, remainder)\n}\n\npub fn div(value: &BigNat, divisor: &BigNat) -> BigNat {\n    divmod(value, divisor).0\n}\n\npub fn rem(value: &BigNat, divisor: &BigNat) -> BigNat {\n    divmod(value, divisor).1\n}\n\n/// Low 64 bits, matching Lean UInt64.ofNat truncation.\npub fn low_u64(value: &BigNat) -> u64 {\n    if value.limbs.len() == 0 {\n        return 0;\n    }\n    value.limbs[0]\n}\n\n/// The value as usize when it fits, mirroring BigUint::to_usize.\npub fn to_usize(value: &BigNat) -> Option<usize> {\n    if value.limbs.len() == 0 {\n        return Some(0usize);\n    }\n    if value.limbs.len() > 1 {\n        return None;\n    }\n    let low = value.limbs[0];\n    if low > usize::MAX as u64 {\n        return None;\n    }\n    Some(low as usize)\n}\n\n/// Greatest common divisor by the Euclidean algorithm; gcd(0, 0) is zero.\npub fn gcd(left: &BigNat, right: &BigNat) -> BigNat {\n    let mut a = left.clone();\n    let mut b = right.clone();\n    while !is_zero(&b) {\n        let rest = rem(&a, &b);\n        a = b;\n        b = rest;\n    }\n    a\n}\n\n/// Decimal digits, most significant first; zero renders as a single 0.\npub fn to_decimal_digits(value: &BigNat) -> Vec<u8> {\n    let mut digits: Vec<u8> = Vec::new();\n    if is_zero(value) {\n        digits.push(b'0');\n        return digits;\n    }\n    let mut rest = value.clone();\n    while !is_zero(&rest) {\n        let (remainder, quotient) = divmod_small(&rest, 10u64);\n        digits.push(b'0' + (remainder as u8));\n        rest = quotient;\n    }\n    let len = digits.len();\n    let mut index = 0usize;\n    while index < len / 2 {\n        let opposite = len - 1 - index;\n        digits.swap(index, opposite);\n        index += 1;\n    }\n    digits\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    /// Values below 2^128, used as a machine-word oracle for the limb code.\n    fn nat(value: u128) -> BigNat {\n        from_u64_pair((value >> 64) as u64, value as u64)\n    }\n\n    fn word(value: &BigNat) -> u128 {\n        let mut total = 0u128;\n        let mut index = value.limbs.len();\n        while index > 0 {\n            index -= 1;\n            total = (total << 64) | (value.limbs[index] as u128);\n        }\n        total\n    }\n\n    fn canonical(value: &BigNat) -> bool {\n        value.limbs.len() == 0 || value.limbs[value.limbs.len() - 1] != 0\n    }\n\n    #[test]\n    fn normalization_and_order() {\n        assert!(is_zero(&zero()));\n        assert!(is_zero(&normalize(vec![0, 0, 0])));\n        assert!(canonical(&normalize(vec![5, 0])));\n        assert_eq!(normalize(vec![5, 0]).limbs, vec![5]);\n        assert_eq!(compare(&nat(7), &nat(7)), 0);\n        assert_eq!(compare(&nat(7), &nat(8)), -1);\n        assert_eq!(compare(&nat(8), &nat(7)), 1);\n        assert_eq!(compare(&nat(1 << 70), &nat(1 << 69)), 1);\n        assert_eq!(compare(&nat(1 << 69), &nat(1 << 70)), -1);\n        assert!(equal(&nat(1 << 100), &nat(1 << 100)));\n        assert!(!equal(&nat(1 << 100), &nat(1 << 101)));\n        assert!(!equal(&nat(1 << 100), &zero()));\n        assert!(is_one(&one()));\n        assert!(!is_one(&nat(2)));\n    }\n\n    #[test]\n    fn word_arithmetic_matches_u128() {\n        let cases: [u128; 9] = [\n            0,\n            1,\n            2,\n            3,\n            1 << 63,\n            0x8000_0000_0000_0001,\n            0xffff_ffff_ffff_ffff,\n            0xdead_beef_dead_beef,\n            123_456_789_012_345_678,\n        ];\n        for left in cases {\n            for right in cases {\n                assert_eq!(word(&add(&nat(left), &nat(right))), left + right);\n                assert_eq!(word(&mul(&nat(left), &nat(right))), left * right);\n                assert_eq!(\n                    word(&sub(&nat(left), &nat(right))),\n                    left.saturating_sub(right)\n                );\n                assert_eq!(\n                    compare(&nat(left), &nat(right)),\n                    match left.cmp(&right) {\n                        std::cmp::Ordering::Less => -1,\n                        std::cmp::Ordering::Equal => 0,\n                        std::cmp::Ordering::Greater => 1,\n                    }\n                );\n                if right != 0 {\n                    assert_eq!(word(&div(&nat(left), &nat(right))), left / right);\n                    assert_eq!(word(&rem(&nat(left), &nat(right))), left % right);\n                    let (low, high) = divmod_small(&nat(left), right as u64);\n                    assert_eq!(word(&high), left / right);\n                    assert_eq!(low as u128, left % right);\n                    assert!(equal(\n                        &divmod(&nat(left), &nat(right)).0,\n                        &nat(left / right)\n                    ));\n                    assert!(equal(\n                        &divmod(&nat(left), &nat(right)).1,\n                        &nat(left % right)\n                    ));\n                }\n            }\n        }\n    }\n\n    #[test]\n    fn division_is_total_and_consistent() {\n        assert!(is_zero(&div(&nat(9), &zero())));\n        assert!(equal(&rem(&nat(9), &zero()), &nat(9)));\n        let big = add(&shl_one(&nat(1 << 127)), &nat(3));\n        assert_eq!(compare(&big, &nat(1 << 127)), 1);\n        assert!(equal(&div(&big, &nat(1 << 127)), &nat(2)));\n        // 2^128 + 3 is congruent to 1 modulo 3.\n        assert!(equal(&rem(&big, &nat(3)), &nat(1)));\n        assert!(equal(&div(&big, &nat(1 << 120)), &nat(256)));\n        // (a * b) / b == a for large operands.\n        let a = nat(0x0123_4567_89ab_cdef);\n        let b = nat(0xfedc_ba98_7654_3210);\n        let product = mul(&a, &b);\n        assert!(equal(&div(&product, &b), &a));\n        assert!(is_zero(&rem(&product, &b)));\n        assert!(equal(&divmod(&product, &b).0, &a));\n        // Powers and a long division with a nontrivial remainder.\n        let mut power = one();\n        let mut step = 0usize;\n        while step < 40 {\n            power = mul(&power, &nat(10));\n            step += 1;\n        }\n        let quotient = div(&power, &nat(7));\n        let remainder = rem(&power, &nat(7));\n        assert!(compare(&remainder, &nat(7)) < 0);\n        assert!(equal(&add(&mul(&quotient, &nat(7)), &remainder), &power));\n    }\n\n    #[test]\n    fn small_helpers_and_digits() {\n        let value = nat(0xffff_ffff_ffff_ffff);\n        assert!(equal(\n            &mul_add_small(&value, 10, 7),\n            &nat(184_467_440_737_095_516_157)\n        ));\n        assert!(equal(&mul_add_small(&zero(), 10, 7), &nat(7)));\n        assert_eq!(bit_length(&zero()), 0);\n        assert_eq!(bit_length(&nat(1)), 1);\n        assert_eq!(bit_length(&nat(255)), 8);\n        assert_eq!(bit_length(&nat(256)), 9);\n        assert_eq!(bit_length(&nat(1 << 64)), 65);\n        assert!(equal(&shl_one(&nat(1 << 63)), &nat(1 << 64)));\n        assert!(equal(&shl_one(&zero()), &zero()));\n        assert_eq!(bit_at(&nat(6), 1), 1);\n        assert_eq!(bit_at(&nat(6), 2), 1);\n        assert_eq!(bit_at(&nat(6), 0), 0);\n        assert_eq!(bit_at(&nat(6), 99), 0);\n        assert!(equal(&succ(&nat(u64::MAX as u128)), &nat(1u128 << 64)));\n        assert!(equal(&add_u64(&zero(), 1), &one()));\n        assert_eq!(to_decimal_digits(&zero()), vec![b'0']);\n        assert_eq!(\n            to_decimal_digits(&nat(1_234_567_890)),\n            b\"1234567890\".to_vec()\n        );\n        assert_eq!(\n            to_decimal_digits(&nat(10_000_000_000_000_000_000_000)),\n            b\"10000000000000000000000\".to_vec()\n        );\n        let square = mul(&nat(1u128 << 64), &nat(1u128 << 64));\n        assert_eq!(\n            to_decimal_digits(&square),\n            b\"340282366920938463463374607431768211456\".to_vec()\n        );\n        assert_eq!(to_usize(&nat(7)), Some(7));\n        assert_eq!(to_usize(&zero()), Some(0));\n        assert_eq!(to_usize(&nat(1 << 70)), None);\n        assert_eq!(low_u64(&nat(1 << 64)), 0);\n        assert_eq!(low_u64(&zero()), 0);\n        assert!(equal(\n            &gcd(&nat(0x1_0000_0000_0000_0000), &nat(0x8000_0000_0000_0000)),\n            &nat(0x8000_0000_0000_0000)\n        ));\n        assert!(equal(&gcd(&zero(), &nat(5)), &nat(5)));\n    }\n}\n"},{"id":4,"name":{"Local":"crates/lnmai-core-verify/src/big_rat.rs"},"crate_name":"lnmai_core_verify","contents":"//! Exact rationals over the extracted integer and natural kernels.\n//!\n//! This is the shared implementation of the runtime Rat type. Values are kept\n//! in lowest terms with a positive denominator; a zero denominator denotes\n//! zero, matching Lean's total division. The decimal renderer keeps at most\n//! twelve fractional digits, as Lean's Rat.toDecimalString does.\n\nuse crate::big_int::{self, BigIntKernel};\nuse crate::big_nat::{self, BigNat};\n\n/// Lowest-terms rational with a positive denominator.\n#[derive(Clone)]\npub struct BigRat {\n    pub num: BigIntKernel,\n    pub den: BigNat,\n}\n\npub fn from_int(num: &BigIntKernel) -> BigRat {\n    BigRat {\n        num: num.clone(),\n        den: big_nat::one(),\n    }\n}\n\npub fn zero() -> BigRat {\n    BigRat {\n        num: big_int::zero(),\n        den: big_nat::one(),\n    }\n}\n\npub fn one() -> BigRat {\n    BigRat {\n        num: big_int::from_u64(1u64),\n        den: big_nat::one(),\n    }\n}\n\npub fn is_zero(value: &BigRat) -> bool {\n    big_int::is_zero(&value.num)\n}\n\npub fn is_negative(value: &BigRat) -> bool {\n    big_int::is_negative(&value.num)\n}\n\nfn den_int(value: &BigRat) -> BigIntKernel {\n    big_int::of_nat(&value.den)\n}\n\n/// Reduce to lowest terms with a nonnegative denominator.\nfn reduce(num: BigIntKernel, den: BigIntKernel) -> BigRat {\n    if big_int::is_zero(&den) {\n        return zero();\n    }\n    let negative = big_int::is_negative(&den);\n    let numer = if negative { big_int::neg(&num) } else { num };\n    let denom = big_int::abs(&den);\n    let divisor = big_int::gcd(&numer, &denom);\n    if big_nat::is_zero(&divisor) {\n        return BigRat {\n            num: numer,\n            den: denom.magnitude,\n        };\n    }\n    let divisor_int = big_int::of_nat(&divisor);\n    BigRat {\n        num: big_int::div_trunc(&numer, &divisor_int),\n        den: big_nat::div(&denom.magnitude, &divisor),\n    }\n}\n\n/// Lean Rational.mk: a zero denominator is zero.\npub fn new(num: &BigIntKernel, den: &BigIntKernel) -> BigRat {\n    reduce(num.clone(), den.clone())\n}\n\npub fn add(left: &BigRat, right: &BigRat) -> BigRat {\n    let first = big_int::mul(&left.num, &den_int(right));\n    let second = big_int::mul(&right.num, &den_int(left));\n    let numerator = big_int::add(&first, &second);\n    let denominator = big_int::of_nat(&big_nat::mul(&left.den, &right.den));\n    reduce(numerator, denominator)\n}\n\npub fn sub(left: &BigRat, right: &BigRat) -> BigRat {\n    let first = big_int::mul(&left.num, &den_int(right));\n    let second = big_int::mul(&right.num, &den_int(left));\n    let numerator = big_int::sub(&first, &second);\n    let denominator = big_int::of_nat(&big_nat::mul(&left.den, &right.den));\n    reduce(numerator, denominator)\n}\n\npub fn mul(left: &BigRat, right: &BigRat) -> BigRat {\n    let numerator = big_int::mul(&left.num, &right.num);\n    let denominator = big_int::of_nat(&big_nat::mul(&left.den, &right.den));\n    reduce(numerator, denominator)\n}\n\npub fn div(left: &BigRat, right: &BigRat) -> BigRat {\n    let numerator = big_int::mul(&left.num, &den_int(right));\n    let denominator = big_int::mul(&right.num, &den_int(left));\n    reduce(numerator, denominator)\n}\n\n/// Comparison by cross multiplication: -1, 0 or 1.\npub fn compare(left: &BigRat, right: &BigRat) -> i8 {\n    let first = big_int::mul(&left.num, &den_int(right));\n    let second = big_int::mul(&right.num, &den_int(left));\n    big_int::compare(&first, &second)\n}\n\npub fn equal(left: &BigRat, right: &BigRat) -> bool {\n    compare(left, right) == 0\n}\n\n/// Decimal digits of the truncated absolute whole part.\npub fn whole_digits(value: &BigRat) -> Vec<u8> {\n    let magnitude = &value.num.magnitude;\n    let whole = big_nat::div(magnitude, &value.den);\n    big_nat::to_decimal_digits(&whole)\n}\n\n/// At most twelve fractional digits with trailing zeros removed.\npub fn fraction_digits(value: &BigRat) -> Vec<u8> {\n    let mut fraction: Vec<u8> = Vec::new();\n    if big_nat::is_zero(&value.num.magnitude) {\n        return fraction;\n    }\n    let mut rest = big_nat::rem(&value.num.magnitude, &value.den);\n    let mut count = 0usize;\n    while count < 12usize && !big_nat::is_zero(&rest) {\n        let scaled = big_nat::mul_add_small(&rest, 10u64, 0u64);\n        let digit = big_nat::div(&scaled, &value.den);\n        rest = big_nat::rem(&scaled, &value.den);\n        fraction.push(b'0' + (big_nat::low_u64(&digit) as u8));\n        count += 1;\n    }\n    let mut length = fraction.len();\n    while length > 0 && fraction[length - 1] == b'0' {\n        length -= 1;\n    }\n    let mut trimmed: Vec<u8> = Vec::new();\n    let mut index = 0usize;\n    while index < length {\n        trimmed.push(fraction[index]);\n        index += 1;\n    }\n    trimmed\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    fn rat(num: i128, den: i128) -> BigRat {\n        new(&big_int::from_i128(num), &big_int::from_i128(den))\n    }\n\n    fn render(value: &BigRat) -> (Vec<u8>, Vec<u8>) {\n        (whole_digits(value), fraction_digits(value))\n    }\n\n    #[test]\n    fn normalization_keeps_lowest_terms() {\n        assert!(equal(&rat(2, 4), &rat(1, 2)));\n        assert!(equal(&rat(-2, 4), &rat(-1, 2)));\n        assert!(equal(&rat(2, -4), &rat(-1, 2)));\n        assert!(is_zero(&rat(5, 0)));\n        assert!(equal(&rat(-3, -3), &one()));\n        assert!(equal(&from_int(&big_int::from_i128(0)), &zero()));\n        assert!(equal(&from_int(&big_int::from_i128(4)), &rat(4, 1)));\n        assert!(equal(&rat(0, 7), &zero()));\n        assert!(equal(&rat(6, 3), &from_int(&big_int::from_i128(2))));\n    }\n\n    #[test]\n    fn arithmetic_matches_cross_products() {\n        let values: [(i128, i128); 7] =\n            [(0, 1), (1, 3), (1, 6), (-1, 4), (7, 5), (-22, 7), (100, 9)];\n        for (ln, ld) in values {\n            for (rn, rd) in values {\n                let left = rat(ln, ld);\n                let right = rat(rn, rd);\n                assert!(equal(&add(&left, &right), &rat(ln * rd + rn * ld, ld * rd)));\n                assert!(equal(&sub(&left, &right), &rat(ln * rd - rn * ld, ld * rd)));\n                assert!(equal(&mul(&left, &right), &rat(ln * rn, ld * rd)));\n                if rn != 0 {\n                    assert!(equal(&div(&left, &right), &rat(ln * rd, ld * rn)));\n                }\n                let ordering = (ln * rd).cmp(&(rn * ld));\n                let expected = match ordering {\n                    std::cmp::Ordering::Less => -1,\n                    std::cmp::Ordering::Equal => 0,\n                    std::cmp::Ordering::Greater => 1,\n                };\n                assert_eq!(compare(&left, &right), expected);\n                assert_eq!(equal(&left, &right), ordering.is_eq());\n            }\n        }\n        assert!(is_zero(&div(&zero(), &zero())));\n        assert!(is_negative(&rat(-1, 2)));\n        assert!(!is_negative(&rat(0, 2)));\n    }\n\n    #[test]\n    fn decimal_renderer_matches_decimal_expansion() {\n        assert_eq!(render(&rat(1, 2)), (b\"0\".to_vec(), b\"5\".to_vec()));\n        assert_eq!(render(&rat(3, 1)), (b\"3\".to_vec(), Vec::new()));\n        assert_eq!(render(&rat(-1, 4)), (b\"0\".to_vec(), b\"25\".to_vec()));\n        assert_eq!(render(&zero()), (b\"0\".to_vec(), Vec::new()));\n        assert_eq!(\n            render(&rat(1, 3)),\n            (b\"0\".to_vec(), b\"333333333333\".to_vec())\n        );\n        assert_eq!(render(&rat(1, 8)), (b\"0\".to_vec(), b\"125\".to_vec()));\n        assert_eq!(render(&rat(7, 4)), (b\"1\".to_vec(), b\"75\".to_vec()));\n        assert_eq!(\n            render(&rat(22, 7)),\n            (b\"3\".to_vec(), b\"142857142857\".to_vec())\n        );\n        assert_eq!(render(&rat(100, 1)), (b\"100\".to_vec(), Vec::new()));\n        let huge = big_nat::from_u64_pair(1, 0);\n        let whole = BigRat {\n            num: big_int::of_nat(&huge),\n            den: big_nat::from_u64(1),\n        };\n        assert_eq!(whole_digits(&whole), b\"18446744073709551616\".to_vec());\n        let half = BigRat {\n            num: big_int::of_nat(&huge),\n            den: big_nat::from_u64(2),\n        };\n        assert_eq!(whole_digits(&half), b\"9223372036854775808\".to_vec());\n    }\n}\n"},{"id":5,"name":{"Local":"crates/lnmai-core-verify/src/constants.rs"},"crate_name":"lnmai_core_verify","contents":"//! Aeneas-friendly constants module\n//!\n//! All timing constants in microseconds\n\nuse super::time::Duration;\n\n/// Frame length (60fps = 16667μs)\npub const FRAME_LENGTH: Duration = Duration { micros: 16667 };\n\n// Tap judgment windows\npub const TAP_PERFECT_1ST: Duration = Duration { micros: 16667 };\npub const TAP_PERFECT_2ND: Duration = Duration { micros: 33334 };\npub const TAP_PERFECT_3RD: Duration = Duration { micros: 50001 };\npub const TAP_GREAT_1ST: Duration = Duration { micros: 66668 };\npub const TAP_GREAT_2ND: Duration = Duration { micros: 83335 };\npub const TAP_GREAT_3RD: Duration = Duration { micros: 100002 };\npub const TAP_GOOD: Duration = Duration { micros: 150000 };\n\n// Touch judgment windows\npub const TOUCH_PERFECT_1ST: Duration = Duration { micros: 150003 };\npub const TOUCH_PERFECT_2ND: Duration = Duration { micros: 175004 };\npub const TOUCH_PERFECT_3RD: Duration = Duration { micros: 200004 };\npub const TOUCH_GREAT_1ST: Duration = Duration { micros: 216671 };\npub const TOUCH_GREAT_2ND: Duration = Duration { micros: 233338 };\npub const TOUCH_GREAT_3RD: Duration = Duration { micros: 250005 };\npub const TOUCH_GOOD: Duration = Duration { micros: 300006 };\n\n// Slide judgment windows\npub const SLIDE_PERFECT_3RD: Duration = Duration { micros: 233338 };\npub const SLIDE_GREAT_1ST: Duration = Duration { micros: 350007 };\npub const SLIDE_GREAT_2ND: Duration = Duration { micros: 416675 };\npub const SLIDE_GREAT_3RD: Duration = Duration { micros: 483343 };\npub const SLIDE_GOOD: Duration = Duration { micros: 600012 };\npub const SLIDE_MAX_EXT: Duration = Duration { micros: 366674 };\n\n// Hold constants\npub const HOLD_HEAD_IGNORE: Duration = Duration { micros: 100002 };\npub const HOLD_TAIL_IGNORE: Duration = Duration { micros: 200004 };\npub const TOUCH_HOLD_HEAD_IGNORE: Duration = Duration { micros: 250005 };\npub const TOUCH_HOLD_TAIL_IGNORE: Duration = Duration { micros: 200004 };\npub const DELUXE_HOLD_RELEASE_IGNORE_TIME: Duration = Duration { micros: 33334 };\npub const CLASSIC_HOLD_ALLOW_OVER_LENGTH: Duration = Duration { micros: 333340 };\n\n// Classic hold end windows (9 frames / 12 frames)\npub const HOLD_CLASSIC_END_JUDGE_PERFECT_FAST: Duration = Duration { micros: 150003 };\npub const HOLD_CLASSIC_END_JUDGE_PERFECT_LATE: Duration = Duration { micros: 200004 };\n\n// Late clear wait\npub const SLIDE_JUDGED_LATE_CLEAR_WAIT: Duration = Duration { micros: 50000 };\n\n// Judgable range\npub const JUDGABLE_RANGE: Duration = Duration { micros: 150000 };\npub const TOUCH_JUDGABLE_RANGE_LATE_EXTRA: Duration = Duration { micros: 166670 };\n\n// Counts\npub const BUTTON_ZONE_COUNT: u32 = 8;\npub const SENSOR_AREA_COUNT: u32 = 33;\n\n// Judge offset applied to slide sub-grade subdivision.\npub const SUBDIVIDE_SLIDE_JUDGE_GRADE: bool = false;\n"},{"id":6,"name":{"Local":"crates/lnmai-core-verify/src/convert.rs"},"crate_name":"lnmai_core_verify","contents":"//! Aeneas-friendly convert module\n//!\n//! Grade conversion functions\n\nuse super::types::{JudgeGrade, JudgeStyle};\n\n/// Convert grade using Maji mode\npub fn convert_maji(grade: JudgeGrade) -> JudgeGrade {\n    match grade {\n        JudgeGrade::LateGreat => JudgeGrade::LateGood,\n        JudgeGrade::LateGreat2nd => JudgeGrade::LateGood,\n        JudgeGrade::LateGreat3rd => JudgeGrade::LateGood,\n        JudgeGrade::FastGreat => JudgeGrade::FastGood,\n        JudgeGrade::FastGreat2nd => JudgeGrade::FastGood,\n        JudgeGrade::FastGreat3rd => JudgeGrade::FastGood,\n        JudgeGrade::LatePerfect3rd => JudgeGrade::LateGreat,\n        JudgeGrade::FastPerfect3rd => JudgeGrade::FastGreat,\n        JudgeGrade::LatePerfect2nd => JudgeGrade::LatePerfect2nd,\n        JudgeGrade::FastPerfect2nd => JudgeGrade::FastPerfect2nd,\n        JudgeGrade::LateGood => JudgeGrade::Miss,\n        JudgeGrade::FastGood => JudgeGrade::TooFast,\n        JudgeGrade::Perfect => JudgeGrade::Perfect,\n        JudgeGrade::Miss => JudgeGrade::Miss,\n        JudgeGrade::TooFast => JudgeGrade::TooFast,\n    }\n}\n\n/// Convert grade using Gachi mode\npub fn convert_gachi(grade: JudgeGrade) -> JudgeGrade {\n    match grade {\n        JudgeGrade::LatePerfect3rd => JudgeGrade::LateGood,\n        JudgeGrade::FastPerfect3rd => JudgeGrade::FastGood,\n        JudgeGrade::LatePerfect2nd => JudgeGrade::LateGreat,\n        JudgeGrade::FastPerfect2nd => JudgeGrade::FastGreat,\n        JudgeGrade::LateGreat => JudgeGrade::Miss,\n        JudgeGrade::LateGreat2nd => JudgeGrade::Miss,\n        JudgeGrade::LateGreat3rd => JudgeGrade::Miss,\n        JudgeGrade::LateGood => JudgeGrade::Miss,\n        JudgeGrade::FastGreat => JudgeGrade::TooFast,\n        JudgeGrade::FastGreat2nd => JudgeGrade::TooFast,\n        JudgeGrade::FastGreat3rd => JudgeGrade::TooFast,\n        JudgeGrade::FastGood => JudgeGrade::TooFast,\n        JudgeGrade::Perfect => JudgeGrade::Perfect,\n        JudgeGrade::Miss => JudgeGrade::Miss,\n        JudgeGrade::TooFast => JudgeGrade::TooFast,\n    }\n}\n\n/// Convert grade using Gori mode\npub fn convert_gori(grade: JudgeGrade) -> JudgeGrade {\n    match grade {\n        JudgeGrade::Perfect => JudgeGrade::Perfect,\n        JudgeGrade::Miss => JudgeGrade::Miss,\n        JudgeGrade::LateGood => JudgeGrade::Miss,\n        JudgeGrade::LateGreat3rd => JudgeGrade::Miss,\n        JudgeGrade::LateGreat2nd => JudgeGrade::Miss,\n        JudgeGrade::LateGreat => JudgeGrade::Miss,\n        JudgeGrade::LatePerfect3rd => JudgeGrade::Miss,\n        JudgeGrade::LatePerfect2nd => JudgeGrade::Miss,\n        JudgeGrade::FastPerfect2nd => JudgeGrade::TooFast,\n        JudgeGrade::FastPerfect3rd => JudgeGrade::TooFast,\n        JudgeGrade::FastGreat => JudgeGrade::TooFast,\n        JudgeGrade::FastGreat2nd => JudgeGrade::TooFast,\n        JudgeGrade::FastGreat3rd => JudgeGrade::TooFast,\n        JudgeGrade::FastGood => JudgeGrade::TooFast,\n        JudgeGrade::TooFast => JudgeGrade::TooFast,\n    }\n}\n\n/// Convert grade based on judge style\npub fn convert_grade(style: JudgeStyle, grade: JudgeGrade) -> JudgeGrade {\n    match style {\n        JudgeStyle::Default => grade,\n        JudgeStyle::Maji => convert_maji(grade),\n        JudgeStyle::Gachi => convert_gachi(grade),\n        JudgeStyle::Gori => convert_gori(grade),\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn test_perfect_fixed() {\n        for style in &[\n            JudgeStyle::Default,\n            JudgeStyle::Maji,\n            JudgeStyle::Gachi,\n            JudgeStyle::Gori,\n        ] {\n            assert_eq!(\n                convert_grade(*style, JudgeGrade::Perfect),\n                JudgeGrade::Perfect\n            );\n        }\n    }\n\n    #[test]\n    fn test_miss_fixed() {\n        for style in &[\n            JudgeStyle::Default,\n            JudgeStyle::Maji,\n            JudgeStyle::Gachi,\n            JudgeStyle::Gori,\n        ] {\n            assert_eq!(convert_grade(*style, JudgeGrade::Miss), JudgeGrade::Miss);\n        }\n    }\n\n    #[test]\n    fn test_default_identity() {\n        let grades = [\n            JudgeGrade::Miss,\n            JudgeGrade::LateGood,\n            JudgeGrade::LateGreat,\n            JudgeGrade::Perfect,\n            JudgeGrade::TooFast,\n        ];\n        for grade in grades {\n            assert_eq!(convert_grade(JudgeStyle::Default, grade), grade);\n        }\n    }\n}\n"},{"id":7,"name":{"Local":"crates/lnmai-core-verify/src/frame_commands.rs"},"crate_name":"lnmai_core_verify","contents":"//! Frame feedback selection and ordered command collection.\n//!\n//! Event payloads, timestamps, and arbitrary-precision identifiers stay in the\n//! runtime. These functions own every branch deciding whether a command is\n//! emitted, its sound kind, and the order of the collected commands.\n\nuse crate::lifecycle::HoldSubState;\nuse crate::types::{JudgeEventKind, JudgeGrade, JudgePhase, RuntimePos};\n\n/// Hold heads on the touch panel are silent; rejected button hold heads are\n/// silent too. An accepted button hold head uses the tap sound.\npub fn event_audio_kind(\n    kind: JudgeEventKind,\n    phase: JudgePhase,\n    grade: JudgeGrade,\n    position: RuntimePos,\n) -> Option<JudgeEventKind> {\n    let hold_head = matches!(kind, JudgeEventKind::Hold) && matches!(phase, JudgePhase::Head);\n    if hold_head && (matches!(position, RuntimePos::Sensor(_)) || grade.is_miss_or_too_fast()) {\n        None\n    } else if hold_head {\n        Some(JudgeEventKind::Tap)\n    } else {\n        Some(kind)\n    }\n}\n\npub fn event_render_visible(\n    kind: JudgeEventKind,\n    phase: JudgePhase,\n    display_hold_head: bool,\n) -> bool {\n    !(matches!(kind, JudgeEventKind::Hold)\n        && matches!(phase, JudgePhase::Head)\n        && !display_hold_head)\n}\n\n/// Ended, waiting, and merely judgeable heads never emit body audio.\npub fn touch_hold_body_active(\n    state: HoldSubState,\n    local_pressed: bool,\n    grouped_pressed: bool,\n) -> bool {\n    let head_accepted = match state {\n        HoldSubState::HeadJudged(grade) => !grade.is_miss_or_too_fast(),\n        HoldSubState::BodyHeld | HoldSubState::BodyReleased => true,\n        _ => false,\n    };\n    head_accepted && (local_pressed || grouped_pressed)\n}\n\n/// Visit every source slot once, retaining each present command in source order.\n/// Each source emits at most one command, so the result never exceeds `len`.\npub fn collect_indexed<T, F>(len: usize, command_at: F) -> Vec<T>\nwhere\n    F: Fn(usize) -> Option<T>,\n{\n    let mut commands = Vec::new();\n    let mut index = 0;\n    while index < len {\n        if let Some(command) = command_at(index) {\n            commands.push(command);\n        }\n        index += 1;\n    }\n    commands\n}\n"},{"id":8,"name":{"Local":"crates/lnmai-core-verify/src/grade_counts.rs"},"crate_name":"lnmai_core_verify","contents":"//! Fixed-array representation of Lean's `JudgeGrade → Nat` counters.\n//! The element type stays generic so the runtime can retain unbounded counts.\n\nuse crate::types::JudgeGrade;\n\npub const NUM_GRADES: usize = 15;\n\npub const JUDGE_GRADES: [JudgeGrade; NUM_GRADES] = [\n    JudgeGrade::Miss,\n    JudgeGrade::LateGood,\n    JudgeGrade::LateGreat3rd,\n    JudgeGrade::LateGreat2nd,\n    JudgeGrade::LateGreat,\n    JudgeGrade::LatePerfect3rd,\n    JudgeGrade::LatePerfect2nd,\n    JudgeGrade::Perfect,\n    JudgeGrade::FastPerfect2nd,\n    JudgeGrade::FastPerfect3rd,\n    JudgeGrade::FastGreat,\n    JudgeGrade::FastGreat2nd,\n    JudgeGrade::FastGreat3rd,\n    JudgeGrade::FastGood,\n    JudgeGrade::TooFast,\n];\n\npub fn grade_index(grade: JudgeGrade) -> usize {\n    match grade {\n        JudgeGrade::Miss => 0,\n        JudgeGrade::LateGood => 1,\n        JudgeGrade::LateGreat3rd => 2,\n        JudgeGrade::LateGreat2nd => 3,\n        JudgeGrade::LateGreat => 4,\n        JudgeGrade::LatePerfect3rd => 5,\n        JudgeGrade::LatePerfect2nd => 6,\n        JudgeGrade::Perfect => 7,\n        JudgeGrade::FastPerfect2nd => 8,\n        JudgeGrade::FastPerfect3rd => 9,\n        JudgeGrade::FastGreat => 10,\n        JudgeGrade::FastGreat2nd => 11,\n        JudgeGrade::FastGreat3rd => 12,\n        JudgeGrade::FastGood => 13,\n        JudgeGrade::TooFast => 14,\n    }\n}\n\npub fn get_count<N>(counts: &[N; NUM_GRADES], grade: JudgeGrade) -> &N {\n    &counts[grade_index(grade)]\n}\n\npub fn set_count<N>(counts: &mut [N; NUM_GRADES], grade: JudgeGrade, value: N) {\n    counts[grade_index(grade)] = value;\n}\n"},{"id":9,"name":{"Local":"crates/lnmai-core-verify/src/judge.rs"},"crate_name":"lnmai_core_verify","contents":"//! Aeneas-friendly judge module\n//!\n//! Pure judgment functions\n\nuse super::constants::*;\nuse super::time::Duration;\nuse super::types::JudgeGrade;\n\n/// Judge a tap note\npub fn judge_tap(diff: Duration, is_ex: bool) -> JudgeGrade {\n    if is_ex {\n        return JudgeGrade::Perfect;\n    }\n\n    let is_fast = diff.micros < 0;\n    let abs_diff = diff.abs();\n\n    if abs_diff.micros <= TAP_PERFECT_1ST.micros {\n        JudgeGrade::Perfect\n    } else if abs_diff.micros <= TAP_PERFECT_2ND.micros {\n        if is_fast {\n            JudgeGrade::FastPerfect2nd\n        } else {\n            JudgeGrade::LatePerfect2nd\n        }\n    } else if abs_diff.micros <= TAP_PERFECT_3RD.micros {\n        if is_fast {\n            JudgeGrade::FastPerfect3rd\n        } else {\n            JudgeGrade::LatePerfect3rd\n        }\n    } else if abs_diff.micros <= TAP_GREAT_1ST.micros {\n        if is_fast {\n            JudgeGrade::FastGreat\n        } else {\n            JudgeGrade::LateGreat\n        }\n    } else if abs_diff.micros <= TAP_GREAT_2ND.micros {\n        if is_fast {\n            JudgeGrade::FastGreat2nd\n        } else {\n            JudgeGrade::LateGreat2nd\n        }\n    } else if abs_diff.micros <= TAP_GREAT_3RD.micros {\n        if is_fast {\n            JudgeGrade::FastGreat3rd\n        } else {\n            JudgeGrade::LateGreat3rd\n        }\n    } else {\n        if is_fast {\n            JudgeGrade::FastGood\n        } else {\n            JudgeGrade::LateGood\n        }\n    }\n}\n\n/// Judge a touch note\npub fn judge_touch(diff: Duration, _is_ex: bool) -> Option<JudgeGrade> {\n    let is_fast = diff.micros < 0;\n    let abs_diff = diff.abs();\n\n    if is_fast && abs_diff.micros > TOUCH_PERFECT_1ST.micros {\n        return None;\n    }\n\n    let grade = if abs_diff.micros <= TOUCH_PERFECT_1ST.micros {\n        JudgeGrade::Perfect\n    } else if abs_diff.micros <= TOUCH_PERFECT_2ND.micros {\n        JudgeGrade::LatePerfect2nd\n    } else if abs_diff.micros <= TOUCH_PERFECT_3RD.micros {\n        JudgeGrade::LatePerfect3rd\n    } else if abs_diff.micros <= TOUCH_GREAT_1ST.micros {\n        JudgeGrade::LateGreat\n    } else if abs_diff.micros <= TOUCH_GREAT_2ND.micros {\n        JudgeGrade::LateGreat2nd\n    } else if abs_diff.micros <= TOUCH_GREAT_3RD.micros {\n        JudgeGrade::LateGreat3rd\n    } else {\n        JudgeGrade::LateGood\n    };\n\n    Some(grade)\n}\n\n/// Judge a classic slide\npub fn judge_slide_classic(diff: Duration) -> JudgeGrade {\n    let is_fast = diff.micros < 0;\n    let abs_diff = diff.abs();\n\n    if is_fast {\n        if abs_diff.micros <= 66668 {\n            JudgeGrade::Perfect\n        } else if abs_diff.micros <= 133336 {\n            JudgeGrade::FastPerfect2nd\n        } else if abs_diff.micros <= 200004 {\n            JudgeGrade::FastPerfect3rd\n        } else if abs_diff.micros <= 266672 {\n            JudgeGrade::FastGreat\n        } else if abs_diff.micros <= 333340 {\n            JudgeGrade::FastGreat2nd\n        } else if abs_diff.micros <= 400008 {\n            JudgeGrade::FastGreat3rd\n        } else {\n            JudgeGrade::FastGood\n        }\n    } else {\n        if abs_diff.micros <= 66668 {\n            JudgeGrade::Perfect\n        } else if abs_diff.micros <= 133336 {\n            JudgeGrade::LatePerfect2nd\n        } else if abs_diff.micros <= 200004 {\n            JudgeGrade::LatePerfect3rd\n        } else if abs_diff.micros <= 266672 {\n            JudgeGrade::LateGreat\n        } else if abs_diff.micros <= 333340 {\n            JudgeGrade::LateGreat2nd\n        } else if abs_diff.micros <= 400008 {\n            JudgeGrade::LateGreat3rd\n        } else {\n            JudgeGrade::LateGood\n        }\n    }\n}\n\n/// Correct slide grade (collapse subdivided grades)\npub fn correct_slide_grade(grade: JudgeGrade) -> JudgeGrade {\n    match grade {\n        JudgeGrade::LatePerfect3rd\n        | JudgeGrade::LatePerfect2nd\n        | JudgeGrade::FastPerfect2nd\n        | JudgeGrade::FastPerfect3rd => JudgeGrade::Perfect,\n        _ => grade,\n    }\n}\n\n/// Judge slide too late\npub fn judge_slide_too_late(queue_remaining: u32) -> JudgeGrade {\n    if queue_remaining == 1 {\n        JudgeGrade::LateGood\n    } else {\n        JudgeGrade::Miss\n    }\n}\n\n// ============================================================================\n// Modern Slide Judgment (dynamic extension)\n// From SlideBase.Judge(), lines 224-273\n// ============================================================================\n\n/// Judge a modern (deluxe) slide. The 3rd-perfect window is dynamically extended\n/// based on `stay_time` (last wait time at slide end).\npub fn judge_slide_modern(diff: Duration, stay_time: Duration, _is_ex: bool) -> JudgeGrade {\n    let is_fast = diff.micros < 0;\n    let diff_msec = diff.abs();\n\n    // Dynamic extension: ext = min(stay_time / 4, 22-frame max)\n    let stay_div4 = stay_time.div_nat(4);\n    let ext = if stay_div4.micros < SLIDE_MAX_EXT.micros {\n        stay_div4\n    } else {\n        SLIDE_MAX_EXT\n    };\n    let seg_3rd_perfect = Duration {\n        micros: SLIDE_PERFECT_3RD.micros + ext.micros,\n    };\n    let seg_1st_perfect = seg_3rd_perfect.div_nat(3);\n    let seg_2nd_perfect = seg_3rd_perfect.scale_nat(2).div_nat(3);\n\n    if diff_msec.micros <= seg_1st_perfect.micros {\n        JudgeGrade::Perfect\n    } else if diff_msec.micros <= seg_2nd_perfect.micros {\n        if is_fast {\n            JudgeGrade::FastPerfect2nd\n        } else {\n            JudgeGrade::LatePerfect2nd\n        }\n    } else if diff_msec.micros <= seg_3rd_perfect.micros {\n        if is_fast {\n            JudgeGrade::FastPerfect3rd\n        } else {\n            JudgeGrade::LatePerfect3rd\n        }\n    } else if diff_msec.micros <= SLIDE_GREAT_1ST.micros {\n        if is_fast {\n            JudgeGrade::FastGreat\n        } else {\n            JudgeGrade::LateGreat\n        }\n    } else if diff_msec.micros <= SLIDE_GREAT_2ND.micros {\n        if is_fast {\n            JudgeGrade::FastGreat2nd\n        } else {\n            JudgeGrade::LateGreat2nd\n        }\n    } else if diff_msec.micros <= SLIDE_GREAT_3RD.micros {\n        if is_fast {\n            JudgeGrade::FastGreat3rd\n        } else {\n            JudgeGrade::LateGreat3rd\n        }\n    } else {\n        if is_fast {\n            JudgeGrade::FastGood\n        } else {\n            JudgeGrade::LateGood\n        }\n    }\n}\n\n// ============================================================================\n// Hold End Judgment (Deluxe/Modern) — press-band lookup table\n// From NoteLongDrop.HoldEndJudge(), lines 66-255\n// ============================================================================\n\n/// Compute the press band index from held percentage:\n///   0: >= 100%, 1: [67%,100%), 2: [33%,67%), 3: [5%,33%), 4: [0%,5%)\nfn press_band_micros(held_micros: i64, reality_micros: i64) -> u32 {\n    if held_micros >= reality_micros {\n        0\n    } else if held_micros * 100 >= reality_micros * 67 {\n        1\n    } else if held_micros * 100 >= reality_micros * 33 {\n        2\n    } else if held_micros * 100 >= reality_micros * 5 {\n        3\n    } else {\n        4\n    }\n}\n\n/// HoldEndJudge: computes the final hold grade from head grade and how\n/// long the player held the button.\npub fn judge_hold_end(\n    head_grade: JudgeGrade,\n    judge_diff: Duration,\n    length: Duration,\n    ignore_time: Duration,\n    player_release_time: Duration,\n) -> JudgeGrade {\n    let reality_ht_raw = Duration {\n        micros: length.micros - ignore_time.micros,\n    };\n    let hold_max = Duration::from_micros(300000);\n    let reality_ht_max = if length.micros > hold_max.micros {\n        Duration {\n            micros: length.micros - hold_max.micros,\n        }\n    } else {\n        Duration::zero()\n    };\n    let zero = Duration::zero();\n    let reality_ht = if reality_ht_raw.micros < zero.micros {\n        zero\n    } else if reality_ht_raw.micros > reality_ht_max.micros {\n        reality_ht_max\n    } else {\n        reality_ht_raw\n    };\n\n    if reality_ht.micros <= 0 {\n        return head_grade;\n    }\n\n    let held_raw = Duration {\n        micros: reality_ht.micros - player_release_time.micros,\n    };\n    let held = if held_raw.micros < zero.micros {\n        zero\n    } else {\n        held_raw\n    };\n    let band = press_band_micros(held.to_micros(), reality_ht.to_micros());\n    hold_band_grade(head_grade, judge_diff.micros >= 0, band)\n}\n\n/// Finite modern-hold grade table, shared by the bounded kernel and the\n/// arbitrary-precision runtime. Band 4 (and larger values) is below 5%.\npub fn hold_band_grade(head_grade: JudgeGrade, is_late: bool, band: u32) -> JudgeGrade {\n    match band {\n        0 => match head_grade {\n            JudgeGrade::LatePerfect3rd\n            | JudgeGrade::LatePerfect2nd\n            | JudgeGrade::Perfect\n            | JudgeGrade::FastPerfect2nd\n            | JudgeGrade::FastPerfect3rd => head_grade,\n            JudgeGrade::LateGood\n            | JudgeGrade::LateGreat3rd\n            | JudgeGrade::LateGreat2nd\n            | JudgeGrade::LateGreat => JudgeGrade::LateGreat,\n            JudgeGrade::FastGreat\n            | JudgeGrade::FastGreat2nd\n            | JudgeGrade::FastGreat3rd\n            | JudgeGrade::FastGood => JudgeGrade::FastGreat,\n            JudgeGrade::Miss => JudgeGrade::LateGood,\n            JudgeGrade::TooFast => JudgeGrade::FastGood,\n        },\n        1 => match head_grade {\n            JudgeGrade::Perfect => {\n                if is_late {\n                    JudgeGrade::LatePerfect2nd\n                } else {\n                    JudgeGrade::FastPerfect2nd\n                }\n            }\n            JudgeGrade::LatePerfect3rd\n            | JudgeGrade::LatePerfect2nd\n            | JudgeGrade::FastPerfect2nd\n            | JudgeGrade::FastPerfect3rd => head_grade,\n            JudgeGrade::LateGood\n            | JudgeGrade::LateGreat3rd\n            | JudgeGrade::LateGreat2nd\n            | JudgeGrade::LateGreat => JudgeGrade::LateGreat,\n            JudgeGrade::FastGreat\n            | JudgeGrade::FastGreat2nd\n            | JudgeGrade::FastGreat3rd\n            | JudgeGrade::FastGood => JudgeGrade::FastGreat,\n            JudgeGrade::Miss => JudgeGrade::LateGood,\n            JudgeGrade::TooFast => JudgeGrade::FastGood,\n        },\n        2 => match head_grade {\n            JudgeGrade::Perfect => {\n                if is_late {\n                    JudgeGrade::LateGreat2nd\n                } else {\n                    JudgeGrade::FastGreat2nd\n                }\n            }\n            JudgeGrade::LateGood\n            | JudgeGrade::LateGreat3rd\n            | JudgeGrade::LateGreat2nd\n            | JudgeGrade::LateGreat\n            | JudgeGrade::LatePerfect3rd\n            | JudgeGrade::LatePerfect2nd => JudgeGrade::LateGreat,\n            JudgeGrade::FastPerfect2nd\n            | JudgeGrade::FastPerfect3rd\n            | JudgeGrade::FastGreat\n            | JudgeGrade::FastGreat2nd\n            | JudgeGrade::FastGreat3rd\n            | JudgeGrade::FastGood => JudgeGrade::FastGreat,\n            JudgeGrade::Miss => JudgeGrade::LateGood,\n            JudgeGrade::TooFast => JudgeGrade::FastGood,\n        },\n        3 => match head_grade {\n            JudgeGrade::Perfect => {\n                if is_late {\n                    JudgeGrade::LateGood\n                } else {\n                    JudgeGrade::FastGood\n                }\n            }\n            JudgeGrade::Miss\n            | JudgeGrade::LateGood\n            | JudgeGrade::LateGreat3rd\n            | JudgeGrade::LateGreat2nd\n            | JudgeGrade::LateGreat\n            | JudgeGrade::LatePerfect3rd\n            | JudgeGrade::LatePerfect2nd => JudgeGrade::LateGood,\n            JudgeGrade::FastPerfect2nd\n            | JudgeGrade::FastPerfect3rd\n            | JudgeGrade::FastGreat\n            | JudgeGrade::FastGreat2nd\n            | JudgeGrade::FastGreat3rd\n            | JudgeGrade::FastGood\n            | JudgeGrade::TooFast => JudgeGrade::FastGood,\n        },\n        _ => match head_grade {\n            JudgeGrade::Perfect => {\n                if is_late {\n                    JudgeGrade::LateGood\n                } else {\n                    JudgeGrade::FastGood\n                }\n            }\n            JudgeGrade::LateGood\n            | JudgeGrade::LateGreat3rd\n            | JudgeGrade::LateGreat2nd\n            | JudgeGrade::LateGreat\n            | JudgeGrade::LatePerfect3rd\n            | JudgeGrade::LatePerfect2nd => JudgeGrade::LateGood,\n            JudgeGrade::FastPerfect2nd\n            | JudgeGrade::FastPerfect3rd\n            | JudgeGrade::FastGreat\n            | JudgeGrade::FastGreat2nd\n            | JudgeGrade::FastGreat3rd\n            | JudgeGrade::FastGood => JudgeGrade::FastGood,\n            JudgeGrade::Miss | JudgeGrade::TooFast => head_grade,\n        },\n    }\n}\n\n// ============================================================================\n// Hold Classic End Judgment\n// From NoteLongDrop.HoldClassicEndJudge(), lines 257-307\n// ============================================================================\n\n/// Classic hold end judge: evaluates release timing independently,\n/// then takes the WORSE of head grade vs end grade.\npub fn judge_hold_classic_end(\n    head_grade: JudgeGrade,\n    timing: i64,\n    length: Duration,\n    release_timing: i64,\n) -> JudgeGrade {\n    if head_grade.is_miss_or_too_fast() {\n        return head_grade;\n    }\n\n    let diff = Duration {\n        micros: timing + length.micros - release_timing,\n    };\n    let is_fast = diff.micros > 0;\n    let abs_diff = diff.abs();\n\n    let end_grade = if is_fast {\n        if abs_diff.micros < HOLD_CLASSIC_END_JUDGE_PERFECT_FAST.micros {\n            JudgeGrade::Perfect\n        } else {\n            JudgeGrade::FastGood\n        }\n    } else {\n        if abs_diff.micros < HOLD_CLASSIC_END_JUDGE_PERFECT_LATE.micros {\n            JudgeGrade::Perfect\n        } else {\n            JudgeGrade::LateGood\n        }\n    };\n\n    let head_dist = head_grade.dist_from_perfect();\n    let end_dist = end_grade.dist_from_perfect();\n    if end_dist > head_dist {\n        end_grade\n    } else {\n        head_grade\n    }\n}\n\n/// Check if a slide is too late\npub fn is_too_late_slide(diff: Duration, user_offset: Duration) -> bool {\n    let min_offset = if user_offset.micros < 0 {\n        user_offset\n    } else {\n        Duration::zero()\n    };\n    let threshold = Duration {\n        micros: SLIDE_GOOD.micros + min_offset.micros,\n    };\n    diff.micros > threshold.micros\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn test_judge_tap_perfect() {\n        assert_eq!(\n            judge_tap(Duration::from_micros(0), false),\n            JudgeGrade::Perfect\n        );\n        assert_eq!(\n            judge_tap(Duration::from_micros(10000), false),\n            JudgeGrade::Perfect\n        );\n    }\n\n    #[test]\n    fn test_judge_tap_ex() {\n        assert_eq!(\n            judge_tap(Duration::from_micros(100000), true),\n            JudgeGrade::Perfect\n        );\n    }\n\n    #[test]\n    fn test_judge_slide_too_late() {\n        assert_eq!(judge_slide_too_late(1), JudgeGrade::LateGood);\n        assert_eq!(judge_slide_too_late(2), JudgeGrade::Miss);\n    }\n\n    #[test]\n    fn test_correct_slide_grade() {\n        assert_eq!(\n            correct_slide_grade(JudgeGrade::LatePerfect2nd),\n            JudgeGrade::Perfect\n        );\n        assert_eq!(\n            correct_slide_grade(JudgeGrade::LateGreat),\n            JudgeGrade::LateGreat\n        );\n    }\n}\n"},{"id":10,"name":{"Local":"crates/lnmai-core-verify/src/judgment_adapter.rs"},"crate_name":"lnmai_core_verify","contents":"//! Exact-integer adapters shared with the runtime judgment API.\n//!\n//! Integer representation and individual arithmetic operations remain outside\n//! extraction. Clamping, exact hold formulas, percentage selection and calls\n//! into the existing judgment/time/score kernels live here.\n\nuse super::{\n    judge, score,\n    time::Duration,\n    types::{JudgeDisplayOption, JudgeGrade},\n};\n\n/// Each method denotes one exact integer operation, with no machine-width\n/// reduction. `less` is strict integer order, `equal` is integer equality,\n/// and `min`/`max` return the corresponding integer value. `to_i64` returns\n/// `Some(n)` exactly when the represented integer is the representable `n`;\n/// it returns `None` outside the i64 range. Implementations must be pure.\n/// No method performs a judgment, clamp, or compound hold calculation.\n#[allow(clippy::wrong_self_convention)]\npub trait IntegerOps<I> {\n    fn from_i64(&self, value: i64) -> I;\n    fn less(&self, left: &I, right: &I) -> bool;\n    fn equal(&self, left: &I, right: &I) -> bool;\n    fn add(&self, left: &I, right: &I) -> I;\n    fn sub(&self, left: &I, right: &I) -> I;\n    fn mul_i64(&self, value: &I, factor: i64) -> I;\n    fn min(&self, left: &I, right: &I) -> I;\n    fn max(&self, left: &I, right: &I) -> I;\n    fn to_i64(&self, value: &I) -> Option<i64>;\n}\n\n/// Clamp to an inclusive interval, whose callers must supply ordered ends.\n/// Taking both ends explicitly avoids negating an arbitrary i64 limit.\n/// Conversion occurs only after the exact comparisons establish its range.\n/// A failed conversion remains a failure, never a truncated/fallback value.\npub fn bounded<I, Ops: IntegerOps<I>>(value: &I, lower: i64, upper: i64, ops: &Ops) -> i64 {\n    if ops.less(value, &ops.from_i64(lower)) {\n        lower\n    } else if ops.less(&ops.from_i64(upper), value) {\n        upper\n    } else {\n        match ops.to_i64(value) {\n            Some(value) => value,\n            None => panic!(\"value lies in the checked i64 interval\"),\n        }\n    }\n}\n\n/// The endpoints lie beyond every fixed judgment threshold, preserve zero\n/// and sign, and keep the bounded kernels' absolute values safe.\npub fn diff_rep<I, Ops: IntegerOps<I>>(value: &I, ops: &Ops) -> Duration {\n    Duration::from_micros(bounded(value, -1_000_000, 1_000_000, ops))\n}\n\npub fn judge_tap<I, Ops: IntegerOps<I>>(diff: &I, is_ex: bool, ops: &Ops) -> JudgeGrade {\n    judge::judge_tap(diff_rep(diff, ops), is_ex)\n}\n\npub fn judge_touch<I, Ops: IntegerOps<I>>(diff: &I, is_ex: bool, ops: &Ops) -> Option<JudgeGrade> {\n    judge::judge_touch(diff_rep(diff, ops), is_ex)\n}\n\npub fn judge_slide_classic<I, Ops: IntegerOps<I>>(diff: &I, ops: &Ops) -> JudgeGrade {\n    judge::judge_slide_classic(diff_rep(diff, ops))\n}\n\npub fn judge_slide_modern<I, Ops: IntegerOps<I>>(\n    diff: &I,\n    stay: &I,\n    is_ex: bool,\n    ops: &Ops,\n) -> JudgeGrade {\n    // Below the lower bound all perfect windows are negative; above the\n    // upper bound the extension is capped. Division remains in the existing\n    // time kernel, including its Euclidean treatment of negative values.\n    judge::judge_slide_modern(\n        diff_rep(diff, ops),\n        Duration::from_micros(bounded(stay, -4_000_000, 4_000_000, ops)),\n        is_ex,\n    )\n}\n\n/// Only equality with one matters; no arbitrary integer is narrowed to u32.\npub fn judge_slide_too_late<I, Ops: IntegerOps<I>>(remaining: &I, ops: &Ops) -> JudgeGrade {\n    let representative = if ops.equal(remaining, &ops.from_i64(1)) {\n        1\n    } else {\n        0\n    };\n    judge::judge_slide_too_late(representative)\n}\n\npub fn is_too_late_slide<I, Ops: IntegerOps<I>>(diff: &I, user_offset: &I, ops: &Ops) -> bool {\n    let zero = ops.from_i64(0);\n    let min_offset = ops.min(user_offset, &zero);\n    // diff > 600012 + min_offset iff diff - min_offset > 600012.\n    // Subtract exactly before clamping: large inputs can cancel near the\n    // boundary, so independently clamping diff and offset would be wrong.\n    let adjusted_diff = ops.sub(diff, &min_offset);\n    judge::is_too_late_slide(diff_rep(&adjusted_diff, ops), Duration::zero())\n}\n\n/// Exact cross-multiplication in the original first-matching band order.\n/// No division, rounding, bounded products, or formula callback is used.\npub fn press_band_micros<I, Ops: IntegerOps<I>>(held: &I, reality: &I, ops: &Ops) -> u32 {\n    if !ops.less(held, reality) {\n        0\n    } else if !ops.less(&ops.mul_i64(held, 100), &ops.mul_i64(reality, 67)) {\n        1\n    } else if !ops.less(&ops.mul_i64(held, 100), &ops.mul_i64(reality, 33)) {\n        2\n    } else if !ops.less(&ops.mul_i64(held, 100), &ops.mul_i64(reality, 5)) {\n        3\n    } else {\n        4\n    }\n}\n\npub fn judge_hold_end<I, Ops: IntegerOps<I>>(\n    head: JudgeGrade,\n    diff: &I,\n    length: &I,\n    ignore: &I,\n    release: &I,\n    ops: &Ops,\n) -> JudgeGrade {\n    let zero = ops.from_i64(0);\n    let maximum_raw = ops.sub(length, &ops.from_i64(300000));\n    let maximum = ops.max(&maximum_raw, &zero);\n    let reality_raw = ops.sub(length, ignore);\n    let nonnegative_reality = ops.max(&reality_raw, &zero);\n    let reality = ops.min(&nonnegative_reality, &maximum);\n    if !ops.less(&zero, &reality) {\n        return head;\n    }\n    let held_raw = ops.sub(&reality, release);\n    let held = ops.max(&held_raw, &zero);\n    let band = press_band_micros(&held, &reality, ops);\n    judge::hold_band_grade(head, !ops.less(diff, &zero), band)\n}\n\npub fn judge_hold_classic_end<I, Ops: IntegerOps<I>>(\n    head: JudgeGrade,\n    timing: &I,\n    length: &I,\n    release: &I,\n    ops: &Ops,\n) -> JudgeGrade {\n    let end = ops.add(timing, length);\n    let diff = ops.sub(&end, release);\n    judge::judge_hold_classic_end(\n        head,\n        bounded(&diff, -1_000_000, 1_000_000, ops),\n        Duration::zero(),\n        0,\n    )\n}\n\npub fn count_fast_late<I, Ops: IntegerOps<I>>(\n    grade: JudgeGrade,\n    diff: &I,\n    display: JudgeDisplayOption,\n    ops: &Ops,\n) -> (bool, bool) {\n    score::count_fast_late(grade, diff_rep(diff, ops), display)\n}\n"},{"id":11,"name":{"Local":"crates/lnmai-core-verify/src/lifecycle.rs"},"crate_name":"lnmai_core_verify","contents":"//! Note transitions and slide checkpoint history, shared with the runtime.\n//!\n//! Progress values are opaque: the runtime supplies its unbounded `Natural`,\n//! while the checkpoint logic only preserves those values.\n\nuse crate::areas::SensorArea;\nuse crate::convert::convert_grade;\nuse crate::storage::SensorVec;\nuse crate::types::{AreaPolicy, JudgeGrade, JudgeStyle};\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum TapState {\n    #[default]\n    Waiting,\n    Judgeable,\n    Judged(JudgeGrade),\n    Ended,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum TapAction {\n    NoEvent,\n    Miss,\n    Judge,\n}\n\n/// Tap and star-head control flow. The runtime computes both time predicates\n/// with arbitrary-precision arithmetic and attaches the selected event.\npub fn tap_transition(\n    state: TapState,\n    too_late: bool,\n    can_judge: bool,\n    input_clicked: bool,\n) -> (TapState, TapAction) {\n    match state {\n        TapState::Waiting => {\n            if too_late {\n                (TapState::Ended, TapAction::Miss)\n            } else if can_judge {\n                if input_clicked {\n                    (TapState::Ended, TapAction::Judge)\n                } else {\n                    (TapState::Judgeable, TapAction::NoEvent)\n                }\n            } else {\n                (state, TapAction::NoEvent)\n            }\n        }\n        TapState::Judgeable => {\n            if too_late {\n                (TapState::Ended, TapAction::Miss)\n            } else if input_clicked && can_judge {\n                (TapState::Ended, TapAction::Judge)\n            } else {\n                (state, TapAction::NoEvent)\n            }\n        }\n        TapState::Judged(_) | TapState::Ended => (state, TapAction::NoEvent),\n    }\n}\n\npub fn accepted_input_engages_judge(input_clicked: bool) -> bool {\n    input_clicked\n}\n\n#[derive(Debug, Clone, PartialEq, Eq, Default)]\npub enum TouchState {\n    #[default]\n    Waiting,\n    Judgeable,\n    Judged(JudgeGrade),\n    Ended,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum TouchAction {\n    NoEvent,\n    Miss,\n    Shared,\n    Judge,\n}\n\n/// Select the touch action before evaluating a local judgment. Shared results\n/// precede local input, but an expired note always emits its timeout miss.\npub fn touch_transition(\n    state: TouchState,\n    too_late: bool,\n    can_judge: bool,\n    input_clicked: bool,\n    has_shared: bool,\n) -> (TouchState, TouchAction) {\n    match state {\n        TouchState::Waiting => {\n            if too_late {\n                (TouchState::Ended, TouchAction::Miss)\n            } else if has_shared {\n                (TouchState::Ended, TouchAction::Shared)\n            } else if can_judge {\n                if input_clicked {\n                    (TouchState::Judgeable, TouchAction::Judge)\n                } else {\n                    (TouchState::Judgeable, TouchAction::NoEvent)\n                }\n            } else {\n                (state, TouchAction::NoEvent)\n            }\n        }\n        TouchState::Judgeable => {\n            if too_late {\n                (TouchState::Ended, TouchAction::Miss)\n            } else if has_shared {\n                (TouchState::Ended, TouchAction::Shared)\n            } else if input_clicked {\n                (TouchState::Judgeable, TouchAction::Judge)\n            } else {\n                (state, TouchAction::NoEvent)\n            }\n        }\n        TouchState::Judged(_) | TouchState::Ended => (state, TouchAction::NoEvent),\n    }\n}\n\n/// A too-early local touch stays judgeable and emits no result.\npub fn finish_touch_judgment(\n    raw: Option<JudgeGrade>,\n    style: JudgeStyle,\n) -> (TouchState, Option<JudgeGrade>) {\n    match raw {\n        Some(grade) => (TouchState::Ended, Some(convert_grade(style, grade))),\n        None => (TouchState::Judgeable, None),\n    }\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum HoldSubState {\n    #[default]\n    HeadWaiting,\n    HeadJudgeable,\n    HeadJudged(JudgeGrade),\n    BodyHeld,\n    BodyReleased,\n    Ended(JudgeGrade),\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum HoldHeadAction {\n    Unchanged,\n    MakeJudgeable,\n    Miss,\n    Shared,\n    JudgeTap,\n    JudgeTouch,\n}\n\n/// The head priority depends on both family and state. In particular, an\n/// already judgeable regular hold accepts its click before checking timeout.\npub fn hold_head_action(\n    state: HoldSubState,\n    is_touch_hold: bool,\n    too_late: bool,\n    can_judge: bool,\n    clicked: bool,\n    has_shared: bool,\n) -> HoldHeadAction {\n    match state {\n        HoldSubState::HeadWaiting => {\n            if too_late {\n                HoldHeadAction::Miss\n            } else if is_touch_hold && has_shared {\n                HoldHeadAction::Shared\n            } else if can_judge {\n                if clicked {\n                    if is_touch_hold {\n                        HoldHeadAction::JudgeTouch\n                    } else {\n                        HoldHeadAction::JudgeTap\n                    }\n                } else {\n                    HoldHeadAction::MakeJudgeable\n                }\n            } else {\n                HoldHeadAction::Unchanged\n            }\n        }\n        HoldSubState::HeadJudgeable => {\n            if is_touch_hold {\n                if too_late {\n                    HoldHeadAction::Miss\n                } else if has_shared {\n                    HoldHeadAction::Shared\n                } else if clicked && can_judge {\n                    HoldHeadAction::JudgeTouch\n                } else {\n                    HoldHeadAction::Unchanged\n                }\n            } else if clicked && can_judge {\n                HoldHeadAction::JudgeTap\n            } else if too_late {\n                HoldHeadAction::Miss\n            } else {\n                HoldHeadAction::Unchanged\n            }\n        }\n        _ => HoldHeadAction::Unchanged,\n    }\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum HoldBodyAction {\n    Unchanged,\n    EndNow(JudgeGrade),\n    EndRelease(JudgeGrade),\n    StartPressed,\n    StartClassicPressed,\n    KeepClassicPressed,\n    KeepPressed,\n    ReleaseHead(JudgeGrade),\n    Release,\n    Recover,\n    ReleasedOff,\n}\n\n/// Head resolution may sample the body immediately or replace head feedback\n/// with a tail event. Shared/missed touch heads without a click wait one frame.\npub fn hold_after_head_action(\n    state: HoldSubState,\n    is_touch_hold: bool,\n    clicked: bool,\n    body_started: bool,\n    reached_end: bool,\n    pressed: bool,\n) -> HoldBodyAction {\n    match state {\n        HoldSubState::HeadJudged(grade) => {\n            if is_touch_hold && !clicked {\n                HoldBodyAction::Unchanged\n            } else if body_started {\n                if reached_end {\n                    HoldBodyAction::EndNow(grade)\n                } else if pressed {\n                    HoldBodyAction::StartPressed\n                } else {\n                    HoldBodyAction::ReleaseHead(grade)\n                }\n            } else {\n                HoldBodyAction::Unchanged\n            }\n        }\n        _ => HoldBodyAction::Unchanged,\n    }\n}\n\n/// All comparisons are evaluated by the runtime using its unbounded times.\n/// No ordering/reachability relationship between these facts is assumed.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct HoldBodyFacts {\n    pub is_classic: bool,\n    pub before_classic_start: bool,\n    pub before_body_start: bool,\n    pub body_window_disabled: bool,\n    pub reached_end: bool,\n    pub classic_limit_reached: bool,\n    pub after_body_end: bool,\n    pub pressed: bool,\n}\n\npub fn hold_body_action(\n    state: HoldSubState,\n    head_grade: JudgeGrade,\n    facts: HoldBodyFacts,\n) -> HoldBodyAction {\n    match state {\n        HoldSubState::HeadJudged(grade) => {\n            if facts.is_classic {\n                if facts.before_classic_start {\n                    HoldBodyAction::Unchanged\n                } else if facts.classic_limit_reached || grade.is_miss_or_too_fast() {\n                    HoldBodyAction::EndNow(grade)\n                } else if facts.pressed {\n                    HoldBodyAction::StartClassicPressed\n                } else {\n                    HoldBodyAction::EndRelease(grade)\n                }\n            } else if facts.before_body_start {\n                HoldBodyAction::Unchanged\n            } else if facts.body_window_disabled {\n                if facts.reached_end {\n                    HoldBodyAction::EndNow(grade)\n                } else {\n                    HoldBodyAction::Unchanged\n                }\n            } else if facts.reached_end {\n                HoldBodyAction::EndNow(grade)\n            } else if facts.after_body_end {\n                HoldBodyAction::Unchanged\n            } else if facts.pressed {\n                HoldBodyAction::StartPressed\n            } else {\n                HoldBodyAction::ReleaseHead(grade)\n            }\n        }\n        HoldSubState::BodyHeld => {\n            if facts.is_classic {\n                if facts.classic_limit_reached || head_grade.is_miss_or_too_fast() {\n                    HoldBodyAction::EndNow(head_grade)\n                } else if facts.pressed {\n                    HoldBodyAction::KeepClassicPressed\n                } else {\n                    HoldBodyAction::EndRelease(head_grade)\n                }\n            } else if facts.body_window_disabled {\n                if facts.reached_end {\n                    HoldBodyAction::EndNow(head_grade)\n                } else {\n                    HoldBodyAction::Unchanged\n                }\n            } else if facts.reached_end {\n                HoldBodyAction::EndNow(head_grade)\n            } else if facts.after_body_end {\n                HoldBodyAction::Unchanged\n            } else if facts.pressed {\n                HoldBodyAction::KeepPressed\n            } else {\n                HoldBodyAction::Release\n            }\n        }\n        HoldSubState::BodyReleased => {\n            // Restored Classic BodyReleased states follow this branch too.\n            if facts.body_window_disabled {\n                if facts.reached_end {\n                    HoldBodyAction::EndNow(head_grade)\n                } else {\n                    HoldBodyAction::Unchanged\n                }\n            } else if facts.reached_end {\n                HoldBodyAction::EndNow(head_grade)\n            } else if facts.after_body_end {\n                HoldBodyAction::Unchanged\n            } else if facts.pressed {\n                HoldBodyAction::Recover\n            } else {\n                HoldBodyAction::ReleasedOff\n            }\n        }\n        _ => HoldBodyAction::Unchanged,\n    }\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct SlideArea<P> {\n    pub target_areas: Vec<SensorArea>,\n    pub policy: AreaPolicy,\n    pub is_last: bool,\n    pub is_skippable: bool,\n    pub arrow_progress_when_on: P,\n    pub arrow_progress_when_finished: P,\n    pub was_on: bool,\n    pub was_off: bool,\n    pub target_was_on: Vec<bool>,\n    pub target_was_off: Vec<bool>,\n}\n\nimpl<P: Default> Default for SlideArea<P> {\n    fn default() -> Self {\n        Self {\n            target_areas: Vec::new(),\n            policy: AreaPolicy::Or,\n            is_last: false,\n            // Lean's derived Inhabited uses Bool.default, not the field initializer.\n            is_skippable: false,\n            arrow_progress_when_on: P::default(),\n            arrow_progress_when_finished: P::default(),\n            was_on: false,\n            was_off: false,\n            target_was_on: Vec::new(),\n            target_was_off: Vec::new(),\n        }\n    }\n}\n\nfn history_any(history: &[bool]) -> bool {\n    let mut result = false;\n    let mut i = 0;\n    while i < history.len() {\n        result = result || history[i];\n        i += 1;\n    }\n    result\n}\n\n// Lean zips the histories even for malformed restored states. In particular,\n// AND over an empty zip is true; it does not pad the shorter history.\nfn history_finished(on: &[bool], off: &[bool], is_last: bool, policy: AreaPolicy) -> bool {\n    let mut result = match policy {\n        AreaPolicy::Or => false,\n        AreaPolicy::And => true,\n    };\n    let mut i = 0;\n    while i < on.len() && i < off.len() {\n        let finished = on[i] && (is_last || off[i]);\n        result = match policy {\n            AreaPolicy::Or => result || finished,\n            AreaPolicy::And => result && finished,\n        };\n        i += 1;\n    }\n    result\n}\n\nfn history_get(history: &[bool], index: usize) -> bool {\n    if index < history.len() {\n        history[index]\n    } else {\n        false\n    }\n}\n\nfn target_history(\n    targets: &[SensorArea],\n    was_on: &[bool],\n    was_off: &[bool],\n    sensor_held: &SensorVec<bool>,\n) -> (Vec<bool>, Vec<bool>) {\n    let mut on = Vec::new();\n    let mut off = Vec::new();\n    let mut i = 0;\n    while i < targets.len() {\n        let old_on = history_get(was_on, i);\n        let old_off = history_get(was_off, i);\n        let held = sensor_held.get_d(targets[i], false);\n        let new_on = old_on || held;\n        let new_off = old_off || (old_on && !held);\n        on.push(new_on);\n        off.push(new_off);\n        i += 1;\n    }\n    (on, off)\n}\n\n// Aeneas models Vec::len; Vec::is_empty is currently an opaque external call.\n#[allow(clippy::len_zero)]\nimpl<P> SlideArea<P> {\n    pub fn on(&self) -> bool {\n        self.was_on\n    }\n\n    pub fn is_finished(&self) -> bool {\n        if self.target_areas.len() == 0 {\n            false\n        } else if self.target_was_on.len() == 0 {\n            self.was_on && (self.is_last || self.was_off)\n        } else {\n            history_finished(\n                &self.target_was_on,\n                &self.target_was_off,\n                self.is_last,\n                self.policy,\n            )\n        }\n    }\n}\n\n// Keep singleton construction and emptiness checks within the extracted model.\n#[allow(clippy::len_zero, clippy::vec_init_then_push)]\nimpl<P: Clone> SlideArea<P> {\n    pub fn check(&self, sensor_held: &SensorVec<bool>) -> Self {\n        let source_on = if self.target_was_on.len() == 0 && self.target_areas.len() == 1 {\n            let mut history = Vec::new();\n            history.push(self.was_on);\n            history\n        } else {\n            self.target_was_on.clone()\n        };\n        let source_off = if self.target_was_off.len() == 0 && self.target_areas.len() == 1 {\n            let mut history = Vec::new();\n            history.push(self.was_off);\n            history\n        } else {\n            self.target_was_off.clone()\n        };\n        let (target_was_on, target_was_off) =\n            target_history(&self.target_areas, &source_on, &source_off, sensor_held);\n        let was_on = history_any(&target_was_on);\n        let was_off = match self.policy {\n            AreaPolicy::Or => {\n                history_finished(&target_was_on, &target_was_off, false, AreaPolicy::Or)\n            }\n            AreaPolicy::And => {\n                self.target_areas.len() != 0\n                    && history_finished(&target_was_on, &target_was_off, false, AreaPolicy::And)\n            }\n        };\n        Self {\n            was_on,\n            was_off,\n            target_was_on,\n            target_was_off,\n            ..self.clone()\n        }\n    }\n}\n"},{"id":12,"name":{"Local":"crates/lnmai-core-verify/src/maidata_line_adapter.rs"},"crate_name":"lnmai_core_verify","contents":"//! Concrete Maidata line dictionaries shared by extraction and the runtime.\n//!\n//! Indexed reads, header field access, chart construction/update and both Vec\n//! pushes live here. The caller supplies only operations on one text or view;\n//! no primitive receives a line collection, cursor, chart, or scan result.\n\nuse crate::maidata_scan::{LineRead, LineWrite};\n\n/// Same field order, derives and struct name as the former runtime record.\n#[derive(Debug, Clone, PartialEq, Eq, Default)]\npub struct MaidataChartBlock<Text, Level> {\n    pub level_index: Level,\n    pub raw_body: Text,\n}\n\n/// Single-text boundary. Views borrow from the supplied text/view, not from\n/// this primitive dictionary. Runtime uses Text = String, View = str, and\n/// Level = Natural. Borrowing and trimming allocate nothing.\n///\n/// `trim` removes only U+0020, U+0009, U+000A and U+000D. `header` retains the\n/// existing first-'=' helper, including its key-before-value allocations.\n/// `level` retains strip_prefix(\"&inote_\")/Natural parsing/default on one key.\n/// These are explicit primitive contracts, not claims about arbitrary Ops.\npub trait LinePrimitives<Text> {\n    type View: ?Sized;\n    type Level;\n\n    fn borrow<'a>(&self, text: &'a Text) -> &'a Self::View;\n    fn trim<'a>(&self, view: &'a Self::View) -> &'a Self::View;\n    fn is_empty(&self, view: &Self::View) -> bool;\n    fn starts_with_amp(&self, view: &Self::View) -> bool;\n    fn starts_with_inote(&self, view: &Self::View) -> bool;\n    fn header(&self, view: &Self::View) -> Option<(Text, Text)>;\n    fn level(&self, view: &Self::View) -> Self::Level;\n    fn push_newline(&self, text: &mut Text);\n    fn push_str(&self, text: &mut Text, view: &Self::View);\n}\n\n/// The source slice stays borrowed; no line or existing output is cloned.\npub struct MaidataLineOps<'a, Text, Ops> {\n    pub lines: &'a [Text],\n    pub primitives: Ops,\n}\n\nimpl<Text, Ops> LineRead<(Text, Text)> for MaidataLineOps<'_, Text, Ops>\nwhere\n    Ops: LinePrimitives<Text>,\n{\n    fn is_blank(&self, index: usize) -> bool {\n        let view = self.primitives.borrow(&self.lines[index]);\n        self.primitives.is_empty(self.primitives.trim(view))\n    }\n\n    fn starts_with_amp(&self, index: usize) -> bool {\n        let view = self.primitives.borrow(&self.lines[index]);\n        self.primitives.starts_with_amp(self.primitives.trim(view))\n    }\n\n    fn header(&self, index: usize) -> Option<(Text, Text)> {\n        // Split the original line; do not trim the whole line first.\n        self.primitives\n            .header(self.primitives.borrow(&self.lines[index]))\n    }\n\n    fn is_chart_header(&self, header: &(Text, Text)) -> bool {\n        self.primitives\n            .starts_with_inote(self.primitives.borrow(&header.0))\n    }\n}\n\nimpl<Text, Ops>\n    LineWrite<\n        (Text, Text),\n        Vec<(Text, Text)>,\n        Vec<MaidataChartBlock<Text, Ops::Level>>,\n        MaidataChartBlock<Text, Ops::Level>,\n    > for MaidataLineOps<'_, Text, Ops>\nwhere\n    Ops: LinePrimitives<Text>,\n{\n    fn append_field(\n        &self,\n        mut fields: Vec<(Text, Text)>,\n        header: (Text, Text),\n    ) -> Vec<(Text, Text)> {\n        fields.push(header);\n        fields\n    }\n\n    fn begin_chart(&self, header: (Text, Text)) -> MaidataChartBlock<Text, Ops::Level> {\n        let (key, value) = header;\n        let level_index = self.primitives.level(self.primitives.borrow(&key));\n        MaidataChartBlock {\n            level_index,\n            raw_body: value,\n        }\n    }\n\n    fn append_body_line(\n        &self,\n        mut body: MaidataChartBlock<Text, Ops::Level>,\n        index: usize,\n    ) -> MaidataChartBlock<Text, Ops::Level> {\n        // Keep newline mutation/allocation before even indexing the input.\n        self.primitives.push_newline(&mut body.raw_body);\n        self.primitives.push_str(\n            &mut body.raw_body,\n            self.primitives.borrow(&self.lines[index]),\n        );\n        body\n    }\n\n    fn append_chart(\n        &self,\n        mut charts: Vec<MaidataChartBlock<Text, Ops::Level>>,\n        body: MaidataChartBlock<Text, Ops::Level>,\n    ) -> Vec<MaidataChartBlock<Text, Ops::Level>> {\n        charts.push(body);\n        charts\n    }\n}\n"},{"id":13,"name":{"Local":"crates/lnmai-core-verify/src/maidata_scan.rs"},"crate_name":"lnmai_core_verify","contents":"//! Maidata line and consecutive-event scans shared with the runtime facade.\n//! All cursors refer to one immutable input; no operation owns a remaining tail.\n//! UTF-8/header parsing, exact event keys, Natural ids and container writes are\n//! point adapters. No adapter may collect a chart body or process a token group.\n\n/// Half-open input interval. Kernels construct start <= end <= input length.\npub struct Span {\n    pub start: usize,\n    pub end: usize,\n}\n\n/// Reads inspect one line or one already-parsed header. `header` splits only\n/// at the first '=' and trims its two fields; it never reads subsequent lines.\npub trait LineRead<Header> {\n    fn is_blank(&self, index: usize) -> bool;\n    fn starts_with_amp(&self, index: usize) -> bool;\n    fn header(&self, index: usize) -> Option<Header>;\n    fn is_chart_header(&self, header: &Header) -> bool;\n}\n\n/// Each write appends one item or one line. `begin_chart` retains the header's\n/// value as the initial body and parses its level, with invalid suffix -> zero.\n/// `append_body_line` adds exactly '\\n' then the ORIGINAL, untrimmed input line.\n/// `append_chart` merely appends the already assembled body/level record.\npub trait LineWrite<Header, Fields, Charts, Body> {\n    fn append_field(&self, fields: Fields, header: Header) -> Fields;\n    fn begin_chart(&self, header: Header) -> Body;\n    fn append_body_line(&self, body: Body, index: usize) -> Body;\n    fn append_chart(&self, charts: Charts, body: Body) -> Charts;\n}\n\npub enum LinePlan<Header> {\n    Skip(usize),\n    Metadata(Header, usize),\n    Chart(Header, Span),\n}\n\n/// Find the first following '&' line without consuming it. Require start <= len\n/// and len equal to the borrowed source length. Empty/whitespace body lines stay.\npub fn chart_body_end<Header, Ops>(len: usize, start: usize, ops: &Ops) -> usize\nwhere\n    Ops: LineRead<Header>,\n{\n    let mut cursor = start;\n    while cursor < len {\n        if ops.starts_with_amp(cursor) {\n            break;\n        }\n        cursor += 1;\n    }\n    cursor\n}\n\n/// One header decision and its precise next cursor. Require cursor < len.\n/// Blank takes priority; non-'&' lines outside a chart body are ignored.\npub fn plan_line<Header, Ops>(len: usize, cursor: usize, ops: &Ops) -> LinePlan<Header>\nwhere\n    Ops: LineRead<Header>,\n{\n    // cursor < len <= usize::MAX establishes that this increment is safe.\n    let next = cursor + 1;\n    if ops.is_blank(cursor) {\n        LinePlan::Skip(next)\n    } else if ops.starts_with_amp(cursor) {\n        match ops.header(cursor) {\n            None => LinePlan::Skip(next),\n            Some(header) => {\n                if ops.is_chart_header(&header) {\n                    let end = chart_body_end::<Header, Ops>(len, next, ops);\n                    LinePlan::Chart(header, Span { start: next, end })\n                } else {\n                    LinePlan::Metadata(header, next)\n                }\n            }\n        }\n    } else {\n        LinePlan::Skip(next)\n    }\n}\n\n/// Full line collection. Output prefixes are FORWARD, unlike the original\n/// Lean helper's reverse accumulators. Public runtime entry supplies empty ones.\n/// Repeated metadata keys and chart levels remain distinct ordered appends.\npub fn collect_lines<Header, Fields, Charts, Body, Ops>(\n    len: usize,\n    mut fields: Fields,\n    mut charts: Charts,\n    ops: Ops,\n) -> (Fields, Charts)\nwhere\n    Ops: LineRead<Header> + LineWrite<Header, Fields, Charts, Body>,\n{\n    let mut cursor = 0usize;\n    while cursor < len {\n        match plan_line::<Header, Ops>(len, cursor, &ops) {\n            LinePlan::Skip(next) => cursor = next,\n            LinePlan::Metadata(header, next) => {\n                fields = ops.append_field(fields, header);\n                cursor = next;\n            }\n            LinePlan::Chart(header, range) => {\n                let mut body = ops.begin_chart(header);\n                let mut line = range.start;\n                while line < range.end {\n                    body = ops.append_body_line(body, line);\n                    line += 1;\n                }\n                charts = ops.append_chart(charts, body);\n                cursor = range.end;\n            }\n        }\n    }\n    (fields, charts)\n}\n\n/// Only distinctions used by the Each classifier; all other kinds are Other.\npub enum TouchKind {\n    Slide,\n    Touch,\n    TouchHold,\n    Other,\n}\n\n/// Each read observes one token, or compares the exact event-key fields of two\n/// tokens. `same_event` performs no scan and may not depend on group metadata.\npub trait TouchRead {\n    fn same_event(&self, head: usize, index: usize) -> bool;\n    fn kind(&self, index: usize) -> TouchKind;\n    fn source_group_index_nonzero(&self, index: usize) -> bool;\n    fn is_slide_no_head(&self, index: usize) -> bool;\n}\n\n/// Append exactly one source token, either unchanged or changing only the three\n/// group fields. GroupId remains arbitrary precision; it is never cast to usize.\n/// The two bounded usize fields are converted exactly by the runtime adapter.\npub trait TouchWrite<GroupId, Output> {\n    fn append_unchanged(&self, output: Output, source: usize) -> Output;\n    fn append_tagged(\n        &self,\n        output: Output,\n        source: usize,\n        group_id: &GroupId,\n        group_index: usize,\n        group_size: usize,\n    ) -> Output;\n    fn next_group(&self, group_id: GroupId) -> GroupId;\n}\n\npub struct TouchGroupPlan {\n    pub range: Span,\n    pub timing_note_count: usize,\n    pub no_head_slide_count: usize,\n}\n\n/// Include the head unconditionally, then stop at the FIRST different event.\n/// Equal event keys after that boundary belong to a later group. Require start < len.\npub fn same_event_end<Ops>(len: usize, start: usize, ops: &Ops) -> usize\nwhere\n    Ops: TouchRead,\n{\n    let mut end = start + 1;\n    while end < len {\n        if !ops.same_event(start, end) {\n            break;\n        }\n        end += 1;\n    }\n    end\n}\n\n/// Range discovery and both counters are kernel control flow, not callbacks.\n/// Expanded slide children contribute to neither count, including headless ones.\npub fn plan_touch_group<Ops>(len: usize, start: usize, ops: &Ops) -> TouchGroupPlan\nwhere\n    Ops: TouchRead,\n{\n    let end = same_event_end(len, start, ops);\n    let mut cursor = start;\n    let mut timing_note_count = 0usize;\n    let mut no_head_slide_count = 0usize;\n    while cursor < end {\n        match ops.kind(cursor) {\n            TouchKind::Slide => {\n                if !ops.source_group_index_nonzero(cursor) {\n                    timing_note_count += 1;\n                    if ops.is_slide_no_head(cursor) {\n                        no_head_slide_count += 1;\n                    }\n                }\n            }\n            _ => timing_note_count += 1,\n        }\n        cursor += 1;\n    }\n    TouchGroupPlan {\n        range: Span { start, end },\n        timing_note_count,\n        no_head_slide_count,\n    }\n}\n\n/// Emit this range once, in source order, preserving all untagged payloads.\n/// Only tagged tokens advance group_index; group_size is the timing count.\npub fn emit_touch_group<GroupId, Output, Ops>(\n    plan: &TouchGroupPlan,\n    group_id: &GroupId,\n    mut output: Output,\n    ops: &Ops,\n) -> Output\nwhere\n    Ops: TouchRead + TouchWrite<GroupId, Output>,\n{\n    let non_no_head_count = plan\n        .timing_note_count\n        .saturating_sub(plan.no_head_slide_count);\n    let touch_is_each = plan.timing_note_count > 1 && non_no_head_count != 1;\n    let touch_hold_is_each = plan.timing_note_count > 1;\n    let mut cursor = plan.range.start;\n    let mut group_index = 0usize;\n    while cursor < plan.range.end {\n        let should_tag = match ops.kind(cursor) {\n            TouchKind::Touch => touch_is_each,\n            TouchKind::TouchHold => touch_hold_is_each,\n            _ => false,\n        };\n        if should_tag {\n            output = ops.append_tagged(\n                output,\n                cursor,\n                group_id,\n                group_index,\n                plan.timing_note_count,\n            );\n            group_index += 1;\n        } else {\n            output = ops.append_unchanged(output, cursor);\n        }\n        cursor += 1;\n    }\n    output\n}\n\n/// Consecutive groups only. Each iteration consumes at least its head, even if\n/// no token is tagged. Output grows by exactly len items; no tail is copied.\npub fn annotate_touch_each<GroupId, Output, Ops>(\n    len: usize,\n    mut group_id: GroupId,\n    mut output: Output,\n    ops: Ops,\n) -> Output\nwhere\n    Ops: TouchRead + TouchWrite<GroupId, Output>,\n{\n    let mut cursor = 0usize;\n    while cursor < len {\n        let plan = plan_touch_group(len, cursor, &ops);\n        output = emit_touch_group(&plan, &group_id, output, &ops);\n        cursor = plan.range.end;\n        group_id = ops.next_group(group_id);\n    }\n    output\n}\n"},{"id":14,"name":{"Local":"crates/lnmai-core-verify/src/natural_parser.rs"},"crate_name":"lnmai_core_verify","contents":"//! Decimal syntax shared with `Natural::from_lean_str`.\n//! The accumulator stays generic so the runtime retains unbounded BigUint\n//! arithmetic. UTF-8 decoding and allocation are outside this character kernel.\n\n/// Lean `Char.isDigit` accepts precisely the ten ASCII decimal digits.\npub fn decimal_digit(c: char) -> Option<u8> {\n    // Explicit comparisons also avoid a char-valued switch in Charon/Aeneas.\n    if c == '0' {\n        Some(0)\n    } else if c == '1' {\n        Some(1)\n    } else if c == '2' {\n        Some(2)\n    } else if c == '3' {\n        Some(3)\n    } else if c == '4' {\n        Some(4)\n    } else if c == '5' {\n        Some(5)\n    } else if c == '6' {\n        Some(6)\n    } else if c == '7' {\n        Some(7)\n    } else if c == '8' {\n        Some(8)\n    } else if c == '9' {\n        Some(9)\n    } else {\n        None\n    }\n}\n\n/// Parse decimal digits with a single underscore allowed only between digits.\n/// `zero` constructs zero; `append(value, digit)` computes value * 10 + digit.\n/// The scan itself rejects empty input, signs, whitespace, non-ASCII digits,\n/// and leading, trailing, or repeated underscores.\n#[allow(clippy::question_mark)]\npub fn parse_decimal<T, Z, F>(chars: &[char], zero: Z, append: F) -> Option<T>\nwhere\n    Z: Fn() -> T,\n    F: Fn(T, u8) -> T,\n{\n    let mut value = zero();\n    let mut last_was_digit = false;\n    let mut index = 0usize;\n    while index < chars.len() {\n        let c = chars[index];\n        if c == '_' {\n            if !last_was_digit {\n                return None;\n            }\n            last_was_digit = false;\n        } else {\n            let digit = match decimal_digit(c) {\n                Some(digit) => digit,\n                None => return None,\n            };\n            value = append(value, digit);\n            last_was_digit = true;\n        }\n        index += 1;\n    }\n    if last_was_digit {\n        Some(value)\n    } else {\n        None\n    }\n}\n"},{"id":15,"name":{"Local":"crates/lnmai-core-verify/src/prefix_directives.rs"},"crate_name":"lnmai_core_verify","contents":"//! One Simai prefix directive, using Unicode scalar indices only.\n//!\n//! Mirrors stripPrefixDirectives: ASCII trim, inspect the first character,\n//! discard through the FIRST corresponding closer, then ASCII trim once more.\n//! An unclosed directive yields empty text; a second directive is not parsed.\n//! All scanning, branch decisions and output copying live in this module.\n//! String decoding/encoding stays at the runtime boundary.\n//!\n//! Source draft: not compiled or extracted. Helpers taking a range are private;\n//! their caller maintains begin <= end <= chars.len().\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct PrefixRange {\n    pub begin: usize,\n    pub end: usize,\n}\n\n/// Exactly Lean Char.isWhitespace, not Rust char::is_whitespace or\n/// is_ascii_whitespace. In particular VT, FF, NBSP and U+3000 are retained.\npub fn is_prefix_whitespace(c: char) -> bool {\n    c == ' ' || c == '\\t' || c == '\\r' || c == '\\n'\n}\n\n/// If-comparisons avoid a char-valued switch in the extractor.\npub fn directive_closer(c: char) -> Option<char> {\n    if c == '{' {\n        Some('}')\n    } else if c == '(' {\n        Some(')')\n    } else if c == '<' {\n        Some('>')\n    } else {\n        None\n    }\n}\n\nfn trim_range(chars: &[char], mut begin: usize, mut end: usize) -> PrefixRange {\n    while begin < end {\n        if !is_prefix_whitespace(chars[begin]) {\n            break;\n        }\n        begin += 1;\n    }\n    while begin < end {\n        let previous = end - 1;\n        if !is_prefix_whitespace(chars[previous]) {\n            break;\n        }\n        end = previous;\n    }\n    PrefixRange { begin, end }\n}\n\n/// Return end when the closer is absent, so the next trim/copy returns empty.\n/// Starts at the opener, just as splitOn in the original Lean definition.\nfn after_first_closer(chars: &[char], mut cursor: usize, end: usize, closer: char) -> usize {\n    while cursor < end {\n        let c = chars[cursor];\n        cursor += 1;\n        if c == closer {\n            return cursor;\n        }\n    }\n    end\n}\n\n/// Total public entry for a borrowed Unicode-scalar slice. Both empty and\n/// all-whitespace inputs take the empty branch before indexing the head.\npub fn strip_prefix_range(chars: &[char]) -> PrefixRange {\n    let trimmed = trim_range(chars, 0, chars.len());\n    if trimmed.begin == trimmed.end {\n        return trimmed;\n    }\n    match directive_closer(chars[trimmed.begin]) {\n        None => trimmed,\n        Some(closer) => {\n            let begin = after_first_closer(chars, trimmed.begin, trimmed.end, closer);\n            trim_range(chars, begin, trimmed.end)\n        }\n    }\n}\n\n/// Copy the selected range in order. No byte offsets, lossy decoding, nested\n/// prefix removal, flag filtering, or whole-prefix callback is involved.\npub fn strip_prefix_chars(chars: &[char]) -> Vec<char> {\n    let selected = strip_prefix_range(chars);\n    let mut result = Vec::new();\n    let mut cursor = selected.begin;\n    while cursor < selected.end {\n        result.push(chars[cursor]);\n        cursor += 1;\n    }\n    result\n}\n"},{"id":16,"name":{"Local":"crates/lnmai-core-verify/src/queue_maintenance.rs"},"crate_name":"lnmai_core_verify","contents":"//! Queue cursor normalization and replacement shared with the runtime.\n//!\n//! The kernel owns every traversal, branch, fuel decrement, and slot counter.\n//! Adapters perform only one point operation; note identifiers stay opaque.\n//! No uniqueness or well-formed-cursor assumption is used by the runtime wiring.\n\n/// Point operations for one cursor step. `advance` preserves the notes and\n/// increments only the cursor. `resolved` observes exactly one note's state.\n/// Named traits avoid higher-ranked borrowed closure bounds in extraction.\npub trait QueueCursor<Q, N> {\n    fn peek(&self, queue: &Q) -> Option<N>;\n    fn resolved(&self, note: &N) -> bool;\n    fn advance(&self, queue: Q) -> Q;\n}\n\n/// Mirrors `normalize{Hold,Touch}QueueCursorFuel`: peek first, then inspect\n/// fuel, then inspect resolution. Even fuel zero does not call `resolved`.\n/// The runtime passes the number of remaining slots, without adding one.\n/// Equivalence of that budget to the reference's remaining + 1 is a pending\n/// proof obligation, dependent on the concrete peek/advance adapter laws.\npub fn normalize_cursor_fuel<Q, N, Ops>(mut fuel: usize, mut queue: Q, ops: Ops) -> Q\nwhere\n    Ops: QueueCursor<Q, N>,\n{\n    loop {\n        let Some(note) = ops.peek(&queue) else {\n            return queue;\n        };\n        if fuel == 0 {\n            return queue;\n        }\n        if !ops.resolved(&note) {\n            return queue;\n        }\n        queue = ops.advance(queue);\n        fuel -= 1;\n    }\n}\n\n/// Read and write exactly one in-bounds slot. `index_equal` compares the\n/// complete note identifiers, without converting them to a machine integer.\n/// `write` preserves queue length, cursor, order, and every other slot.\npub trait QueueReplace<Q, N> {\n    fn get(&self, queue: &Q, index: usize) -> N;\n    fn index_equal(&self, existing: &N, replacement: &N) -> bool;\n    fn write(&self, queue: Q, index: usize, replacement: &N) -> Q;\n}\n\n/// Replace every matching identifier across the entire queue, including\n/// slots before its cursor and every duplicate. Never stop after a match.\n/// `len` is the initial slot count; point writes must preserve that count.\n/// Thus `index < len` justifies each read/write and also `index += 1`, even\n/// when len is usize::MAX. The cursor is neither read nor normalized here.\npub fn replace_all<Q, N, Ops>(len: usize, mut queue: Q, replacement: &N, ops: Ops) -> Q\nwhere\n    Ops: QueueReplace<Q, N>,\n{\n    let mut index = 0;\n    while index < len {\n        let existing = ops.get(&queue, index);\n        if ops.index_equal(&existing, replacement) {\n            queue = ops.write(queue, index, replacement);\n        }\n        index += 1;\n    }\n    queue\n}\n"},{"id":17,"name":{"Local":"crates/lnmai-core-verify/src/queue_remaining.rs"},"crate_name":"lnmai_core_verify","contents":"//! Scalar queue budgets shared by the runtime scheduler and extraction.\n//!\n//! The runtime reads length before converting its Natural cursor, then calls\n//! one scalar helper. Conversion remains a single runtime operation; these\n//! helpers neither interpret BigUint nor copy a queue.\n\n/// Keep the actual Vec length primitive in the extracted subset. The Vec\n/// reference is intentional: no slice conversion or element clone is needed.\npub fn vec_len<T>(notes: &[T]) -> usize {\n    notes.len()\n}\n\n/// Remaining slots, including failed conversion and cursors past the end.\n/// Tap and queue normalization use this count without adding one.\npub fn remaining_scalar(len: usize, converted_cursor: Option<usize>) -> usize {\n    len.saturating_sub(converted_cursor.unwrap_or(usize::MAX))\n}\n\n/// The outer Touch head budget retains the runtime's ordinary +1.\n/// Its successful extracted execution requires remaining + 1 <= usize::MAX;\n/// this helper deliberately preserves the original arithmetic operation.\npub fn head_fuel_scalar(len: usize, converted_cursor: Option<usize>) -> usize {\n    remaining_scalar(len, converted_cursor) + 1\n}\n"},{"id":18,"name":{"Local":"crates/lnmai-core-verify/src/scheduler.rs"},"crate_name":"lnmai_core_verify","contents":"//! Scheduler click ownership, frame order, and touch-group selection.\n//!\n//! The runtime keeps unbounded per-zone click counters and evaluates the\n//! availability comparisons with its own arithmetic. This kernel fixes the\n//! ownership decision itself: a button click is consumed before the mapped\n//! sensor fallback, a consumed button suppresses that fallback, and input that\n//! the current context does not accept consumes nothing.\n\n/// Which counters one note consumes for a single frame.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct ClickUse {\n    pub used_button: bool,\n    pub used_sensor: bool,\n}\n\n/// Button-then-sensor precedence. The two availability arguments are the\n/// caller's used-less-than-available comparisons.\npub fn consume_click(\n    allow_input: bool,\n    button_available: bool,\n    sensor_available: bool,\n) -> ClickUse {\n    if allow_input && button_available {\n        ClickUse {\n            used_button: true,\n            used_sensor: false,\n        }\n    } else if allow_input && sensor_available {\n        ClickUse {\n            used_button: false,\n            used_sensor: true,\n        }\n    } else {\n        ClickUse {\n            used_button: false,\n            used_sensor: false,\n        }\n    }\n}\n\n/// The tap family accepts a queue click through the button or, when the button\n/// is exhausted, through the fallback sensor area mapped from that button.\npub fn tap_queue_has_unused_click(button_available: bool, fallback_sensor_available: bool) -> bool {\n    button_available || fallback_sensor_available\n}\n\n/// Touch families may also accept the button ring mapped from the sensor area.\n/// The last argument is none when the area has no outer button zone.\n#[allow(clippy::manual_unwrap_or, clippy::manual_unwrap_or_default)]\npub fn touch_input_available(\n    button_ring_for_touch: bool,\n    sensor_available: bool,\n    outer_zone_available: Option<bool>,\n) -> bool {\n    let ring_available = match outer_zone_available {\n        Some(available) => available,\n        None => false,\n    };\n    sensor_available || (button_ring_for_touch && ring_available)\n}\n\n/// Processing order differs from the order in which events are reported.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum FramePhase {\n    Tap,\n    Hold,\n    Slide,\n    Touch,\n    TouchHold,\n}\n\n/// Thread the entire scheduler accumulator through each pass. In particular,\n/// touch-holds receive the touch pass's cursor, frontiers, and group updates.\n/// Note transitions and arithmetic belong to the caller's pass adapter.\npub fn process_frame<S, F>(state: S, step: F) -> S\nwhere\n    F: Fn(FramePhase, S) -> S,\n{\n    let state = step(FramePhase::Tap, state);\n    let state = step(FramePhase::Hold, state);\n    let state = step(FramePhase::Slide, state);\n    let state = step(FramePhase::Touch, state);\n    step(FramePhase::TouchHold, state)\n}\n\n/// Opaque batches keep unbounded runtime payloads out of the extracted kernel.\npub struct FrameEvents<E> {\n    pub tap: E,\n    pub hold: E,\n    pub slide: E,\n    pub touch: E,\n    pub touch_hold: E,\n}\n\n/// `stepFrame` reports slide events last, even though slides run third.\n/// The append adapter must preserve the order within both input batches.\npub fn combine_events<E, F>(events: FrameEvents<E>, append: F) -> E\nwhere\n    F: Fn(E, E) -> E,\n{\n    let out = append(events.tap, events.hold);\n    let out = append(out, events.touch);\n    let out = append(out, events.touch_hold);\n    append(out, events.slide)\n}\n\n/// Slide commands precede body audio and judgment commands. The two append\n/// adapters preserve order and are responsible for their buffer representations.\n#[allow(clippy::too_many_arguments)]\npub fn combine_commands<A, R, FA, FR>(\n    slide_audio: A,\n    body_audio: A,\n    event_audio: A,\n    slide_render: R,\n    event_render: R,\n    append_audio: FA,\n    append_render: FR,\n) -> (A, R)\nwhere\n    FA: Fn(A, A) -> A,\n    FR: Fn(R, R) -> R,\n{\n    let audio = append_audio(slide_audio, body_audio);\n    let audio = append_audio(audio, event_audio);\n    let render = append_render(slide_render, event_render);\n    (audio, render)\n}\n\n/// The runtime supplies identifier equality and the strict-majority predicate\n/// using its arbitrary-precision naturals. Majority is relevant only on a match.\npub struct TouchGroupProbe {\n    pub matches_group: bool,\n    pub has_majority: bool,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum TouchGroupAction {\n    Append,\n    Update { index: usize, keep_result: bool },\n}\n\n/// Select only the first matching group, including when that group has no\n/// majority. A later duplicate must neither supply a result nor be updated.\n/// An absent group is appended; an existing majority keeps its stored grade\n/// and diff while the caller increments the count and replaces the size.\npub fn touch_group_plan<F>(len: usize, probe: F) -> TouchGroupAction\nwhere\n    F: Fn(usize) -> TouchGroupProbe,\n{\n    let mut index = 0;\n    while index < len {\n        let group = probe(index);\n        if group.matches_group {\n            return TouchGroupAction::Update {\n                index,\n                keep_result: group.has_majority,\n            };\n        }\n        index += 1;\n    }\n    TouchGroupAction::Append\n}\n"},{"id":19,"name":{"Local":"crates/lnmai-core-verify/src/score.rs"},"crate_name":"lnmai_core_verify","contents":"//! Score and combo computation.\n//!\n//! Mirrors `LnmaiCore/Score.lean`.\n\nuse super::time::Duration;\nuse super::types::{JudgeDisplayOption, JudgeGrade, NoteType};\n\n/// Base score for a note type.\npub fn base_score(nt: NoteType) -> u32 {\n    nt.base_score()\n}\n\n/// Score a non-break note: returns `(earned, lost)`.\npub fn score_non_break(base: u32, grade: JudgeGrade, multiple: u32) -> (u32, u32) {\n    let b = base * multiple;\n    match grade {\n        JudgeGrade::Miss | JudgeGrade::TooFast => (0, b),\n        JudgeGrade::LateGood | JudgeGrade::FastGood => (b / 2, b - b / 2),\n        JudgeGrade::LateGreat\n        | JudgeGrade::LateGreat2nd\n        | JudgeGrade::LateGreat3rd\n        | JudgeGrade::FastGreat\n        | JudgeGrade::FastGreat2nd\n        | JudgeGrade::FastGreat3rd => (b * 4 / 5, b - b * 4 / 5),\n        JudgeGrade::LatePerfect3rd\n        | JudgeGrade::LatePerfect2nd\n        | JudgeGrade::Perfect\n        | JudgeGrade::FastPerfect2nd\n        | JudgeGrade::FastPerfect3rd => (b, 0),\n    }\n}\n\n/// Score a Break note: returns\n/// `(baseEarned, extraEarned, classicExtraEarned, baseLost, extraLost, classicExtraLost)`.\npub fn score_break(grade: JudgeGrade, multiple: u32) -> (u32, u32, u32, u32, u32, u32) {\n    let m = multiple;\n    match grade {\n        JudgeGrade::Miss | JudgeGrade::TooFast => (0, 0, 0, 2500 * m, 100 * m, 100 * m),\n        JudgeGrade::LateGood | JudgeGrade::FastGood => {\n            (1000 * m, 30 * m, 0, 1500 * m, 70 * m, 100 * m)\n        }\n        JudgeGrade::LateGreat3rd | JudgeGrade::FastGreat3rd => {\n            (1250 * m, 40 * m, 0, 1250 * m, 60 * m, 100 * m)\n        }\n        JudgeGrade::LateGreat2nd | JudgeGrade::FastGreat2nd => {\n            (1500 * m, 40 * m, 0, 1000 * m, 60 * m, 100 * m)\n        }\n        JudgeGrade::LateGreat | JudgeGrade::FastGreat => {\n            (2000 * m, 40 * m, 0, 500 * m, 60 * m, 100 * m)\n        }\n        JudgeGrade::LatePerfect3rd | JudgeGrade::FastPerfect3rd => {\n            (2500 * m, 50 * m, 0, 0, 50 * m, 100 * m)\n        }\n        JudgeGrade::LatePerfect2nd | JudgeGrade::FastPerfect2nd => {\n            (2500 * m, 75 * m, 50 * m, 0, 25 * m, 50 * m)\n        }\n        JudgeGrade::Perfect => (2500 * m, 100 * m, 100 * m, 0, 0, 0),\n    }\n}\n\n/// Combo delta produced by one judgment.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub struct ComboDelta {\n    pub combo: u32,\n    pub p_combo: u32,\n    pub c_p_combo: u32,\n    pub dx_score_lost: i64,\n}\n\n/// Update combo counters for a single note judgment.\npub fn update_combo(\n    combo: u32,\n    p_combo: u32,\n    c_p_combo: u32,\n    dx_score_lost: i64,\n    grade: JudgeGrade,\n    multiple: u32,\n) -> ComboDelta {\n    let m = multiple as i64;\n    match grade {\n        JudgeGrade::Perfect => ComboDelta {\n            combo: combo + multiple,\n            p_combo: p_combo + multiple,\n            c_p_combo: c_p_combo + multiple,\n            dx_score_lost,\n        },\n        JudgeGrade::LatePerfect2nd\n        | JudgeGrade::FastPerfect2nd\n        | JudgeGrade::LatePerfect3rd\n        | JudgeGrade::FastPerfect3rd => ComboDelta {\n            combo: combo + multiple,\n            p_combo: p_combo + multiple,\n            c_p_combo: 0,\n            dx_score_lost: dx_score_lost - m,\n        },\n        JudgeGrade::LateGreat3rd\n        | JudgeGrade::LateGreat2nd\n        | JudgeGrade::LateGreat\n        | JudgeGrade::FastGreat\n        | JudgeGrade::FastGreat2nd\n        | JudgeGrade::FastGreat3rd => ComboDelta {\n            combo: combo + multiple,\n            p_combo: 0,\n            c_p_combo: 0,\n            dx_score_lost: dx_score_lost - 2 * m,\n        },\n        JudgeGrade::LateGood | JudgeGrade::FastGood => ComboDelta {\n            combo: combo + multiple,\n            p_combo: 0,\n            c_p_combo: 0,\n            dx_score_lost: dx_score_lost - 3 * m,\n        },\n        JudgeGrade::Miss | JudgeGrade::TooFast => ComboDelta {\n            combo: 0,\n            p_combo: 0,\n            c_p_combo: 0,\n            dx_score_lost: dx_score_lost - 3 * m,\n        },\n    }\n}\n\n/// Fast/late increment flags for a grade under a display option.\npub fn count_fast_late(\n    grade: JudgeGrade,\n    diff: Duration,\n    display: JudgeDisplayOption,\n) -> (bool, bool) {\n    if grade.is_miss_or_too_fast() {\n        (false, false)\n    } else {\n        let d = grade.dist_from_perfect();\n        match display {\n            JudgeDisplayOption::All => {\n                if diff.to_micros() == 0 {\n                    (false, false)\n                } else if diff.to_micros() < 0 {\n                    (true, false)\n                } else {\n                    (false, true)\n                }\n            }\n            JudgeDisplayOption::BelowCP => {\n                if matches!(grade, JudgeGrade::Perfect) {\n                    (false, false)\n                } else if diff.to_micros() < 0 {\n                    (true, false)\n                } else {\n                    (false, true)\n                }\n            }\n            JudgeDisplayOption::BelowP\n            | JudgeDisplayOption::BelowGR\n            | JudgeDisplayOption::Disable => {\n                if d <= 2 {\n                    (false, false)\n                } else if diff.to_micros() < 0 {\n                    (true, false)\n                } else {\n                    (false, true)\n                }\n            }\n            JudgeDisplayOption::MissOnly => (false, false),\n        }\n    }\n}\n\n/// DX score rank (5 = SSS+, 0 = none).\npub fn dx_score_rank(achieved: u32, max: u32) -> u32 {\n    if max == 0 {\n        return 0;\n    }\n    // Products are at most u32::MAX * 100 and fit exactly in u64.\n    let meets = |threshold: u64| -> bool { (achieved as u64) * 100 >= (max as u64) * threshold };\n    if meets(97) {\n        5\n    } else if meets(95) {\n        4\n    } else if meets(93) {\n        3\n    } else if meets(90) {\n        2\n    } else if meets(85) {\n        1\n    } else {\n        0\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn test_base_score() {\n        assert!(matches!(base_score(NoteType::Tap), 500));\n        assert!(matches!(base_score(NoteType::Break), 2500));\n    }\n\n    #[test]\n    fn test_score_non_break() {\n        assert!(matches!(\n            score_non_break(500, JudgeGrade::Perfect, 1),\n            (500, 0)\n        ));\n        assert!(matches!(\n            score_non_break(500, JudgeGrade::Miss, 1),\n            (0, 500)\n        ));\n    }\n}\n"},{"id":20,"name":{"Local":"crates/lnmai-core-verify/src/shape.rs"},"crate_name":"lnmai_core_verify","contents":"//! Pure Simai shape operations shared by the runtime and the extracted model.\n//! Mirrors LnmaiCore/Simai/Shape.lean; textual parsing stays at the boundary.\n\nuse crate::areas::{OuterSlot, SensorArea};\nuse crate::symmetry::{self, SlideSymmetry};\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum SlideKind {\n    #[default]\n    Line,\n    Circle,\n    V,\n    Turn,\n    Pq,\n    Ppqq,\n    S,\n    Wifi,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum CanonicalSlideShape {\n    Line(usize),\n    Circle(usize),\n    V(usize),\n    Turn(usize),\n    Pq(usize),\n    Ppqq(usize),\n    S,\n    Wifi,\n}\n\nimpl Default for CanonicalSlideShape {\n    fn default() -> Self {\n        Self::Line(0)\n    }\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct SlideShape {\n    pub canonical: CanonicalSlideShape,\n    pub symmetry: SlideSymmetry,\n}\n\nimpl Default for SlideShape {\n    fn default() -> Self {\n        SlideShape {\n            canonical: CanonicalSlideShape::Line(0),\n            symmetry: crate::symmetry::direct(),\n        }\n    }\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum SlideBodyKind {\n    #[default]\n    Line,\n    CircleRight,\n    CircleLeft,\n    CircleUp,\n    V,\n    Pp,\n    Qq,\n    P,\n    Q,\n    S,\n    Z,\n    Turn,\n    Wifi,\n}\n\n/// Structured errors preserve Lean's distinction between a non-outer area,\n/// an invalid endpoint, and the two different turn failures.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum ShapeError {\n    EndNotOuter,\n    InvalidEnd,\n    InvalidTurnEnd,\n    InvalidTurn,\n}\n\n/// `SlideShape.kind`.\npub fn shape_kind(slide_shape: SlideShape) -> SlideKind {\n    match slide_shape.canonical {\n        CanonicalSlideShape::Line(_) => SlideKind::Line,\n        CanonicalSlideShape::Circle(_) => SlideKind::Circle,\n        CanonicalSlideShape::V(_) => SlideKind::V,\n        CanonicalSlideShape::Turn(_) => SlideKind::Turn,\n        CanonicalSlideShape::Pq(_) => SlideKind::Pq,\n        CanonicalSlideShape::Ppqq(_) => SlideKind::Ppqq,\n        CanonicalSlideShape::S => SlideKind::S,\n        CanonicalSlideShape::Wifi => SlideKind::Wifi,\n    }\n}\n\n/// `SlideShape.relEnd`.\npub fn shape_rel_end(slide_shape: SlideShape) -> Option<usize> {\n    match slide_shape.canonical {\n        CanonicalSlideShape::Line(n)\n        | CanonicalSlideShape::Circle(n)\n        | CanonicalSlideShape::V(n)\n        | CanonicalSlideShape::Turn(n)\n        | CanonicalSlideShape::Pq(n)\n        | CanonicalSlideShape::Ppqq(n) => Some(n),\n        CanonicalSlideShape::S | CanonicalSlideShape::Wifi => None,\n    }\n}\n\n/// `SlideShape.mirrored`.\npub fn shape_mirrored(slide_shape: SlideShape) -> bool {\n    symmetry::is_mirrored(slide_shape.symmetry)\n}\n\n/// `mkCanonicalSlideShape?`.\n#[allow(clippy::manual_range_contains)]\npub fn mk_canonical_slide_shape_opt(\n    kind: SlideKind,\n    rel_end: Option<usize>,\n) -> Option<CanonicalSlideShape> {\n    match (kind, rel_end) {\n        (SlideKind::Line, Some(n)) => {\n            if 2 <= n && n <= 8 {\n                Some(CanonicalSlideShape::Line(n))\n            } else {\n                None\n            }\n        }\n        (SlideKind::Circle, Some(n)) => Some(CanonicalSlideShape::Circle(n)),\n        (SlideKind::V, Some(n)) => {\n            if n != 5 {\n                Some(CanonicalSlideShape::V(n))\n            } else {\n                None\n            }\n        }\n        (SlideKind::Turn, Some(n)) => {\n            if 2 <= n && n <= 8 {\n                Some(CanonicalSlideShape::Turn(n))\n            } else {\n                None\n            }\n        }\n        (SlideKind::Pq, Some(n)) => Some(CanonicalSlideShape::Pq(n)),\n        (SlideKind::Ppqq, Some(n)) => Some(CanonicalSlideShape::Ppqq(n)),\n        (SlideKind::S, None) => Some(CanonicalSlideShape::S),\n        (SlideKind::Wifi, None) => Some(CanonicalSlideShape::Wifi),\n        _ => None,\n    }\n}\n\nfn mk_canonical_slide_shape(\n    kind: SlideKind,\n    rel_end: Option<usize>,\n) -> Result<CanonicalSlideShape, ShapeError> {\n    match mk_canonical_slide_shape_opt(kind, rel_end) {\n        Some(shape) => Ok(shape),\n        None => Err(ShapeError::InvalidEnd),\n    }\n}\n\n/// `mkCanonicalSlideShapeUnchecked`.\npub fn mk_canonical_slide_shape_unchecked(\n    kind: SlideKind,\n    rel_end: Option<usize>,\n) -> CanonicalSlideShape {\n    match (kind, rel_end) {\n        (SlideKind::Line, Some(n)) => CanonicalSlideShape::Line(n),\n        (SlideKind::Circle, Some(n)) => CanonicalSlideShape::Circle(n),\n        (SlideKind::V, Some(n)) => CanonicalSlideShape::V(n),\n        (SlideKind::Turn, Some(n)) => CanonicalSlideShape::Turn(n),\n        (SlideKind::Pq, Some(n)) => CanonicalSlideShape::Pq(n),\n        (SlideKind::Ppqq, Some(n)) => CanonicalSlideShape::Ppqq(n),\n        (SlideKind::S, _) => CanonicalSlideShape::S,\n        (SlideKind::Wifi, _) => CanonicalSlideShape::Wifi,\n        (SlideKind::Line, None) => CanonicalSlideShape::Line(3),\n        (SlideKind::Circle, None) => CanonicalSlideShape::Circle(2),\n        (SlideKind::V, None) => CanonicalSlideShape::V(1),\n        (SlideKind::Turn, None) => CanonicalSlideShape::Turn(2),\n        (SlideKind::Pq, None) => CanonicalSlideShape::Pq(1),\n        (SlideKind::Ppqq, None) => CanonicalSlideShape::Ppqq(1),\n    }\n}\n\n/// `mkSlideShape`.\npub fn mk_slide_shape(canonical: CanonicalSlideShape, sym: SlideSymmetry) -> SlideShape {\n    SlideShape {\n        canonical,\n        symmetry: sym,\n    }\n}\n\n/// `digitToNat?`.\npub fn digit_to_nat(c: char) -> Option<usize> {\n    if c == '1' {\n        Some(1)\n    } else if c == '2' {\n        Some(2)\n    } else if c == '3' {\n        Some(3)\n    } else if c == '4' {\n        Some(4)\n    } else if c == '5' {\n        Some(5)\n    } else if c == '6' {\n        Some(6)\n    } else if c == '7' {\n        Some(7)\n    } else if c == '8' {\n        Some(8)\n    } else {\n        None\n    }\n}\n\nfn mirror_key(n: usize) -> usize {\n    match n {\n        1 => 1,\n        2 => 8,\n        3 => 7,\n        4 => 6,\n        5 => 5,\n        6 => 4,\n        7 => 3,\n        8 => 2,\n        n => n,\n    }\n}\n\n/// `canonicalRelEnd`.\npub fn canonical_rel_end(sym: SlideSymmetry, rel_end: usize) -> usize {\n    if symmetry::is_mirrored(sym) {\n        mirror_key(rel_end)\n    } else {\n        rel_end\n    }\n}\n\n/// `baseRelEnd`.\npub fn base_rel_end(sym: SlideSymmetry, rel_end: usize) -> usize {\n    canonical_rel_end(sym, rel_end)\n}\n\nfn relative_end_pos(start_pos: usize, end_pos: usize) -> usize {\n    (((end_pos - 1) + 8 - (start_pos - 1)) % 8) + 1\n}\n\npub fn outer_slot_is_right_half(slot: OuterSlot) -> bool {\n    slot.to_index() < 4\n}\n\npub fn outer_slot_is_upper_half(slot: OuterSlot) -> bool {\n    matches!(\n        slot,\n        OuterSlot::S7 | OuterSlot::S8 | OuterSlot::S1 | OuterSlot::S2\n    )\n}\n\npub fn relative_end_from_typed(\n    start_lane: OuterSlot,\n    end_area: SensorArea,\n) -> Result<usize, ShapeError> {\n    match end_area.to_outer_slot() {\n        Some(end_zone) => Ok(relative_end_pos(\n            start_lane.to_index() + 1,\n            end_zone.to_index() + 1,\n        )),\n        None => Err(ShapeError::EndNotOuter),\n    }\n}\n\n// Explicit propagation keeps the complete error path transparent to extraction.\nmacro_rules! shape_try {\n    ($value:expr) => {\n        match $value {\n            Ok(value) => value,\n            Err(error) => return Err(error),\n        }\n    };\n}\n\n/// `solveSlideShape`.\n#[allow(clippy::manual_range_contains)]\npub fn solve_shape(\n    kind: SlideBodyKind,\n    start_lane: OuterSlot,\n    end_area: Option<SensorArea>,\n    turn_area: Option<SensorArea>,\n) -> Result<SlideShape, ShapeError> {\n    let end_area = end_area.unwrap_or(SensorArea::A1);\n    let direct = symmetry::direct();\n    let mirror = symmetry::mirror();\n    match kind {\n        SlideBodyKind::Line => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Line, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::CircleRight => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if outer_slot_is_upper_half(start_lane) {\n                    direct\n                } else {\n                    mirror\n                },\n            ))\n        }\n        SlideBodyKind::CircleLeft => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if !outer_slot_is_upper_half(start_lane) {\n                    direct\n                } else {\n                    mirror\n                },\n            ))\n        }\n        SlideBodyKind::CircleUp => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if rel_end < 5 { direct } else { mirror },\n            ))\n        }\n        SlideBodyKind::V => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::V, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Pp => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Ppqq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Qq => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Ppqq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, mirror))\n        }\n        SlideBodyKind::P => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Pq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Q => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Pq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, mirror))\n        }\n        SlideBodyKind::S | SlideBodyKind::Z => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if rel_end != 5 {\n                Err(ShapeError::InvalidEnd)\n            } else {\n                let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::S, None));\n                let sym = if kind == SlideBodyKind::Z {\n                    mirror\n                } else {\n                    direct\n                };\n                Ok(mk_slide_shape(canonical, sym))\n            }\n        }\n        SlideBodyKind::Turn => {\n            let turn_area = turn_area.unwrap_or(SensorArea::A1);\n            let turn_rel = shape_try!(relative_end_from_typed(start_lane, turn_area));\n            let end_rel = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if turn_rel == 7 {\n                if end_rel < 2 || end_rel > 5 {\n                    Err(ShapeError::InvalidTurnEnd)\n                } else {\n                    let canonical =\n                        shape_try!(mk_canonical_slide_shape(SlideKind::Turn, Some(end_rel)));\n                    Ok(mk_slide_shape(canonical, direct))\n                }\n            } else if turn_rel == 3 {\n                if end_rel < 5 {\n                    Err(ShapeError::InvalidTurnEnd)\n                } else {\n                    let canonical =\n                        shape_try!(mk_canonical_slide_shape(SlideKind::Turn, Some(end_rel)));\n                    Ok(mk_slide_shape(canonical, mirror))\n                }\n            } else {\n                Err(ShapeError::InvalidTurn)\n            }\n        }\n        SlideBodyKind::Wifi => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if rel_end != 5 {\n                Err(ShapeError::InvalidEnd)\n            } else {\n                let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Wifi, None));\n                Ok(mk_slide_shape(canonical, direct))\n            }\n        }\n    }\n}\n"},{"id":21,"name":{"Local":"crates/lnmai-core-verify/src/slide_chain.rs"},"crate_name":"lnmai_core_verify","contents":"//! Continuous-slide grammar shared with the runtime tokenizer.\n//!\n//! Scans use a borrowed character slice and increasing cursors. Errors are\n//! finite; successful segments are ranges in the input. No char-valued switch,\n//! recursion, suffix cloning, timing parser, or whole-chain callback occurs here.\n//! The only generic operation encodes ONE already-built Vec<char> as text.\n//!\n//! Source-only delivery: not compiled or extracted. See OPEN-OBLIGATIONS.md.\n\nuse crate::tokenize::is_slide_mark_char;\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum ChainError {\n    InvalidSyntax,\n    FreshNumericHead,\n    UnterminatedTiming,\n}\n\n/// head is synthetic; [begin, end) contains the original shape and optional\n/// bracket suffix, including '[' and the FIRST closing ']'. Bounds are character\n/// positions, never UTF-8 byte positions. Consecutive plans partition the input.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct SegmentPlan {\n    pub head: char,\n    pub begin: usize,\n    pub end: usize,\n    pub has_timing: bool,\n}\n\n/// The runtime uses Segment<String>; the encoder cannot change has_timing.\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct Segment<Text> {\n    pub raw_text: Text,\n    pub has_timing: bool,\n}\n\n/// Deliberately accepts ASCII 0 and 9 as well as 1..8, matching Char.isDigit.\n/// Equality tests avoid the extractor's unsupported char-valued switch.\npub fn is_chain_digit(c: char) -> bool {\n    c == '0'\n        || c == '1'\n        || c == '2'\n        || c == '3'\n        || c == '4'\n        || c == '5'\n        || c == '6'\n        || c == '7'\n        || c == '8'\n        || c == '9'\n}\n\n/// Success consumes exactly one character. An out-of-range cursor returns the\n/// original generic syntax error, not a bounds panic.\npub fn read_digit(chars: &[char], cursor: usize) -> Result<(char, usize), ChainError> {\n    if cursor < chars.len() {\n        let c = chars[cursor];\n        if is_chain_digit(c) {\n            return Ok((c, cursor + 1));\n        }\n    }\n    Err(ChainError::InvalidSyntax)\n}\n\n/// cursor is immediately after op; parse_plans checks the slide-mark predicate.\n/// Return the endpoint and next cursor. The original-input range preserves the\n/// spelling of the shape without reconstruction.\npub fn read_shape(\n    chars: &[char],\n    op: char,\n    mut cursor: usize,\n) -> Result<(char, usize), ChainError> {\n    if op == 'V' {\n        cursor = match read_digit(chars, cursor) {\n            Ok((_middle, next)) => next,\n            Err(error) => return Err(error),\n        };\n        read_digit(chars, cursor)\n    } else {\n        if (op == 'p' || op == 'q') && cursor < chars.len() && chars[cursor] == op {\n            cursor += 1;\n        }\n        read_digit(chars, cursor)\n    }\n}\n\n/// Exact readBracketSuffixFuel order: empty first, read a character, accept ']'\n/// EVEN WITH ZERO FUEL, then check/decrement fuel and continue. The opening '['\n/// has already been consumed. Return the position after ']'.\npub fn timing_end_with_fuel(\n    chars: &[char],\n    mut cursor: usize,\n    mut fuel: usize,\n) -> Result<usize, ChainError> {\n    while cursor < chars.len() {\n        let c = chars[cursor];\n        cursor += 1;\n        if c == ']' {\n            return Ok(cursor);\n        }\n        if fuel == 0 {\n            return Err(ChainError::UnterminatedTiming);\n        }\n        fuel -= 1;\n    }\n    Err(ChainError::UnterminatedTiming)\n}\n\n/// Uses remaining characters without +1. Equality with the original length+1\n/// wrapper needs the explicit fuel-stability proof in the Lean draft.\npub fn timing_end(chars: &[char], cursor: usize) -> Result<usize, ChainError> {\n    if cursor > chars.len() {\n        return Err(ChainError::UnterminatedTiming);\n    }\n    timing_end_with_fuel(chars, cursor, chars.len() - cursor)\n}\n\n/// Outer fuel: empty succeeds before the fuel guard; nonempty/fuel=0 returns\n/// InvalidSyntax before digit/mark inspection. A later error discards all plans,\n/// as with the original Except recursion.\n#[allow(clippy::question_mark)]\npub fn parse_plans_with_fuel(\n    chars: &[char],\n    mut current_start: char,\n    mut fuel: usize,\n) -> Result<Vec<SegmentPlan>, ChainError> {\n    let mut plans = Vec::new();\n    let mut cursor = 0usize;\n    while cursor < chars.len() {\n        if fuel == 0 {\n            return Err(ChainError::InvalidSyntax);\n        }\n        fuel -= 1;\n        let begin = cursor;\n        let op = chars[cursor];\n        cursor += 1;\n        if is_chain_digit(op) {\n            return Err(ChainError::FreshNumericHead);\n        }\n        if !is_slide_mark_char(op) {\n            return Err(ChainError::InvalidSyntax);\n        }\n        let (end_char, next) = match read_shape(chars, op, cursor) {\n            Ok(value) => value,\n            Err(error) => return Err(error),\n        };\n        cursor = next;\n        let mut has_timing = false;\n        if cursor < chars.len() && chars[cursor] == '[' {\n            has_timing = true;\n            cursor += 1;\n            cursor = match timing_end(chars, cursor) {\n                Ok(next) => next,\n                Err(error) => return Err(error),\n            };\n        }\n        plans.push(SegmentPlan {\n            head: current_start,\n            begin,\n            end: cursor,\n            has_timing,\n        });\n        current_start = end_char;\n    }\n    Ok(plans)\n}\n\n/// Runtime uses remaining length, not remaining length+1. Each complete segment\n/// consumes at least its operator and one digit. Fuel sufficiency and equality\n/// with the original wrapper remain explicit proof obligations.\npub fn parse_plans(chars: &[char], current_start: char) -> Result<Vec<SegmentPlan>, ChainError> {\n    parse_plans_with_fuel(chars, current_start, chars.len())\n}\n\n/// Only indexing/push. For scanner-produced plans: begin < end <= chars.len().\n/// Prove those bounds and room for the synthetic head before calling this helper;\n/// arbitrary hand-built plans are not checked here. No UTF-8 slicing occurs.\npub fn render_plan(chars: &[char], plan: SegmentPlan) -> Vec<char> {\n    let mut text = Vec::new();\n    text.push(plan.head);\n    let mut cursor = plan.begin;\n    while cursor < plan.end {\n        text.push(chars[cursor]);\n        cursor += 1;\n    }\n    text\n}\n\n/// Point encoder law: decode(encode(v)) = String.ofList(v). Both traversal and\n/// segment construction are in the kernel, not hidden inside that callback.\npub fn encode_plans<Text, Encode>(\n    chars: &[char],\n    plans: &[SegmentPlan],\n    encode: Encode,\n) -> Vec<Segment<Text>>\nwhere\n    Encode: Fn(Vec<char>) -> Text,\n{\n    let mut segments = Vec::new();\n    let mut index = 0usize;\n    while index < plans.len() {\n        let plan = plans[index];\n        let text = render_plan(chars, plan);\n        segments.push(Segment {\n            raw_text: encode(text),\n            has_timing: plan.has_timing,\n        });\n        index += 1;\n    }\n    segments\n}\n\n/// Runtime entry: scanning, output order, range copies and record construction\n/// are actual Rust kernel code. String encoding is the only callback.\npub fn parse_segments<Text, Encode>(\n    chars: &[char],\n    current_start: char,\n    encode: Encode,\n) -> Result<Vec<Segment<Text>>, ChainError>\nwhere\n    Encode: Fn(Vec<char>) -> Text,\n{\n    match parse_plans(chars, current_start) {\n        Ok(plans) => Ok(encode_plans(chars, &plans, encode)),\n        Err(error) => Err(error),\n    }\n}\n"},{"id":22,"name":{"Local":"crates/lnmai-core-verify/src/slide_lifecycle.rs"},"crate_name":"lnmai_core_verify","contents":"//! Slide/WiFi lifecycle control. Exact durations and queue snapshots are\n//! supplied by the runtime; the transition never converts or bounds them.\n\nuse crate::convert::convert_grade;\nuse crate::judge::correct_slide_grade;\nuse crate::types::{JudgeGrade, JudgeStyle};\n\n#[derive(Debug, Clone, PartialEq, Eq, Default)]\npub enum SlideState<D> {\n    #[default]\n    Waiting,\n    Active(D),\n    Judged(JudgeGrade, D, D),\n    Ended,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum SlideAction<D> {\n    Dormant,\n    Activate(D),\n    Timeout,\n    Finish(JudgeGrade, D),\n    Wait(JudgeGrade, D, D),\n    Ended,\n}\n\npub fn should_be_checkable(\n    latched: bool,\n    connected: bool,\n    group_head: bool,\n    parent_finished: bool,\n    parent_pending: bool,\n    head_ready: bool,\n) -> bool {\n    if latched {\n        true\n    } else if connected {\n        if group_head {\n            head_ready\n        } else {\n            parent_finished || parent_pending\n        }\n    } else {\n        head_ready\n    }\n}\n\npub fn unjudged_action<D>(\n    wait: D,\n    checkable: bool,\n    judgable: bool,\n    too_late: bool,\n) -> SlideAction<D> {\n    if checkable {\n        SlideAction::Activate(wait)\n    } else if judgable && too_late {\n        SlideAction::Timeout\n    } else {\n        SlideAction::Dormant\n    }\n}\n\n/// The caller compares the stored wait before subtracting this frame delta.\n/// Crossing zero during the frame therefore emits the result next frame.\npub fn transition<D>(\n    state: SlideState<D>,\n    initial_wait: D,\n    checkable: bool,\n    judgable: bool,\n    too_late: bool,\n    wait_expired: bool,\n) -> SlideAction<D> {\n    match state {\n        SlideState::Waiting => unjudged_action(initial_wait, checkable, judgable, too_late),\n        SlideState::Active(wait) => unjudged_action(wait, checkable, judgable, too_late),\n        SlideState::Judged(grade, wait, diff) => {\n            if wait_expired {\n                SlideAction::Finish(grade, diff)\n            } else {\n                SlideAction::Wait(grade, wait, diff)\n            }\n        }\n        SlideState::Ended => SlideAction::Ended,\n    }\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum ActiveAction {\n    Complete,\n    Timeout,\n    SampleSensors,\n}\n\n/// Completion and timeout refer to the queues BEFORE this frame samples\n/// sensors. Completion wins if both predicates are true.\npub fn active_action(judgable: bool, cleared: bool, too_late: bool) -> ActiveAction {\n    if judgable && cleared {\n        ActiveAction::Complete\n    } else if judgable && too_late {\n        ActiveAction::Timeout\n    } else {\n        ActiveAction::SampleSensors\n    }\n}\n\npub fn effective_grade(style: JudgeStyle, subdivide: bool, raw: JudgeGrade) -> JudgeGrade {\n    let converted = convert_grade(style, raw);\n    if subdivide {\n        converted\n    } else {\n        correct_slide_grade(converted)\n    }\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct OutputFlags {\n    pub mark_sound_played: bool,\n    pub emit_audio: bool,\n    pub emit_render: bool,\n}\n\npub fn output_flags(\n    ended: bool,\n    should_play: bool,\n    sound_played: bool,\n    has_track_ons: bool,\n    hide_slide: bool,\n) -> OutputFlags {\n    OutputFlags {\n        mark_sound_played: should_play && !sound_played && has_track_ons,\n        emit_audio: !ended && should_play && has_track_ons,\n        emit_render: !ended || hide_slide,\n    }\n}\n"},{"id":23,"name":{"Local":"crates/lnmai-core-verify/src/slide_parents.rs"},"crate_name":"lnmai_core_verify","contents":"//! Connected-slide parent propagation shared with the runtime scheduler.\n//!\n//! Identifiers are opaque: equality and cloning their runtime representation\n//! belong to the point-read adapter. Searches select the first matching slot,\n//! whereas edits visit every matching slot, including duplicate identifiers.\n//! The adapters read/write one slot or append one command; all scans, guards,\n//! ancestor fuel, and command sequencing live here.\n\npub struct ParentInfo<I> {\n    pub note_index: I,\n    pub parent_index: Option<I>,\n    pub zero_remaining: bool,\n    pub one_remaining: bool,\n    pub connected: bool,\n    pub final_part: bool,\n    pub ended: bool,\n}\n\n#[derive(Clone, Copy)]\npub enum ParentEdit {\n    Flags { finished: bool, pending: bool },\n    ClearQueues,\n    End,\n}\n\n/// Named traits keep the borrowed point operations explicit without a\n/// higher-ranked closure bound, which the extraction backend cannot translate.\npub trait ParentRead<S, I> {\n    fn read(&self, state: &S, index: usize) -> ParentInfo<I>;\n}\n\npub trait ParentEqual<I> {\n    fn equal(&self, left: &I, right: &I) -> bool;\n}\n\n/// The reader returns the metadata of exactly one in-bounds slot. Identifier\n/// equality is supplied separately, without conversion to a machine integer.\npub fn find_first<S, I, Read, Equal>(\n    len: usize,\n    state: &S,\n    target: &I,\n    read: &Read,\n    equal: &Equal,\n) -> Option<ParentInfo<I>>\nwhere\n    Read: ParentRead<S, I>,\n    Equal: ParentEqual<I>,\n{\n    let mut index = 0;\n    while index < len {\n        let parent = read.read(state, index);\n        if equal.equal(&parent.note_index, target) {\n            return Some(parent);\n        }\n        index += 1;\n    }\n    None\n}\n\n/// Write every matching slot. A writer must preserve length, identifiers and\n/// all fields outside the requested edit, including every other slot.\npub fn update_all<S, I, Read, Equal, Write>(\n    len: usize,\n    mut state: S,\n    target: &I,\n    edit: ParentEdit,\n    read: &Read,\n    equal: &Equal,\n    write: &Write,\n) -> S\nwhere\n    Read: ParentRead<S, I>,\n    Equal: ParentEqual<I>,\n    Write: Fn(S, usize, ParentEdit) -> S,\n{\n    let mut index = 0;\n    while index < len {\n        let parent = read.read(&state, index);\n        if equal.equal(&parent.note_index, target) {\n            state = write(state, index, edit);\n        }\n        index += 1;\n    }\n    state\n}\n\n/// Read flags from an immutable snapshot, exactly like the reference status\n/// list. Writes do not feed back into the lookup for a later child.\npub fn refresh_flags<R, S, I, Read, Equal, Write>(\n    len: usize,\n    snapshot: &R,\n    mut state: S,\n    read: Read,\n    equal: Equal,\n    write: Write,\n) -> S\nwhere\n    Read: ParentRead<R, I>,\n    Equal: ParentEqual<I>,\n    Write: Fn(S, usize, ParentEdit) -> S,\n{\n    let mut index = 0;\n    while index < len {\n        let child = read.read(snapshot, index);\n        let parent = match child.parent_index {\n            None => None,\n            Some(parent_index) => find_first(len, snapshot, &parent_index, &read, &equal),\n        };\n        let (finished, pending) = match parent {\n            None => (false, false),\n            Some(parent) => (parent.zero_remaining, parent.one_remaining),\n        };\n        state = write(state, index, ParentEdit::Flags { finished, pending });\n        index += 1;\n    }\n    state\n}\n\n#[derive(Clone, Copy)]\npub enum SensorPhase {\n    Waiting,\n    Active,\n    Other,\n}\n\n/// The consumed comparison uses the runtime arbitrary-precision sum of queue\n/// lengths. Only a queue head can supply historical On evidence.\npub fn sensor_triggered<Head>(\n    before: SensorPhase,\n    after: SensorPhase,\n    checkable: bool,\n    consumed: bool,\n    queue_count: usize,\n    head_on: Head,\n) -> bool\nwhere\n    Head: Fn(usize) -> bool,\n{\n    match (before, after) {\n        (SensorPhase::Waiting | SensorPhase::Active, SensorPhase::Active) => {}\n        _ => return false,\n    }\n    if !checkable {\n        return false;\n    }\n    if consumed {\n        return true;\n    }\n    sensor_heads(queue_count, head_on)\n}\n\n/// Search queue heads after the phase/checkability/consumption guards.\npub fn sensor_heads<Head>(queue_count: usize, head_on: Head) -> bool\nwhere\n    Head: Fn(usize) -> bool,\n{\n    let mut index = 0;\n    while index < queue_count {\n        if head_on(index) {\n            return true;\n        }\n        index += 1;\n    }\n    false\n}\n\n/// Clear all copies of the direct parent, but emit once using the first\n/// parent. Neither lifecycle states nor earlier ancestors are changed.\n#[allow(clippy::too_many_arguments)]\npub fn force_finish<S, C, I, Read, Equal, Write, Emit>(\n    len: usize,\n    state: S,\n    commands: C,\n    triggered: bool,\n    parent_index: Option<I>,\n    read: Read,\n    equal: Equal,\n    write: Write,\n    emit: Emit,\n) -> (S, C)\nwhere\n    Read: ParentRead<S, I>,\n    Equal: ParentEqual<I>,\n    Write: Fn(S, usize, ParentEdit) -> S,\n    Emit: Fn(C, I) -> C,\n{\n    if !triggered {\n        return (state, commands);\n    }\n    let Some(target) = parent_index else {\n        return (state, commands);\n    };\n    let Some(parent) = find_first(len, &state, &target, &read, &equal) else {\n        return (state, commands);\n    };\n    if !parent.connected || parent.final_part || parent.zero_remaining {\n        return (state, commands);\n    }\n    let state = update_all(\n        len,\n        state,\n        &target,\n        ParentEdit::ClearQueues,\n        &read,\n        &equal,\n        &write,\n    );\n    (state, emit(commands, parent.note_index))\n}\n\n/// Each successful iteration ends all same-ID slots and then appends the\n/// first matching parent's hide command. Its original parent ID determines\n/// the next iteration. Already-ended parents and missing IDs stop the loop;\n/// fuel bounds even malformed cycles without assuming unique IDs or a DAG.\n#[allow(clippy::too_many_arguments)]\npub fn end_ancestors_fuel<S, C, I, Read, Equal, Write, Emit>(\n    len: usize,\n    mut fuel: usize,\n    mut state: S,\n    mut commands: C,\n    mut parent_index: Option<I>,\n    read: Read,\n    equal: Equal,\n    write: Write,\n    emit: Emit,\n) -> (S, C)\nwhere\n    Read: ParentRead<S, I>,\n    Equal: ParentEqual<I>,\n    Write: Fn(S, usize, ParentEdit) -> S,\n    Emit: Fn(C, I) -> C,\n{\n    while fuel > 0 {\n        let Some(target) = parent_index else {\n            return (state, commands);\n        };\n        let Some(parent) = find_first(len, &state, &target, &read, &equal) else {\n            return (state, commands);\n        };\n        if parent.ended {\n            return (state, commands);\n        }\n        state = update_all(len, state, &target, ParentEdit::End, &read, &equal, &write);\n        commands = emit(commands, parent.note_index);\n        parent_index = parent.parent_index;\n        fuel -= 1;\n    }\n    (state, commands)\n}\n\n/// Only a newly ended child propagates, initially with one unit of fuel per\n/// slide slot (including duplicate IDs).\n#[allow(clippy::too_many_arguments)]\npub fn end_ancestors<S, C, I, Read, Equal, Write, Emit>(\n    len: usize,\n    state: S,\n    commands: C,\n    before_ended: bool,\n    after_ended: bool,\n    parent_index: Option<I>,\n    read: Read,\n    equal: Equal,\n    write: Write,\n    emit: Emit,\n) -> (S, C)\nwhere\n    Read: ParentRead<S, I>,\n    Equal: ParentEqual<I>,\n    Write: Fn(S, usize, ParentEdit) -> S,\n    Emit: Fn(C, I) -> C,\n{\n    if before_ended || !after_ended {\n        (state, commands)\n    } else {\n        end_ancestors_fuel(\n            len,\n            len,\n            state,\n            commands,\n            parent_index,\n            read,\n            equal,\n            write,\n            emit,\n        )\n    }\n}\n"},{"id":24,"name":{"Local":"crates/lnmai-core-verify/src/slide_parser.rs"},"crate_name":"lnmai_core_verify","contents":"//! Slide command dispatch shared with the runtime parser.\n//! UTF-8 decoding, substring search, digit/error construction, and shape\n//! arithmetic stay in explicit runtime adapters. No well-formedness assumption\n//! is made about the facts: conflicting commands retain Lean's priority.\n\nuse crate::shape::SlideBodyKind;\n\npub fn keep_slide_char(c: char) -> bool {\n    c != 'b' && c != 'x' && c != 'f' && c != '!' && c != '?' && c != '$'\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct CommandFacts {\n    pub line: bool,\n    pub circle_right: bool,\n    pub circle_left: bool,\n    pub circle_up: bool,\n    pub v: bool,\n    pub pp: bool,\n    pub qq: bool,\n    pub p: bool,\n    pub q: bool,\n    pub s: bool,\n    pub z: bool,\n    pub turn: bool,\n    pub wifi: bool,\n}\n\n/// The ordered contains-branches of Lean `parseSlideBodyFromText`.\n/// In particular, a doubled p/q beats its single-character command, while\n/// an earlier line/circle/v command still beats the doubled command.\npub fn select_command(facts: CommandFacts) -> Option<SlideBodyKind> {\n    if facts.line {\n        Some(SlideBodyKind::Line)\n    } else if facts.circle_right {\n        Some(SlideBodyKind::CircleRight)\n    } else if facts.circle_left {\n        Some(SlideBodyKind::CircleLeft)\n    } else if facts.circle_up {\n        Some(SlideBodyKind::CircleUp)\n    } else if facts.v {\n        Some(SlideBodyKind::V)\n    } else if facts.pp {\n        Some(SlideBodyKind::Pp)\n    } else if facts.qq {\n        Some(SlideBodyKind::Qq)\n    } else if facts.p {\n        Some(SlideBodyKind::P)\n    } else if facts.q {\n        Some(SlideBodyKind::Q)\n    } else if facts.s {\n        Some(SlideBodyKind::S)\n    } else if facts.z {\n        Some(SlideBodyKind::Z)\n    } else if facts.turn {\n        Some(SlideBodyKind::Turn)\n    } else if facts.wifi {\n        Some(SlideBodyKind::Wifi)\n    } else {\n        None\n    }\n}\n\npub fn command_end_index(kind: SlideBodyKind) -> usize {\n    match kind {\n        SlideBodyKind::Pp | SlideBodyKind::Qq | SlideBodyKind::Turn => 3,\n        _ => 2,\n    }\n}\n\n/// The adapter must read this optional turn BEFORE reading the endpoint.\npub fn command_turn_index(kind: SlideBodyKind) -> Option<usize> {\n    match kind {\n        SlideBodyKind::Turn => Some(2),\n        _ => None,\n    }\n}\n\n/// Terminal parsing deliberately observes all text, independently of the\n/// command chosen above (even a lower-priority V/pp/qq forces index 3).\npub fn terminal_end_index(has_turn: bool, has_pp: bool, has_qq: bool) -> usize {\n    if has_turn || has_pp || has_qq {\n        3\n    } else {\n        2\n    }\n}\n"},{"id":25,"name":{"Local":"crates/lnmai-core-verify/src/slide_parser_frontend.rs"},"crate_name":"lnmai_core_verify","contents":"//! Character reads and just-type dispatch shared with the runtime parser.\n//! UTF-8 decoding, unbounded index conversion, and diagnostic String allocation\n//! are runtime adapters. All character scans and branch/error choices live here.\n\nuse crate::areas::{OuterSlot, SensorArea};\nuse crate::shape::{self, ShapeError};\n\n#[derive(Debug, Clone, Copy)]\npub enum ReadError {\n    MissingDigit,\n    ExpectedDigit,\n    InvalidStartLane,\n    InvalidEndArea,\n}\n\n#[derive(Debug, Clone, Copy)]\npub enum JustError {\n    At(ReadError, usize),\n    Shape(ShapeError),\n    EndNotOuter,\n}\n\npub fn get_at(chars: &[char], index: usize) -> Option<char> {\n    if index < chars.len() {\n        Some(chars[index])\n    } else {\n        None\n    }\n}\n\n/// Accept only ASCII 1..=8, including when the input is an arbitrary Unicode char.\npub fn read_digit(found: Option<char>) -> Result<usize, ReadError> {\n    match found {\n        Some(c) => match shape::digit_to_nat(c) {\n            Some(n) => Ok(n),\n            None => Err(ReadError::ExpectedDigit),\n        },\n        None => Err(ReadError::MissingDigit),\n    }\n}\n\nmacro_rules! read_try {\n    ($value:expr) => {\n        match $value {\n            Ok(value) => value,\n            Err(error) => return Err(error),\n        }\n    };\n}\n\npub fn read_start_lane(found: Option<char>) -> Result<OuterSlot, ReadError> {\n    let pos = read_try!(read_digit(found));\n    match OuterSlot::of_index(pos.saturating_sub(1)) {\n        Some(slot) => Ok(slot),\n        None => Err(ReadError::InvalidStartLane),\n    }\n}\n\npub fn read_end_area(found: Option<char>) -> Result<SensorArea, ReadError> {\n    let pos = read_try!(read_digit(found));\n    match OuterSlot::of_index(pos.saturating_sub(1)) {\n        Some(slot) => Ok(slot.to_outer_sensor_area()),\n        None => Err(ReadError::InvalidEndArea),\n    }\n}\n\n/// Search the entire character sequence, including malformed or mixed commands.\npub fn contains_char(chars: &[char], target: char) -> bool {\n    let mut index = 0usize;\n    while index < chars.len() {\n        if chars[index] == target {\n            return true;\n        }\n        index += 1;\n    }\n    false\n}\n\n/// Consecutive equal characters only: p...p does not count as pp.\npub fn contains_double(chars: &[char], target: char) -> bool {\n    let mut previous = false;\n    let mut index = 0usize;\n    while index < chars.len() {\n        let current = chars[index] == target;\n        if previous && current {\n            return true;\n        }\n        previous = current;\n        index += 1;\n    }\n    false\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct JustFacts {\n    pub circle_right: bool,\n    pub circle_left: bool,\n    pub circle_up: bool,\n    pub turn: bool,\n    pub wifi: bool,\n    pub qq: bool,\n    pub pp: bool,\n}\n\npub fn just_facts(chars: &[char]) -> JustFacts {\n    JustFacts {\n        circle_right: contains_char(chars, '>'),\n        circle_left: contains_char(chars, '<'),\n        circle_up: contains_char(chars, '^'),\n        turn: contains_char(chars, 'V'),\n        wifi: contains_char(chars, 'w'),\n        qq: contains_double(chars, 'q'),\n        pp: contains_double(chars, 'p'),\n    }\n}\n\nfn just_start(found: Option<char>) -> Result<OuterSlot, JustError> {\n    match read_start_lane(found) {\n        Ok(slot) => Ok(slot),\n        Err(error) => Err(JustError::At(error, 0)),\n    }\n}\n\nfn just_end(found: Option<char>, index: usize) -> Result<SensorArea, JustError> {\n    match read_end_area(found) {\n        Ok(area) => Ok(area),\n        Err(error) => Err(JustError::At(error, index)),\n    }\n}\n\nfn just_outer(area: SensorArea) -> Result<OuterSlot, JustError> {\n    match area.to_outer_slot() {\n        Some(slot) => Ok(slot),\n        None => Err(JustError::EndNotOuter),\n    }\n}\n\n/// The priority is >, <, ^, V, w, default; it is independent of shape dispatch.\n/// In the default branch the start character is deliberately never validated.\npub fn detect_just_type_observed(\n    facts: JustFacts,\n    start: Option<char>,\n    end2: Option<char>,\n    end3: Option<char>,\n) -> Result<bool, JustError> {\n    if facts.circle_right {\n        let start_lane = read_try!(just_start(start));\n        let _end = read_try!(just_end(end2, 2));\n        Ok(shape::outer_slot_is_upper_half(start_lane))\n    } else if facts.circle_left {\n        let start_lane = read_try!(just_start(start));\n        let _end = read_try!(just_end(end2, 2));\n        Ok(!shape::outer_slot_is_upper_half(start_lane))\n    } else if facts.circle_up {\n        let start_lane = read_try!(just_start(start));\n        let end_area = read_try!(just_end(end2, 2));\n        match shape::relative_end_from_typed(start_lane, end_area) {\n            Ok(rel_end) => Ok(rel_end < 4),\n            Err(error) => Err(JustError::Shape(error)),\n        }\n    } else if facts.turn {\n        let _start = read_try!(just_start(start));\n        let end_area = read_try!(just_end(end3, 3));\n        let end_zone = read_try!(just_outer(end_area));\n        Ok(shape::outer_slot_is_right_half(end_zone))\n    } else if facts.wifi {\n        let _start = read_try!(just_start(start));\n        let end_area = read_try!(just_end(end2, 2));\n        let end_zone = read_try!(just_outer(end_area));\n        Ok(shape::outer_slot_is_upper_half(end_zone))\n    } else {\n        let end_area = if facts.qq || facts.pp {\n            read_try!(just_end(end3, 3))\n        } else {\n            read_try!(just_end(end2, 2))\n        };\n        let end_zone = read_try!(just_outer(end_area));\n        Ok(shape::outer_slot_is_right_half(end_zone))\n    }\n}\n\npub fn detect_just_type(chars: &[char]) -> Result<bool, JustError> {\n    let facts = just_facts(chars);\n    detect_just_type_observed(facts, get_at(chars, 0), get_at(chars, 2), get_at(chars, 3))\n}\n"},{"id":26,"name":{"Local":"crates/lnmai-core-verify/src/slide_parser_sequence.rs"},"crate_name":"lnmai_core_verify","contents":"//! Ordered, fallible collection shared with the runtime slide timing-point parser.\n//! The callback owns each result; indexing the caller's input stays in its adapter.\n\n/// Call each index once in ascending order, stopping at the first error.\n/// Successful values are appended in that same order; an error discards the prefix.\n#[allow(clippy::question_mark)]\npub fn try_map_indexed<T, E, F>(len: usize, parse: F) -> Result<Vec<T>, E>\nwhere\n    F: Fn(usize) -> Result<T, E>,\n{\n    let mut result = Vec::new();\n    let mut index = 0usize;\n    while index < len {\n        let value = match parse(index) {\n            Ok(value) => value,\n            Err(error) => return Err(error),\n        };\n        result.push(value);\n        index += 1;\n    }\n    Ok(result)\n}\n"},{"id":27,"name":{"Local":"crates/lnmai-core-verify/src/slide_parser_text.rs"},"crate_name":"lnmai_core_verify","contents":"//! Text scans used by the slide parser's command and sanitizer adapters.\n//! UTF-8 decoding, String construction, and their allocation bounds stay in the\n//! runtime. These kernels preserve arbitrary character sequences and scan order.\n\nuse crate::slide_parser::{keep_slide_char, CommandFacts};\nuse crate::slide_parser_frontend::{contains_char, contains_double};\n\n/// Observe the whole text, including conflicting commands and malformed input.\npub fn command_facts(chars: &[char]) -> CommandFacts {\n    CommandFacts {\n        line: contains_char(chars, '-'),\n        circle_right: contains_char(chars, '>'),\n        circle_left: contains_char(chars, '<'),\n        circle_up: contains_char(chars, '^'),\n        v: contains_char(chars, 'v'),\n        pp: contains_double(chars, 'p'),\n        qq: contains_double(chars, 'q'),\n        p: contains_char(chars, 'p'),\n        q: contains_char(chars, 'q'),\n        s: contains_char(chars, 's'),\n        z: contains_char(chars, 'z'),\n        turn: contains_char(chars, 'V'),\n        wifi: contains_char(chars, 'w'),\n    }\n}\n\n/// Remove only the six flag characters, preserving all remaining characters in\n/// order. Filtering may create adjacent pp/qq pairs, so callers scan the result.\npub fn sanitize_slide_chars(chars: &[char]) -> Vec<char> {\n    let mut result = Vec::new();\n    let mut index = 0usize;\n    while index < chars.len() {\n        let c = chars[index];\n        if keep_slide_char(c) {\n            result.push(c);\n        }\n        index += 1;\n    }\n    result\n}\n"},{"id":28,"name":{"Local":"crates/lnmai-core-verify/src/slide_queue.rs"},"crate_name":"lnmai_core_verify","contents":"//! Ordered checkpoint traversal, shared by replay and rendered gameplay.\n//!\n//! The output contains hide-progress values in emission order. The runtime\n//! attaches the note and optional track identifiers to these values.\n\nuse crate::lifecycle::SlideArea;\nuse crate::storage::SensorVec;\n\n#[allow(clippy::vec_init_then_push)]\nfn with_head<P: Clone>(head: SlideArea<P>, tail: &[SlideArea<P>]) -> Vec<SlideArea<P>> {\n    let mut result = Vec::new();\n    result.push(head);\n    result.extend_from_slice(tail);\n    result\n}\n\nfn prepend_progress<P: Clone>(emit: bool, progress: &P, rest: &[P]) -> Vec<P> {\n    let mut result = Vec::new();\n    if emit {\n        result.push(progress.clone());\n        result.extend_from_slice(rest);\n    }\n    result\n}\n\n// Aeneas models Vec/slice lengths; keep emptiness and singleton construction\n// within that model. Fuel is decremented on every recursive call.\n#[allow(clippy::len_zero)]\npub fn advance_fuel<P: Clone>(\n    fuel: usize,\n    emit: bool,\n    queue: &[SlideArea<P>],\n    held: &SensorVec<bool>,\n) -> (Vec<SlideArea<P>>, Vec<P>) {\n    if queue.len() == 0 {\n        return (Vec::new(), Vec::new());\n    }\n    if fuel == 0 {\n        return (queue.to_vec(), Vec::new());\n    }\n    let fuel = fuel - 1;\n    let first = queue[0].check(held);\n    let rest = &queue[1..];\n    if rest.len() == 0 {\n        if first.is_finished() {\n            let commands = prepend_progress(emit, &first.arrow_progress_when_finished, &[]);\n            (Vec::new(), commands)\n        } else if first.on() {\n            let commands = prepend_progress(emit, &first.arrow_progress_when_on, &[]);\n            (with_head(first, rest), commands)\n        } else {\n            (with_head(first, rest), Vec::new())\n        }\n    } else if first.is_skippable || first.on() {\n        let second = rest[0].check(held);\n        let rest2 = &rest[1..];\n        if second.is_finished() {\n            let (remaining, commands) = advance_fuel(fuel, emit, rest2, held);\n            let commands = prepend_progress(emit, &second.arrow_progress_when_finished, &commands);\n            (remaining, commands)\n        } else if second.on() {\n            let next = with_head(second.clone(), rest2);\n            let (remaining, commands) = advance_fuel(fuel, emit, &next, held);\n            let commands = prepend_progress(emit, &second.arrow_progress_when_on, &commands);\n            (remaining, commands)\n        } else if first.is_finished() {\n            let next = with_head(second, rest2);\n            let (remaining, commands) = advance_fuel(fuel, emit, &next, held);\n            let commands = prepend_progress(emit, &first.arrow_progress_when_finished, &commands);\n            (remaining, commands)\n        } else {\n            let next = with_head(second, rest2);\n            (with_head(first, &next), Vec::new())\n        }\n    } else if first.is_finished() {\n        let (remaining, commands) = advance_fuel(fuel, emit, rest, held);\n        let commands = prepend_progress(emit, &first.arrow_progress_when_finished, &commands);\n        (remaining, commands)\n    } else {\n        (with_head(first, rest), Vec::new())\n    }\n}\n\n/// Queue length supplies the reference traversal's initial fuel.\npub fn advance<P: Clone>(\n    emit: bool,\n    queue: &[SlideArea<P>],\n    held: &SensorVec<bool>,\n) -> (Vec<SlideArea<P>>, Vec<P>) {\n    advance_fuel(queue.len() + 1, emit, queue, held)\n}\n"},{"id":29,"name":{"Local":"crates/lnmai-core-verify/src/slide_queue_metrics.rs"},"crate_name":"lnmai_core_verify","contents":"//! Queue observations shared by slide lifecycles and parent scheduling.\n//! These scans inspect lengths only; checkpoint payloads stay unrestricted.\n\n/// Maximum remaining checkpoint count, including zero for no tracks.\npub fn remaining<T>(queues: &[Vec<T>]) -> usize {\n    let mut maximum = 0usize;\n    let mut index = 0usize;\n    while index < queues.len() {\n        let count = queues[index].len();\n        if maximum < count {\n            maximum = count;\n        }\n        index += 1;\n    }\n    maximum\n}\n\n/// Stop at the first nonempty track, matching the reference recursion.\npub fn cleared<T>(queues: &[Vec<T>]) -> bool {\n    let mut index = 0usize;\n    while index < queues.len() {\n        let count = queues[index].len();\n        if count != 0 {\n            return false;\n        }\n        index += 1;\n    }\n    true\n}\n"},{"id":30,"name":{"Local":"crates/lnmai-core-verify/src/slide_schedule.rs"},"crate_name":"lnmai_core_verify","contents":"//! The slide-body pass shared with the runtime scheduler.\n//!\n//! Slots before `index` have already received their lifecycle step. Parent\n//! effects and readiness refresh still update the entire live collection, so\n//! both earlier and later slots observe those effects. Only the index advances;\n//! no cached pending tail can overwrite a parent update.\n\n/// Forward-order buffers and the next slot to step. The runtime adapter reverses\n/// the reference's initial accumulators before entering this kernel.\npub struct SlideWork<S, E, A, R> {\n    pub slides: S,\n    pub events: E,\n    pub audio: A,\n    pub render: R,\n    pub index: usize,\n}\n\n/// Each method is one atomic adapter, never an iteration or a complete pass.\n/// Named methods avoid higher-ranked borrowed closure bounds in extraction.\n/// `read` clones one slot; `replace` clones only its replacement. Parent and\n/// refresh operations preserve slot count and order. Append preserves both\n/// batches' order; allocation/representation conditions belong to the adapter.\n/// The lifecycle event batch contains zero or one event.\npub trait SlideSchedule<S, N, E, A, R> {\n    fn read(&self, slides: &S, index: usize) -> N;\n    fn step(&self, note: &N) -> (N, E, A, R);\n    fn replace(&self, slides: S, index: usize, note: &N) -> S;\n    fn force_direct(&self, slides: S, before: &N, after: &N) -> (S, R);\n    fn end_ancestors(&self, slides: S, before: &N, after: &N) -> (S, R);\n    fn refresh(&self, slides: S) -> S;\n    fn append_events(&self, accumulated: E, batch: E) -> E;\n    fn append_audio(&self, accumulated: A, batch: A) -> A;\n    fn append_render(&self, accumulated: R, batch: R) -> R;\n}\n\n/// The guard and length-preserving adapters justify every slot read/write and\n/// increment. `len - index` decreases, bounding the pass by pending slot count\n/// without computing the reference's potentially overflowing `pending + 1`.\npub fn process<S, N, E, A, R, Ops>(\n    len: usize,\n    mut work: SlideWork<S, E, A, R>,\n    ops: Ops,\n) -> SlideWork<S, E, A, R>\nwhere\n    Ops: SlideSchedule<S, N, E, A, R>,\n{\n    while work.index < len {\n        let before = ops.read(&work.slides, work.index);\n        let (after, events, audio, render) = ops.step(&before);\n        work.slides = ops.replace(work.slides, work.index, &after);\n        work.render = ops.append_render(work.render, render);\n        let (slides, direct_render) = ops.force_direct(work.slides, &before, &after);\n        work.slides = slides;\n        work.render = ops.append_render(work.render, direct_render);\n        let (slides, ancestor_render) = ops.end_ancestors(work.slides, &before, &after);\n        work.slides = slides;\n        work.render = ops.append_render(work.render, ancestor_render);\n        work.slides = ops.refresh(work.slides);\n        work.events = ops.append_events(work.events, events);\n        work.audio = ops.append_audio(work.audio, audio);\n        work.index += 1;\n    }\n    work\n}\n"},{"id":31,"name":{"Local":"crates/lnmai-core-verify/src/slide_tables.rs"},"crate_name":"lnmai_core_verify","contents":"//! Finite scalar slide tables shared with the runtime.\n//! Exact string classification (including stripping ONE mirror prefix) and\n//! rational construction are runtime adapters. Unknown includes every string\n//! outside the listed keys; Line2/Line8 intentionally have no scalar entries.\n\n#[derive(Debug, Clone, Copy)]\npub enum TableKey {\n    Circle1,\n    Circle2,\n    Circle3,\n    Circle4,\n    Circle5,\n    Circle6,\n    Circle7,\n    Circle8,\n    Line2,\n    Line3,\n    Line4,\n    Line5,\n    Line6,\n    Line7,\n    Line8,\n    V1,\n    V2,\n    V3,\n    V4,\n    V6,\n    V7,\n    V8,\n    Ppqq1,\n    Ppqq2,\n    Ppqq3,\n    Ppqq4,\n    Ppqq5,\n    Ppqq6,\n    Ppqq7,\n    Ppqq8,\n    Pq1,\n    Pq2,\n    Pq3,\n    Pq4,\n    Pq5,\n    Pq6,\n    Pq7,\n    Pq8,\n    L2,\n    L3,\n    L4,\n    L5,\n    S,\n    Wifi,\n    Unknown,\n}\n\n/// Visual path weights, distinct from judge-queue lengths.\npub fn slide_bar_count(key: TableKey) -> Option<usize> {\n    match key {\n        TableKey::Circle1 => Some(64),\n        TableKey::Circle2 => Some(8),\n        TableKey::Circle3 => Some(16),\n        TableKey::Circle4 => Some(24),\n        TableKey::Circle5 => Some(32),\n        TableKey::Circle6 => Some(40),\n        TableKey::Circle7 => Some(48),\n        TableKey::Circle8 => Some(56),\n        TableKey::Line3 => Some(14),\n        TableKey::Line4 => Some(19),\n        TableKey::Line5 => Some(20),\n        TableKey::Line6 => Some(19),\n        TableKey::Line7 => Some(14),\n        TableKey::V1 => Some(21),\n        TableKey::V2 | TableKey::V3 | TableKey::V4 | TableKey::V6 | TableKey::V7 | TableKey::V8 => {\n            Some(20)\n        }\n        TableKey::Ppqq1 => Some(36),\n        TableKey::Ppqq2 => Some(29),\n        TableKey::Ppqq3 => Some(23),\n        TableKey::Ppqq4 | TableKey::Ppqq5 => Some(50),\n        TableKey::Ppqq6 => Some(49),\n        TableKey::Ppqq7 => Some(47),\n        TableKey::Ppqq8 => Some(42),\n        TableKey::Pq1 => Some(34),\n        TableKey::Pq2 => Some(31),\n        TableKey::Pq3 => Some(28),\n        TableKey::Pq4 => Some(25),\n        TableKey::Pq5 => Some(22),\n        TableKey::Pq6 => Some(43),\n        TableKey::Pq7 => Some(41),\n        TableKey::Pq8 => Some(37),\n        TableKey::L2 => Some(33),\n        TableKey::L3 => Some(35),\n        TableKey::L4 => Some(33),\n        TableKey::L5 => Some(29),\n        TableKey::S => Some(31),\n        _ => None,\n    }\n}\n\n/// Select exact millionths before the runtime constructs its unbounded Rat.\npub fn slide_last_wait_millionths(key: TableKey, is_classic: bool) -> Option<u32> {\n    let (modern, classic) = match key {\n        TableKey::Circle1 => (58000, 65500),\n        TableKey::Circle2 => (465000, 505000),\n        TableKey::Circle3 => (233000, 263000),\n        TableKey::Circle4 => (155000, 175000),\n        TableKey::Circle5 => (116000, 131000),\n        TableKey::Circle6 => (93000, 108000),\n        TableKey::Circle7 => (78000, 85500),\n        TableKey::Circle8 => (66000, 76000),\n        TableKey::Line3 | TableKey::Line7 => (182000, 277000),\n        TableKey::Line4 | TableKey::Line6 => (190000, 230000),\n        TableKey::Line5 => (152000, 167000),\n        TableKey::V1 => (185000, 205000),\n        TableKey::V2 => (150000, 170000),\n        TableKey::V3 | TableKey::V4 | TableKey::V6 | TableKey::V7 => (158000, 178000),\n        TableKey::V8 => (154000, 174000),\n        TableKey::Ppqq1 => (65000, 95000),\n        TableKey::Ppqq2 => (86000, 131000),\n        TableKey::Ppqq3 => (157000, 197000),\n        TableKey::Ppqq4 => (65000, 72500),\n        TableKey::Ppqq5 => (65000, 75000),\n        TableKey::Ppqq6 => (67000, 77000),\n        TableKey::Ppqq7 => (79000, 94000),\n        TableKey::Ppqq8 => (62600, 80100),\n        TableKey::L2 => (100000, 120000),\n        TableKey::L3 => (104000, 114000),\n        TableKey::L4 => (98000, 123000),\n        TableKey::L5 => (105000, 150000),\n        TableKey::S => (130000, 155000),\n        TableKey::Pq1 => (95000, 115000),\n        TableKey::Pq2 => (112000, 137000),\n        TableKey::Pq3 => (125000, 150000),\n        TableKey::Pq4 => (139000, 169000),\n        TableKey::Pq5 => (160000, 192500),\n        TableKey::Pq6 => (80000, 97500),\n        TableKey::Pq7 => (84000, 104000),\n        TableKey::Pq8 => (89500, 109500),\n        TableKey::Wifi => (162870, 162870),\n        _ => return None,\n    };\n    Some(if is_classic { classic } else { modern })\n}\n"},{"id":32,"name":{"Local":"crates/lnmai-core-verify/src/storage.rs"},"crate_name":"lnmai_core_verify","contents":"//! List-backed note storage.\n//!\n//! Mirrors `LnmaiCore/Storage.lean`. The Lean module is generic over the\n//! stored element type; this port preserves that with `T: Clone`.\n\nuse crate::areas::{ButtonZone, SensorArea};\nuse crate::constants::SENSOR_AREA_COUNT;\n\n/// `sensorAreaToStorageIndex`: sensor areas are stored in A/D/C/E/B order.\npub fn sensor_area_to_storage_index(area: SensorArea) -> usize {\n    match area {\n        SensorArea::A1 => 0,\n        SensorArea::A2 => 1,\n        SensorArea::A3 => 2,\n        SensorArea::A4 => 3,\n        SensorArea::A5 => 4,\n        SensorArea::A6 => 5,\n        SensorArea::A7 => 6,\n        SensorArea::A8 => 7,\n        SensorArea::D1 => 8,\n        SensorArea::D2 => 9,\n        SensorArea::D3 => 10,\n        SensorArea::D4 => 11,\n        SensorArea::D5 => 12,\n        SensorArea::D6 => 13,\n        SensorArea::D7 => 14,\n        SensorArea::D8 => 15,\n        SensorArea::C => 16,\n        SensorArea::E1 => 17,\n        SensorArea::E2 => 18,\n        SensorArea::E3 => 19,\n        SensorArea::E4 => 20,\n        SensorArea::E5 => 21,\n        SensorArea::E6 => 22,\n        SensorArea::E7 => 23,\n        SensorArea::E8 => 24,\n        SensorArea::B1 => 25,\n        SensorArea::B2 => 26,\n        SensorArea::B3 => 27,\n        SensorArea::B4 => 28,\n        SensorArea::B5 => 29,\n        SensorArea::B6 => 30,\n        SensorArea::B7 => 31,\n        SensorArea::B8 => 32,\n    }\n}\n\n/// `sensorAreaOfStorageIndex?`.\npub fn sensor_area_of_storage_index(index: usize) -> Option<SensorArea> {\n    match index {\n        0 => Some(SensorArea::A1),\n        1 => Some(SensorArea::A2),\n        2 => Some(SensorArea::A3),\n        3 => Some(SensorArea::A4),\n        4 => Some(SensorArea::A5),\n        5 => Some(SensorArea::A6),\n        6 => Some(SensorArea::A7),\n        7 => Some(SensorArea::A8),\n        8 => Some(SensorArea::D1),\n        9 => Some(SensorArea::D2),\n        10 => Some(SensorArea::D3),\n        11 => Some(SensorArea::D4),\n        12 => Some(SensorArea::D5),\n        13 => Some(SensorArea::D6),\n        14 => Some(SensorArea::D7),\n        15 => Some(SensorArea::D8),\n        16 => Some(SensorArea::C),\n        17 => Some(SensorArea::E1),\n        18 => Some(SensorArea::E2),\n        19 => Some(SensorArea::E3),\n        20 => Some(SensorArea::E4),\n        21 => Some(SensorArea::E5),\n        22 => Some(SensorArea::E6),\n        23 => Some(SensorArea::E7),\n        24 => Some(SensorArea::E8),\n        25 => Some(SensorArea::B1),\n        26 => Some(SensorArea::B2),\n        27 => Some(SensorArea::B3),\n        28 => Some(SensorArea::B4),\n        29 => Some(SensorArea::B5),\n        30 => Some(SensorArea::B6),\n        31 => Some(SensorArea::B7),\n        32 => Some(SensorArea::B8),\n        _ => None,\n    }\n}\n\n/// `ButtonZone.storageOrder` (identity order).\npub fn button_zone_storage_order() -> Vec<ButtonZone> {\n    let mut out = Vec::new();\n    let mut i = 0;\n    while i < 8 {\n        if let Some(zone) = ButtonZone::of_index(i) {\n            out.push(zone);\n        }\n        i += 1;\n    }\n    out\n}\n\npub fn sensor_area_storage_order() -> Vec<SensorArea> {\n    let mut out = Vec::new();\n    let mut i = 0;\n    while i < SENSOR_AREA_COUNT as usize {\n        if let Some(area) = sensor_area_of_storage_index(i) {\n            out.push(area);\n        }\n        i += 1;\n    }\n    out\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct ButtonVec<T> {\n    pub data: Vec<T>,\n}\n\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct SensorVec<T> {\n    pub data: Vec<T>,\n}\n\nimpl<T> Default for ButtonVec<T> {\n    fn default() -> Self {\n        Self { data: Vec::new() }\n    }\n}\n\nimpl<T> Default for SensorVec<T> {\n    fn default() -> Self {\n        Self { data: Vec::new() }\n    }\n}\n\nfn clone_values<T: Clone>(data: &[T]) -> Vec<T> {\n    data.to_vec()\n}\n\nfn list_set_at<T: Clone>(data: &[T], index: usize, value: T) -> Vec<T> {\n    let mut out = clone_values(data);\n    if index < out.len() {\n        out[index] = value;\n    }\n    out\n}\n\nimpl<T: Clone> ButtonVec<T> {\n    pub fn replicate(n: usize, value: T) -> ButtonVec<T> {\n        ButtonVec {\n            data: vec![value; n],\n        }\n    }\n    pub fn get_d(&self, zone: ButtonZone, default: T) -> T {\n        let index = zone.to_index();\n        if index < self.data.len() {\n            self.data[index].clone()\n        } else {\n            default\n        }\n    }\n    pub fn set(&self, zone: ButtonZone, value: T) -> ButtonVec<T> {\n        ButtonVec {\n            data: list_set_at(&self.data, zone.to_index(), value),\n        }\n    }\n    pub fn to_list(&self) -> Vec<T> {\n        clone_values(&self.data)\n    }\n    pub fn entries(&self) -> Vec<(ButtonZone, T)> {\n        let keys = button_zone_storage_order();\n        let mut out = Vec::new();\n        let mut i = 0;\n        while i < keys.len() && i < self.data.len() {\n            out.push((keys[i], self.data[i].clone()));\n            i += 1;\n        }\n        out\n    }\n    pub fn of_fn(f: impl Fn(ButtonZone) -> T) -> ButtonVec<T> {\n        let keys = button_zone_storage_order();\n        let mut out = Vec::new();\n        let mut i = 0;\n        while i < keys.len() {\n            out.push(f(keys[i]));\n            i += 1;\n        }\n        ButtonVec { data: out }\n    }\n    pub fn map_accum<S, B, F>(&self, mut state: S, f: F) -> (ButtonVec<B>, S)\n    where\n        F: Fn(ButtonZone, T, S) -> (B, S),\n    {\n        let keys = button_zone_storage_order();\n        let mut out = Vec::new();\n        let mut i = 0;\n        while i < keys.len() && i < self.data.len() {\n            let (mapped, next) = f(keys[i], self.data[i].clone(), state);\n            out.push(mapped);\n            state = next;\n            i += 1;\n        }\n        (ButtonVec { data: out }, state)\n    }\n}\n\nimpl<T: Clone> SensorVec<T> {\n    pub fn replicate(n: usize, value: T) -> SensorVec<T> {\n        SensorVec {\n            data: vec![value; n],\n        }\n    }\n    pub fn get_d(&self, zone: SensorArea, default: T) -> T {\n        let index = sensor_area_to_storage_index(zone);\n        if index < self.data.len() {\n            self.data[index].clone()\n        } else {\n            default\n        }\n    }\n    pub fn set(&self, zone: SensorArea, value: T) -> SensorVec<T> {\n        SensorVec {\n            data: list_set_at(&self.data, sensor_area_to_storage_index(zone), value),\n        }\n    }\n    pub fn to_list(&self) -> Vec<T> {\n        clone_values(&self.data)\n    }\n    pub fn entries(&self) -> Vec<(SensorArea, T)> {\n        let keys = sensor_area_storage_order();\n        let mut out = Vec::new();\n        let mut i = 0;\n        while i < keys.len() && i < self.data.len() {\n            out.push((keys[i], self.data[i].clone()));\n            i += 1;\n        }\n        out\n    }\n    pub fn of_fn(f: impl Fn(SensorArea) -> T) -> SensorVec<T> {\n        let keys = sensor_area_storage_order();\n        let mut out = Vec::new();\n        let mut i = 0;\n        while i < keys.len() {\n            out.push(f(keys[i]));\n            i += 1;\n        }\n        SensorVec { data: out }\n    }\n    pub fn map_accum<S, B, F>(&self, mut state: S, f: F) -> (SensorVec<B>, S)\n    where\n        F: Fn(SensorArea, T, S) -> (B, S),\n    {\n        let keys = sensor_area_storage_order();\n        let mut out = Vec::new();\n        let mut i = 0;\n        while i < keys.len() && i < self.data.len() {\n            let (mapped, next) = f(keys[i], self.data[i].clone(), state);\n            out.push(mapped);\n            state = next;\n            i += 1;\n        }\n        (SensorVec { data: out }, state)\n    }\n}\n"},{"id":33,"name":{"Local":"crates/lnmai-core-verify/src/symmetry.rs"},"crate_name":"lnmai_core_verify","contents":"//! Slide symmetry group (`DihedralGroup 8` in Lean).\n//!\n//! Mirrors `LnmaiCore/Simai/Symmetry.lean`. The Lean code only ever needs a\n//! group element as \"mirrored or not\" plus a rotation count, and applies it to\n//! sensor areas, so a two-constructor representation is sufficient.\n\nuse crate::areas::SensorArea;\n\n/// An element of the dihedral group on 8 positions.\n#[derive(Debug, Clone, Copy, Eq)]\npub enum SlideSymmetry {\n    /// Rotation by `k` (Lean `DihedralGroup.r k`).\n    R(u32),\n    /// Reflection followed by rotation by `k` (Lean `DihedralGroup.sr k`).\n    Sr(u32),\n}\n\n// Constructor arguments denote residue classes, just like Lean's ZMod 8.\nimpl PartialEq for SlideSymmetry {\n    fn eq(&self, other: &Self) -> bool {\n        is_mirrored(*self) == is_mirrored(*other) && rotation_steps(*self) == rotation_steps(*other)\n    }\n}\n\n/// `SlideSymmetry.direct`.\npub const fn direct() -> SlideSymmetry {\n    SlideSymmetry::R(0)\n}\n\n/// `SlideSymmetry.mirror`.\npub const fn mirror() -> SlideSymmetry {\n    SlideSymmetry::Sr(0)\n}\n\n/// `SlideSymmetry.isMirrored`.\npub fn is_mirrored(g: SlideSymmetry) -> bool {\n    match g {\n        SlideSymmetry::R(_) => false,\n        SlideSymmetry::Sr(_) => true,\n    }\n}\n\n/// `SlideSymmetry.rotationSteps`.\npub fn rotation_steps(g: SlideSymmetry) -> u32 {\n    match g {\n        SlideSymmetry::R(k) => k % 8,\n        SlideSymmetry::Sr(k) => k % 8,\n    }\n}\n\n/// Mirror a sensor area across the vertical axis (Lean's private `reflect`).\nfn reflect(area: SensorArea) -> SensorArea {\n    match area {\n        SensorArea::C => SensorArea::C,\n        SensorArea::A1 => SensorArea::A1,\n        SensorArea::A2 => SensorArea::A8,\n        SensorArea::A3 => SensorArea::A7,\n        SensorArea::A4 => SensorArea::A6,\n        SensorArea::A5 => SensorArea::A5,\n        SensorArea::A6 => SensorArea::A4,\n        SensorArea::A7 => SensorArea::A3,\n        SensorArea::A8 => SensorArea::A2,\n        SensorArea::B1 => SensorArea::B1,\n        SensorArea::B2 => SensorArea::B8,\n        SensorArea::B3 => SensorArea::B7,\n        SensorArea::B4 => SensorArea::B6,\n        SensorArea::B5 => SensorArea::B5,\n        SensorArea::B6 => SensorArea::B4,\n        SensorArea::B7 => SensorArea::B3,\n        SensorArea::B8 => SensorArea::B2,\n        SensorArea::D1 => SensorArea::D1,\n        SensorArea::D2 => SensorArea::D8,\n        SensorArea::D3 => SensorArea::D7,\n        SensorArea::D4 => SensorArea::D6,\n        SensorArea::D5 => SensorArea::D5,\n        SensorArea::D6 => SensorArea::D4,\n        SensorArea::D7 => SensorArea::D3,\n        SensorArea::D8 => SensorArea::D2,\n        SensorArea::E1 => SensorArea::E1,\n        SensorArea::E2 => SensorArea::E8,\n        SensorArea::E3 => SensorArea::E7,\n        SensorArea::E4 => SensorArea::E6,\n        SensorArea::E5 => SensorArea::E5,\n        SensorArea::E6 => SensorArea::E4,\n        SensorArea::E7 => SensorArea::E3,\n        SensorArea::E8 => SensorArea::E2,\n    }\n}\n\n/// `SlideSymmetry.actOnSensorArea`.\npub fn act_on_sensor_area(g: SlideSymmetry, area: SensorArea) -> SensorArea {\n    match g {\n        SlideSymmetry::R(k) => area.rotate(k as usize),\n        SlideSymmetry::Sr(k) => reflect(area).rotate(k as usize),\n    }\n}\n"},{"id":34,"name":{"Local":"crates/lnmai-core-verify/src/tap_schedule.rs"},"crate_name":"lnmai_core_verify","contents":"//! The tap-family queue traversal shared with the runtime scheduler.\n//!\n//! The queue's current slot is peeked before inspecting fuel. Only an Ended\n//! result advances the queue/frontier, and another iteration requires an\n//! unused button or the just-processed note's fallback sensor click.\n\n/// Events use the reference's reverse accumulator order. The outer runtime\n/// pass reverses the accumulated events once, after processing all zones.\npub struct TapWork<Q, F, C, E> {\n    pub queue: Q,\n    pub frontiers: F,\n    pub cursor: C,\n    pub events_rev: E,\n}\n\n/// Named point operations, following SlideSchedule's extraction interface.\n/// No method traverses a queue or decides whether to continue it. `step` is\n/// exactly one note's lifecycle call; its result does not include a queue,\n/// frontier, cursor, or accumulated event buffer. Time, note fields, Natural\n/// counters and container/allocation laws remain concrete adapter boundaries.\npub trait TapSchedule<Q, N, F, C, E, Event, D, Area> {\n    fn peek(&self, queue: &Q) -> Option<N>;\n    fn button_diff(&self, note: &N) -> D;\n    fn sensor_diff(&self, note: &N) -> D;\n    fn eligible(&self, note: &N) -> bool;\n    fn unlocked(&self, frontiers: &F, note: &N) -> bool;\n    fn fallback_area(&self, note: &N) -> Area;\n    fn button_available(&self, cursor: &C) -> bool;\n    fn sensor_available(&self, cursor: &C, area: &Area) -> bool;\n    fn use_button(&self, cursor: C) -> C;\n    fn use_sensor(&self, cursor: C, area: &Area) -> C;\n    fn step(&self, note: &N, diff: D, clicked: bool) -> (N, Option<Event>);\n    fn ended(&self, note: &N) -> bool;\n    fn prepend_event(&self, events_rev: E, event: Event) -> E;\n    fn advance(&self, queue: Q) -> Q;\n    fn advance_frontier(&self, frontiers: F) -> F;\n    fn replace_current(&self, queue: Q, note: &N) -> Q;\n}\n\n/// The complete queue control flow. `fuel` decreases only on a continuing\n/// Ended branch and only after its nonzero guard. Passing the remaining slot\n/// count suffices; the runtime wrapper need not compute `remaining + 1`.\npub fn process<Q, N, F, C, E, Event, D, Area, Ops>(\n    mut fuel: usize,\n    mut work: TapWork<Q, F, C, E>,\n    ops: Ops,\n) -> TapWork<Q, F, C, E>\nwhere\n    Ops: TapSchedule<Q, N, F, C, E, Event, D, Area>,\n{\n    loop {\n        let before = match ops.peek(&work.queue) {\n            None => return work,\n            Some(note) => note,\n        };\n        if fuel == 0 {\n            return work;\n        }\n\n        let button_diff = ops.button_diff(&before);\n        let sensor_diff = ops.sensor_diff(&before);\n        let allow_input = ops.eligible(&before) && ops.unlocked(&work.frontiers, &before);\n        let fallback_area = ops.fallback_area(&before);\n        // Both comparisons observe the cursor before either counter update.\n        let plan = crate::scheduler::consume_click(\n            allow_input,\n            ops.button_available(&work.cursor),\n            ops.sensor_available(&work.cursor, &fallback_area),\n        );\n        if plan.used_button {\n            work.cursor = ops.use_button(work.cursor);\n        }\n        if plan.used_sensor {\n            work.cursor = ops.use_sensor(work.cursor, &fallback_area);\n        }\n        let (clicked, diff) = if plan.used_button {\n            (true, button_diff)\n        } else if plan.used_sensor {\n            (true, sensor_diff)\n        } else {\n            (false, button_diff)\n        };\n        let (after, event) = ops.step(&before, diff, clicked);\n        let ended = ops.ended(&after);\n        if let Some(event) = event {\n            work.events_rev = ops.prepend_event(work.events_rev, event);\n        }\n\n        if ended {\n            // Ended with no event still advances both positions. The old\n            // queue slot is deliberately retained rather than replaced.\n            work.queue = ops.advance(work.queue);\n            work.frontiers = ops.advance_frontier(work.frontiers);\n            let continue_queue = crate::scheduler::tap_queue_has_unused_click(\n                ops.button_available(&work.cursor),\n                ops.sensor_available(&work.cursor, &fallback_area),\n            );\n            if !continue_queue {\n                return work;\n            }\n            fuel -= 1;\n        } else {\n            work.queue = ops.replace_current(work.queue, &after);\n            return work;\n        }\n    }\n}\n"},{"id":35,"name":{"Local":"crates/lnmai-core-verify/src/time.rs"},"crate_name":"lnmai_core_verify","contents":"//! Microsecond timeline types.\n//!\n//! Matches `LnmaiCore/Time.lean`: a `Duration`/`TimePoint` is an integer\n//! microsecond tick count. Lean models the underlying value as an unbounded\n//! `ℤ`; here it is an `i64`. Equivalence proofs must therefore establish the\n//! game-range bounds under which the two agree.\n\n/// A duration on the song timeline, in microseconds.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub struct Duration {\n    pub micros: i64,\n}\n\nimpl Duration {\n    pub const fn from_micros(micros: i64) -> Duration {\n        Duration { micros }\n    }\n\n    pub const fn zero() -> Duration {\n        Duration { micros: 0 }\n    }\n\n    pub const fn to_micros(self) -> i64 {\n        self.micros\n    }\n\n    pub fn abs(self) -> Duration {\n        if self.micros < 0 {\n            Duration {\n                micros: -self.micros,\n            }\n        } else {\n            self\n        }\n    }\n\n    pub fn scale_nat(self, factor: u32) -> Duration {\n        Duration {\n            micros: self.micros * (factor as i64),\n        }\n    }\n\n    pub fn div_nat(self, divisor: u32) -> Duration {\n        if divisor == 0 {\n            Duration { micros: 0 }\n        } else {\n            let divisor = divisor as i64;\n            let quotient = self.micros / divisor;\n            let remainder = self.micros % divisor;\n            Duration {\n                micros: if remainder < 0 {\n                    quotient - 1\n                } else {\n                    quotient\n                },\n            }\n        }\n    }\n}\n\nimpl core::ops::Add for Duration {\n    type Output = Duration;\n    fn add(self, rhs: Duration) -> Duration {\n        Duration {\n            micros: self.micros + rhs.micros,\n        }\n    }\n}\n\nimpl core::ops::Sub for Duration {\n    type Output = Duration;\n    fn sub(self, rhs: Duration) -> Duration {\n        Duration {\n            micros: self.micros - rhs.micros,\n        }\n    }\n}\n\n/// A point on the song timeline, in microseconds.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub struct TimePoint {\n    pub micros: i64,\n}\n\nimpl TimePoint {\n    pub const fn from_micros(micros: i64) -> TimePoint {\n        TimePoint { micros }\n    }\n\n    pub const fn zero() -> TimePoint {\n        TimePoint { micros: 0 }\n    }\n\n    pub const fn to_micros(self) -> i64 {\n        self.micros\n    }\n}\n\nimpl core::ops::Sub for TimePoint {\n    type Output = Duration;\n    fn sub(self, rhs: TimePoint) -> Duration {\n        Duration {\n            micros: self.micros - rhs.micros,\n        }\n    }\n}\n"},{"id":36,"name":{"Local":"crates/lnmai-core-verify/src/timing_aggregate.rs"},"crate_name":"lnmai_core_verify","contents":"//! Ordered timing aggregation shared with the runtime parser.\n//! Parsing and exact-number operations stay in pointwise callback adapters.\n\n/// Skip failed entries and add successful exact values in input order.\n/// No successful entry means `None`; the first success needs no zero value.\npub fn sum_optional_indexed<T, P, A>(len: usize, parse: P, add: A) -> Option<T>\nwhere\n    P: Fn(usize) -> Option<T>,\n    A: Fn(T, T) -> T,\n{\n    let mut total = None;\n    let mut index = 0usize;\n    while index < len {\n        if let Some(value) = parse(index) {\n            total = Some(match total {\n                Some(sum) => add(sum, value),\n                None => value,\n            });\n        }\n        index += 1;\n    }\n    total\n}\n\n/// Quantize exactly once after the complete exact sum, or never for `None`.\n#[allow(clippy::manual_map)]\npub fn sum_then_map_indexed<T, U, P, A, Q>(len: usize, parse: P, add: A, quantize: Q) -> Option<U>\nwhere\n    P: Fn(usize) -> Option<T>,\n    A: Fn(T, T) -> T,\n    Q: Fn(T) -> U,\n{\n    match sum_optional_indexed(len, parse, add) {\n        Some(total) => Some(quantize(total)),\n        None => None,\n    }\n}\n\n/// Continue after failed entries and return immediately at the first success.\n/// The callback is never invoked for entries after that success.\npub fn first_some_indexed<T, P>(len: usize, parse: P) -> Option<T>\nwhere\n    P: Fn(usize) -> Option<T>,\n{\n    let mut index = 0usize;\n    while index < len {\n        if let Some(value) = parse(index) {\n            return Some(value);\n        }\n        index += 1;\n    }\n    None\n}\n"},{"id":37,"name":{"Local":"crates/lnmai-core-verify/src/timing_number.rs"},"crate_name":"lnmai_core_verify","contents":"//! Character-level decimal timing numbers, shared with the runtime parser.\n//! Trimming/UTF-8 decoding and unbounded arithmetic remain in the caller.\n\nuse crate::natural_parser::decimal_digit;\n\n/// Only the exact natural-number primitives used by the scan.\npub trait DecimalOps<T> {\n    fn zero(&self) -> T;\n    fn one(&self) -> T;\n    fn append(&self, value: T, digit: u8) -> T;\n}\n\npub struct Parts<T> {\n    pub negative: bool,\n    pub whole: T,\n    pub fraction: Option<(T, T)>,\n}\n\n/// Scan the characters after the first decimal point. Empty fractions denote\n/// zero over one; underscores and all non-ASCII digits are rejected.\n#[allow(clippy::question_mark)]\npub fn fraction<T, O: DecimalOps<T>>(chars: &[char], mut index: usize, ops: &O) -> Option<(T, T)> {\n    if index > chars.len() {\n        return None;\n    }\n    let mut value = ops.zero();\n    let mut denominator = ops.one();\n    while index < chars.len() {\n        let digit = match decimal_digit(chars[index]) {\n            Some(digit) => digit,\n            None => return None,\n        };\n        value = ops.append(value, digit);\n        denominator = ops.append(denominator, 0);\n        index += 1;\n    }\n    Some((value, denominator))\n}\n\n/// Parse a trimmed timing number. The whole part follows Lean `toNat?`,\n/// including single internal underscores; the fractional part is digits only.\n/// A single leading minus is accepted, while plus signs and empty wholes fail.\n#[allow(clippy::question_mark)]\npub fn parse<T, O: DecimalOps<T>>(chars: &[char], ops: &O) -> Option<Parts<T>> {\n    if chars.is_empty() {\n        return None;\n    }\n    let negative = chars[0] == '-';\n    let mut index = if negative { 1 } else { 0 };\n    let mut whole = ops.zero();\n    let mut last_was_digit = false;\n    while index < chars.len() {\n        let c = chars[index];\n        if c == '.' {\n            if !last_was_digit {\n                return None;\n            }\n            index += 1;\n            return match fraction(chars, index, ops) {\n                Some(fraction) => Some(Parts {\n                    negative,\n                    whole,\n                    fraction: Some(fraction),\n                }),\n                None => None,\n            };\n        } else if c == '_' {\n            if !last_was_digit {\n                return None;\n            }\n            last_was_digit = false;\n        } else {\n            let digit = match decimal_digit(c) {\n                Some(digit) => digit,\n                None => return None,\n            };\n            whole = ops.append(whole, digit);\n            last_was_digit = true;\n        }\n        index += 1;\n    }\n    if last_was_digit {\n        Some(Parts {\n            negative,\n            whole,\n            fraction: None,\n        })\n    } else {\n        None\n    }\n}\n"},{"id":38,"name":{"Local":"crates/lnmai-core-verify/src/timing_parser.rs"},"crate_name":"lnmai_core_verify","contents":"//! Character scans and field routing shared with the runtime timing parser.\n//! String conversion, exact numeric parsing, and quantization stay in runtime.\n\n/// Preserve the reference's front insertion for a nested opening bracket.\n/// Explicit copying avoids relying on the extractor's Vec::insert model.\nfn prepend_open(current: Vec<char>) -> Vec<char> {\n    let mut result = Vec::new();\n    result.push('[');\n    let mut index = 0usize;\n    while index < current.len() {\n        result.push(current[index]);\n        index += 1;\n    }\n    result\n}\n\n/// Scan complete brackets, including the reference's malformed-input behavior.\n/// Nested '[' is prepended; unmatched ']' and an unfinished tail are ignored.\npub fn extract_brackets(chars: &[char]) -> Vec<Vec<char>> {\n    let mut result = Vec::new();\n    let mut inside = false;\n    let mut current = Vec::new();\n    let mut index = 0usize;\n    while index < chars.len() {\n        let c = chars[index];\n        if c == '[' {\n            if inside {\n                current = prepend_open(current);\n            } else {\n                inside = true;\n                current = Vec::new();\n            }\n        } else if c == ']' {\n            if inside {\n                inside = false;\n                result.push(current);\n                current = Vec::new();\n            }\n        } else if inside {\n            current.push(c);\n        }\n        index += 1;\n    }\n    result\n}\n\n#[derive(Clone, Copy)]\npub enum DurationRoute {\n    Reject,\n    CurrentRatioOrSeconds { timing: usize },\n    SecondsOnly { timing: usize },\n    CustomRatioOrSeconds { bpm: usize, timing: usize },\n    CustomRatioOnly { bpm: usize, timing: usize },\n}\n\n/// Classify fields after splitting on '#', before trimming or numeric parsing.\n/// Only a strictly empty first field selects seconds-only for two fields.\n// Vec::len has an extraction model; Vec::is_empty is an opaque external call.\n#[allow(clippy::len_zero)]\npub fn duration_route(fields: &[Vec<char>]) -> DurationRoute {\n    if fields.len() == 1 {\n        DurationRoute::CurrentRatioOrSeconds { timing: 0 }\n    } else if fields.len() == 2 {\n        if fields[0].len() == 0 {\n            DurationRoute::SecondsOnly { timing: 1 }\n        } else {\n            DurationRoute::CustomRatioOrSeconds { bpm: 0, timing: 1 }\n        }\n    } else if fields.len() == 3 {\n        DurationRoute::CurrentRatioOrSeconds { timing: 2 }\n    } else if fields.len() == 4 {\n        DurationRoute::CustomRatioOnly { bpm: 2, timing: 3 }\n    } else {\n        DurationRoute::Reject\n    }\n}\n"},{"id":39,"name":{"Local":"crates/lnmai-core-verify/src/tokenize.rs"},"crate_name":"lnmai_core_verify","contents":"//! Character-level Simai tokenization shared with the runtime parser.\n//! UTF-8 decoding and String construction remain in the runtime adapter.\n\npub fn is_touch_area_char(c: char) -> bool {\n    c == 'A' || c == 'B' || c == 'C' || c == 'D' || c == 'E'\n}\n\npub fn is_slide_mark_char(c: char) -> bool {\n    c == '-'\n        || c == '^'\n        || c == 'v'\n        || c == '<'\n        || c == '>'\n        || c == 'V'\n        || c == 'p'\n        || c == 'q'\n        || c == 's'\n        || c == 'z'\n        || c == 'w'\n        || c == 'K'\n}\n\n/// Preserve empty pieces and treat separators inside brackets as literal text.\n/// Brackets themselves have priority even when the separator is '[' or ']'.\npub fn split_top_level(sep: char, chars: &[char]) -> Vec<Vec<char>> {\n    let mut result = Vec::new();\n    let mut depth = 0usize;\n    let mut current = Vec::new();\n    let mut index = 0usize;\n    while index < chars.len() {\n        let c = chars[index];\n        if c == '[' {\n            depth += 1;\n            current.push(c);\n        } else if c == ']' {\n            depth = depth.saturating_sub(1);\n            current.push(c);\n        } else if c == sep && depth == 0 {\n            result.push(current);\n            current = Vec::new();\n        } else {\n            current.push(c);\n        }\n        index += 1;\n    }\n    result.push(current);\n    result\n}\n"},{"id":40,"name":{"Local":"crates/lnmai-core-verify/src/touch_schedule.rs"},"crate_name":"lnmai_core_verify","contents":"//! Proposed shared kernel for Scheduler.processTouchQueueHeadFuel only.\n//!\n//! The caller supplies the head fuel unchanged. Queue normalization is composed\n//! from queue_maintenance, including at fuel zero and at each recursive-entry\n//! equivalent. This module does not implement the separate automatic pass.\n\nuse crate::queue_maintenance::{self, QueueCursor, QueueReplace};\n\n/// Groups and clicks are shared across iterations; events stay in reverse\n/// accumulator order. The outer sensor pass owns the final reversal.\npub struct TouchWork<Q, F, C, G, E> {\n    pub queue: Q,\n    pub frontiers: F,\n    pub cursor: C,\n    pub groups: G,\n    pub events_rev: E,\n}\n\n/// Scheduler point operations, plus two explicitly identified group subcalls.\n///\n/// `step` is one note's lifecycle call, never a queue/click/group iteration.\n/// `shared_result` and `register_group` retain the existing group-plan helpers;\n/// their list traversal is a SEPARATE proof boundary (SchedulerFrameProof's\n/// group-plan interpretation plus concrete container/number laws). They must\n/// not be described as single field accesses. Queue traversal is composed\n/// below, rather than delegated to normalize/replace callbacks.\n///\n/// M supplies QueueCursor's peek/resolved/advance and QueueReplace's\n/// get/index_equal/write. Each queue_ops result must implement the same laws.\n/// Id represents both group identifiers and group sizes; it is not a usize.\npub trait TouchSchedule<Q, N, F, C, G, E, Event, T, D, Area, Zone, Id, Grade, M> {\n    fn queue_ops(&self) -> M;\n    fn queue_remaining(&self, queue: &Q) -> usize;\n    fn queue_len(&self, queue: &Q) -> usize;\n    fn timing(&self, note: &N) -> T;\n    fn sensor_diff(&self, timing: &T) -> D;\n    fn button_diff(&self, timing: T) -> D;\n    fn group_id(&self, note: &N) -> Option<Id>;\n    fn group_size(&self, note: &N) -> Id;\n    fn shared_result(&self, groups: &G, id: Id) -> Option<(Grade, D)>;\n    fn eligible(&self, note: &N) -> bool;\n    fn unlocked(&self, frontiers: &F, note: &N) -> bool;\n    fn button_ring_for_touch(&self) -> bool;\n    fn sensor_area(&self, note: &N) -> Area;\n    fn outer_button(&self, area: &Area) -> Option<Zone>;\n    fn button_available(&self, cursor: &C, zone: &Zone) -> bool;\n    fn sensor_available(&self, cursor: &C, area: &Area) -> bool;\n    fn use_button(&self, cursor: C, zone: &Zone) -> C;\n    fn use_sensor(&self, cursor: C, area: &Area) -> C;\n    fn step(\n        &self,\n        note: &N,\n        diff: &D,\n        clicked: bool,\n        shared: Option<(Grade, D)>,\n    ) -> (N, Option<Event>);\n    fn ended(&self, note: &N) -> bool;\n    fn event_grade(&self, event: &Event) -> Grade;\n    fn is_miss_or_too_fast(&self, grade: &Grade) -> bool;\n    fn prepend_event(&self, events_rev: E, event: &Event) -> E;\n    fn register_group(&self, groups: G, id: Id, size: Id, grade: Grade, diff: D) -> G;\n    fn advance_frontier(&self, frontiers: F) -> F;\n}\n\n/// Iterative form of the original head-fuel recursion. All head-level\n/// branching is here. A continuation spends one fuel unit, after the\n/// nonzero guard, and normalizes once again at the top of the loop.\npub fn process<Q, N, F, C, G, E, Event, T, D, Area, Zone, Id, Grade, M, Ops>(\n    mut fuel: usize,\n    mut work: TouchWork<Q, F, C, G, E>,\n    ops: Ops,\n) -> TouchWork<Q, F, C, G, E>\nwhere\n    Ops: TouchSchedule<Q, N, F, C, G, E, Event, T, D, Area, Zone, Id, Grade, M>,\n    M: QueueCursor<Q, N> + QueueReplace<Q, N>,\n{\n    loop {\n        let remaining = ops.queue_remaining(&work.queue);\n        work.queue =\n            queue_maintenance::normalize_cursor_fuel(remaining, work.queue, ops.queue_ops());\n        if fuel == 0 {\n            return work;\n        }\n        let maintenance = ops.queue_ops();\n        let before = match maintenance.peek(&work.queue) {\n            None => return work,\n            Some(note) => note,\n        };\n\n        // Compute this even on a shared judgment or a button click.\n        let timing = ops.timing(&before);\n        let sensor_diff = ops.sensor_diff(&timing);\n        let shared = match ops.group_id(&before) {\n            Some(id) => ops.shared_result(&work.groups, id),\n            None => None,\n        };\n        let can_consume_click =\n            shared.is_none() && ops.eligible(&before) && ops.unlocked(&work.frontiers, &before);\n        let area = ops.sensor_area(&before);\n        let mut used_button = false;\n        if can_consume_click && ops.button_ring_for_touch() {\n            if let Some(zone) = ops.outer_button(&area) {\n                if ops.button_available(&work.cursor, &zone) {\n                    work.cursor = ops.use_button(work.cursor, &zone);\n                    used_button = true;\n                }\n            }\n        }\n        let mut used_sensor = false;\n        if can_consume_click && !used_button && ops.sensor_available(&work.cursor, &area) {\n            work.cursor = ops.use_sensor(work.cursor, &area);\n            used_sensor = true;\n        }\n        let clicked = used_button || used_sensor;\n        let diff = if used_button {\n            ops.button_diff(timing)\n        } else {\n            sensor_diff\n        };\n        // No click is required: timeout/shared judgments are part of the head.\n        let (after, event) = ops.step(&before, &diff, clicked, shared);\n        let resolved_now = !maintenance.resolved(&before) && maintenance.resolved(&after);\n        if let Some(event) = event {\n            work.events_rev = ops.prepend_event(work.events_rev, &event);\n            if clicked {\n                let grade = ops.event_grade(&event);\n                if !ops.is_miss_or_too_fast(&grade) {\n                    if let Some(id) = ops.group_id(&before) {\n                        work.groups = ops.register_group(\n                            work.groups,\n                            id,\n                            ops.group_size(&before),\n                            grade,\n                            diff,\n                        );\n                    }\n                }\n            }\n        }\n\n        // Replace EVERY matching id, including duplicate slots before the\n        // cursor. Normalization is independent of whether an event exists.\n        let len = ops.queue_len(&work.queue);\n        work.queue = queue_maintenance::replace_all(len, work.queue, &after, maintenance);\n        let remaining = ops.queue_remaining(&work.queue);\n        work.queue =\n            queue_maintenance::normalize_cursor_fuel(remaining, work.queue, ops.queue_ops());\n        if resolved_now {\n            work.frontiers = ops.advance_frontier(work.frontiers);\n        }\n\n        // Judged is resolved, but only Ended permits another head iteration.\n        if !ops.ended(&after) {\n            return work;\n        }\n        // Match the existing helper's eager ring probe, including when the\n        // ring is disabled; the availability kernel applies the ring flag.\n        let ring_available = match ops.outer_button(&area) {\n            Some(zone) => ops.button_available(&work.cursor, &zone),\n            None => false,\n        };\n        let unused = crate::scheduler::touch_input_available(\n            ops.button_ring_for_touch(),\n            ops.sensor_available(&work.cursor, &area),\n            Some(ring_available),\n        );\n        if !unused {\n            return work;\n        }\n        fuel -= 1;\n    }\n}\n"},{"id":41,"name":{"Local":"crates/lnmai-core-verify/src/types.rs"},"crate_name":"lnmai_core_verify","contents":"//! Core domain types.\n//!\n//! Mirrors `LnmaiCore/Types.lean`. Pure data only; no `String`, no\n//! collections, so the module stays inside the Aeneas subset.\n\nuse super::areas::{ButtonZone, SensorArea};\nuse super::time::Duration;\n\n/// Judgment grades (15-tier lattice, ordered by quality ascending).\n#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Default)]\npub enum JudgeGrade {\n    #[default]\n    Miss,\n    LateGood,\n    LateGreat3rd,\n    LateGreat2nd,\n    LateGreat,\n    LatePerfect3rd,\n    LatePerfect2nd,\n    Perfect,\n    FastPerfect2nd,\n    FastPerfect3rd,\n    FastGreat,\n    FastGreat2nd,\n    FastGreat3rd,\n    FastGood,\n    TooFast,\n}\n\nimpl JudgeGrade {\n    pub fn is_miss_or_too_fast(&self) -> bool {\n        matches!(self, JudgeGrade::Miss | JudgeGrade::TooFast)\n    }\n\n    pub fn is_fast(&self) -> bool {\n        matches!(\n            self,\n            JudgeGrade::FastPerfect2nd\n                | JudgeGrade::FastPerfect3rd\n                | JudgeGrade::FastGreat\n                | JudgeGrade::FastGreat2nd\n                | JudgeGrade::FastGreat3rd\n                | JudgeGrade::FastGood\n                | JudgeGrade::TooFast\n        )\n    }\n\n    pub fn is_late(&self) -> bool {\n        matches!(\n            self,\n            JudgeGrade::LateGood\n                | JudgeGrade::LateGreat3rd\n                | JudgeGrade::LateGreat2nd\n                | JudgeGrade::LateGreat\n                | JudgeGrade::LatePerfect3rd\n                | JudgeGrade::LatePerfect2nd\n                | JudgeGrade::Miss\n        )\n    }\n\n    /// Distance from Critical Perfect (0 = Perfect, 7 = Miss/TooFast).\n    pub fn dist_from_perfect(&self) -> u32 {\n        match self {\n            JudgeGrade::Miss => 7,\n            JudgeGrade::LateGood => 6,\n            JudgeGrade::LateGreat3rd => 5,\n            JudgeGrade::LateGreat2nd => 4,\n            JudgeGrade::LateGreat => 3,\n            JudgeGrade::LatePerfect3rd => 2,\n            JudgeGrade::LatePerfect2nd => 1,\n            JudgeGrade::Perfect => 0,\n            JudgeGrade::FastPerfect2nd => 1,\n            JudgeGrade::FastPerfect3rd => 2,\n            JudgeGrade::FastGreat => 3,\n            JudgeGrade::FastGreat2nd => 4,\n            JudgeGrade::FastGreat3rd => 5,\n            JudgeGrade::FastGood => 6,\n            JudgeGrade::TooFast => 7,\n        }\n    }\n\n    pub fn is_perfect_grade(&self) -> bool {\n        matches!(\n            self,\n            JudgeGrade::Perfect\n                | JudgeGrade::LatePerfect2nd\n                | JudgeGrade::LatePerfect3rd\n                | JudgeGrade::FastPerfect2nd\n                | JudgeGrade::FastPerfect3rd\n        )\n    }\n\n    pub fn is_great_grade(&self) -> bool {\n        matches!(\n            self,\n            JudgeGrade::LateGreat\n                | JudgeGrade::LateGreat2nd\n                | JudgeGrade::LateGreat3rd\n                | JudgeGrade::FastGreat\n                | JudgeGrade::FastGreat2nd\n                | JudgeGrade::FastGreat3rd\n        )\n    }\n\n    pub fn is_good_grade(&self) -> bool {\n        matches!(self, JudgeGrade::LateGood | JudgeGrade::FastGood)\n    }\n}\n\n/// Display/counting option mirrored from MajdataPlay's `JudgeDisplayOption`.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum JudgeDisplayOption {\n    #[default]\n    All,\n    BelowCP,\n    BelowP,\n    BelowGR,\n    MissOnly,\n    Disable,\n}\n\n/// Note types.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum NoteType {\n    #[default]\n    Tap,\n    Hold,\n    Slide,\n    Touch,\n    Break,\n}\n\nimpl NoteType {\n    pub fn base_score(&self) -> u32 {\n        match self {\n            NoteType::Tap => 500,\n            NoteType::Hold => 1000,\n            NoteType::Slide => 1500,\n            NoteType::Touch => 500,\n            NoteType::Break => 2500,\n        }\n    }\n\n    /// `NoteType.extraScore`: Break notes earn 100 extra DX score.\n    pub fn extra_score(&self) -> u32 {\n        match self {\n            NoteType::Break => 100,\n            _ => 0,\n        }\n    }\n}\n\n/// Slide kinds.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum SlideKind {\n    #[default]\n    Single,\n    Wifi,\n    ConnPart,\n}\n\n/// Area policy.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum AreaPolicy {\n    #[default]\n    Or,\n    And,\n}\n\n/// Difficulty / judgment style.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum JudgeStyle {\n    #[default]\n    Default,\n    Maji,\n    Gachi,\n    Gori,\n}\n\n/// Note lifecycle status.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum NoteStatus {\n    #[default]\n    Start,\n    Inited,\n    Scaling,\n    Running,\n    Arrived,\n    End,\n}\n\nimpl NoteStatus {\n    pub fn leq(a: NoteStatus, b: NoteStatus) -> bool {\n        match (a, b) {\n            (NoteStatus::Start, _) => true,\n            (NoteStatus::Inited, NoteStatus::Start) => false,\n            (NoteStatus::Inited, _) => true,\n            (NoteStatus::Scaling, NoteStatus::Start) => false,\n            (NoteStatus::Scaling, NoteStatus::Inited) => false,\n            (NoteStatus::Scaling, _) => true,\n            (NoteStatus::Running, NoteStatus::Start) => false,\n            (NoteStatus::Running, NoteStatus::Inited) => false,\n            (NoteStatus::Running, NoteStatus::Scaling) => false,\n            (NoteStatus::Running, _) => true,\n            (NoteStatus::Arrived, NoteStatus::Start) => false,\n            (NoteStatus::Arrived, NoteStatus::Inited) => false,\n            (NoteStatus::Arrived, NoteStatus::Scaling) => false,\n            (NoteStatus::Arrived, NoteStatus::Running) => false,\n            (NoteStatus::Arrived, _) => true,\n            (NoteStatus::End, NoteStatus::End) => true,\n            (NoteStatus::End, _) => false,\n        }\n    }\n}\n\n/// Combo display state.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Default)]\npub enum ComboState {\n    #[default]\n    None,\n    FC,\n    FCPlus,\n    AP,\n    APPlus,\n}\n\n/// Typed runtime note/event position.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum RuntimePos {\n    Button(ButtonZone),\n    Sensor(SensorArea),\n}\n\nimpl Default for RuntimePos {\n    fn default() -> Self {\n        Self::Button(ButtonZone::K1)\n    }\n}\n\nimpl core::fmt::Display for JudgeGrade {\n    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {\n        core::fmt::Debug::fmt(self, f)\n    }\n}\n\nimpl RuntimePos {\n    pub fn button_zone(&self) -> Option<ButtonZone> {\n        match self {\n            RuntimePos::Button(zone) => Some(*zone),\n            RuntimePos::Sensor(_) => None,\n        }\n    }\n\n    pub fn sensor_area(&self) -> Option<SensorArea> {\n        match self {\n            RuntimePos::Button(_) => None,\n            RuntimePos::Sensor(area) => Some(*area),\n        }\n    }\n}\n\n/// Judge event kind.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum JudgeEventKind {\n    #[default]\n    Tap,\n    Hold,\n    Slide,\n    Touch,\n    Break,\n}\n\n/// A single note's judgment result.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub struct NoteJudgeResult {\n    pub grade: JudgeGrade,\n    pub diff: Duration,\n    pub is_break: bool,\n    pub is_ex: bool,\n}\n\nimpl NoteJudgeResult {\n    pub fn is_fast(&self) -> bool {\n        self.diff.to_micros() < 0\n    }\n\n    pub fn is_miss_or_too_fast(&self) -> bool {\n        self.grade.is_miss_or_too_fast()\n    }\n}\n\n/// Group state for multi-part notes.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub struct GroupState {\n    pub group_id: usize,\n    pub count: usize,\n    pub size: usize,\n    pub grade: JudgeGrade,\n    pub diff: Duration,\n}\n\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub enum JudgePhase {\n    #[default]\n    Head,\n    Tail,\n}\n\n/// Judge event emitted by Core, consumed by the host for rendering.\n#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]\npub struct JudgeEvent {\n    pub kind: JudgeEventKind,\n    pub phase: JudgePhase,\n    pub grade: JudgeGrade,\n    pub diff: Duration,\n    pub position: RuntimePos,\n    pub note_index: usize,\n    pub is_break: bool,\n    pub is_ex: bool,\n    pub multiple: usize,\n}\n\n/// Score accumulation state.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub struct ScoreState {\n    pub combo: usize,\n    pub p_combo: usize,\n    pub c_p_combo: usize,\n    pub total_base: usize,\n    pub total_extra: usize,\n    pub earned_base: usize,\n    pub earned_extra: usize,\n    pub earned_classic_extra: usize,\n    pub lost_base: usize,\n    pub lost_extra: usize,\n    pub lost_classic_extra: usize,\n    pub dx_score: i64,\n    pub max_dx_score: usize,\n    pub fast_count: usize,\n    pub late_count: usize,\n}\n\n// Explicit zero fields avoid external Default calls in the extracted model.\n#[allow(clippy::derivable_impls)]\nimpl Default for ScoreState {\n    fn default() -> Self {\n        ScoreState {\n            combo: 0,\n            p_combo: 0,\n            c_p_combo: 0,\n            total_base: 0,\n            total_extra: 0,\n            earned_base: 0,\n            earned_extra: 0,\n            earned_classic_extra: 0,\n            lost_base: 0,\n            lost_extra: 0,\n            lost_classic_extra: 0,\n            dx_score: 0,\n            max_dx_score: 0,\n            fast_count: 0,\n            late_count: 0,\n        }\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn test_dist_from_perfect() {\n        assert!(matches!(JudgeGrade::Perfect.dist_from_perfect(), 0));\n        assert!(matches!(JudgeGrade::Miss.dist_from_perfect(), 7));\n    }\n\n    #[test]\n    fn test_base_score() {\n        assert!(matches!(NoteType::Break.base_score(), 2500));\n        assert!(matches!(NoteType::Break.extra_score(), 100));\n    }\n}\n"},{"id":42,"name":{"Local":"crates/lnmai-core-verify/src/vec_erase.rs"},"crate_name":"lnmai_core_verify","contents":"//! Ordered removal using modeled slice swaps and the shrinking resize branch.\n\n/// Remove a valid element while preserving the order of all retained elements.\n/// `filler` is required by `resize`; this call always shrinks, so it is never\n/// cloned or inserted. Runtime callers use value types without observable Drop.\npub fn erase<T: Clone>(values: &mut Vec<T>, mut index: usize, filler: T) {\n    let len = values.len();\n    assert!(index < len);\n    let last = len - 1;\n    while index < last {\n        let next = index + 1;\n        values.swap(index, next);\n        index = next;\n    }\n    values.resize(last, filler);\n}\n"},{"id":43,"name":{"Local":"crates/lnmai-core-verify/src/vec_prepend.rs"},"crate_name":"lnmai_core_verify","contents":"//! Ordered front insertion using the modeled push and slice-swap operations.\n//! No old element is cloned or dropped; duplicates retain their source order.\n\n/// Move `head` to the front after pushing it into the existing allocation.\n/// Every swap shifts the new element one slot left. Successful execution\n/// requires space for one extra element, just as insertion at zero does.\npub fn prepend<T>(values: &mut Vec<T>, head: T) {\n    let mut index = values.len();\n    values.push(head);\n    while index > 0 {\n        let previous = index - 1;\n        values.swap(index, previous);\n        index = previous;\n    }\n}\n"},{"id":44,"name":{"Local":"crates/lnmai-core-verify/src/hold_schedule.rs"},"crate_name":"lnmai_core_verify","contents":"//! The ordinary button-hold traversal shared with the runtime scheduler.\n//!\n//! Read the original input list once, in order, threading frontier, queue and\n//! cursor updates between notes. Forward appends preserve the reference's\n//! recursive-cons output order without a recursive Rust traversal.\n\n/// Scheduling observes the constructor, not a HeadJudged/Ended grade payload.\n/// The complete note is still passed to the lifecycle operation.\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum HoldPhase {\n    HeadWaiting,\n    HeadJudgeable,\n    HeadJudged,\n    BodyHeld,\n    BodyReleased,\n    Ended,\n}\n\n/// Forward-order output buffers. Runtime calls start active/events empty.\npub struct HoldWork<F, Q, C, H, E> {\n    pub frontiers: F,\n    pub queues: Q,\n    pub cursor: C,\n    pub active: H,\n    pub events: E,\n}\n\n/// Point reads/writes and one-note lifecycle, with one explicit exception:\n/// update_queue retains the separate replace+normalize composition contract.\n/// No method decides an entire item or pass. length/get observe the immutable\n/// source list; appends preserve order and require sufficient container capacity.\npub trait HoldSchedule<S, Z, N, F, Q, C, H, E, Event, D, Area> {\n    fn length(&self, holds: &S) -> usize;\n    fn get(&self, holds: &S, index: usize) -> (Z, N);\n    fn button_diff(&self, note: &N) -> D;\n    fn sensor_diff(&self, note: &N) -> D;\n    fn button_pressed(&self, zone: &Z) -> bool;\n    fn sensor_pressed(&self, zone: &Z) -> bool;\n    fn prev_sensor_pressed(&self, zone: &Z) -> bool;\n    fn phase(&self, note: &N) -> HoldPhase;\n    fn unlocked(&self, frontiers: &F, zone: &Z, note: &N) -> bool;\n    fn eligible(&self, note: &N) -> bool;\n    fn fallback_area(&self, zone: &Z) -> Area;\n    fn button_available(&self, cursor: &C, zone: &Z) -> bool;\n    fn sensor_available(&self, cursor: &C, area: &Area) -> bool;\n    fn use_button(&self, cursor: C, zone: &Z) -> C;\n    fn use_sensor(&self, cursor: C, area: &Area) -> C;\n    fn step(\n        &self,\n        note: &N,\n        diff: D,\n        clicked: bool,\n        pressed: bool,\n        current_button_pressed: bool,\n        prev_sensor_pressed: bool,\n    ) -> (N, Option<Event>);\n    fn advance_frontier(&self, frontiers: F, zone: &Z) -> F;\n    fn update_queue(&self, queues: Q, zone: &Z, note: &N) -> Q;\n    fn append_active(&self, active: H, zone: Z, note: N) -> H;\n    fn append_event(&self, events: E, event: Event) -> E;\n}\n\n/// Full ordinary-hold pass. The index increases only under index < len, so\n/// index + 1 <= len <= usize::MAX. No recursive traversal or len + 1 is needed.\n/// The queue adapter's separate normalization boundary is unaffected by this.\npub fn process<S, Z, N, F, Q, C, H, E, Event, D, Area, Ops>(\n    holds: &S,\n    mut work: HoldWork<F, Q, C, H, E>,\n    ops: Ops,\n) -> HoldWork<F, Q, C, H, E>\nwhere\n    Ops: HoldSchedule<S, Z, N, F, Q, C, H, E, Event, D, Area>,\n{\n    let len = ops.length(holds);\n    let mut index = 0;\n    while index < len {\n        let (zone, before) = ops.get(holds, index);\n        let button_diff = ops.button_diff(&before);\n        let sensor_diff = ops.sensor_diff(&before);\n        let current_button_pressed = ops.button_pressed(&zone);\n        let current_sensor_pressed = ops.sensor_pressed(&zone);\n        let prev_sensor_pressed = ops.prev_sensor_pressed(&zone);\n        let before_phase = ops.phase(&before);\n        let allow_input = matches!(\n            before_phase,\n            HoldPhase::HeadWaiting | HoldPhase::HeadJudgeable\n        ) && ops.unlocked(&work.frontiers, &zone, &before)\n            && ops.eligible(&before);\n        let fallback_area = ops.fallback_area(&zone);\n        // Both availability reads observe the cursor before either update.\n        let plan = crate::scheduler::consume_click(\n            allow_input,\n            ops.button_available(&work.cursor, &zone),\n            ops.sensor_available(&work.cursor, &fallback_area),\n        );\n        if plan.used_button {\n            work.cursor = ops.use_button(work.cursor, &zone);\n        }\n        if plan.used_sensor {\n            work.cursor = ops.use_sensor(work.cursor, &fallback_area);\n        }\n        let clicked = plan.used_button || plan.used_sensor;\n        // Ordinary Hold uses the sensor diff even when no click was consumed.\n        let diff = if plan.used_button {\n            button_diff\n        } else {\n            sensor_diff\n        };\n        let pressed = current_button_pressed || current_sensor_pressed;\n        let (after, event) = ops.step(\n            &before,\n            diff,\n            clicked,\n            pressed,\n            current_button_pressed,\n            prev_sensor_pressed,\n        );\n        let after_phase = ops.phase(&after);\n        // Match the final lifecycle state, including HeadJudged(Miss). A\n        // transition straight to Body/Ended does not satisfy this condition.\n        if !matches!(before_phase, HoldPhase::HeadJudged)\n            && matches!(after_phase, HoldPhase::HeadJudged)\n        {\n            work.frontiers = ops.advance_frontier(work.frontiers, &zone);\n        }\n        // Sync every result; event presence and active retention are irrelevant.\n        work.queues = ops.update_queue(work.queues, &zone, &after);\n        if !matches!(after_phase, HoldPhase::Ended) {\n            work.active = ops.append_active(work.active, zone, after);\n        }\n        if let Some(event) = event {\n            work.events = ops.append_event(work.events, event);\n        }\n        index += 1;\n    }\n    work\n}\n"},{"id":45,"name":{"Local":"crates/lnmai-core-verify/src/normalization.rs"},"crate_name":"lnmai_core_verify","contents":"//! Shared, parser-independent normalization control flow.\n//! This new module is a source artifact: Charon/Aeneas extraction is pending.\n//! Runtime adapters may read one discriminant or write one queue slot; none\n//! may return an entire normalized note, queue traversal, or parser result.\n\nuse crate::shape::SlideKind as ShapeSlideKind;\nuse crate::types::SlideKind;\n\n#[derive(Debug, Clone, Copy)]\npub enum NoteKind {\n    Tap,\n    Hold,\n    Slide,\n    Touch,\n    TouchHold,\n    Rest,\n    Unknown,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct RawFlags {\n    pub is_break: bool,\n    pub is_ex: bool,\n    pub is_hanabi: bool,\n    pub is_slide_no_head: bool,\n    pub is_force_star: bool,\n    pub is_fake_rotate: bool,\n    pub is_slide_break: bool,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct TapFlags {\n    pub is_break: bool,\n    pub is_ex: bool,\n    pub is_hanabi: bool,\n    pub is_force_star: bool,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct HoldFlags {\n    pub is_break: bool,\n    pub is_ex: bool,\n    pub is_hanabi: bool,\n}\n\n#[derive(Debug, Clone, Copy)]\npub struct TouchFlags {\n    pub is_break: bool,\n    pub is_hanabi: bool,\n}\n\n/// Slide requests parsing; it is not itself an accepted/emitted note.\n/// Identifiers, times, durations and source metadata stay outside this plan.\npub enum NotePlan<Slot, Sensor> {\n    Skip,\n    Tap(Slot, TapFlags),\n    Hold(Slot, HoldFlags),\n    Touch(Sensor, TouchFlags),\n    TouchHold(Sensor, HoldFlags),\n    Slide(Slot, RawFlags),\n}\n\n/// The complete kind/position/flag decision for one raw token.\n/// Sensor presence cannot rescue a missing Tap/Hold/Slide slot and vice versa.\npub fn plan_note<Slot, Sensor>(\n    kind: NoteKind,\n    slot: Option<Slot>,\n    sensor: Option<Sensor>,\n    flags: RawFlags,\n) -> NotePlan<Slot, Sensor> {\n    match kind {\n        NoteKind::Tap => match slot {\n            Some(slot) => NotePlan::Tap(\n                slot,\n                TapFlags {\n                    is_break: flags.is_break,\n                    is_ex: flags.is_ex,\n                    is_hanabi: flags.is_hanabi,\n                    is_force_star: flags.is_force_star,\n                },\n            ),\n            None => NotePlan::Skip,\n        },\n        NoteKind::Hold => match slot {\n            Some(slot) => NotePlan::Hold(\n                slot,\n                HoldFlags {\n                    is_break: flags.is_break,\n                    is_ex: flags.is_ex,\n                    is_hanabi: flags.is_hanabi,\n                },\n            ),\n            None => NotePlan::Skip,\n        },\n        NoteKind::Touch => match sensor {\n            Some(sensor) => NotePlan::Touch(\n                sensor,\n                TouchFlags {\n                    is_break: flags.is_break,\n                    is_hanabi: flags.is_hanabi,\n                },\n            ),\n            None => NotePlan::Skip,\n        },\n        NoteKind::TouchHold => match sensor {\n            Some(sensor) => NotePlan::TouchHold(\n                sensor,\n                HoldFlags {\n                    is_break: flags.is_break,\n                    is_ex: flags.is_ex,\n                    is_hanabi: flags.is_hanabi,\n                },\n            ),\n            None => NotePlan::Skip,\n        },\n        NoteKind::Slide => match slot {\n            Some(slot) => NotePlan::Slide(slot, flags),\n            None => NotePlan::Skip,\n        },\n        NoteKind::Rest | NoteKind::Unknown => NotePlan::Skip,\n    }\n}\n\n/// One discriminant read, including shapes with arbitrary Natural endpoints.\npub trait ShapeKind<Shape> {\n    fn kind(&self, shape: &Shape) -> ShapeSlideKind;\n}\n\npub struct SlideLayout {\n    pub flags: RawFlags,\n    pub slide_kind: SlideKind,\n    pub track_count: usize,\n    pub is_classic: bool,\n    pub has_head_note: bool,\n    pub has_body: bool,\n    pub is_conn_slide: bool,\n    pub is_group_head: bool,\n    pub is_group_end: bool,\n    pub total_judge_queue_len: usize,\n    pub multiple: usize,\n}\n\n/// Successful lowerSlideToken construction only: no parser or timing callback.\n/// Kind/track count depend solely on shape kind, including malformed shapes.\n/// No-head affects the head flag only, never body existence or multiplicity.\npub fn slide_layout<Shape, Ops>(\n    input_shape: &Shape,\n    flags: RawFlags,\n    is_classic: bool,\n    ops: Ops,\n) -> SlideLayout\nwhere\n    Ops: ShapeKind<Shape>,\n{\n    let (slide_kind, track_count) = match ops.kind(input_shape) {\n        ShapeSlideKind::Wifi => (SlideKind::Wifi, 3),\n        _ => (SlideKind::Single, 1),\n    };\n    let has_head_note = !flags.is_slide_no_head;\n    SlideLayout {\n        flags,\n        slide_kind,\n        track_count,\n        is_classic,\n        has_head_note,\n        has_body: true,\n        is_conn_slide: false,\n        is_group_head: false,\n        is_group_end: false,\n        total_judge_queue_len: 0,\n        multiple: 1,\n    }\n}\n\n/// In-bounds, single-slot lens. No search, iteration, filtering or allocation\n/// is delegated. Preserve all other slots and every non-is_skippable field.\npub trait TrackWrite<Q> {\n    fn set_skippable(&self, queue: Q, index: usize, value: bool) -> Q;\n}\n\n/// Full applySingleTrackConnRulesNormalized control flow.\n/// `len` equals the physical queue length; writes preserve it.\n/// `total_lt_four` is the exact Natural comparison totalJudgeQueueLen < 4.\n/// Small tracks change at most their first two slots, regardless of len.\n/// Long tracks visit every slot, preserving order and any duplicate contents.\npub fn normalize_track<Q, Ops>(\n    is_conn_slide: bool,\n    total_lt_four: bool,\n    is_group_head: bool,\n    is_group_end: bool,\n    len: usize,\n    mut queue: Q,\n    ops: Ops,\n) -> Q\nwhere\n    Ops: TrackWrite<Q>,\n{\n    if !is_conn_slide {\n        return queue;\n    }\n    if total_lt_four {\n        if len == 0 {\n            return queue;\n        }\n        if len == 1 {\n            return ops.set_skippable(queue, 0, is_group_head || is_group_end);\n        }\n        queue = ops.set_skippable(queue, 0, is_group_head);\n        ops.set_skippable(queue, 1, is_group_end)\n    } else {\n        let mut index = 0;\n        while index < len {\n            queue = ops.set_skippable(queue, index, true);\n            // index < len <= usize::MAX proves this addition cannot overflow.\n            index += 1;\n        }\n        queue\n    }\n}\n"},{"id":46,"name":{"Local":"crates/lnmai-core-verify/src/touch_automatic.rs"},"crate_name":"lnmai_core_verify","contents":"//! Automatic Touch traversal, shared with the scheduler.\n//!\n//! Group results are a fixed frame snapshot. This traversal never consumes\n//! clicks or registers new group results; it visits every original slot once\n//! and prepends emitted events while keeping note order.\n\npub struct TouchAutomaticWork<Notes, F, E> {\n    pub notes: Notes,\n    pub frontiers: F,\n    pub events_rev: E,\n}\n\n/// Container/field operations and one note's lifecycle call. No callback\n/// selects the next slot, skips a note, or traverses the queue.\npub trait TouchAutomatic<S, N, Notes, F, E, Event, D, Shared> {\n    fn length(&self, source: &S) -> usize;\n    fn get(&self, source: &S, index: usize) -> N;\n    fn before_cursor(&self, source: &S, index: usize) -> bool;\n    fn resolved(&self, note: &N) -> bool;\n    fn sensor_diff(&self, note: &N) -> D;\n    fn shared(&self, note: &N) -> Option<Shared>;\n    fn too_late(&self, note: &N) -> bool;\n    fn step(&self, note: &N, diff: D, shared: Option<Shared>) -> (N, Option<Event>);\n    fn advance_frontier(&self, frontiers: F) -> F;\n    fn prepend_event(&self, events: E, event: Event) -> E;\n    fn append_note(&self, notes: Notes, note: N) -> Notes;\n}\n\npub fn process<S, N, Notes, F, E, Event, D, Shared, Ops>(\n    source: &S,\n    mut work: TouchAutomaticWork<Notes, F, E>,\n    ops: Ops,\n) -> TouchAutomaticWork<Notes, F, E>\nwhere\n    Ops: TouchAutomatic<S, N, Notes, F, E, Event, D, Shared>,\n{\n    let len = ops.length(source);\n    let mut index = 0;\n    while index < len {\n        let before = ops.get(source, index);\n        if ops.before_cursor(source, index) || ops.resolved(&before) {\n            work.notes = ops.append_note(work.notes, before);\n        } else {\n            let diff = ops.sensor_diff(&before);\n            let shared = ops.shared(&before);\n            let too_late = ops.too_late(&before);\n            if shared.is_none() && !too_late {\n                work.notes = ops.append_note(work.notes, before);\n            } else {\n                let (after, event) = ops.step(&before, diff, shared);\n                let resolved_now = !ops.resolved(&before) && ops.resolved(&after);\n                if resolved_now {\n                    work.frontiers = ops.advance_frontier(work.frontiers);\n                }\n                if let Some(event) = event {\n                    work.events_rev = ops.prepend_event(work.events_rev, event);\n                }\n                work.notes = ops.append_note(work.notes, after);\n            }\n        }\n        index += 1;\n    }\n    work\n}\n"},{"id":47,"name":{"Local":"crates/lnmai-core-verify/src/touch_hold_body.rs"},"crate_name":"lnmai_core_verify","contents":"//! Concrete TouchHold body-group storage and field operations.\n//!\n//! IDs remain generic: PartialEq, Clone and Default are primitive dictionaries.\n//! Only list positions and lengths use usize. Source HoldNote reads and the\n//! existing reconstruction/pass control flow remain outside this module.\n//! All scans stop at the first equal ID, including on inputs with duplicates.\n\n#![allow(clippy::len_zero)]\n\nuse crate::{vec_erase, vec_prepend};\n\n/// Same public fields and derives as the runtime record. The runtime aliases\n/// this type at its arbitrary-precision Natural; JSON implementations stay there.\n#[derive(Debug, Clone, PartialEq, Eq)]\npub struct TouchHoldBodyGroupState<Id> {\n    pub group_id: Id,\n    pub member_note_indices: Vec<Id>,\n    pub triggered_note_indices: Vec<Id>,\n}\n\nimpl<Id: Default> Default for TouchHoldBodyGroupState<Id> {\n    fn default() -> Self {\n        Self {\n            group_id: Id::default(),\n            member_note_indices: Vec::new(),\n            triggered_note_indices: Vec::new(),\n        }\n    }\n}\n\npub fn empty<Id>() -> Vec<TouchHoldBodyGroupState<Id>> {\n    Vec::new()\n}\n\npub fn group_length<Id>(groups: &[TouchHoldBodyGroupState<Id>]) -> usize {\n    groups.len()\n}\n\npub fn group_matches<Id: PartialEq>(\n    groups: &[TouchHoldBodyGroupState<Id>],\n    index: usize,\n    id: &Id,\n) -> bool {\n    &groups[index].group_id == id\n}\n\npub fn member_length<Id>(groups: &[TouchHoldBodyGroupState<Id>], group: usize) -> usize {\n    groups[group].member_note_indices.len()\n}\n\npub fn member_matches<Id: PartialEq>(\n    groups: &[TouchHoldBodyGroupState<Id>],\n    group: usize,\n    index: usize,\n    note: &Id,\n) -> bool {\n    &groups[group].member_note_indices[index] == note\n}\n\npub fn trigger_length<Id>(groups: &[TouchHoldBodyGroupState<Id>], group: usize) -> usize {\n    groups[group].triggered_note_indices.len()\n}\n\npub fn trigger_matches<Id: PartialEq>(\n    groups: &[TouchHoldBodyGroupState<Id>],\n    group: usize,\n    index: usize,\n    note: &Id,\n) -> bool {\n    &groups[group].triggered_note_indices[index] == note\n}\n\n/// Concrete first-match outer scan; a later duplicate group is never selected.\npub fn find_group<Id: PartialEq>(groups: &[TouchHoldBodyGroupState<Id>], id: &Id) -> Option<usize> {\n    let len = group_length(groups);\n    let mut index = 0;\n    while index < len {\n        if group_matches(groups, index, id) {\n            return Some(index);\n        }\n        index += 1;\n    }\n    None\n}\n\n/// Shared first-match scan for member and trigger lists. No ID conversion,\n/// clone, allocation, uniqueness assumption, or source adapter is involved.\npub fn find_id<Id: PartialEq>(values: &[Id], note: &Id) -> Option<usize> {\n    let len = values.len();\n    let mut index = 0;\n    while index < len {\n        if &values[index] == note {\n            return Some(index);\n        }\n        index += 1;\n    }\n    None\n}\n\npub fn find_member<Id: PartialEq>(\n    groups: &[TouchHoldBodyGroupState<Id>],\n    group: usize,\n    note: &Id,\n) -> Option<usize> {\n    find_id(&groups[group].member_note_indices, note)\n}\n\npub fn find_trigger<Id: PartialEq>(\n    groups: &[TouchHoldBodyGroupState<Id>],\n    group: usize,\n    note: &Id,\n) -> Option<usize> {\n    find_id(&groups[group].triggered_note_indices, note)\n}\n\npub fn has_member<Id: PartialEq>(\n    groups: &[TouchHoldBodyGroupState<Id>],\n    group: usize,\n    note: &Id,\n) -> bool {\n    find_member(groups, group, note).is_some()\n}\n\npub fn has_trigger<Id: PartialEq>(\n    groups: &[TouchHoldBodyGroupState<Id>],\n    group: usize,\n    note: &Id,\n) -> bool {\n    find_trigger(groups, group, note).is_some()\n}\n\npub fn members_empty<Id>(groups: &[TouchHoldBodyGroupState<Id>], group: usize) -> bool {\n    groups[group].member_note_indices.len() == 0\n}\n\n/// Clone only the incoming note once; push/swap moves all existing elements.\npub fn prepend_member<Id: Clone>(\n    mut groups: Vec<TouchHoldBodyGroupState<Id>>,\n    group: usize,\n    note: &Id,\n) -> Vec<TouchHoldBodyGroupState<Id>> {\n    vec_prepend::prepend(&mut groups[group].member_note_indices, note.clone());\n    groups\n}\n\npub fn prepend_trigger<Id: Clone>(\n    mut groups: Vec<TouchHoldBodyGroupState<Id>>,\n    group: usize,\n    note: &Id,\n) -> Vec<TouchHoldBodyGroupState<Id>> {\n    vec_prepend::prepend(&mut groups[group].triggered_note_indices, note.clone());\n    groups\n}\n\n/// Indexed erasure. The shrinking resize branch never clones its filler or\n/// any old value; Clone is only required by the Rust resize signature.\npub fn remove_member<Id: Clone + Default>(\n    mut groups: Vec<TouchHoldBodyGroupState<Id>>,\n    group: usize,\n    index: usize,\n) -> Vec<TouchHoldBodyGroupState<Id>> {\n    vec_erase::erase(&mut groups[group].member_note_indices, index, Id::default());\n    groups\n}\n\npub fn remove_trigger<Id: Clone + Default>(\n    mut groups: Vec<TouchHoldBodyGroupState<Id>>,\n    group: usize,\n    index: usize,\n) -> Vec<TouchHoldBodyGroupState<Id>> {\n    vec_erase::erase(\n        &mut groups[group].triggered_note_indices,\n        index,\n        Id::default(),\n    );\n    groups\n}\n\n/// Erase only the first matching member; a miss does not construct a filler.\npub fn erase_member<Id: PartialEq + Clone + Default>(\n    groups: Vec<TouchHoldBodyGroupState<Id>>,\n    group: usize,\n    note: &Id,\n) -> Vec<TouchHoldBodyGroupState<Id>> {\n    match find_member(&groups, group, note) {\n        Some(index) => remove_member(groups, group, index),\n        None => groups,\n    }\n}\n\npub fn erase_trigger<Id: PartialEq + Clone + Default>(\n    groups: Vec<TouchHoldBodyGroupState<Id>>,\n    group: usize,\n    note: &Id,\n) -> Vec<TouchHoldBodyGroupState<Id>> {\n    match find_trigger(&groups, group, note) {\n        Some(index) => remove_trigger(groups, group, index),\n        None => groups,\n    }\n}\n\n/// Append exactly one group; clone the supplied group ID once.\npub fn append_empty<Id: Clone>(\n    mut groups: Vec<TouchHoldBodyGroupState<Id>>,\n    id: &Id,\n) -> Vec<TouchHoldBodyGroupState<Id>> {\n    groups.push(TouchHoldBodyGroupState {\n        group_id: id.clone(),\n        member_note_indices: Vec::new(),\n        triggered_note_indices: Vec::new(),\n    });\n    groups\n}\n\n/// Same clone order/count as the runtime literal: id, member note, trigger note.\n/// Each new singleton has its own one-element buffer; no old tail is copied.\n#[allow(clippy::vec_init_then_push)]\npub fn append<Id: Clone>(\n    mut groups: Vec<TouchHoldBodyGroupState<Id>>,\n    id: &Id,\n    note: &Id,\n) -> Vec<TouchHoldBodyGroupState<Id>> {\n    let group_id = id.clone();\n    let mut member_note_indices = Vec::with_capacity(1);\n    member_note_indices.push(note.clone());\n    let mut triggered_note_indices = Vec::with_capacity(1);\n    triggered_note_indices.push(note.clone());\n    groups.push(TouchHoldBodyGroupState {\n        group_id,\n        member_note_indices,\n        triggered_note_indices,\n    });\n    groups\n}\n\n/// Delete exactly one outer slot in order. The default record is a discarded\n/// shrink filler, never inserted or cloned; retained groups are moved by swaps.\npub fn remove_group<Id: Clone + Default>(\n    mut groups: Vec<TouchHoldBodyGroupState<Id>>,\n    index: usize,\n) -> Vec<TouchHoldBodyGroupState<Id>> {\n    vec_erase::erase(&mut groups, index, TouchHoldBodyGroupState::default());\n    groups\n}\n\npub fn swap_groups<Id>(\n    mut groups: Vec<TouchHoldBodyGroupState<Id>>,\n    left: usize,\n    right: usize,\n) -> Vec<TouchHoldBodyGroupState<Id>> {\n    groups.swap(left, right);\n    groups\n}\n"},{"id":48,"name":{"Local":"crates/lnmai-core-verify/src/touch_hold_body_adapter.rs"},"crate_name":"lnmai_core_verify","contents":"//! Shared concrete TouchHold body storage adapters.\n//!\n//! Both trait implementations call the same generic record/Vec kernels used by\n//! the runtime. SliceHoldSource supplies ordered source access and Id cloning;\n//! the runtime supplies three borrowed note fields. Scheduling forwards the\n//! existing head/lifecycle operations once,\n//! without changing the pass's decisions, evaluation order or accumulated work.\n\nuse crate::hold_schedule::HoldPhase;\nuse crate::touch_hold_body::{self, TouchHoldBodyGroupState};\nuse crate::touch_hold_rebuild::TouchHoldRebuild;\nuse crate::touch_hold_schedule::{BodyGroups, HeadGroups, TouchHoldSchedule};\n\n/// Immutable source boundary for body-group reconstruction.\n/// Reads must preserve the full source order, duplicate notes, exact IDs, and\n/// trigger flags. Indexed reads require index < hold_length(holds).\n/// No lifecycle filter, storage operation, search or mutation belongs here.\npub trait HoldSource<S, Id> {\n    fn hold_length(&self, holds: &S) -> usize;\n    fn hold_group_id(&self, holds: &S, index: usize) -> Option<Id>;\n    fn hold_note_index(&self, holds: &S, index: usize) -> Id;\n    fn hold_triggered(&self, holds: &S, index: usize) -> bool;\n}\n\n/// Three borrowed fields from one note. These methods perform no slice access,\n/// source filtering, cloning, group lookup, or mutation. The body group ID is\n/// intentionally distinct from the head-sharing touch_group_id field.\npub trait HoldFields<Note, Id> {\n    fn body_group_id<'note>(&self, note: &'note Note) -> &'note Option<Id>;\n    fn note_index<'note>(&self, note: &'note Note) -> &'note Id;\n    fn body_triggered(&self, note: &Note) -> bool;\n}\n\n/// Full ordered-slice source reads, shared by both reconstruction callers.\n/// Only the three literal note-field projections stay in the runtime facade.\npub struct SliceHoldSource<Fields> {\n    pub fields: Fields,\n}\n\n/// Clone one optional ID through a direct borrowed input.\n/// None clones nothing; Some clones only the contained ID once.\nfn clone_optional_id<Id: Clone>(value: &Option<Id>) -> Option<Id> {\n    match value {\n        None => None,\n        Some(id) => Some(Id::clone(id)),\n    }\n}\n\nimpl<'source, Area, Note, Id, Fields> HoldSource<&'source [(Area, Note)], Id>\n    for SliceHoldSource<Fields>\nwhere\n    Id: Clone,\n    Fields: HoldFields<Note, Id>,\n{\n    fn hold_length(&self, holds: &&'source [(Area, Note)]) -> usize {\n        holds.len()\n    }\n\n    fn hold_group_id(&self, holds: &&'source [(Area, Note)], index: usize) -> Option<Id> {\n        let note = &holds[index].1;\n        clone_optional_id(self.fields.body_group_id(note))\n    }\n\n    fn hold_note_index(&self, holds: &&'source [(Area, Note)], index: usize) -> Id {\n        let note = &holds[index].1;\n        Id::clone(self.fields.note_index(note))\n    }\n\n    fn hold_triggered(&self, holds: &&'source [(Area, Note)], index: usize) -> bool {\n        let note = &holds[index].1;\n        self.fields.body_triggered(note)\n    }\n}\n\n/// The same wrapper supplies concrete body storage for rebuild and scheduling.\n/// Ops is a HoldSource for rebuild, or the existing head/lifecycle adapter for\n/// scheduling. No trait on Ops can override the body-group storage operations.\npub struct TouchHoldBodyAdapter<Ops> {\n    pub ops: Ops,\n}\n\n/// Strict majority of a nonempty member list. This is equivalent to\n/// member_len > 0 && 2 * triggered_len > member_len over unbounded naturals.\n/// The zero-member guard is intentional even if triggers are nonempty. No\n/// triggered_len <= member_len assumption, multiplication or increment is used.\npub fn strict_majority_lengths(triggered_len: usize, member_len: usize) -> bool {\n    member_len > 0 && triggered_len > member_len / 2\n}\n\n/// Read trigger length before member length, as in the runtime's former call.\npub fn body_majority<Id>(groups: &[TouchHoldBodyGroupState<Id>], index: usize) -> bool {\n    let triggered_len = touch_hold_body::trigger_length(groups, index);\n    let member_len = touch_hold_body::member_length(groups, index);\n    strict_majority_lengths(triggered_len, member_len)\n}\n\n/// The first matching group decides, including when its majority is false.\n/// Later duplicate IDs are never used as a fallback.\npub fn body_pressed<Id: PartialEq>(groups: &[TouchHoldBodyGroupState<Id>], id: &Id) -> bool {\n    match touch_hold_body::find_group(groups, id) {\n        Some(index) => body_majority(groups, index),\n        None => false,\n    }\n}\n\nimpl<S, Id, Ops> TouchHoldRebuild<S, Vec<TouchHoldBodyGroupState<Id>>, Id>\n    for TouchHoldBodyAdapter<Ops>\nwhere\n    Id: PartialEq + Clone + Default,\n    Ops: HoldSource<S, Id>,\n{\n    fn hold_length(&self, holds: &S) -> usize {\n        self.ops.hold_length(holds)\n    }\n\n    fn hold_group_id(&self, holds: &S, index: usize) -> Option<Id> {\n        self.ops.hold_group_id(holds, index)\n    }\n\n    fn hold_note_index(&self, holds: &S, index: usize) -> Id {\n        self.ops.hold_note_index(holds, index)\n    }\n\n    fn hold_triggered(&self, holds: &S, index: usize) -> bool {\n        self.ops.hold_triggered(holds, index)\n    }\n\n    fn empty(&self) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::empty()\n    }\n\n    fn group_length(&self, groups: &Vec<TouchHoldBodyGroupState<Id>>) -> usize {\n        touch_hold_body::group_length(groups)\n    }\n\n    fn group_matches(\n        &self,\n        groups: &Vec<TouchHoldBodyGroupState<Id>>,\n        index: usize,\n        id: &Id,\n    ) -> bool {\n        touch_hold_body::group_matches(groups, index, id)\n    }\n\n    fn member_length(&self, groups: &Vec<TouchHoldBodyGroupState<Id>>, group: usize) -> usize {\n        touch_hold_body::member_length(groups, group)\n    }\n\n    fn member_matches(\n        &self,\n        groups: &Vec<TouchHoldBodyGroupState<Id>>,\n        group: usize,\n        index: usize,\n        note: &Id,\n    ) -> bool {\n        touch_hold_body::member_matches(groups, group, index, note)\n    }\n\n    fn trigger_length(&self, groups: &Vec<TouchHoldBodyGroupState<Id>>, group: usize) -> usize {\n        touch_hold_body::trigger_length(groups, group)\n    }\n\n    fn trigger_matches(\n        &self,\n        groups: &Vec<TouchHoldBodyGroupState<Id>>,\n        group: usize,\n        index: usize,\n        note: &Id,\n    ) -> bool {\n        touch_hold_body::trigger_matches(groups, group, index, note)\n    }\n\n    fn prepend_member(\n        &self,\n        groups: Vec<TouchHoldBodyGroupState<Id>>,\n        group: usize,\n        note: &Id,\n    ) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::prepend_member(groups, group, note)\n    }\n\n    fn prepend_trigger(\n        &self,\n        groups: Vec<TouchHoldBodyGroupState<Id>>,\n        group: usize,\n        note: &Id,\n    ) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::prepend_trigger(groups, group, note)\n    }\n\n    fn remove_trigger(\n        &self,\n        groups: Vec<TouchHoldBodyGroupState<Id>>,\n        group: usize,\n        index: usize,\n    ) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::remove_trigger(groups, group, index)\n    }\n\n    fn append_empty(\n        &self,\n        groups: Vec<TouchHoldBodyGroupState<Id>>,\n        id: &Id,\n    ) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::append_empty(groups, id)\n    }\n\n    fn swap_groups(\n        &self,\n        groups: Vec<TouchHoldBodyGroupState<Id>>,\n        left: usize,\n        right: usize,\n    ) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::swap_groups(groups, left, right)\n    }\n}\n\nimpl<Id, Ops> BodyGroups<Vec<TouchHoldBodyGroupState<Id>>, Id> for TouchHoldBodyAdapter<Ops>\nwhere\n    Id: PartialEq + Clone + Default,\n{\n    fn body_length(&self, groups: &Vec<TouchHoldBodyGroupState<Id>>) -> usize {\n        touch_hold_body::group_length(groups)\n    }\n\n    fn body_matches(\n        &self,\n        groups: &Vec<TouchHoldBodyGroupState<Id>>,\n        index: usize,\n        id: &Id,\n    ) -> bool {\n        touch_hold_body::group_matches(groups, index, id)\n    }\n\n    fn body_majority(&self, groups: &Vec<TouchHoldBodyGroupState<Id>>, index: usize) -> bool {\n        body_majority(groups, index)\n    }\n\n    fn body_has_member(\n        &self,\n        groups: &Vec<TouchHoldBodyGroupState<Id>>,\n        index: usize,\n        note: &Id,\n    ) -> bool {\n        touch_hold_body::has_member(groups, index, note)\n    }\n\n    fn body_has_trigger(\n        &self,\n        groups: &Vec<TouchHoldBodyGroupState<Id>>,\n        index: usize,\n        note: &Id,\n    ) -> bool {\n        touch_hold_body::has_trigger(groups, index, note)\n    }\n\n    fn body_prepend_member(\n        &self,\n        groups: Vec<TouchHoldBodyGroupState<Id>>,\n        index: usize,\n        note: &Id,\n    ) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::prepend_member(groups, index, note)\n    }\n\n    fn body_prepend_trigger(\n        &self,\n        groups: Vec<TouchHoldBodyGroupState<Id>>,\n        index: usize,\n        note: &Id,\n    ) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::prepend_trigger(groups, index, note)\n    }\n\n    fn body_erase_member(\n        &self,\n        groups: Vec<TouchHoldBodyGroupState<Id>>,\n        index: usize,\n        note: &Id,\n    ) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::erase_member(groups, index, note)\n    }\n\n    fn body_erase_trigger(\n        &self,\n        groups: Vec<TouchHoldBodyGroupState<Id>>,\n        index: usize,\n        note: &Id,\n    ) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::erase_trigger(groups, index, note)\n    }\n\n    fn body_members_empty(&self, groups: &Vec<TouchHoldBodyGroupState<Id>>, index: usize) -> bool {\n        touch_hold_body::members_empty(groups, index)\n    }\n\n    fn body_remove(\n        &self,\n        groups: Vec<TouchHoldBodyGroupState<Id>>,\n        index: usize,\n    ) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::remove_group(groups, index)\n    }\n\n    fn body_append(\n        &self,\n        groups: Vec<TouchHoldBodyGroupState<Id>>,\n        id: &Id,\n        note: &Id,\n    ) -> Vec<TouchHoldBodyGroupState<Id>> {\n        touch_hold_body::append(groups, id, note)\n    }\n}\n\n// Keep the existing schedule kernel's public API. Only these forwarding impls\n// adapt its other two trait dictionaries; their arguments/results pass through\n// unchanged, without cloning source notes, groups, IDs, events or cursors.\nimpl<G, Id, Grade, D, Ops> HeadGroups<G, Id, Grade, D> for TouchHoldBodyAdapter<Ops>\nwhere\n    Ops: HeadGroups<G, Id, Grade, D>,\n{\n    fn head_length(&self, groups: &G) -> usize {\n        self.ops.head_length(groups)\n    }\n\n    fn head_matches(&self, groups: &G, index: usize, id: &Id) -> bool {\n        self.ops.head_matches(groups, index, id)\n    }\n\n    fn head_majority(&self, groups: &G, index: usize) -> bool {\n        self.ops.head_majority(groups, index)\n    }\n\n    fn head_result(&self, groups: &G, index: usize) -> (Grade, D) {\n        self.ops.head_result(groups, index)\n    }\n\n    fn head_increment(&self, groups: G, index: usize) -> G {\n        self.ops.head_increment(groups, index)\n    }\n\n    fn head_set_size(&self, groups: G, index: usize, size: Id) -> G {\n        self.ops.head_set_size(groups, index, size)\n    }\n\n    fn head_set_result(&self, groups: G, index: usize, grade: Grade, diff: D) -> G {\n        self.ops.head_set_result(groups, index, grade, diff)\n    }\n\n    fn head_append(&self, groups: G, id: &Id, size: Id, grade: Grade, diff: D) -> G {\n        self.ops.head_append(groups, id, size, grade, diff)\n    }\n}\n\nimpl<S, A, N, F, Q, C, H, E, Event, D, Z, Id, Grade, Ops>\n    TouchHoldSchedule<S, A, N, F, Q, C, H, E, Event, D, Z, Id, Grade> for TouchHoldBodyAdapter<Ops>\nwhere\n    Ops: TouchHoldSchedule<S, A, N, F, Q, C, H, E, Event, D, Z, Id, Grade>,\n{\n    fn length(&self, holds: &S) -> usize {\n        self.ops.length(holds)\n    }\n\n    fn get(&self, holds: &S, index: usize) -> (A, N) {\n        self.ops.get(holds, index)\n    }\n\n    fn sensor_diff(&self, note: &N) -> D {\n        self.ops.sensor_diff(note)\n    }\n\n    fn button_diff(&self, note: &N) -> D {\n        self.ops.button_diff(note)\n    }\n\n    fn local_pressed(&self, area: &A) -> bool {\n        self.ops.local_pressed(area)\n    }\n\n    fn body_check_active(&self, note: &N) -> bool {\n        self.ops.body_check_active(note)\n    }\n\n    fn body_group_id(&self, note: &N) -> Option<Id> {\n        self.ops.body_group_id(note)\n    }\n\n    fn head_group_id(&self, note: &N) -> Option<Id> {\n        self.ops.head_group_id(note)\n    }\n\n    fn note_index(&self, note: &N) -> Id {\n        self.ops.note_index(note)\n    }\n\n    fn group_size(&self, note: &N) -> Id {\n        self.ops.group_size(note)\n    }\n\n    fn phase(&self, note: &N) -> HoldPhase {\n        self.ops.phase(note)\n    }\n\n    fn head_grade(&self, note: &N) -> Option<Grade> {\n        self.ops.head_grade(note)\n    }\n\n    fn head_diff(&self, note: &N) -> D {\n        self.ops.head_diff(note)\n    }\n\n    fn grade_rejected(&self, grade: &Grade) -> bool {\n        self.ops.grade_rejected(grade)\n    }\n\n    fn within_head_window(&self, note: &N) -> bool {\n        self.ops.within_head_window(note)\n    }\n\n    fn unlocked(&self, frontiers: &F, area: &A, note: &N) -> bool {\n        self.ops.unlocked(frontiers, area, note)\n    }\n\n    fn eligible(&self, note: &N) -> bool {\n        self.ops.eligible(note)\n    }\n\n    fn button_ring(&self) -> bool {\n        self.ops.button_ring()\n    }\n\n    fn outer_button(&self, area: &A) -> Option<Z> {\n        self.ops.outer_button(area)\n    }\n\n    fn button_available(&self, cursor: &C, zone: &Z) -> bool {\n        self.ops.button_available(cursor, zone)\n    }\n\n    fn sensor_available(&self, cursor: &C, area: &A) -> bool {\n        self.ops.sensor_available(cursor, area)\n    }\n\n    fn use_button(&self, cursor: C, zone: &Z) -> C {\n        self.ops.use_button(cursor, zone)\n    }\n\n    fn use_sensor(&self, cursor: C, area: &A) -> C {\n        self.ops.use_sensor(cursor, area)\n    }\n\n    fn step(\n        &self,\n        note: &N,\n        diff: D,\n        clicked: bool,\n        pressed: bool,\n        shared: Option<(Grade, D)>,\n    ) -> (N, Option<Event>) {\n        self.ops.step(note, diff, clicked, pressed, shared)\n    }\n\n    fn advance_frontier(&self, frontiers: F, area: &A) -> F {\n        self.ops.advance_frontier(frontiers, area)\n    }\n\n    fn update_queue(&self, queues: Q, area: &A, note: &N) -> Q {\n        self.ops.update_queue(queues, area, note)\n    }\n\n    fn append_active(&self, active: H, area: A, note: N) -> H {\n        self.ops.append_active(active, area, note)\n    }\n\n    fn append_event(&self, events: E, event: Event) -> E {\n        self.ops.append_event(events, event)\n    }\n}\n"},{"id":49,"name":{"Local":"crates/lnmai-core-verify/src/touch_hold_rebuild.rs"},"crate_name":"lnmai_core_verify","contents":"//! Shared reconstruction of TouchHold body groups for scheduler and ChartLoader.\n//! No lifecycle filter: every source hold with a body group participates.\n//! The adapter exposes fields and indexed container operations only. All scans,\n//! duplicate handling, insertion/removal decisions, source traversal, and the\n//! final group-order reversal live here. Every loop uses the original length of\n//! its scanned list; no usize len + 1 and no recursive Rust traversal.\n\n/// Point laws required by the extracted proof:\n/// - source reads preserve the full immutable source, including duplicate notes;\n/// - matches compares exact IDs, without converting them to machine indices;\n/// - prepend_* inserts at zero and changes only that one group's named list;\n/// - remove_trigger removes exactly the specified slot (not all equal IDs);\n/// - append_empty appends one group with the supplied ID and two empty lists;\n/// - swap_groups exchanges exactly two outer-list slots, preserving both groups;\n/// - every other group/field and all unaffected lengths are unchanged.\n///   Indexed reads/mutations require in-bounds indices; insert/append also need\n///   successful allocation and representable resulting lengths.\npub trait TouchHoldRebuild<S, B, Id> {\n    fn hold_length(&self, holds: &S) -> usize;\n    fn hold_group_id(&self, holds: &S, index: usize) -> Option<Id>;\n    fn hold_note_index(&self, holds: &S, index: usize) -> Id;\n    fn hold_triggered(&self, holds: &S, index: usize) -> bool;\n\n    fn empty(&self) -> B;\n    fn group_length(&self, groups: &B) -> usize;\n    fn group_matches(&self, groups: &B, index: usize, id: &Id) -> bool;\n    fn member_length(&self, groups: &B, group: usize) -> usize;\n    fn member_matches(&self, groups: &B, group: usize, index: usize, note: &Id) -> bool;\n    fn trigger_length(&self, groups: &B, group: usize) -> usize;\n    fn trigger_matches(&self, groups: &B, group: usize, index: usize, note: &Id) -> bool;\n\n    fn prepend_member(&self, groups: B, group: usize, note: &Id) -> B;\n    fn prepend_trigger(&self, groups: B, group: usize, note: &Id) -> B;\n    fn remove_trigger(&self, groups: B, group: usize, index: usize) -> B;\n    fn append_empty(&self, groups: B, id: &Id) -> B;\n    fn swap_groups(&self, groups: B, left: usize, right: usize) -> B;\n}\n\n/// Return the FIRST matching group. Later duplicates are neither read nor edited.\npub fn find_group<S, B, Id, Ops>(groups: &B, id: &Id, ops: &Ops) -> Option<usize>\nwhere\n    Ops: TouchHoldRebuild<S, B, Id>,\n{\n    let len = ops.group_length(groups);\n    let mut index = 0;\n    while index < len {\n        if ops.group_matches(groups, index, id) {\n            return Some(index);\n        }\n        index += 1;\n    }\n    None\n}\n\npub fn find_member<S, B, Id, Ops>(groups: &B, group: usize, note: &Id, ops: &Ops) -> Option<usize>\nwhere\n    Ops: TouchHoldRebuild<S, B, Id>,\n{\n    let len = ops.member_length(groups, group);\n    let mut index = 0;\n    while index < len {\n        if ops.member_matches(groups, group, index, note) {\n            return Some(index);\n        }\n        index += 1;\n    }\n    None\n}\n\npub fn find_trigger<S, B, Id, Ops>(groups: &B, group: usize, note: &Id, ops: &Ops) -> Option<usize>\nwhere\n    Ops: TouchHoldRebuild<S, B, Id>,\n{\n    let len = ops.trigger_length(groups, group);\n    let mut index = 0;\n    while index < len {\n        if ops.trigger_matches(groups, group, index, note) {\n            return Some(index);\n        }\n        index += 1;\n    }\n    None\n}\n\n/// Update one source note. In particular, false still inserts a missing member,\n/// and removes at most ONE trigger. No sets, deduplication, or length clamping.\npub fn upsert<S, B, Id, Ops>(mut groups: B, id: &Id, note: &Id, triggered: bool, ops: &Ops) -> B\nwhere\n    Ops: TouchHoldRebuild<S, B, Id>,\n{\n    match find_group::<S, B, Id, Ops>(&groups, id, ops) {\n        Some(group) => {\n            if find_member::<S, B, Id, Ops>(&groups, group, note, ops).is_none() {\n                groups = ops.prepend_member(groups, group, note);\n            }\n            // A member write preserves the original trigger list and its length.\n            let trigger = find_trigger::<S, B, Id, Ops>(&groups, group, note, ops);\n            if triggered {\n                if trigger.is_none() {\n                    groups = ops.prepend_trigger(groups, group, note);\n                }\n            } else if let Some(index) = trigger {\n                groups = ops.remove_trigger(groups, group, index);\n            }\n            groups\n        }\n        None => {\n            let group = ops.group_length(&groups);\n            groups = ops.append_empty(groups, id);\n            groups = ops.prepend_member(groups, group, note);\n            if triggered {\n                groups = ops.prepend_trigger(groups, group, note);\n            }\n            groups\n        }\n    }\n}\n\n/// Reverse outer group order ONLY. The loop performs floor(len / 2) point swaps;\n/// member and trigger order inside each group remains unchanged.\npub fn reverse_groups<S, B, Id, Ops>(mut groups: B, ops: &Ops) -> B\nwhere\n    Ops: TouchHoldRebuild<S, B, Id>,\n{\n    let len = ops.group_length(&groups);\n    let half = len / 2;\n    let mut left = 0;\n    while left < half {\n        // Entering the loop implies len >= 2 and left < len.\n        let right = len - 1 - left;\n        groups = ops.swap_groups(groups, left, right);\n        left += 1;\n    }\n    groups\n}\n\n/// Generalized accumulator form, corresponding to the reference private loop.\n/// The groups argument is in its pre-reversal order. Duplicate group IDs and\n/// duplicate member/trigger entries in an accumulator are intentionally allowed.\npub fn rebuild_from<S, B, Id, Ops>(holds: &S, mut groups: B, ops: &Ops) -> B\nwhere\n    Ops: TouchHoldRebuild<S, B, Id>,\n{\n    let len = ops.hold_length(holds);\n    let mut index = 0;\n    while index < len {\n        if let Some(id) = ops.hold_group_id(holds, index) {\n            let note = ops.hold_note_index(holds, index);\n            let triggered = ops.hold_triggered(holds, index);\n            groups = upsert::<S, B, Id, Ops>(groups, &id, &note, triggered, ops);\n        }\n        index += 1;\n    }\n    reverse_groups::<S, B, Id, Ops>(groups, ops)\n}\n\n/// Both concrete runtime helpers call this function using the same point adapter.\npub fn rebuild<S, B, Id, Ops>(holds: &S, ops: Ops) -> B\nwhere\n    Ops: TouchHoldRebuild<S, B, Id>,\n{\n    let groups = ops.empty();\n    rebuild_from::<S, B, Id, Ops>(holds, groups, &ops)\n}\n"},{"id":50,"name":{"Local":"crates/lnmai-core-verify/src/touch_hold_schedule.rs"},"crate_name":"lnmai_core_verify","contents":"//! Complete TouchHold pass: immutable source order, current groups and cursor.\n//! All searches and scheduling branches live here. Adapters supply point fields,\n//! list primitives, one-note lifecycle and the separate queue composition.\n\nuse crate::hold_schedule::HoldPhase;\n\npub struct TouchHoldWork<F, Q, C, H, E, G, B> {\n    pub frontiers: F,\n    pub queues: Q,\n    pub cursor: C,\n    pub active: H,\n    pub events: E,\n    pub groups: G,\n    pub body_groups: B,\n}\n\n/// Indexed single-group fields/mutations. No search or upsert callback.\npub trait HeadGroups<G, Id, Grade, D> {\n    fn head_length(&self, groups: &G) -> usize;\n    fn head_matches(&self, groups: &G, index: usize, id: &Id) -> bool;\n    fn head_majority(&self, groups: &G, index: usize) -> bool;\n    fn head_result(&self, groups: &G, index: usize) -> (Grade, D);\n    fn head_increment(&self, groups: G, index: usize) -> G;\n    fn head_set_size(&self, groups: G, index: usize, size: Id) -> G;\n    fn head_set_result(&self, groups: G, index: usize, grade: Grade, diff: D) -> G;\n    fn head_append(&self, groups: G, id: &Id, size: Id, grade: Grade, diff: D) -> G;\n}\n\n/// Membership-list primitives on one group. Erase means FIRST occurrence;\n/// prepend means index zero. Neither primitive decides a whole member update.\npub trait BodyGroups<B, Id> {\n    fn body_length(&self, groups: &B) -> usize;\n    fn body_matches(&self, groups: &B, index: usize, id: &Id) -> bool;\n    fn body_majority(&self, groups: &B, index: usize) -> bool;\n    fn body_has_member(&self, groups: &B, index: usize, note: &Id) -> bool;\n    fn body_has_trigger(&self, groups: &B, index: usize, note: &Id) -> bool;\n    fn body_prepend_member(&self, groups: B, index: usize, note: &Id) -> B;\n    fn body_prepend_trigger(&self, groups: B, index: usize, note: &Id) -> B;\n    fn body_erase_member(&self, groups: B, index: usize, note: &Id) -> B;\n    fn body_erase_trigger(&self, groups: B, index: usize, note: &Id) -> B;\n    fn body_members_empty(&self, groups: &B, index: usize) -> bool;\n    fn body_remove(&self, groups: B, index: usize) -> B;\n    fn body_append(&self, groups: B, id: &Id, note: &Id) -> B;\n}\n\npub trait TouchHoldSchedule<S, A, N, F, Q, C, H, E, Event, D, Z, Id, Grade> {\n    fn length(&self, holds: &S) -> usize;\n    fn get(&self, holds: &S, index: usize) -> (A, N);\n    fn sensor_diff(&self, note: &N) -> D;\n    fn button_diff(&self, note: &N) -> D;\n    fn local_pressed(&self, area: &A) -> bool;\n    fn body_check_active(&self, note: &N) -> bool;\n    fn body_group_id(&self, note: &N) -> Option<Id>;\n    fn head_group_id(&self, note: &N) -> Option<Id>;\n    fn note_index(&self, note: &N) -> Id;\n    fn group_size(&self, note: &N) -> Id;\n    fn phase(&self, note: &N) -> HoldPhase;\n    fn head_grade(&self, note: &N) -> Option<Grade>;\n    fn head_diff(&self, note: &N) -> D;\n    fn grade_rejected(&self, grade: &Grade) -> bool;\n    fn within_head_window(&self, note: &N) -> bool;\n    fn unlocked(&self, frontiers: &F, area: &A, note: &N) -> bool;\n    fn eligible(&self, note: &N) -> bool;\n    fn button_ring(&self) -> bool;\n    fn outer_button(&self, area: &A) -> Option<Z>;\n    fn button_available(&self, cursor: &C, zone: &Z) -> bool;\n    fn sensor_available(&self, cursor: &C, area: &A) -> bool;\n    fn use_button(&self, cursor: C, zone: &Z) -> C;\n    fn use_sensor(&self, cursor: C, area: &A) -> C;\n    fn step(\n        &self,\n        note: &N,\n        diff: D,\n        clicked: bool,\n        pressed: bool,\n        shared: Option<(Grade, D)>,\n    ) -> (N, Option<Event>);\n    fn advance_frontier(&self, frontiers: F, area: &A) -> F;\n    /// Existing replace-all + normalize + sensor-slot-store composition.\n    fn update_queue(&self, queues: Q, area: &A, note: &N) -> Q;\n    fn append_active(&self, active: H, area: A, note: N) -> H;\n    fn append_event(&self, events: E, event: Event) -> E;\n}\n\n/// Preserve first matching group even when that group's majority is false.\npub fn find_head<G, Id, Grade, D, Ops>(groups: &G, id: &Id, ops: &Ops) -> Option<usize>\nwhere\n    Ops: HeadGroups<G, Id, Grade, D>,\n{\n    let len = ops.head_length(groups);\n    let mut index = 0;\n    while index < len {\n        if ops.head_matches(groups, index, id) {\n            return Some(index);\n        }\n        index += 1;\n    }\n    None\n}\n\npub fn shared_result<G, Id, Grade, D, Ops>(groups: &G, id: &Id, ops: &Ops) -> Option<(Grade, D)>\nwhere\n    Ops: HeadGroups<G, Id, Grade, D>,\n{\n    match find_head::<G, Id, Grade, D, Ops>(groups, id, ops) {\n        Some(index) => {\n            if ops.head_majority(groups, index) {\n                Some(ops.head_result(groups, index))\n            } else {\n                None\n            }\n        }\n        None => None,\n    }\n}\n\npub fn register_head<G, Id, Grade, D, Ops>(\n    mut groups: G,\n    id: &Id,\n    size: Id,\n    grade: Grade,\n    diff: D,\n    ops: &Ops,\n) -> G\nwhere\n    Ops: HeadGroups<G, Id, Grade, D>,\n{\n    match find_head::<G, Id, Grade, D, Ops>(&groups, id, ops) {\n        Some(index) => {\n            let keep_result = ops.head_majority(&groups, index);\n            groups = ops.head_increment(groups, index);\n            groups = ops.head_set_size(groups, index, size);\n            if !keep_result {\n                groups = ops.head_set_result(groups, index, grade, diff);\n            }\n            groups\n        }\n        None => ops.head_append(groups, id, size, grade, diff),\n    }\n}\n\npub fn find_body<B, Id, Ops>(groups: &B, id: &Id, ops: &Ops) -> Option<usize>\nwhere\n    Ops: BodyGroups<B, Id>,\n{\n    let len = ops.body_length(groups);\n    let mut index = 0;\n    while index < len {\n        if ops.body_matches(groups, index, id) {\n            return Some(index);\n        }\n        index += 1;\n    }\n    None\n}\n\npub fn body_pressed<B, Id, Ops>(groups: &B, id: &Id, ops: &Ops) -> bool\nwhere\n    Ops: BodyGroups<B, Id>,\n{\n    match find_body(groups, id, ops) {\n        Some(index) => ops.body_majority(groups, index),\n        None => false,\n    }\n}\n\npub fn register_body<B, Id, Ops>(mut groups: B, id: &Id, note: &Id, ops: &Ops) -> B\nwhere\n    Ops: BodyGroups<B, Id>,\n{\n    match find_body(&groups, id, ops) {\n        Some(index) => {\n            if !ops.body_has_member(&groups, index, note) {\n                groups = ops.body_prepend_member(groups, index, note);\n            }\n            if !ops.body_has_trigger(&groups, index, note) {\n                groups = ops.body_prepend_trigger(groups, index, note);\n            }\n            groups\n        }\n        None => ops.body_append(groups, id, note),\n    }\n}\n\npub fn unregister_body<B, Id, Ops>(groups: B, id: &Id, note: &Id, ops: &Ops) -> B\nwhere\n    Ops: BodyGroups<B, Id>,\n{\n    match find_body(&groups, id, ops) {\n        Some(index) => ops.body_erase_trigger(groups, index, note),\n        None => groups,\n    }\n}\n\npub fn exit_body<B, Id, Ops>(mut groups: B, id: &Id, note: &Id, ops: &Ops) -> B\nwhere\n    Ops: BodyGroups<B, Id>,\n{\n    match find_body(&groups, id, ops) {\n        Some(index) => {\n            groups = ops.body_erase_member(groups, index, note);\n            if ops.body_members_empty(&groups, index) {\n                ops.body_remove(groups, index)\n            } else {\n                ops.body_erase_trigger(groups, index, note)\n            }\n        }\n        None => groups,\n    }\n}\n\n/// No recursive source traversal, no whole-item callback, no len + 1.\n/// Every bounded scan increments only under index < len. Forward appends\n/// preserve the successful reference's recursive-cons order, with old prefixes.\npub fn process<S, A, N, F, Q, C, H, E, Event, D, Z, Id, Grade, G, B, Ops>(\n    holds: &S,\n    mut work: TouchHoldWork<F, Q, C, H, E, G, B>,\n    ops: Ops,\n) -> TouchHoldWork<F, Q, C, H, E, G, B>\nwhere\n    Ops: TouchHoldSchedule<S, A, N, F, Q, C, H, E, Event, D, Z, Id, Grade>\n        + HeadGroups<G, Id, Grade, D>\n        + BodyGroups<B, Id>,\n{\n    let len = ops.length(holds);\n    let mut index = 0;\n    while index < len {\n        let (area, before) = ops.get(holds, index);\n        let sensor_diff = ops.sensor_diff(&before);\n        let local_pressed = ops.local_pressed(&area);\n        let body_id = ops.body_group_id(&before);\n        let note_id = ops.note_index(&before);\n        if ops.body_check_active(&before) {\n            if let Some(id) = &body_id {\n                work.body_groups = if local_pressed {\n                    register_body(work.body_groups, id, &note_id, &ops)\n                } else {\n                    unregister_body(work.body_groups, id, &note_id, &ops)\n                };\n            }\n        }\n        let pressed = local_pressed\n            || match &body_id {\n                Some(id) => body_pressed(&work.body_groups, id, &ops),\n                None => false,\n            };\n        let head_id = ops.head_group_id(&before);\n        let shared = match &head_id {\n            Some(id) => shared_result::<G, Id, Grade, D, Ops>(&work.groups, id, &ops),\n            None => None,\n        };\n        let before_phase = ops.phase(&before);\n        let allow_input = shared.is_none()\n            && ops.within_head_window(&before)\n            && matches!(\n                before_phase,\n                HoldPhase::HeadWaiting | HoldPhase::HeadJudgeable\n            )\n            && ops.unlocked(&work.frontiers, &area, &before)\n            && ops.eligible(&before);\n        let outer_button = if allow_input && ops.button_ring() {\n            ops.outer_button(&area)\n        } else {\n            None\n        };\n        let button_available = match &outer_button {\n            Some(zone) => ops.button_available(&work.cursor, zone),\n            None => false,\n        };\n        // If a button is consumed the sensor is not even probed. Otherwise\n        // the cursor before and after the button branch is identical.\n        let sensor_available = if allow_input && !button_available {\n            ops.sensor_available(&work.cursor, &area)\n        } else {\n            false\n        };\n        let plan = crate::scheduler::consume_click(allow_input, button_available, sensor_available);\n        if plan.used_button {\n            if let Some(zone) = outer_button {\n                work.cursor = ops.use_button(work.cursor, &zone);\n            }\n        }\n        if plan.used_sensor {\n            work.cursor = ops.use_sensor(work.cursor, &area);\n        }\n        let diff = if plan.used_button {\n            ops.button_diff(&before)\n        } else {\n            sensor_diff\n        };\n        let (after, event) = ops.step(\n            &before,\n            diff,\n            plan.used_button || plan.used_sensor,\n            pressed,\n            shared,\n        );\n        let after_phase = ops.phase(&after);\n        let entered_head = !matches!(before_phase, HoldPhase::HeadJudged)\n            && matches!(after_phase, HoldPhase::HeadJudged);\n        if entered_head {\n            work.frontiers = ops.advance_frontier(work.frontiers, &area);\n        }\n        work.queues = ops.update_queue(work.queues, &area, &after);\n        if entered_head {\n            if let Some(id) = &head_id {\n                if let Some(grade) = ops.head_grade(&after) {\n                    if !ops.grade_rejected(&grade) {\n                        work.groups = register_head(\n                            work.groups,\n                            id,\n                            ops.group_size(&before),\n                            grade,\n                            ops.head_diff(&after),\n                            &ops,\n                        );\n                    }\n                }\n            }\n        }\n        let keep_active = !matches!(after_phase, HoldPhase::Ended);\n        if !keep_active {\n            if let Some(id) = &body_id {\n                work.body_groups = exit_body(work.body_groups, id, &note_id, &ops);\n            }\n        }\n        if keep_active {\n            work.active = ops.append_active(work.active, area, after);\n        }\n        if let Some(event) = event {\n            work.events = ops.append_event(work.events, event);\n        }\n        index += 1;\n    }\n    work\n}\n"},{"id":51,"name":{"Local":"/rustc/library/core/src/clone.rs"},"crate_name":"core","contents":null},{"id":52,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":53,"name":{"Local":"/rustc/library/core/src/marker.rs"},"crate_name":"core","contents":null},{"id":54,"name":{"Local":"/rustc/library/core/src/default.rs"},"crate_name":"core","contents":null},{"id":55,"name":{"Local":"/rustc/library/core/src/cmp.rs"},"crate_name":"core","contents":null},{"id":56,"name":{"Local":"/rustc/library/core/src/option.rs"},"crate_name":"core","contents":null},{"id":57,"name":{"Local":"/rustc/library/core/src/ops/control_flow.rs"},"crate_name":"core","contents":null},{"id":58,"name":{"Local":"/rustc/library/core/src/ops/mod.rs"},"crate_name":"core","contents":null},{"id":59,"name":{"Local":"/rustc/library/core/src/fmt/mod.rs"},"crate_name":"core","contents":null},{"id":60,"name":{"Local":"/rustc/library/core/src/num/int_macros.rs"},"crate_name":"core","contents":null},{"id":61,"name":{"Local":"/rustc/library/core/src/num/mod.rs"},"crate_name":"core","contents":null},{"id":62,"name":{"Local":"/rustc/library/core/src/num/uint_macros.rs"},"crate_name":"core","contents":null},{"id":63,