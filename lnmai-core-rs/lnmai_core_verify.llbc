raw = Duration {\n        micros: length.micros - ignore_time.micros,\n    };\n    let hold_max = Duration::from_micros(300000);\n    let reality_ht_max = if length.micros > hold_max.micros {\n        Duration {\n            micros: length.micros - hold_max.micros,\n        }\n    } else {\n        Duration::zero()\n    };\n    let zero = Duration::zero();\n    let reality_ht = if reality_ht_raw.micros < zero.micros {\n        zero\n    } else if reality_ht_raw.micros > reality_ht_max.micros {\n        reality_ht_max\n    } else {\n        reality_ht_raw\n    };\n\n    if reality_ht.micros <= 0 {\n        return head_grade;\n    }\n\n    let held_raw = Duration {\n        micros: reality_ht.micros - player_release_time.micros,\n    };\n    let held = if held_raw.micros < zero.micros {\n        zero\n    } else {\n        held_raw\n    };\n    let band = press_band_micros(held.to_micros(), reality_ht.to_micros());\n    hold_band_grade(head_grade, judge_diff.micros >= 0, band)\n}","attr_info":{"attributes":[{"DocComment":" HoldEndJudge: computes the final hold grade from head grade and how"},{"DocComment":" long the player held the button."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":9953},{"Deduplicated":9952},{"Deduplicated":9952},{"Deduplicated":9952},{"Deduplicated":9952}],"output":{"Deduplicated":9953}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":11,"beg":{"line":235,"col":0},"end":{"line":276,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":5,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":11,"beg":{"line":241,"col":5},"end":{"line":241,"col":15}},"generated_from_span":null},"ty":{"Deduplicated":9953}