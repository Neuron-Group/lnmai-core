 replacement: &N, ops: Ops) -> Q\nwhere\n    Ops: QueueReplace<Q, N>,\n{\n    let mut index = 0;\n    while index < len {\n        let existing = ops.get(&queue, index);\n        if ops.index_equal(&existing, replacement) {\n            queue = ops.write(queue, index, replacement);\n        }\n        index += 1;\n    }\n    queue\n}","attr_info":{"attributes":[{"DocComment":" Replace every matching identifier across the entire queue, including"},{"DocComment":" slots before its cursor and every duplicate. Never stop after a match."},{"DocComment":" `len` is the initial slot count; point writes must preserve that count."},{"DocComment":" Thus `index < len` justifies each read/write and also `index += 1`, even"},{"DocComment":" when len is usize::MAX. The cursor is neither read nor normalized here."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Q"},{"index":1,"name":"N"},{"index":2,"name":"Ops"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":16,"beg":{"line":56,"col":9},"end":{"line":56,"col":27}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":28864},{"Deduplicated":28859},{"Deduplicated":28860}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":8349},{"Deduplicated":28859},{"Deduplicated":29061},{"Deduplicated":28864}],"output":{"Deduplicated":28859}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":16,"beg":{"line":54,"col":0},"end":{"line":67,"col":1}},"generated_from_span":null},"bound_body_regions":27,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":16,"beg":{"line":54,"c