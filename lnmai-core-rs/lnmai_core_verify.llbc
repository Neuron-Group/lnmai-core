NoteKind::Rest | NoteKind::Unknown => NotePlan::Skip,\n    }\n}","attr_info":{"attributes":[{"DocComment":" The complete kind/position/flag decision for one raw token."},{"DocComment":" Sensor presence cannot rescue a missing Tap/Hold/Slide slot and vice versa."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Slot"},{"index":1,"name":"Sensor"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"HashConsedValue":[14827,{"Adt":{"id":{"Adt":75},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":28863},{"Deduplicated":29082},{"Deduplicated":14845}],"output":{"HashConsedValue":[29716,{"Adt":{"id":{"Adt":80},"generics":{"regions":[],"types":[{"Deduplicated":28859},{"Deduplicated":28860}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":45,"beg":{"line":65,"col":0},"end":{"line":122,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":45,"beg":{"line":70,"col":5},"end":{"line":70,"col":27}},"generated_from_span":null},"ty":{"Deduplicated":29716}},{"index":1,"name":"kind","span":{"data":{"file_id":45,"beg":{"line":66,"col":4},"end":{"line":66,"col":8}},"generated_from_span":null},"ty":{"Deduplicated":14827}},{"index":2,"name":"slot","span":{"data":{"file_id":45,"beg":{"line":67,"col":4},"end":{"line":67,"col":8}},"generated_from_span":null},"ty":{"Deduplicated":28863}},{"index":3,"name":"sensor","span":{"data":{"file_id":45,"beg":{"line":68,"col":4},"end":{"line":68,"col":10}},"generated_from_span":null},"ty":{"Deduplicated":29082}},{"index":4,"name":"flags","span":{"data":{"file_id":45,"beg":{"line":69,"col":4},"end":{"line":69,"col":9}},"g