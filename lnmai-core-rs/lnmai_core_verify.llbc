se, false),\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" Fast/late increment flags for a grade under a display option."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":9813},{"Deduplicated":9812},{"Deduplicated":10206}],"output":{"Deduplicated":10207}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":19,"beg":{"line":123,"col":0},"end":{"line":165,"col":1}},"generated_from_span":null},"bound_body_regions":7,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":19,"beg":{"line":127,"col":5},"end":{"line":127,"col":17}},"generated_from_span":null},"ty":{"Deduplicated":10207}},{"index":1,"name":"grade","span":{"data":{"file_id":19,"beg":{"line":124,"col":4},"end":{"line":124,"col":9}},"generated_from_span":null},"ty":{"Deduplicated":9813}},{"index":2,"name":"diff","span":{"data":{"file_id":19,"beg":{"line":125,"col":4},"end":{"line":125,"col":8}},"generated_from_span":null},"ty":{"Deduplicated":9812}},{"index":3,"name":"display","span":{"data":{"file_id":19,"beg":{"line":126,"col":4},"end":{"line":126,"col":11}},"generated_from_span":null},"ty":{"Deduplicated":10206}},{"index":4,"name":null,"span":{"data":{"file_id":19,"beg":{"line":128,"col":7},"end":{"line":128,"col":34}},"generated_from_span":null},"ty":{"Deduplicated":7972}},{"index":5,"name":null,"span":{"data":{"file_id":19,"beg":{"line":128,"col":7},"end":{"line":128,"col":12}},"generated_from_span":null},"ty":{"Deduplicated":9821}},{"index":6,"name":"d","span":{"data":{"file_id":19,"beg":{"line":131,"col":12},"end":{"line":131,"col":13}},"generated_from_span":null},"ty":{"Deduplicated":8404}},{"index":7,"name":null,"span":{"data":{"file_id":19,"beg":{"lin