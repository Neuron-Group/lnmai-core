end_member(groups, group, note);\n            }\n            // A member write preserves the original trigger list and its length.\n            let trigger = find_trigger::<S, B, Id, Ops>(&groups, group, note, ops);\n            if triggered {\n                if trigger.is_none() {\n                    groups = ops.prepend_trigger(groups, group, note);\n                }\n            } else if let Some(index) = trigger {\n                groups = ops.remove_trigger(groups, group, index);\n            }\n            groups\n        }\n        None => {\n            let group = ops.group_length(&groups);\n            groups = ops.append_empty(groups, id);\n            groups = ops.prepend_member(groups, group, note);\n            if triggered {\n                groups = ops.prepend_trigger(groups, group, note);\n            }\n            groups\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" Update one source note. In particular, false still inserts a missing member,"},{"DocComment":" and removes at most ONE trigger. No sets, deduplication, or length clamping."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"S"},{"index":1,"name":"B"},{"index":2,"name":"Id"},{"index":3,"name":"Ops"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":38,"beg":{"line":89,"col":9},"end":{"line":89,"col":35}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":24529},{"Deduplicated":24525},{"Deduplicated":24527},{"Deduplicated":24528}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Ded