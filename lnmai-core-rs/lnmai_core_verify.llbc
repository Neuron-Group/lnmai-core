col":1}},"generated_from_span":null},"source_text":"impl<Text, Ops> LineRead<(Text, Text)> for MaidataLineOps<'_, Text, Ops>\nwhere\n    Ops: LinePrimitives<Text>,\n{\n    fn is_blank(&self, index: usize) -> bool {\n        let view = self.primitives.borrow(&self.lines[index]);\n        self.primitives.is_empty(self.primitives.trim(view))\n    }\n\n    fn starts_with_amp(&self, index: usize) -> bool {\n        let view = self.primitives.borrow(&self.lines[index]);\n        self.primitives.starts_with_amp(self.primitives.trim(view))\n    }\n\n    fn header(&self, index: usize) -> Option<(Text, Text)> {\n        // Split the original line; do not trim the whole line first.\n        self.primitives\n            .header(self.primitives.borrow(&self.lines[index]))\n    }\n\n    fn is_chart_header(&self, header: &(Text, Text)) -> bool {\n        self.primitives\n            .starts_with_inote(self.primitives.borrow(&header.0))\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"impl_trait":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":29133},{"Deduplicated":29087}],"const_generics":[],"trait_refs":[]}},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Text"},{"index":1,"name":"Ops"},{"index":2,"name":"Clause0_View"},{"index":3,"name":"Clause0_Level"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":14,"beg":{"line":47,"col":9},"end":{"line":47,"col":29}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":29080},{"Deduplicated":29079},{"Deduplicated":29084},{"Deduplicated":29085}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"muta