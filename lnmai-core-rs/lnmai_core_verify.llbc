"Ident":["touch_hold_rebuild",0]},{"Ident":["upsert",0]}],"span":{"data":{"file_id":49,"beg":{"line":87,"col":0},"end":{"line":117,"col":1}},"generated_from_span":null},"source_text":"pub fn upsert<S, B, Id, Ops>(mut groups: B, id: &Id, note: &Id, triggered: bool, ops: &Ops) -> B\nwhere\n    Ops: TouchHoldRebuild<S, B, Id>,\n{\n    match find_group::<S, B, Id, Ops>(&groups, id, ops) {\n        Some(group) => {\n            if find_member::<S, B, Id, Ops>(&groups, group, note, ops).is_none() {\n                groups = ops.prepend_member(groups, group, note);\n            }\n            // A member write preserves the original trigger list and its length.\n            let trigger = find_trigger::<S, B, Id, Ops>(&groups, group, note, ops);\n            if triggered {\n                if trigger.is_none() {\n                    groups = ops.prepend_trigger(groups, group, note);\n                }\n            } else if let Some(index) = trigger {\n                groups = ops.remove_trigger(groups, group, index);\n            }\n            groups\n        }\n        None => {\n            let group = ops.group_length(&groups);\n            groups = ops.append_empty(groups, id);\n            groups = ops.prepend_member(groups, group, note);\n            if triggered {\n                groups = ops.prepend_trigger(groups, group, note);\n            }\n            groups\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" Update one source note. In particular, false still inserts a missing member,"},{"DocComment":" and removes at most ONE trigger. No sets, deduplication, or length clamping."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"S"},{"index":1,"name":"B"},{"index":2,"name":"Id"},{"index":3,"name":"Ops"}],