input = matches!(\n            before_phase,\n            HoldPhase::HeadWaiting | HoldPhase::HeadJudgeable\n        ) && ops.unlocked(&work.frontiers, &zone, &before)\n            && ops.eligible(&before);\n        let fallback_area = ops.fallback_area(&zone);\n        // Both availability reads observe the cursor before either update.\n        let plan = crate::scheduler::consume_click(\n            allow_input,\n            ops.button_available(&work.cursor, &zone),\n            ops.sensor_available(&work.cursor, &fallback_area),\n        );\n        if plan.used_button {\n            work.cursor = ops.use_button(work.cursor, &zone);\n        }\n        if plan.used_sensor {\n            work.cursor = ops.use_sensor(work.cursor, &fallback_area);\n        }\n        let clicked = plan.used_button || plan.used_sensor;\n        // Ordinary Hold uses the sensor diff even when no click was consumed.\n        let diff = if plan.used_button {\n            button_diff\n        } else {\n            sensor_diff\n        };\n        let pressed = current_button_pressed || current_sensor_pressed;\n        let (after, event) = ops.step(\n            &before,\n            diff,\n            clicked,\n            pressed,\n            current_button_pressed,\n            prev_sensor_pressed,\n        );\n        let after_phase = ops.phase(&after);\n        // Match the final lifecycle state, including HeadJudged(Miss). A\n        // transition straight to Body/Ended does not satisfy this condition.\n        if !matches!(before_phase, HoldPhase::HeadJudged)\n            && matches!(after_phase, HoldPhase::HeadJudged)\n        {\n            work.frontiers = ops.advance_frontier(work.frontiers, &zone);\n        }\n        // Sync every result; event presence and active retention are irrelevant.\n        work.queues = ops.update_queue(work.queues, &zone, &after);\n        if !matches!(after_phase, HoldPhase::Ended) {\n            work.active = ops.append_active(work.active, zone, after);\n        }\n        if let Some(event) = event {\n            work.events = ops.append_event(work.events, event);\n        }\n        index += 1;\n    }\n    work\n}","attr_info":{"attributes":[{"DocComment":" Full ordinary-hold pass. The index increases only under index < len, so"},{"DocComment":" index + 1 <= len <= usize::MAX. No recursive traversal or len + 1 is needed."},{"DocComment":" The queue adapter's separate normalization boundary is unaffected by this."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"S"},{"index":1,"name":"Z"},{"index":2,"name":"N"},{"index":3,"name":"F"},{"index":4,"name":"Q"},{"index":5,"name":"C"},{"index":6,"name":"H"},{"index":7,"name":"E"},{"index":8,"name":"Event"},{"index":9,"name":"D"},{"index":10,"name":"Area"},{"index":11,"name":"Ops"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":44,"beg":{"line":72,"col":9},"end":{"line":72,"col":61}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":29035},{"Deduplicated":28859},{"Deduplicated":28860},{"Deduplicated":28864},{"Deduplicated":28865},{"Deduplicated":28869},{"Deduplicated":28870},{"Deduplicated":28871},{"Deduplicated":29031},{"Deduplicated":29032},{"Deduplicated":29033},{"Deduplicated":29034}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":29066},{"HashConsedValue":[29667,{"Adt":{"id":{"Adt":74},"generics":{"regions":[],"types":[{"Deduplicated":28865},{"Deduplicated":28869},{"Deduplicated":28870},{"Deduplicated":28871},{"Deduplicated":29031}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":29035}],"output":{"Deduplicated":29667}},"src":"TopLevel"