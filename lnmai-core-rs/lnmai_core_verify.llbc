held);\n        let rest2 = &rest[1..];\n        if second.is_finished() {\n            let (remaining, commands) = advance_fuel(fuel, emit, rest2, held);\n            let commands = prepend_progress(emit, &second.arrow_progress_when_finished, &commands);\n            (remaining, commands)\n        } else if second.on() {\n            let next = with_head(second.clone(), rest2);\n            let (remaining, commands) = advance_fuel(fuel, emit, &next, held);\n            let commands = prepend_progress(emit, &second.arrow_progress_when_on, &commands);\n            (remaining, commands)\n        } else if first.is_finished() {\n            let next = with_head(second, rest2);\n            let (remaining, commands) = advance_fuel(fuel, emit, &next, held);\n            let commands = prepend_progress(emit, &first.arrow_progress_when_finished, &commands);\n            (remaining, commands)\n        } else {\n            let next = with_head(second, rest2);\n            (with_head(first, &next), Vec::new())\n        }\n    } else if first.is_finished() {\n        let (remaining, commands) = advance_fuel(fuel, emit, rest, held);\n        let commands = prepend_progress(emit, &first.arrow_progress_when_finished, &commands);\n        (remaining, commands)\n    } else {\n        (with_head(first, rest), Vec::new())\n    }\n}","attr_info":{"attributes":[{"Unknown":{"path":"allow","args":"clippy::len_zero"}}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"P"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":19,"beg":{"line":29,"col":23},"end":{"line":29,"col":28}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":23111}],"const_generics":[],"trait_refs"