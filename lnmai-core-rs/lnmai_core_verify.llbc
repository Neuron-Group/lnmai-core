f.micros < 0;\n    let abs_diff = diff.abs();\n\n    if is_fast && abs_diff.micros > TOUCH_PERFECT_1ST.micros {\n        return None;\n    }\n\n    let grade = if abs_diff.micros <= TOUCH_PERFECT_1ST.micros {\n        JudgeGrade::Perfect\n    } else if abs_diff.micros <= TOUCH_PERFECT_2ND.micros {\n        JudgeGrade::LatePerfect2nd\n    } else if abs_diff.micros <= TOUCH_PERFECT_3RD.micros {\n        JudgeGrade::LatePerfect3rd\n    } else if abs_diff.micros <= TOUCH_GREAT_1ST.micros {\n        JudgeGrade::LateGreat\n    } else if abs_diff.micros <= TOUCH_GREAT_2ND.micros {\n        JudgeGrade::LateGreat2nd\n    } else if abs_diff.micros <= TOUCH_GREAT_3RD.micros {\n        JudgeGrade::LateGreat3rd\n    } else {\n        JudgeGrade::LateGood\n    };\n\n    Some(grade)\n}","attr_info":{"attributes":[{"DocComment":" Judge a touch note"}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":6810},{"Deduplicated":6395}],"output":{"HashConsedValue":[6843,{"Adt":{"id":{"Adt":80},"generics":{"regions":[],"types":[{"Deduplicated":6812}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":5,"beg":{"line":60,"col":0},"end":{"line":85,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":5,"beg":{"line":60,"col":52},"end":{"line":60,"col":70}},"generated_from_span":null},"ty":{"Deduplicated":6843}},{"index":1,"name":"diff","span":{"data":{"file_id":5,"beg":{"line":60,"col":19},"end":{"line":60,"col":23}},"generated_from_span":null},"ty":{"Deduplicated":6810}},{"index":2,"name":"_is_ex","span":{"data":{"file_id":5,"beg":{"line":60,"col":35},"end":{"l