            // Ended with no event still advances both positions. The old\n            // queue slot is deliberately retained rather than replaced.\n            work.queue = ops.advance(work.queue);\n            work.frontiers = ops.advance_frontier(work.frontiers);\n            let continue_queue = crate::scheduler::tap_queue_has_unused_click(\n                ops.button_available(&work.cursor),\n                ops.sensor_available(&work.cursor, &fallback_area),\n            );\n            if !continue_queue {\n                return work;\n            }\n            fuel -= 1;\n        } else {\n            work.queue = ops.replace_current(work.queue, &after);\n            return work;\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" The complete queue control flow. `fuel` decreases only on a continuing"},{"DocComment":" Ended branch and only after its nonzero guard. Passing the remaining slot"},{"DocComment":" count suffices; the runtime wrapper need not compute `remaining + 1`."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Q"},{"index":1,"name":"N"},{"index":2,"name":"F"},{"index":3,"name":"C"},{"index":4,"name":"E"},{"index":5,"name":"Event"},{"index":6,"name":"D"},{"index":7,"name":"Area"},{"index":8,"name":"Ops"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":34,"beg":{"line":49,"col":9},"end":{"line":49,"col":51}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"HashConsedValue":[29032,{"TypeVar":{"Free":8}}]},{"Deduplicated":28859},{"Deduplicated":28860},{"Deduplicated":28864},{"Deduplicated":28865},{"Deduplicated":28869},{"Deduplicated":28870},{"Deduplicated":28871},{"HashConsedValue":[29031,{"TypeVar":{"Free":7}}]}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_con