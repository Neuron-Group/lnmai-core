len, cursor, &ops) {\n            LinePlan::Skip(next) => cursor = next,\n            LinePlan::Metadata(header, next) => {\n                fields = ops.append_field(fields, header);\n                cursor = next;\n            }\n            LinePlan::Chart(header, range) => {\n                let mut body = ops.begin_chart(header);\n                let mut line = range.start;\n                while line < range.end {\n                    body = ops.append_body_line(body, line);\n                    line += 1;\n                }\n                charts = ops.append_chart(charts, body);\n                cursor = range.end;\n            }\n        }\n    }\n    (fields, charts)\n}","attr_info":{"attributes":[{"DocComment":" Full line collection. Output prefixes are FORWARD, unlike the original"},{"DocComment":" Lean helper's reverse accumulators. Public runtime entry supplies empty ones."},{"DocComment":" Repeated metadata keys and chart levels remain distinct ordered appends."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Header"},{"index":1,"name":"Fields"},{"index":2,"name":"Charts"},{"index":3,"name":"Body"},{"index":4,"name":"Ops"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":13,"beg":{"line":91,"col":9},"end":{"line":91,"col":25}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":28869},{"Deduplicated":28859}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":13,"beg":{"line":91,"col":28},"end":{"line":91,"col":67}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":28869},{"Deduplicated":28859},{"Deduplicated":28860},{"Deduplicated":28864},{"Deduplicated":28865}],"const_generics":[],"trait_re