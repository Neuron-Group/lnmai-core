 len / 2;\n    let mut left = 0;\n    while left < half {\n        // Entering the loop implies len >= 2 and left < len.\n        let right = len - 1 - left;\n        groups = ops.swap_groups(groups, left, right);\n        left += 1;\n    }\n    groups\n}","attr_info":{"attributes":[{"DocComment":" Reverse outer group order ONLY. The loop performs floor(len / 2) point swaps;"},{"DocComment":" member and trigger order inside each group remains unchanged."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"S"},{"index":1,"name":"B"},{"index":2,"name":"Id"},{"index":3,"name":"Ops"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":38,"beg":{"line":123,"col":9},"end":{"line":123,"col":35}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":24529},{"Deduplicated":24525},{"Deduplicated":24527},{"Deduplicated":24528}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":24527},{"HashConsedValue":[25360,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":24529},"Shared"]}]}],"output":{"Deduplicated":24527}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":38,"beg":{"line":121,"col":0},"end":{"line":135,"col":1}},"generated_from_span":null},"bound_body_regions":13,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":38,"beg":{"line":121,"col":66},"end":{"line":121,"col":67}},"generated_from_span":null},"ty":{"Deduplicated":24527}},{"index":1,"name":"groups","span":{"data":{"file_id":38,"beg":{"line":121,"col":37},"end":{"line":121,"col":47}},"generated_from_span":null},"ty":{"Deduplicated":24527}},{"index":2,"n