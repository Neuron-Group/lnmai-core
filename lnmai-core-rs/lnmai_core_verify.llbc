ration,\n    display: JudgeDisplayOption,\n) -> (bool, bool) {\n    if grade.is_miss_or_too_fast() {\n        (false, false)\n    } else {\n        let d = grade.dist_from_perfect();\n        match display {\n            JudgeDisplayOption::All => {\n                if diff.to_micros() == 0 {\n                    (false, false)\n                } else if diff.to_micros() < 0 {\n                    (true, false)\n                } else {\n                    (false, true)\n                }\n            }\n            JudgeDisplayOption::BelowCP => {\n                if matches!(grade, JudgeGrade::Perfect) {\n                    (false, false)\n                } else if diff.to_micros() < 0 {\n                    (true, false)\n                } else {\n                    (false, true)\n                }\n            }\n            JudgeDisplayOption::BelowP\n            | JudgeDisplayOption::BelowGR\n            | JudgeDisplayOption::Disable => {\n                if d <= 2 {\n                    (false, false)\n                } else if diff.to_micros() < 0 {\n                    (true, false)\n                } else {\n                    (false, true)\n                }\n            }\n            JudgeDisplayOption::MissOnly => (false, false),\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" Fast/late increment flags for a grade under a display option."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":5350},{"Deduplicated":5348},{"Deduplicated":5704}],"output":{"Deduplicated":5705}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":10,"beg":{"line":123,"col":0},"end":{"line":165,"col":1}},"generated_from_span":null},"bound_body_regions":7,"