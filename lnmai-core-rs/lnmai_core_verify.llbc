"id":3666,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":54,"item_meta":{"name":[{"Ident":["lnmai_core_verify",0]},{"Ident":["shape",0]},{"Ident":["solve_shape",0]}],"span":{"data":{"file_id":8,"beg":{"line":280,"col":0},"end":{"line":400,"col":1}},"generated_from_span":null},"source_text":"pub fn solve_shape(\n    kind: SlideBodyKind,\n    start_lane: OuterSlot,\n    end_area: Option<SensorArea>,\n    turn_area: Option<SensorArea>,\n) -> Result<SlideShape, ShapeError> {\n    let end_area = end_area.unwrap_or(SensorArea::A1);\n    let direct = symmetry::direct();\n    let mirror = symmetry::mirror();\n    match kind {\n        SlideBodyKind::Line => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Line, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::CircleRight => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if outer_slot_is_upper_half(start_lane) {\n                    direct\n                } else {\n                    mirror\n                },\n            ))\n        }\n        SlideBodyKind::CircleLeft => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if !outer_slot_is_upper_half(start_lane) {\n                    direct\n                } else {\n                    mirror\n                },\n            ))\n        }\n        SlideBodyKind::CircleUp => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if rel_end < 5 { direct } else { mirror },\n            ))\n        }\n        SlideBodyKind::V => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::V, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Pp => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Ppqq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Qq => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Ppqq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, mirror))\n        }\n        SlideBodyKind::P => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Pq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Q => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Pq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, mirror))\n        }\n        SlideBodyKind::S | SlideBodyKind::Z => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if rel_end != 5 {\n                Err(ShapeError::InvalidEnd)\n            } else {\n                let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::S, None));\n                let sym = if kind == SlideBodyKind::Z {\n                    mirror\n                } else {\n                    direct\n                };\n                Ok(mk_slide_shape(canonical, sym))\n            }\n        }\n        SlideBodyKind::Turn => {\n            let turn_area = turn_area.unwrap_or(SensorArea::A1);\n            let turn_rel = shape_try!(relative_end_from_typed(start_lane, turn_area));\n            let end_rel = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if turn_rel == 7 {\n                if end_rel < 2 || end_rel > 5 {\n                    Err(ShapeError::InvalidTurnEnd)\n                } else {\n                    let canonical =\n                        shape_try!(mk_canonical_slide_shape(SlideKind::Turn, Some(end_rel)));\n                    Ok(mk_slide_shape(canonical, direct))\n                }\n            } else if turn_rel == 3 {\n                if end_rel < 5 {\n                    Err(ShapeError::InvalidTurnEnd)\n                } else {\n                    let canonical =\n                        shape_try!(mk_canonical_slide_shape(SlideKind::Turn, Some(end_rel)));\n                    Ok(mk_slide_shape(canonical, mirror))\n                }\n            } else {\n                Err(ShapeError::InvalidTurn)\n            }\n        }\n        SlideBodyKind::Wifi => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if rel_end != 5 {\n                Err(ShapeError::InvalidEnd)\n            } else {\n                let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Wifi, None));\n                Ok(mk_slide_shape(canonical, direct))\n            }\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" `solveSlideShape`."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"HashConsedValue":[4474,{"Adt":{"id":{"Adt":12},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":3517},{"HashConsedValue":[4545,{"Adt":{"id":{"Adt":36},"generics":{"regions":[],"types":[{"Deduplicated":3091}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":4545}],"output":{"HashConsedValue":[4546,{"Adt":{"id":{"Adt":42},"generics":{"regions":[],"types":[{"Deduplicated":4439},{"Deduplicated":4500}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":8,"beg":{"line":280,"col":0},"end":{"line":400,"col":1}},"generated_from_span":null},"bound_body_regions":10,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":8,"beg":{"line":285,"col":5},"end":{"line":285,"col":35}},"generated_from_span":null},"ty":{"Deduplicated":4546}},{"index":1,"name":"kind","span":{"data":{"file_id":8,"beg":{"line":281,"col":4},"end":{"line":281,"col":8}},"generated_from_span":null},"ty":{"Deduplicated":4474}},{"index":2,"name":"start_lane","span":{"data":{"file_id":8,"beg":{"line":282,"col":4},"end":{"line":282,"col":14}},"generated_from_span":null},"ty":{"Deduplicated":3517}},{"index":3,"name":"end_area","span":{"data":{"file_id":8,"beg":{"line":283,"col":4},"end":{"line":283,"col":12}},"generated_from_span":null},"ty":{"Deduplicated":4545}},{"index":4,"name":"turn_area","span":{"data":{"file_id":8,"beg":{"line":284,"col":4},"end":{"line":284,"col":13}},"generated_from_span":null},"ty":{"Deduplicated":4545}},{"index":5,"name":"end_area","span":{"data":{"file_id":8,"beg":{"line":286,"col":8},"end":{"line":286,"col":16}},"generated_from_span":null},"ty":{"Deduplicated":3091}},{"index":6,"name":null,"span":{"data":{"file_id":8,"beg":{"line":286,"col":19},"end":{"line":286,"col":27}},"generated_from_span":null},"ty":{"Deduplicated":4545}},{"index":7,"name":null,"span":