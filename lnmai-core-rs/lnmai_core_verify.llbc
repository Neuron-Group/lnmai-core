lags: RawFlags,\n) -> NotePlan<Slot, Sensor> {\n    match kind {\n        NoteKind::Tap => match slot {\n            Some(slot) => NotePlan::Tap(\n                slot,\n                TapFlags {\n                    is_break: flags.is_break,\n                    is_ex: flags.is_ex,\n                    is_hanabi: flags.is_hanabi,\n                    is_force_star: flags.is_force_star,\n                },\n            ),\n            None => NotePlan::Skip,\n        },\n        NoteKind::Hold => match slot {\n            Some(slot) => NotePlan::Hold(\n                slot,\n                HoldFlags {\n                    is_break: flags.is_break,\n                    is_ex: flags.is_ex,\n                    is_hanabi: flags.is_hanabi,\n                },\n            ),\n            None => NotePlan::Skip,\n        },\n        NoteKind::Touch => match sensor {\n            Some(sensor) => NotePlan::Touch(\n                sensor,\n                TouchFlags {\n                    is_break: flags.is_break,\n                    is_hanabi: flags.is_hanabi,\n                },\n            ),\n            None => NotePlan::Skip,\n        },\n        NoteKind::TouchHold => match sensor {\n            Some(sensor) => NotePlan::TouchHold(\n                sensor,\n                HoldFlags {\n                    is_break: flags.is_break,\n                    is_ex: flags.is_ex,\n                    is_hanabi: flags.is_hanabi,\n                },\n            ),\n            None => NotePlan::Skip,\n        },\n        NoteKind::Slide => match slot {\n            Some(slot) => NotePlan::Slide(slot, flags),\n            None => NotePlan::Skip,\n        },\n        NoteKind::Rest | NoteKind::Unknown => NotePlan::Skip,\n    }\n}","attr_info":{"attributes":[{"DocComment":" The complete kind/position/flag decision for one raw token."},{"DocComment":" Sensor presence cannot rescue a missing Tap/Hold/Slide slot and vice versa."}],"inline":null,"rename":null,"public":true},"is_l