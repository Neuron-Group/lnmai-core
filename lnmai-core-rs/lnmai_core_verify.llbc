nd => (1500 * m, 40 * m, 0, 1000 * m, 60 * m, 100 * m),\n        JudgeGrade::LateGreat | JudgeGrade::FastGreat => (2000 * m, 40 * m, 0, 500 * m, 60 * m, 100 * m),\n        JudgeGrade::LatePerfect3rd | JudgeGrade::FastPerfect3rd => (2500 * m, 50 * m, 0, 0, 50 * m, 100 * m),\n        JudgeGrade::LatePerfect2nd | JudgeGrade::FastPerfect2nd => (2500 * m, 75 * m, 50 * m, 0, 25 * m, 50 * m),\n        JudgeGrade::Perfect => (2500 * m, 100 * m, 100 * m, 0, 0, 0),\n    }\n}","attr_info":{"attributes":[{"DocComment":" Score a Break note: returns"},{"DocComment":" `(baseEarned, extraEarned, classicExtraEarned, baseLost, extraLost, classicExtraLost)`."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":2033},{"Deduplicated":2032}],"output":{"HashConsedValue":[2117,{"Adt":{"id":"Tuple","generics":{"regions":[],"types":[{"Deduplicated":2032},{"Deduplicated":2032},{"Deduplicated":2032},{"Deduplicated":2032},{"Deduplicated":2032},{"Deduplicated":2032}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":5,"beg":{"line":35,"col":0},"end":{"line":47,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":5,"beg":{"line":35,"col":56},"end":{"line":35,"col":86}},"generated_from_span":null},"ty":{"Deduplicated":2117}},{"index":1,"name":"grade","span":{"data":{"file_id":5,"beg":{"line":35,"col":19},"end":{"line":35,"col":24}},"generated_from_span":null},"ty":{"Deduplicated":2033}},{"index":2,"name":"multiple","span":{"data":{"file_id":5,"beg":{"line":35,"col":38},"end":{"line":35,"col":46}},"generated_from_span":null},"ty":{"Deduplicated":2032}},{"index":3,"