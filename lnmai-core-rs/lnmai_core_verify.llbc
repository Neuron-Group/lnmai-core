end) => Ok(rel_end < 4),\n            Err(error) => Err(JustError::Shape(error)),\n        }\n    } else if facts.turn {\n        let _start = read_try!(just_start(start));\n        let end_area = read_try!(just_end(end3, 3));\n        let end_zone = read_try!(just_outer(end_area));\n        Ok(shape::outer_slot_is_right_half(end_zone))\n    } else if facts.wifi {\n        let _start = read_try!(just_start(start));\n        let end_area = read_try!(just_end(end2, 2));\n        let end_zone = read_try!(just_outer(end_area));\n        Ok(shape::outer_slot_is_upper_half(end_zone))\n    } else {\n        let end_area = if facts.qq || facts.pp {\n            read_try!(just_end(end3, 3))\n        } else {\n            read_try!(just_end(end2, 2))\n        };\n        let end_zone = read_try!(just_outer(end_area));\n        Ok(shape::outer_slot_is_right_half(end_zone))\n    }\n}","attr_info":{"attributes":[{"DocComment":" The priority is >, <, ^, V, w, default; it is independent of shape dispatch."},{"DocComment":" In the default branch the start character is deliberately never validated."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":12279},{"Deduplicated":11091},{"Deduplicated":11091},{"Deduplicated":11091}],"output":{"HashConsedValue":[12295,{"Adt":{"id":{"Adt":104},"generics":{"regions":[],"types":[{"Deduplicated":7972},{"Deduplicated":12258}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":25,"beg":{"line":140,"col":0},"end":{"line":180,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":25,"beg":{"line":145,"col":5},"end":{"