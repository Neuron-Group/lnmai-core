rom_span":null},"id":5474,"kind":{"StorageDead":7},"comments_before":[]},{"span":{"data":{"file_id":11,"beg":{"line":261,"col":26},"end":{"line":264,"col":10}},"generated_from_span":null},"id":5475,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":6902}},{"Aggregate":[{"Adt":[{"id":{"Adt":67},"generics":{"regions":[],"types":[{"Deduplicated":5311},{"Deduplicated":6863}],"const_generics":[],"trait_refs":[]}},0,null]},[{"Move":{"kind":{"Local":6},"ty":{"Deduplicated":5311}}}]]}]},"comments_before":[]},{"span":{"data":{"file_id":11,"beg":{"line":264,"col":9},"end":{"line":264,"col":10}},"generated_from_span":null},"id":5476,"kind":{"StorageDead":6},"comments_before":[]},{"span":{"data":{"file_id":11,"beg":{"line":264,"col":9},"end":{"line":264,"col":10}},"generated_from_span":null},"id":5477,"kind":{"StorageDead":5},"comments_before":[]}]}]],null]}},"comments_before":[]},{"span":{"data":{"file_id":11,"beg":{"line":267,"col":0},"end":{"line":267,"col":1}},"generated_from_span":null},"id":5481,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"data":{"file_id":11,"beg":{"line":267,"col":1},"end":{"line":267,"col":1}},"generated_from_span":null},"id":5482,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":78,"item_meta":{"name":[{"Ident":["lnmai_core_verify",0]},{"Ident":["shape",0]},{"Ident":["solve_shape",0]}],"span":{"data":{"file_id":11,"beg":{"line":280,"col":0},"end":{"line":400,"col":1}},"generated_from_span":null},"source_text":"pub fn solve_shape(\n    kind: SlideBodyKind,\n    start_lane: OuterSlot,\n    end_area: Option<SensorArea>,\n    turn_area: Option<SensorArea>,\n) -> Result<SlideShape, ShapeError> {\n    let end_area = end_area.unwrap_or(SensorArea::A1);\n    let direct = symmetry::direct();\n    let mirror = symmetry::mirror();\n    match kind {\n        SlideBodyKind::Line => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Line, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::CircleRight => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if outer_slot_is_upper_half(start_lane) {\n                    direct\n                } else {\n                    mirror\n                },\n            ))\n        }\n        SlideBodyKind::CircleLeft => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if !outer_slot_is_upper_half(start_lane) {\n                    direct\n                } else {\n                    mirror\n                },\n            ))\n        }\n        SlideBodyKind::CircleUp => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Circle, Some(rel_end)));\n            Ok(mk_slide_shape(\n                canonical,\n                if rel_end < 5 { direct } else { mirror },\n            ))\n        }\n        SlideBodyKind::V => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::V, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Pp => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Ppqq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Qq => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Ppqq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, mirror))\n        }\n        SlideBodyKind::P => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Pq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, direct))\n        }\n        SlideBodyKind::Q => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Pq, Some(rel_end)));\n            Ok(mk_slide_shape(canonical, mirror))\n        }\n        SlideBodyKind::S | SlideBodyKind::Z => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if rel_end != 5 {\n                Err(ShapeError::InvalidEnd)\n            } else {\n                let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::S, None));\n                let sym = if kind == SlideBodyKind::Z {\n                    mirror\n                } else {\n                    direct\n                };\n                Ok(mk_slide_shape(canonical, sym))\n            }\n        }\n        SlideBodyKind::Turn => {\n            let turn_area = turn_area.unwrap_or(SensorArea::A1);\n            let turn_rel = shape_try!(relative_end_from_typed(start_lane, turn_area));\n            let end_rel = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if turn_rel == 7 {\n                if end_rel < 2 || end_rel > 5 {\n                    Err(ShapeError::InvalidTurnEnd)\n                } else {\n                    let canonical =\n                        shape_try!(mk_canonical_slide_shape(SlideKind::Turn, Some(end_rel)));\n                    Ok(mk_slide_shape(canonical, direct))\n                }\n            } else if turn_rel == 3 {\n                if end_rel < 5 {\n                    Err(ShapeError::InvalidTurnEnd)\n                } else {\n                    let canonical =\n                        shape_try!(mk_canonical_slide_shape(SlideKind::Turn, Some(end_rel)));\n                    Ok(mk_slide_shape(canonical, mirror))\n                }\n            } else {\n                Err(ShapeError::InvalidTurn)\n            }\n        }\n        SlideBodyKind::Wifi => {\n            let rel_end = shape_try!(relative_end_from_typed(start_lane, end_area));\n            if rel_end != 5 {\n                Err(ShapeError::InvalidEnd)\n            } else {\n                let canonical = shape_try!(mk_canonical_slide_shape(SlideKind::Wifi, None));\n                Ok(mk_slide_shape(canonical, direct))\n            }\n        }\n    }\n}","attr_info":{"attributes":[{"DocComment":" `solveSlideShape`."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"HashConsedValue":[6837,{"Adt":{"id":{"Adt":21},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":5252},{"HashConsedValue":[6904,{"Adt":{"id":{"Adt":59},"generics":{"regions":[],"types":[{"Deduplicated":4833}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":6904}],"output":{"HashConsedValue":[6905,{"Adt":{"id":{"Adt":67},"generics":{"regions":[],"types":[{"Deduplicated":6802},{"Deduplicated":6863}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":11,"beg":{"line":280,"col":0},"end":{"line":400,"col":1}},"generated_from_span":null},"bound_body_regions":10,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"s