   };\n            }\n        }\n        plans.push(SegmentPlan {\n            head: current_start,\n            begin,\n            end: cursor,\n            has_timing,\n        });\n        current_start = end_char;\n    }\n    Ok(plans)\n}","attr_info":{"attributes":[{"DocComment":" Outer fuel: empty succeeds before the fuel guard; nonempty/fuel=0 returns"},{"DocComment":" InvalidSyntax before digit/mark inspection. A later error discards all plans,"},{"DocComment":" as with the original Except recursion."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":24924},{"Deduplicated":8254},{"Deduplicated":6773}],"output":{"HashConsedValue":[23050,{"Adt":{"id":{"Adt":94},"generics":{"regions":[],"types":[{"HashConsedValue":[23049,{"Adt":{"id":{"Adt":85},"generics":{"regions":[],"types":[{"HashConsedValue":[8949,{"Adt":{"id":{"Adt":28},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":8926}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":14,"beg":{"line":124,"col":0},"end":{"line":170,"col":1}},"generated_from_span":null},"bound_body_regions":18,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":14,"beg":{"line":128,"col":5},"end":{"line":128,"col":41}},"generated_from_span":null},"ty":{"Deduplicated":23050}},{"index":1,"name":"chars","span":{"data":{"file_id":14,"beg":{"line":125,"col":4},"end":{"line":125,"col":9}},"generated_from_span":null},"ty":{"Deduplicated":8303}},{"index":2,"name":"current_start","span":{"data":{"file_id":14,"beg":{"line":126,"col":4},