,"Conditional"]},"comments_before":[]},{"span":{"data":{"file_id":34,"beg":{"line":174,"col":1},"end":{"line":174,"col":1}},"generated_from_span":null},"id":16281,"kind":"Return","comments_before":[]}]},"comments":[[91,["Compute this even on a shared judgment or a button click."]],[123,["No click is required: timeout/shared judgments are part of the head."]],[145,["Replace EVERY matching id, including duplicate slots before the","cursor. Normalization is independent of whether an event exists."]],[155,["Judged is resolved, but only Ended permits another head iteration."]],[160,["Match the existing helper's eager ring probe, including when the","ring is disabled; the availability kernel applies the ring flag."]]]}}},{"def_id":170,"item_meta":{"name":[{"Ident":["lnmai_core_verify",0]},{"Ident":["hold_schedule",0]},{"Ident":["process",0]}],"span":{"data":{"file_id":36,"beg":{"line":66,"col":0},"end":{"line":137,"col":1}},"generated_from_span":null},"source_text":"pub fn process<S, Z, N, F, Q, C, H, E, Event, D, Area, Ops>(\n    holds: &S,\n    mut work: HoldWork<F, Q, C, H, E>,\n    ops: Ops,\n) -> HoldWork<F, Q, C, H, E>\nwhere\n    Ops: HoldSchedule<S, Z, N, F, Q, C, H, E, Event, D, Area>,\n{\n    let len = ops.length(holds);\n    let mut index = 0;\n    while index < len {\n        let (zone, before) = ops.get(holds, index);\n        let button_diff = ops.button_diff(&before);\n        let sensor_diff = ops.sensor_diff(&before);\n        let current_button_pressed = ops.button_pressed(&zone);\n        let current_sensor_pressed = ops.sensor_pressed(&zone);\n        let prev_sensor_pressed = ops.prev_sensor_pressed(&zone);\n        let before_phase = ops.phase(&before);\n        let allow_input = matches!(\n            before_phase,\n            HoldPhase::HeadWaiting | HoldPhase::HeadJudgeable\n        ) && ops.unlocked(&work.frontiers, &zone, &before)\n            && ops.eligible(&before);\n        let fallback_area = ops.fallback_area(&zone);\n        // Both availability reads observe the cursor before either update.\n        let plan = crate::scheduler::consume_click(\n            allow_input,\n            ops.button_available(&work.cursor, &zone),\n            ops.sensor_available(&work.cursor, &fallback_area),\n        );\n        if plan.used_button {\n            work.cursor = ops.use_button(work.cursor, &zone);\n        }\n        if plan.used_sensor {\n            work.cursor = ops.use_sensor(work.cursor, &fallback_area);\n        }\n        let clicked = plan.used_button || plan.used_sensor;\n        // Ordinary Hold uses the sensor diff even when no click was consumed.\n        let diff = if plan.used_button {\n            button_diff\n        } else {\n            sensor_diff\n        };\n        let pressed = current_button_pressed || current_sensor_pressed;\n        let (after, event) = ops.step(\n            &before,\n            diff,\n            clicked,\n            pressed,\n            current_button_pressed,\n            prev_sensor_pressed,\n        );\n        let after_phase = ops.phase(&after);\n        // Match the final lifecycle state, including HeadJudged(Miss). A\n        // transition straight to Body/Ended does not satisfy this condition.\n        if !matches!(before_phase, HoldPhase::HeadJudged)\n            && matches!(after_phase, HoldPhase::HeadJudged)\n        {\n            work.frontiers = ops.advance_frontier(work.frontiers, &zone);\n        }\n        // Sync every result; event presence and active retention are irrelevant.\n        work.queues = ops.update_queue(work.queues, &zone, &after);\n        if !matches!(after_phase, HoldPhase::Ended) {\n            work.active = ops.append_active(work.active, zone, after);\n        }\n        if let Some(event) = event {\n            work.events = ops.append_event(work.events, event);\n        }\n        index += 1;\n    }\n    work\n}","attr_info":{"attributes":[{"DocComment":" Full ordinary-hold pass. The index increases only under index < len, so"},{"DocComment":" index + 1 <= len <= usize::MAX. No recursive traversal or len + 1 is needed."},{"DocComment":" The queue adapter's separate normalization boundary is unaffected by this."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"S"},{"index":1,"name":"Z"},{"index":2,"name":"N"},{"index":3,"name":"F"},{"index":4,"name":"Q"},{"index":5,"name":"C"},{"index":6,"name":"H"},{"index":7,"name":"E"},{"index":8,"name":"Event"},{"index":9,"name":"D"},{"index":10,"name":"Area"},{"index":11,"name":"Ops"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":36,"beg":{"line":72,"col":9},"end":{"line":72,"col":61}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":24751},{"Deduplicated":24553},{"Deduplicated":24555},{"Deduplicated":24556},{"Deduplicated":24557},{"Deduplicated":24561},{"Deduplicated":24562},{"Deduplicated":24563},{"Deduplicated":24738},{"Deduplicated":24739},{"Deduplicated":24749},{"Deduplicated":24750}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":24712},{"HashConsedValue":[25304,{"Adt":{"id":{"Adt":68},"generics":{"regions":[],"types":[{"Deduplicated":24557},{"Deduplicated":24561},{"Deduplicated":24562},{"Deduplicated":24563},{"Deduplicated":24738}],"const_generics":[],"trait_refs":[]}}}]},{"Deduplicated":24751}],"output":{"Deduplicated":25304}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":36,"beg":{"line":66,"col":0},"end":{"line":137,"col":1}},"generated_from_span":null},"bound_body_regions":165,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":36,"beg":{"l