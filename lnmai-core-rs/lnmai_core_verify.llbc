d_ancestors_fuel",0]}],"span":{"data":{"file_id":25,"beg":{"line":216,"col":0},"end":{"line":249,"col":1}},"generated_from_span":null},"source_text":"pub fn end_ancestors_fuel<S, C, I, Read, Equal, Write, Emit>(\n    len: usize,\n    mut fuel: usize,\n    mut state: S,\n    mut commands: C,\n    mut parent_index: Option<I>,\n    read: Read,\n    equal: Equal,\n    write: Write,\n    emit: Emit,\n) -> (S, C)\nwhere\n    Read: ParentRead<S, I>,\n    Equal: ParentEqual<I>,\n    Write: Fn(S, usize, ParentEdit) -> S,\n    Emit: Fn(C, I) -> C,\n{\n    while fuel > 0 {\n        let Some(target) = parent_index else {\n            return (state, commands);\n        };\n        let Some(parent) = find_first(len, &state, &target, &read, &equal) else {\n            return (state, commands);\n        };\n        if parent.ended {\n            return (state, commands);\n        }\n        state = update_all(len, state, &target, ParentEdit::End, &read, &equal, &write);\n        commands = emit(commands, parent.note_index);\n        parent_index = parent.parent_index;\n        fuel -= 1;\n    }\n    (state, commands)\n}","attr_info":{"attributes":[{"DocComment":" Each successful iteration ends all same-ID slots and then appends the"},{"DocComment":" first matching parent's hide command. Its original parent ID determines"},{"DocComment":" the next iteration. Already-ended parents and missing IDs stop the loop;"},{"DocComment":" fuel bounds even malformed cycles without assuming unique IDs or a DAG."},{"Unknown":{"path":"allow","args":"clippy::too_many_arguments"}}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"S"},{"index":1,"name":"C"},{"index":2,"name":"I"},{"index":3,"name":"Read"},{"index":4,"name":"Equal"},{"index":5,"name":"Write"},{"index":6,"name":"Emit"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":25,"beg":{"line":228,"col":10},"end"