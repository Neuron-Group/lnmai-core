null},"source_text":"pub fn parse<T, O: DecimalOps<T>>(chars: &[char], ops: &O) -> Option<Parts<T>> {\n    if chars.is_empty() {\n        return None;\n    }\n    let negative = chars[0] == '-';\n    let mut index = if negative { 1 } else { 0 };\n    let mut whole = ops.zero();\n    let mut last_was_digit = false;\n    while index < chars.len() {\n        let c = chars[index];\n        if c == '.' {\n            if !last_was_digit {\n                return None;\n            }\n            index += 1;\n            return match fraction(chars, index, ops) {\n                Some(fraction) => Some(Parts {\n                    negative,\n                    whole,\n                    fraction: Some(fraction),\n                }),\n                None => None,\n            };\n        } else if c == '_' {\n            if !last_was_digit {\n                return None;\n            }\n            last_was_digit = false;\n        } else {\n            match decimal_digit(c) {\n                Some(digit) => {\n                    whole = ops.append(whole, digit);\n                    last_was_digit = true;\n                }\n                None => return None,\n            }\n        }\n        index += 1;\n    }\n    if last_was_digit {\n        Some(Parts {\n            negative,\n            whole,\n            fraction: None,\n        })\n    } else {\n        None\n    }\n}","attr_info":{"attributes":[{"DocComment":" Parse a trimmed timing number. The whole part follows Lean `toNat?`,"},{"DocComment":" including single internal underscores; the fractional part is digits only."},{"DocComment":" A single leading minus is accepted, while plus signs and empty wholes fail."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"},{"index":1,"name":"O"}],"const_generics":[],"t