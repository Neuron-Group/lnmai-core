    Visibility: public -/
def judge.judge_touch
  (diff : time.Duration) (_is_ex : Bool) :
  Result (Option types.JudgeGrade)
  := do
  let abs_diff ← time.Duration.abs diff
  if diff.micros < 0#i64
  then
    if abs_diff.micros > constants.TOUCH_PERFECT_1ST.micros
    then ok none
    else
      if abs_diff.micros <= constants.TOUCH_PERFECT_1ST.micros
      then ok (some types.JudgeGrade.Perfect)
      else
        if abs_diff.micros <= constants.TOUCH_PERFECT_2ND.micros
        then ok (some types.JudgeGrade.LatePerfect2nd)
        else
          if abs_diff.micros <= constants.TOUCH_PERFECT_3RD.micros
          then ok (some types.JudgeGrade.LatePerfect3rd)
          else
            if abs_diff.micros <= constants.TOUCH_GREAT_1ST.micros
            then ok (some types.JudgeGrade.LateGreat)
            else
              if abs_diff.micros <= constants.TOUCH_GREAT_2ND.micros
              then ok (some types.JudgeGrade.LateGreat2nd)
              else
                if abs_diff.micros <= constants.TOUCH_GREAT_3RD.micros
                then ok (some types.JudgeGrade.LateGreat3rd)
                else ok (some types.JudgeGrade.LateGood)
  else
    if abs_diff.micros <= constants.TOUCH_PERFECT_1ST.micros
    then ok (some types.JudgeGrade.Perfect)
    else
      if abs_diff.micros <= constants.TOUCH_PERFECT_2ND.micros
      then ok (some types.JudgeGrade.LatePerfect2nd)
      else
        if abs_diff.micros <= constants.TOUCH_PERFECT_3RD.micros
        then ok (some types.JudgeGrade.LatePerfect3rd)
        else
          if abs_diff.micros <= constants.TOUCH_GREAT_1ST.micros
          then ok (some types.JudgeGrade.LateGreat)
          else
            if abs_diff.micros <= constants.TOUCH_GREAT_2ND.micros
            then ok (some types.JudgeGrade.LateGreat2nd)
            else
              if abs_diff.micros <= constants.TOUCH_GREAT_3RD.micros
              then ok (some types.JudgeGrade.LateGreat3rd)
              else ok (some types.JudgeGrade.LateGood)

