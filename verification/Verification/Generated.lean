def slide_lifecycle.unjudged_action
  {D : Type} (wait : D) (checkable : Bool) (judgable : Bool) (too_late : Bool)
  :
  Result (slide_lifecycle.SlideAction D)
  := do
  if checkable
  then ok (slide_lifecycle.SlideAction.Activate wait)
  else
    if judgable
