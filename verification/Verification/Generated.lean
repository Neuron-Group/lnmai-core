  | shape.SlideBodyKind.Q =>
    let r ← shape.relative_end_from_typed start_lane end_area1
    match r with
    | core.result.Result.Ok value =>
      let r1 ← shape.mk_canonical_slide_shape shape.SlideKind.Pq (some value)
      match r1 with
