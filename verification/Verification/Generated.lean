    Source: 'crates/lnmai-core-verify/src/judge.rs', lines 10:0-57:1
    Visibility: public -/
def judge.judge_tap
  (diff : time.Duration) (is_ex : Bool) : Result types.JudgeGrade := do
  if is_ex
  then ok types.JudgeGrade.Perfect
  else
    let abs_diff ← time.Duration.abs diff
    if abs_diff.micros <= constants.TAP_PERFECT_1ST.micros
    then ok types.JudgeGrade.Perfect
    else
      if abs_diff.micros <= constants.TAP_PERFECT_2ND.micros
      then
        if diff.micros < 0#i64
        then ok types.JudgeGrade.FastPerfect2nd
        else ok types.JudgeGrade.LatePerfect2nd
      else
        if abs_diff.micros <= constants.TAP_PERFECT_3RD.micros
        then
          if diff.micros < 0#i64
          then ok types.JudgeGrade.FastPerfect3rd
          else ok types.JudgeGrade.LatePerfect3rd
        else
          if abs_diff.micros <= constants.TAP_GREAT_1ST.micros
          then
            if diff.micros < 0#i64
            then ok types.JudgeGrade.FastGreat
            else ok types.JudgeGrade.LateGreat
          else
            if abs_diff.micros <= constants.TAP_GREAT_2ND.micros
            then
              if diff.micros < 0#i64
              then ok types.JudgeGrade.FastGreat2nd
              else ok types.JudgeGrade.LateGreat2nd
            else
              if abs_diff.micros <= constants.TAP_GREAT_3RD.micros
              then
                if diff.micros < 0#i64
                then ok types.JudgeGrade.FastGreat3rd
                else ok types.JudgeGrade.LateGreat3rd
              else
                if diff.micros < 0#i64
                then ok types.JudgeGrade.FastGood
                else ok types.JudgeGrade.LateGood

/-- [lnmai_core_verify::judge::judge_touch]:
    Source: 'crates/lnmai-core-verify/src/judge.rs', lines 60:0-85:1
    Visibility: public -/
def judge.judge_touch
  (diff : time.Duration) (_is_ex : Bool) :
  Result (Option types.JudgeGrade)
  := do
  let abs_diff ← time.Duration.abs diff
  if diff.micros < 0#i64
  then
    if abs_diff.micros > constants.TOUCH_PERFECT_1ST.micros
    then ok none
    else
      if abs_diff.micros <= constants.TOUCH_PERFECT_1ST.micros
      then ok (some types.JudgeGrade.Perfect)
      else
        if abs_diff.micros <= constants.TOUCH_PERFECT_2ND.micros
        then ok (some types.JudgeGrade.LatePerfect2nd)
        else
          if abs_diff.micros <= constants.TOUCH_PERFECT_3RD.micros
          then ok (some types.JudgeGrade.LatePerfect3rd)
          else
            if abs_diff.micros <= constants.TOUCH_GREAT_1ST.micros
            then ok (some types.JudgeGrade.LateGreat)
            else
              if abs_diff.micros <= constants.TOUCH_GREAT_2ND.micros
              then ok (some types.JudgeGrade.LateGreat2nd)
              else
                if abs_diff.micros <= constants.TOUCH_GREAT_3RD.micros
                then ok (some types.JudgeGrade.LateGreat3rd)
                else ok (some types.JudgeGrade.LateGood)
  else
    if abs_diff.micros <= constants.TOUCH_PERFECT_1ST.micros
    then ok (some types.JudgeGrade.Perfect)
    else
      if abs_diff.micros <= constants.TOUCH_PERFECT_2ND.micros
      then ok (some types.JudgeGrade.LatePerfect2nd)
      else
        if abs_diff.micros <= constants.TOUCH_PERFECT_3RD.micros
        then ok (some types.JudgeGrade.LatePerfect3rd)
        else
          if abs_diff.micros <= constants.TOUCH_GREAT_1ST.micros
          then ok (some types.JudgeGrade.LateGreat)
          else
            if abs_diff.micros <= constants.TOUCH_GREAT_2ND.micros
            then ok (some types.JudgeGrade.LateGreat2nd)
            else
              if abs_diff.micros <= constants.TOUCH_GREAT_3RD.micros
              then ok (some types.JudgeGrade.LateGreat3rd)
              else ok (some types.JudgeGrade.LateGood)

