    | types.JudgeGrade.LateGreat3rd => ok types.JudgeGrade.LateGreat
    | types.JudgeGrade.LateGreat2nd => ok types.JudgeGrade.LateGreat
    | types.JudgeGrade.LateGreat => ok types.JudgeGrade.LateGreat
