  (steps : Std.Usize) (n : Std.Usize) : Result Std.Usize := do
  let i ← n - 1#usize
  let i1 ← steps % 8#usize
  let i2 ← i + i1
  let i3 ← i2 % 8#usize
  i3 + 1#usize

