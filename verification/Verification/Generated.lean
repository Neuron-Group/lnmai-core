def types.NoteStatus.leq
  (a : types.NoteStatus) (b : types.NoteStatus) : Result Bool := do
  match a with
  | types.NoteStatus.Start => ok true
  | types.NoteStatus.Inited =>
    match b with
    | types.NoteStatus.Start => ok false
    | types.NoteStatus.Inited => ok true
    | types.NoteStatus.Scaling => ok true
    | types.NoteStatus.Running => ok true
    | types.NoteStatus.Arrived => ok true
    | types.NoteStatus.End => ok true
  | types.NoteStatus.Scaling =>
    match b with
    | types.NoteStatus.Start => ok false
