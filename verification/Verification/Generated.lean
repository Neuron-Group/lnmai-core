def natural_parser.decimal_digit (c : Char) : Result (Option Std.U8) := do
  if c = '0'
  then ok (some 0#u8)
  else
    if c = '1'
    then ok (some 1#u8)
    else
      if c = '2'
      then ok (some 2#u8)
      else
        if c = '3'
        then ok (some 3#u8)
        else
          if c = '4'
          then ok (some 4#u8)
          else
            if c = '5'
            then ok (some 5#u8)
            else
              if c = '6'
              then ok (some 6#u8)
              else
                if c = '7'
                then ok (some 7#u8)
                else
                  if c = '8'
                  then ok (some 8#u8)
                  else if c = '9'
                       then ok (some 9#u8)
                       else ok none

