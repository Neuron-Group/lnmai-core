    | core.result.Result.Err error => ok (core.result.Result.Err error)
  | shape.SlideBodyKind.Wifi =>
    let r ← shape.relative_end_from_typed start_lane end_area1
    match r with
    | core.result.Result.Ok value =>
      if value != 5#usize
