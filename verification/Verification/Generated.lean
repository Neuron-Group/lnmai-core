/-- [lnmai_core_verify::judge::judge_hold_classic_end]:
    Source: 'crates/lnmai-core-verify/src/judge.rs', lines 400:0-437:1
    Visibility: public -/
def judge.judge_hold_classic_end
  (head_grade : types.JudgeGrade) (timing : Std.I64) (length : time.Duration)
  (release_timing : Std.I64) :
  Result types.JudgeGrade
  := do
  let b ← types.JudgeGrade.is_miss_or_too_fast head_grade
  if b
  then ok head_grade
  else
    let i ← timing + length.micros
    let i1 ← i - release_timing
    let abs_diff ← time.Duration.abs { micros := i1 }
    let end_grade ←
      if i1 > 0#i64
      then
        if abs_diff.micros <
          constants.HOLD_CLASSIC_END_JUDGE_PERFECT_FAST.micros
        then ok types.JudgeGrade.Perfect
        else ok types.JudgeGrade.FastGood
      else
        if abs_diff.micros <
          constants.HOLD_CLASSIC_END_JUDGE_PERFECT_LATE.micros
        then ok types.JudgeGrade.Perfect
        else ok types.JudgeGrade.LateGood
    let head_dist ← types.JudgeGrade.dist_from_perfect head_grade
    let end_dist ← types.JudgeGrade.dist_from_perfect end_grade
    if end_dist > head_dist
    then ok end_grade
    else ok head_grade

