  {GroupId : Type} {Output : Type} {Ops : Type} (TouchReadInst :
  maidata_scan.TouchRead Ops) (TouchWriteInst : maidata_scan.TouchWrite Ops
  GroupId Output) (i : Std.Usize) (i1 : Std.Usize) (group_id : GroupId)
