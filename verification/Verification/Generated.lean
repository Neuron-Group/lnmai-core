    Source: 'crates/lnmai-core-verify/src/judge.rs', lines 165:0-177:1 -/
def judge.press_band_micros
  (held_micros : Std.I64) (reality_micros : Std.I64) : Result Std.U32 := do
  if held_micros >= reality_micros
  then ok 0#u32
  else
    let i ← held_micros * 100#i64
    let i1 ← reality_micros * 67#i64
    if i >= i1
    then ok 1#u32
    else
      let i2 ← reality_micros * 33#i64
      if i >= i2
      then ok 2#u32
      else
        let i3 ← reality_micros * 5#i64
        if i >= i3
        then ok 3#u32
        else ok 4#u32

