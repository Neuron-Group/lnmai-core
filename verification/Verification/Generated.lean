      | maidata_scan.TouchKind.Touch => ok touch_is_each
      | maidata_scan.TouchKind.TouchHold => ok touch_hold_is_each
      | maidata_scan.TouchKind.Other => ok false
    let (output1, group_index1) ←
      if should_tag
      then
        do
