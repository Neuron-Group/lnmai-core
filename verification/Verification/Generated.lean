def shape.relative_end_pos
  (start_pos : Std.Usize) (end_pos : Std.Usize) : Result Std.Usize := do
  let i ← end_pos - 1#usize
  let i1 ← i + 8#usize
  let i2 ← start_pos - 1#usize
  let i3 ← i1 - i2
  let i4 ← i3 % 8#usize
  i4 + 1#usize

