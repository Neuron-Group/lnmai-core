  | shape.SlideBodyKind.Turn =>
    let turn_area1 ←
      lift (core.option.Option.unwrap_or turn_area areas.SensorArea.A1)
    let r ← shape.relative_end_from_typed start_lane turn_area1
    match r with
    | core.result.Result.Ok value =>
