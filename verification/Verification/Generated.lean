def types.JudgeGrade.dist_from_perfect
  (self : types.JudgeGrade) : Result Std.U32 := do
  match self with
  | types.JudgeGrade.Miss => ok 7#u32
  | types.JudgeGrade.LateGood => ok 6#u32
  | types.JudgeGrade.LateGreat3rd => ok 5#u32
  | types.JudgeGrade.LateGreat2nd => ok 4#u32
  | types.JudgeGrade.LateGreat => ok 3#u32
  | types.JudgeGrade.LatePerfect3rd => ok 2#u32
  | types.JudgeGrade.LatePerfect2nd => ok 1#u32
  | types.JudgeGrade.Perfect => ok 0#u32
  | types.JudgeGrade.FastPerfect2nd => ok 1#u32
  | types.JudgeGrade.FastPerfect3rd => ok 2#u32
  | types.JudgeGrade.FastGreat => ok 3#u32
  | types.JudgeGrade.FastGreat2nd => ok 4#u32
